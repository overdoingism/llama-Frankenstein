index 127a4a142..cdef3ce69 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1649,9 +1649,32 @@ void   ggml_cuda_h2d_ring_cap_set(size_t bytes);
 // The per-operand cap GGML_CUDA_FA_STAGE_MAX_MB resolves to (0 = unbounded): a staging request
 // larger than this is not staged at all.  Shared by launch_fattn and the --fit accounting of the
 // staging arena (ggml_backend_cuda_fattn_stage_bound).
+// With the fp8 prefill attention on (FRANK_FA_FP8, on unless set to 0 or unset with FRANK_ALL=0) and every device an
+// RDNA4 one (where it runs), the default is 1 MiB: a batch of 32 or more tokens goes to it and never stages, and the ones
+// it declines (9-31 tokens) read the q8_0 cache directly at the same speed and with the same result, instead of growing a
+// whole-prefix F16 copy that is never freed (the arena sits outside --fit, and on Windows a device allocation does not
+// fail when VRAM runs out but lands in shared memory).  An explicit setting still wins.
+static inline bool ggml_cuda_lf_fa_fp8_runs() {
+    const char * f = getenv("FRANK_FA_FP8");
+    const char * a = getenv("FRANK_ALL");
+    if (f != nullptr ? atoi(f) == 0 : (a != nullptr && a[0] == '0' && a[1] == '\0')) {
+        return false;
+    }
+    const ggml_cuda_device_info & info = ggml_cuda_info();
+    for (int d = 0; d < info.device_count; ++d) {
+        if (!GGML_CUDA_CC_IS_RDNA4(info.devices[d].cc)) {
+            return false;
+        }
+    }
+    return info.device_count > 0;
+}
+
 static inline size_t ggml_cuda_fattn_stage_max_bytes() {
     static const size_t stage_max_bytes = []() {
         const char * e = getenv("GGML_CUDA_FA_STAGE_MAX_MB");
+        if (e == nullptr && ggml_cuda_lf_fa_fp8_runs()) {
+            return (size_t) 1 << 20;
+        }
         return (size_t) (e ? atoll(e) : 512) << 20;
     }();
     return stage_max_bytes;
