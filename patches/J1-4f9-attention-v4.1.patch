+// the packed KV-group bitmap shared by the attention layers of one graph evaluation (see fattn-common.cuh)
+namespace {
+struct fattn_kq_blocks_entry {
+    uint64_t            eval    = 0;      // evaluation the bitmap was built in (0: none)
+    const ggml_tensor * mask    = nullptr;
+    const void *        data    = nullptr;
+    int64_t             key[8]  = {};
+    cudaStream_t        stream  = nullptr;
+    uint32_t *          buf     = nullptr;
+    size_t              cap     = 0;      // in words
+};
+std::mutex                                                             fattn_kq_blocks_mutex;
+std::unordered_map<const ggml_backend_cuda_context *, uint64_t>              fattn_eval;
+std::unordered_map<const ggml_backend_cuda_context *, fattn_kq_blocks_entry> fattn_kq_blocks;
+
+bool fattn_kq_blocks_reuse_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_FA_KQ_BLOCKS_REUSE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+} // namespace
+
+void ggml_cuda_fattn_new_graph_eval(const ggml_backend_cuda_context & ctx) {
+    if (!fattn_kq_blocks_reuse_on()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(fattn_kq_blocks_mutex);
+    ++fattn_eval[&ctx];
+}
+
+uint32_t * ggml_cuda_fattn_kq_blocks_reuse(const ggml_backend_cuda_context & ctx, const ggml_tensor * mask, const int64_t key[8],
+                                           const size_t n_words, cudaStream_t stream, bool & built) {
+    built = true;
+    if (!fattn_kq_blocks_reuse_on()) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(fattn_kq_blocks_mutex);
+    const uint64_t eval = fattn_eval[&ctx];
+    if (eval == 0) {
+        return nullptr;
+    }
+    fattn_kq_blocks_entry & e = fattn_kq_blocks[&ctx];
+    if (e.eval == eval && e.mask == mask && e.data == mask->data && e.stream == stream && memcmp(e.key, key, sizeof(e.key)) == 0) {
+        built = false;
+        return e.buf;
+    }
+    // another stream of this evaluation may still read the buffer: no reuse there
+    if (e.eval == eval && e.stream != stream) {
+        return nullptr;
+    }
+    if (e.buf == nullptr) {
+        // one fixed buffer (captured graphs keep its address), never while a graph is captured
+#if defined(GGML_USE_HIP)
+        hipStreamCaptureStatus cs = hipStreamCaptureStatusNone;
+        CUDA_CHECK(hipStreamIsCapturing(stream, &cs));
+        if (cs != hipStreamCaptureStatusNone) {
+            return nullptr;
+        }
+#elif defined(USE_CUDA_GRAPH)
+        cudaStreamCaptureStatus cs = cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+        if (cs != cudaStreamCaptureStatusNone) {
+            return nullptr;
+        }
+#endif
+        e.cap = 16384;   // 64 KiB: a 2048-token batch at a 256K context needs ~8K words
+        CUDA_CHECK(cudaMalloc((void **) &e.buf, e.cap * sizeof(uint32_t)));
+    }
+    if (n_words > e.cap) {
+        return nullptr;
+    }
+    e.eval = eval; e.mask = mask; e.data = mask->data; e.stream = stream;
+    memcpy(e.key, key, sizeof(e.key));
+    return e.buf;
+}
