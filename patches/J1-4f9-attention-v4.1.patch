index 000000000..628ec562e
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-q8r.cu
@@ -0,0 +1,601 @@
+// BigOne stage 4: decode / verify flash attention over the q8_0r KV cache (a row of 256 int8 codes, then the 8 f16 scales of
+// its 32-value groups; the same values as q8_0).  Head 256, GQA <= 6, 1..8 query tokens per launch (9..16 in two launches,
+// 17..31 in launches of 8: below F8's 32 rows, so no batch converts the whole cache to f16 into the pool).
+//
+// One workgroup per (split p, KV head) of eight warps: all of them load the next 16 tokens of K and V (one task a lane), widen
+// them to f16 and store them in LDS (K as [token][dim], V transposed as [dim][token], 16-byte chunks XOR-swizzled), double
+// buffered -- the six compute warps between the two halves of a step -- and the compute warps hold the GQA x width query rows
+// (up to 48, three 16-row tiles) with each tile split over two warps by head dim.  FRANK_FA_Q8R_SW=2: the earlier split,
+// two staging warps loading every byte; the bytes in LDS and their order are the same, so are the results.
+// S^T = K Q^T and O^T += V^T P^T on f16 WMMA (16x16x16, f32 accumulators), so a lane keeps one query row: the softmax is
+// lane-local after one exchange between the two head-dim halves (through LDS, summed in a fixed order so both warps make
+// the same decisions).  The running max is only raised when a block's max exceeds it by more than 2^8 (P <= 256 in f16).
+//
+// Purity: the KV cells are cut into 64-token batches and batch b always belongs to split b % P (P fixed: not a function of
+// the KV length or of the query width).  Every query row is computed alone (its own max, its own rescales), the partials
+// are merged in split order, and the one kernel instance serves every width, so a token's output does not depend on the
+// width of the batch it is verified in nor on cells past the ones it sees.  A 256-cell group that is masked for every
+// query row (the other slots' cells in a unified cache) is skipped: it would only add exact zeros.
+//
+// Simulation, measurements and the purity checks: tools/decode-attn (E4).  The online softmax is Milakov & Gimelshein's
+// (arXiv 1805.02867); skipping the rescale while a row's max stays within 2^8 of the one it was scaled to follows
+// FlashAttention-4 (Zadouri et al., arXiv 2603.05451, sec. 3.1.4), decided here per row.  Q folded with scale * log2(e) for
+// exp2 as in Triton's fused-attention tutorial (v2.1.0); 16-bit partials with f32 maxima and sums as in vLLM's
+// PagedAttention V2; int8 codes widened through the mantissa of f16 1024 as in Kim et al. (arXiv 2211.10017, sec. 3.4);
+// K / V widened once per workgroup into LDS for one KV pass of the whole GQA group as the rdna-boosts decode band does.
+
+#include "fattn-q8r.cuh"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+typedef int      q8r_i4 __attribute__((ext_vector_type(4)));
+typedef float    q8r_f8 __attribute__((ext_vector_type(8)));
+typedef _Float16 q8r_h2 __attribute__((ext_vector_type(2)));
+typedef _Float16 q8r_h4 __attribute__((ext_vector_type(4)));
+typedef _Float16 q8r_h8 __attribute__((ext_vector_type(8)));
+
+static constexpr int   Q8R_D          = 256;           // head dim of K and V
+static constexpr int   Q8R_ROWS       = 48;            // query rows of a KV head in one launch (GQA x width)
+static constexpr int   Q8R_TILES      = 3;             // 16-row tiles, each over two warps
+static constexpr int   Q8R_THREADS    = 32*(2*Q8R_TILES + 2);
+static constexpr int   Q8R_MAX_Q      = 8;             // query tokens of one launch
+static constexpr int   Q8R_MAX_OP_Q   = 31;            // query tokens of one op (F8 takes 32 and more)
+static constexpr int   Q8R_SKIP_WORDS = 64;            // masked-group bitmap words kept in LDS (2048 groups of 256 cells)
+static constexpr float Q8R_TAU        = 8.0f;          // lazy rescale threshold (log2)
+static constexpr float Q8R_LOG2E      = 1.4426950408889634f;
+
+uint32_t * ggml_cuda_fattn_kq_blocks_reuse(const ggml_backend_cuda_context & ctx, const ggml_tensor * mask, const int64_t key[8],
+                                           size_t n_words, cudaStream_t stream, bool & built);
+
+static bool q8r_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_FA_Q8R");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+static bool q8r_skip_on() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_FA_MASK_SKIP");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+// splits per KV head (FRANK_FA_Q8R_SPLIT for tuning); fixed, see the purity note above
+static int q8r_splits() {
+    static const int p = [] {
+        const char * e = getenv("FRANK_FA_Q8R_SPLIT");
+        const int v = e ? atoi(e) : 0;
+        return v > 0 ? v : 24;
+    }();
+    return p;
+}
+
+// FRANK_FA_Q8R_SW=2: the pure kernel's earlier staging (two warps load every byte); default: every warp stages a share
+static int q8r_sw() {
+    static const int sw = [] {
+        const char * e = getenv("FRANK_FA_Q8R_SW");
+        return e != nullptr && atoi(e) == 2 ? 2 : 0;
+    }();
+    return sw;
+}
+
+#if defined(RDNA4)
+// LDS positions: K [token t][dim], chunk c (8 dims) of row t at c ^ (t & 15); V^T [dim d][token], chunk c (8 tokens) of row
+// d at c ^ ((d >> 3) & 1): a fragment read touches distinct banks without padding
+static __device__ __forceinline__ int q8r_sk(const int t, const int dim) { return t*Q8R_D + (((dim >> 3) ^ (t & 15)) << 3) + (dim & 7); }
+static __device__ __forceinline__ int q8r_sv(const int d, const int tok) { return d*16 + (((tok >> 3) ^ ((d >> 3) & 1)) << 3) + (tok & 7); }
+
+// 16 codes (one b128) times scale s as two 8-element fragments: code + 128 placed in the mantissa of f16 1024 is exact
+static __device__ __forceinline__ void q8r_codes16(const q8r_i4 q, const _Float16 s, q8r_h8 & f0, q8r_h8 & f1) {
+    const q8r_h2 k = { (_Float16) 1152.0f, (_Float16) 1152.0f }, s2 = { s, s };
+    q8r_h2 x[8];
+#pragma unroll
+    for (int w = 0; w < 4; ++w) {
+        const uint32_t v = (uint32_t) q[w] ^ 0x80808080u;
+        x[2*w + 0] = (__builtin_bit_cast(q8r_h2, __builtin_amdgcn_perm(0x64646464u, v, 0x04010400u)) - k) * s2;
+        x[2*w + 1] = (__builtin_bit_cast(q8r_h2, __builtin_amdgcn_perm(0x64646464u, v, 0x04030402u)) - k) * s2;
+    }
+    f0 = __builtin_shufflevector(__builtin_shufflevector(x[0], x[1], 0, 1, 2, 3), __builtin_shufflevector(x[2], x[3], 0, 1, 2, 3), 0, 1, 2, 3, 4, 5, 6, 7);
+    f1 = __builtin_shufflevector(__builtin_shufflevector(x[4], x[5], 0, 1, 2, 3), __builtin_shufflevector(x[6], x[7], 0, 1, 2, 3), 0, 1, 2, 3, 4, 5, 6, 7);
+}
+
+// A staging lane's share of 16 tokens (s = 0..NS-1): K tasks s + NS i (token, 16-code segment), V tasks s + NS i (dim quad,
+// token quad) and the mask rows of the query tokens (s < 16: row s/2, 8 tokens); the raw bytes are loaded first and
+// widened into the LDS buffers later
+template <int NI>   // tasks a staging lane: 4 with the two staging warps (64 lanes), 1 with every warp staging (256 lanes)
+struct q8r_stage_t {
+    static constexpr int NS = 256/NI;   // staging lanes
+    q8r_i4   kq[NI];
+    _Float16 ks[NI];
+    uint32_t vw[NI][4];
+    _Float16 vsc[NI][4];
+    q8r_i4   mk = { 0, 0, 0, 0 };
+
+    __device__ __forceinline__ void load(const char * __restrict__ K, const char * __restrict__ V, const char * __restrict__ mask,
+            const int t0, const int g, const int s, const int n_q,
+            const int64_t nb11, const int64_t nb12, const int64_t nb21, const int64_t nb22, const int64_t nb31) {
+#pragma unroll
+        for (int i = 0; i < NI; ++i) {
+            const int task = s + NS*i, t = task/16, seg = task%16;
+            const char * kr = K + (int64_t) (t0 + t)*nb11 + (int64_t) g*nb12;
+            kq[i] = *(const q8r_i4 *) (kr + 16*seg);
+            ks[i] = *(const _Float16 *) (kr + Q8R_D + 2*(seg/2));
+        }
+#pragma unroll
+        for (int i = 0; i < NI; ++i) {
+            const int task = s + NS*i, dq = task%64, tq = task/64;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                const char * vr = V + (int64_t) (t0 + 4*tq + j)*nb21 + (int64_t) g*nb22;
+                vw[i][j]  = *(const uint32_t *) (vr + 4*dq);
+                vsc[i][j] = *(const _Float16 *) (vr + Q8R_D + 2*(dq/8));
+            }
+        }
+        if (s < 2*Q8R_MAX_Q && s/2 < n_q) {
+            mk = *(const q8r_i4 *) (mask + (int64_t) (s/2)*nb31 + 2*(t0 + 8*(s%2)));
+        }
+    }
+
+    // sK [16][Q8R_D], sVT [Q8R_D][16], sM [Q8R_MAX_Q][16] of one buffer
+    __device__ __forceinline__ void write(_Float16 * sK, _Float16 * sVT, _Float16 * sM, const int s, const int n_q) const {
+#pragma unroll
+        for (int i = 0; i < NI; ++i) {
+            const int task = s + NS*i, t = task/16, seg = task%16;
+            q8r_h8 f0, f1;
+            q8r_codes16(kq[i], ks[i], f0, f1);
+            *(q8r_h8 *) &sK[q8r_sk(t, 16*seg)]     = f0;
+            *(q8r_h8 *) &sK[q8r_sk(t, 16*seg + 8)] = f1;
+        }
+        const q8r_h2 k1152 = { (_Float16) 1152.0f, (_Float16) 1152.0f };
+#pragma unroll
+        for (int i = 0; i < NI; ++i) {
+            // 4 dims x 4 tokens: transpose the bytes, then widen each dim's 4 codes with the 4 tokens' scales
+            const int task = s + NS*i, dq = task%64, tq = task/64;
+            const uint32_t * w = vw[i];
+            const uint32_t x01 = __builtin_amdgcn_perm(w[1], w[0], 0x05010400u), x01h = __builtin_amdgcn_perm(w[1], w[0], 0x07030602u);
+            const uint32_t x23 = __builtin_amdgcn_perm(w[3], w[2], 0x05010400u), x23h = __builtin_amdgcn_perm(w[3], w[2], 0x07030602u);
+            const uint32_t col[4] = { __builtin_amdgcn_perm(x23, x01, 0x05040100u), __builtin_amdgcn_perm(x23, x01, 0x07060302u),
+                                      __builtin_amdgcn_perm(x23h, x01h, 0x05040100u), __builtin_amdgcn_perm(x23h, x01h, 0x07060302u) };
+            const q8r_h2 s01 = { vsc[i][0], vsc[i][1] }, s23 = { vsc[i][2], vsc[i][3] };
+#pragma unroll
+            for (int e = 0; e < 4; ++e) {
+                const uint32_t v = col[e] ^ 0x80808080u;
+                const q8r_h2 a = (__builtin_bit_cast(q8r_h2, __builtin_amdgcn_perm(0x64646464u, v, 0x04010400u)) - k1152) * s01;
+                const q8r_h2 b = (__builtin_bit_cast(q8r_h2, __builtin_amdgcn_perm(0x64646464u, v, 0x04030402u)) - k1152) * s23;
+                *(q8r_h4 *) &sVT[q8r_sv(4*dq + e, 4*tq)] = __builtin_shufflevector(a, b, 0, 1, 2, 3);
+            }
+        }
+        if (s < 2*Q8R_MAX_Q && s/2 < n_q) {
+            *(q8r_i4 *) &sM[(s/2)*16 + 8*(s%2)] = mk;
+        }
+    }
+};
+#endif // defined(RDNA4)
+
+// grid (P, KV heads).  Q f32 (row qtok at nb01, head at nb02), K / V q8_0r (token at nb11 / nb21, head at nb12 / nb22),
+// mask f16 (row at nb31).  Writes split p's normalized partial (f16), its max and its sum per query row.
+// NSW: 0 = every warp stages, 2 = two staging warps (FRANK_FA_Q8R_SW=2); same bytes in LDS in the same order
+template <int NSW>
+__launch_bounds__(Q8R_THREADS)
+static __global__ void flash_attn_q8r(
+        const char * __restrict__ Q, const char * __restrict__ K, const char * __restrict__ V, const char * __restrict__ mask,
+        const uint32_t * __restrict__ skip, float * __restrict__ pm, float * __restrict__ pl, _Float16 * __restrict__ po,
+        const float qscale, const int n_kv, const int n_q, const int gqa, const int P,
+        const int64_t nb01, const int64_t nb02, const int64_t nb11, const int64_t nb12, const int64_t nb21, const int64_t nb22,
+        const int64_t nb31) {
+#if defined(RDNA4)
+    const int p = blockIdx.x, g = blockIdx.y, n_kvh = gridDim.y;
+    const int tid = threadIdx.x, warp = tid/32, lane = tid%32, r16 = lane%16, h = lane/16;
+    const int tile = warp/2, half = warp%2;
+    const int R = gqa*n_q;
+    const int row = 16*tile + r16;
+    const bool compute = warp < 2*Q8R_TILES;
+    const bool row_on = compute && row < R;
+    const int qtok = row_on ? row/gqa : 0;
+    const int nb = n_kv/64;
+
+    __shared__ __attribute__((aligned(16))) _Float16 sK[2][16*Q8R_D];
+    __shared__ __attribute__((aligned(16))) _Float16 sVT[2][Q8R_D*16];
+    __shared__ __attribute__((aligned(16))) _Float16 sM[2][Q8R_MAX_Q][16];
+    __shared__ __attribute__((aligned(16))) float sX[Q8R_TILES][2][32][8];
+    __shared__ uint32_t sSkip[Q8R_SKIP_WORDS];
+
+    const int n_words = skip ? (n_kv/256 + 31)/32 : 0;
+    for (int i = tid; i < Q8R_SKIP_WORDS; i += Q8R_THREADS) {
+        sSkip[i] = i < n_words ? skip[i] : 0u;
+    }
+    __syncthreads();
+    // the batches of split p in order, the masked groups left out (every warp walks the same sequence)
+    auto masked = [&](const int b) { const int grp = b >> 2; return (sSkip[grp >> 5] >> (grp & 31)) & 1u; };
+    auto next_batch = [&](int b) { do { b += P; } while (b < nb && masked(b)); return b; };
+    const int first = p < nb && masked(p) ? next_batch(p) : p;
+
+    if (NSW == 2 && !compute) {
+        const int s = tid - 32*2*Q8R_TILES;
+        q8r_stage_t<4> st;
+        auto load_raw  = [&](const int t0) { st.load(K, V, mask, t0, g, s, n_q, nb11, nb12, nb21, nb22, nb31); };
+        auto write_raw = [&](const int buf) { st.write(sK[buf], sVT[buf], &sM[buf][0][0], s, n_q); };
+        int b = first, sub = 0, n = 0;
+        if (b < nb) {
+            load_raw(64*b);
+            write_raw(0);
+        }
+        __syncthreads();
+#pragma unroll 1
+        while (b < nb) {
+            int b2 = b, sub2 = sub + 1;
+            if (sub2 == 4) {
+                sub2 = 0;
+                b2 = next_batch(b);
+            }
+            const bool more = b2 < nb;
+            if (more) {
+                load_raw(64*b2 + 16*sub2);
+            }
+            __syncthreads();
+            if (more) {
+                write_raw((n & 1) ^ 1);
+            }
+            __syncthreads();
+            b = b2; sub = sub2; ++n;
+        }
+        return;
+    }
+
+    // this warp's half of Q (dims 128*half .. 128*half + 127), times scale * log2(e), in f16
+    q8r_h8 qf[4][2];
+    {
+        const float * qp = (const float *) (Q + (int64_t) qtok*nb01 + (int64_t) (g*gqa + (row_on ? row % gqa : 0))*nb02);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+#pragma unroll
+            for (int u = 0; u < 2; ++u) {
+                q8r_h8 f = { 0, 0, 0, 0, 0, 0, 0, 0 };
+                if (row_on) {
+                    const int d0 = 32*(4*half + j) + 16*h + 8*u;
+                    const float4 a = *(const float4 *) (qp + d0), c = *(const float4 *) (qp + d0 + 4);
+                    f = q8r_h8{ (_Float16) (a.x*qscale), (_Float16) (a.y*qscale), (_Float16) (a.z*qscale), (_Float16) (a.w*qscale),
+                                (_Float16) (c.x*qscale), (_Float16) (c.y*qscale), (_Float16) (c.z*qscale), (_Float16) (c.w*qscale) };
+                }
+                qf[j][u] = f;
+            }
+        }
+    }
+    q8r_f8 o[8];
+#pragma unroll
+    for (int dt = 0; dt < 8; ++dt) {
+        o[dt] = q8r_f8{ 0, 0, 0, 0, 0, 0, 0, 0 };
+    }
+    float m_ref = -INFINITY, l_sum = 0.0f;
+    // NSW == 0: every lane stages one task of each step; the next step's raw bytes are loaded at the top of a step and written
+    // between its two halves, as the staging warps of NSW == 2 do
+    q8r_stage_t<1> sta;
+    if (NSW == 0 && first < nb) {
+        sta.load(K, V, mask, 64*first, g, tid, n_q, nb11, nb12, nb21, nb22, nb31);
+        sta.write(sK[0], sVT[0], &sM[0][0][0], tid, n_q);
+    }
+    __syncthreads();
+    const bool tile_on = 16*tile < R;   // a tile past the rows only keeps the barriers
+    int b = first, sub = 0, n = 0;
+#pragma unroll 1
+    while (b < nb) {
+        const int buf = n & 1;
+        int b2 = b, sub2 = sub + 1;
+        if (sub2 == 4) {
+            sub2 = 0;
+            b2 = next_batch(b);
+        }
+        const bool more = b2 < nb;
+        if (NSW == 0 && more) {
+            sta.load(K, V, mask, 64*b2 + 16*sub2, g, tid, n_q, nb11, nb12, nb21, nb22, nb31);
+        }
+        if (tile_on) {
+            const _Float16 * kb = sK[buf];
+            q8r_f8 sp = { 0, 0, 0, 0, 0, 0, 0, 0 };
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+#pragma unroll
+                for (int u = 0; u < 2; ++u) {
+                    sp = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(*(const q8r_h8 *) &kb[q8r_sk(r16, 32*(4*half + j) + 16*h + 8*u)], qf[j][u], sp);
+                }
+            }
+            *(q8r_f8 *) sX[tile][half][lane] = sp;
+        }
+        __syncthreads();
+        if (tile_on) {
+            q8r_f8 s = *(const q8r_f8 *) sX[tile][0][lane] + *(const q8r_f8 *) sX[tile][1][lane];
+            const q8r_h8 mv = *(const q8r_h8 *) &sM[buf][qtok][8*h];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                s[i] = fmaf((float) mv[i], Q8R_LOG2E, s[i]);
+            }
+            float mx = s[0];
+#pragma unroll
+            for (int i = 1; i < 8; ++i) {
+                mx = fmaxf(mx, s[i]);
+            }
+            mx = fmaxf(mx, __shfl_xor(mx, 16, 32));
+            if (mx > m_ref + Q8R_TAU) {
+                const float f = exp2f(m_ref - mx);
+#pragma unroll
+                for (int dt = 0; dt < 8; ++dt) {
+                    o[dt] *= f;
+                }
+                l_sum *= f;
+                m_ref = mx;
+            }
+            q8r_h8 pf;
+            float ps = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                const _Float16 ph = (_Float16) (m_ref == -INFINITY ? 0.0f : exp2f(s[i] - m_ref));
+                pf[i] = ph;
+                ps += (float) ph;
+            }
+            l_sum += ps;
+            const _Float16 * vb = sVT[buf];
+#pragma unroll
+            for (int dt = 0; dt < 8; ++dt) {
+                o[dt] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(*(const q8r_h8 *) &vb[q8r_sv(16*(8*half + dt) + r16, 8*h)], pf, o[dt]);
+            }
+        }
+        if (NSW == 0 && more) {
+            sta.write(sK[buf ^ 1], sVT[buf ^ 1], &sM[buf ^ 1][0][0], tid, n_q);
+        }
+        __syncthreads();
+        b = b2; sub = sub2;
+        ++n;
+    }
+    if (!row_on) {
+        return;
+    }
+    const float l_tot = l_sum + __shfl_xor(l_sum, 16, 32);
+    const int64_t prow = ((int64_t) p*n_kvh + g)*Q8R_ROWS + row;
+    if (half == 0 && h == 0) {
+        pm[prow] = m_ref;
+        pl[prow] = l_tot;
+    }
+    const float inv = l_tot > 0.0f ? 1.0f/l_tot : 0.0f;
+#pragma unroll
+    for (int dt = 0; dt < 8; ++dt) {
+        q8r_h8 v;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            v[i] = (_Float16) (o[dt][i]*inv);
+        }
+        *(q8r_h8 *) (po + prow*Q8R_D + 16*(8*half + dt) + 8*h) = v;
+    }
+#else
+    GGML_UNUSED_VARS(Q, K, V, mask, skip, pm, pl, po, qscale, n_kv, n_q, gqa, P, nb01, nb02, nb11, nb12, nb21, nb22, nb31);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// grid (query rows, KV heads), one thread per dim: the P partials merged in split order into dst (f32, head at nb1, token at
+// nb2).  Up to Q8R_COMBINE_PMAX splits: the first P threads load the splits' m and l into LDS and every thread issues its
+// dim's P partial outputs before the first use (a loop of P load-then-use steps waited out each load, ~18 us a launch); the
+// arithmetic and its order are the loop's.  More splits (FRANK_FA_Q8R_SPLIT): the loop.
+static constexpr int Q8R_COMBINE_PMAX = 32;
+
+static __device__ __forceinline__ void flash_attn_q8r_combine_loop(const float * __restrict__ pm, const float * __restrict__ pl,
+        const _Float16 * __restrict__ po, char * __restrict__ dst, const int P, const int gqa, const int64_t nb1, const int64_t nb2,
+        const int row, const int g, const int n_kvh, const int d) {
+    float M = -INFINITY;
+    for (int p = 0; p < P; ++p) {
+        M = fmaxf(M, pm[((int64_t) p*n_kvh + g)*Q8R_ROWS + row]);
+    }
+    float den = 0.0f, acc = 0.0f;
+    for (int p = 0; p < P; ++p) {
+        const int64_t prow = ((int64_t) p*n_kvh + g)*Q8R_ROWS + row;
+        const float l = pl[prow];
+        if (l > 0.0f) {
+            const float w = l*exp2f(pm[prow] - M);
+            den += w;
+            acc += w*(float) po[prow*Q8R_D + d];
+        }
+    }
+    *(float *) (dst + (int64_t) (row/gqa)*nb2 + (int64_t) (g*gqa + row % gqa)*nb1 + 4*d) = den > 0.0f ? acc/den : 0.0f;
+}
+
+static __global__ void flash_attn_q8r_combine(const float * __restrict__ pm, const float * __restrict__ pl, const _Float16 * __restrict__ po,
+                                              char * __restrict__ dst, const int P, const int gqa, const int64_t nb1, const int64_t nb2) {
+    const int row = blockIdx.x, g = blockIdx.y, n_kvh = gridDim.y, d = threadIdx.x;
+    if (P > Q8R_COMBINE_PMAX) {
+        flash_attn_q8r_combine_loop(pm, pl, po, dst, P, gqa, nb1, nb2, row, g, n_kvh, d);
+        return;
+    }
+    __shared__ float s_m[Q8R_COMBINE_PMAX];
+    __shared__ float s_l[Q8R_COMBINE_PMAX];
+    if (d < P) {
+        const int64_t prow = ((int64_t) d*n_kvh + g)*Q8R_ROWS + row;
+        s_m[d] = pm[prow];
+        s_l[d] = pl[prow];
+    }
+    float v[Q8R_COMBINE_PMAX];
+#pragma unroll
+    for (int p = 0; p < Q8R_COMBINE_PMAX; ++p) {
+        v[p] = p < P ? (float) po[(((int64_t) p*n_kvh + g)*Q8R_ROWS + row)*Q8R_D + d] : 0.0f;
+    }
+    __syncthreads();
+    float M = -INFINITY;
+#pragma unroll
+    for (int p = 0; p < Q8R_COMBINE_PMAX; ++p) {
+        if (p < P) {
+            M = fmaxf(M, s_m[p]);
+        }
+    }
+    float den = 0.0f, acc = 0.0f;
+#pragma unroll
+    for (int p = 0; p < Q8R_COMBINE_PMAX; ++p) {
+        const float l = p < P ? s_l[p] : 0.0f;
+        if (l > 0.0f) {
+            const float w = l*exp2f(s_m[p] - M);
+            den += w;
+            acc += w*v[p];
+        }
+    }
+    *(float *) (dst + (int64_t) (row/gqa)*nb2 + (int64_t) (g*gqa + row % gqa)*nb1 + 4*d) = den > 0.0f ? acc/den : 0.0f;
+}
+
+// FRANK_FA_Q8R_COMBINE_CHECK=1 (testing only): the loop also merges the same partials into a scratch buffer, and a kernel
+// counts the floats that differ from the combine's output (device printf of the first ones and of a running count)
+static __global__ void flash_attn_q8r_combine_ref(const float * __restrict__ pm, const float * __restrict__ pl, const _Float16 * __restrict__ po,
+                                                  char * __restrict__ dst, const int P, const int gqa, const int64_t nb1, const int64_t nb2) {
+    flash_attn_q8r_combine_loop(pm, pl, po, dst, P, gqa, nb1, nb2, blockIdx.x, blockIdx.y, gridDim.y, threadIdx.x);
+}
+
+__device__ unsigned long long q8r_combine_n_checked = 0, q8r_combine_n_bad = 0;
+
+static __global__ void flash_attn_q8r_combine_cmp(const char * __restrict__ a, const char * __restrict__ b, const int nrow, const int nh,
+                                                  const int64_t nb1, const int64_t nb2) {
+    const int r = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+    const int64_t off = (int64_t) r*nb2 + (int64_t) h*nb1 + 4*d;
+    const uint32_t x = *(const uint32_t *) (a + off), y = *(const uint32_t *) (b + off);
+    const unsigned long long n = atomicAdd(&q8r_combine_n_checked, 1ull) + 1;
+    if (x != y) {
+        const unsigned long long nb = atomicAdd(&q8r_combine_n_bad, 1ull);
+        if (nb < 8) {
+            printf("q8r combine check: row %d head %d dim %d differs: %08x vs %08x\n", r, h, d, x, y);
+        }
+    }
+    if (n == 1 || (n & ((1ull << 20) - 1)) == 0) {
+        printf("q8r combine check: %llu floats checked, %llu differ\n", n, q8r_combine_n_bad);
+    }
+}
+
+static bool q8r_combine_check() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_FA_Q8R_COMBINE_CHECK");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+// one warp per 256-cell group: the bit is set when the group is -INF for every one of the n_q mask rows
+static __global__ void flash_attn_q8r_groups(const half * __restrict__ mask, uint32_t * __restrict__ blocks, const int n_q, const int64_t s31,
+                                             const int n_groups) {
+    const int grp = (blockIdx.x*blockDim.x + threadIdx.x)/WARP_SIZE, lane = threadIdx.x % WARP_SIZE;
+    if (grp >= n_groups) {
+        return;
+    }
+    int all_inf = 1;
+    for (int j = 0; j < n_q; ++j) {
+        for (int k = 256*grp + lane; k < 256*(grp + 1); k += WARP_SIZE) {
+            all_inf = all_inf && __half2float(mask[(int64_t) j*s31 + k]) == -INFINITY;
+        }
+    }
+    all_inf = warp_reduce_all(all_inf);
+    if (lane == 0 && all_inf) {
+        atomicOr(blocks + (grp >> 5), 1u << (grp & 31));
+    }
+}
+
+bool ggml_cuda_flash_attn_ext_q8r_applies(const int cc, const ggml_tensor * dst) {
+    if (!q8r_on() || !GGML_CUDA_CC_IS_RDNA4(cc)) {
+        return false;
+    }
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    if (K->type != GGML_TYPE_Q8_0R || V == nullptr || V->type != GGML_TYPE_Q8_0R || Q->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+            mask == nullptr || mask->type != GGML_TYPE_F16 || dst->src[4] != nullptr || dst->src[5] != nullptr || dst->src[6] != nullptr) {
+        return false;
+    }
+    float max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || logit_softcap != 0.0f) {
+        return false;
+    }
+    if (Q->ne[0] != Q8R_D || K->ne[0] != Q8R_D || V->ne[0] != Q8R_D || Q->ne[1] > Q8R_MAX_OP_Q || Q->ne[3] != 1 || K->ne[3] != 1 ||
+            V->ne[3] != 1 || mask->ne[2] != 1 || mask->ne[3] != 1 || V->ne[1] != K->ne[1] || V->ne[2] != K->ne[2] ||
+            K->ne[1] % 256 != 0 || mask->ne[0] < K->ne[1] || mask->ne[1] < Q->ne[1] || Q->ne[2] % K->ne[2] != 0 ||
+            (Q->ne[2]/K->ne[2])*Q8R_MAX_Q > Q8R_ROWS || dst->nb[0] != sizeof(float)) {
+        return false;
+    }
+    for (const ggml_tensor * t : { Q, K, V, mask }) {
+        if ((uintptr_t) t->data % 16 != 0 || t->nb[1] % 16 != 0 || t->nb[2] % 16 != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void ggml_cuda_flash_attn_ext_q8r(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    cudaStream_t stream = ctx.stream();
+
+    const int n_q   = (int) Q->ne[1];
+    const int n_kv  = (int) K->ne[1];
+    const int n_kvh = (int) K->ne[2];
+    const int gqa   = (int) (Q->ne[2]/K->ne[2]);
+    const int P     = q8r_splits();
+    float scale = 1.0f;
+    memcpy(&scale, dst->op_params, sizeof(float));
+
+    // the groups masked for every query row of the op (shared by its attention layers; one bitmap for both launches of
+    // 9..16 tokens)
+    const uint32_t * skip = nullptr;
+    ggml_cuda_pool_alloc<uint32_t> skip_buf(ctx.pool());
+    const int n_groups = n_kv/256;
+    if (q8r_skip_on() && n_groups <= 32*Q8R_SKIP_WORDS) {
+        const int     n_words = (n_groups + 31)/32;
+        const int64_t s31     = mask->nb[1]/sizeof(half);
+        const int64_t key[8]  = { n_kv, n_q, s31, 0, 0, 0, 0, -256 };
+        bool built = true;
+        uint32_t * blocks = ggml_cuda_fattn_kq_blocks_reuse(ctx, mask, key, (size_t) n_words, stream, built);
+        if (blocks == nullptr) {
+            blocks = skip_buf.alloc(n_words);
+        }
+        if (built) {
+            CUDA_CHECK(cudaMemsetAsync(blocks, 0, n_words*sizeof(uint32_t), stream));
+            flash_attn_q8r_groups<<<(n_groups*WARP_SIZE + 255)/256, 256, 0, stream>>>((const half *) mask->data, blocks, n_q, s31, n_groups);
+            CUDA_CHECK(cudaGetLastError());
+        }
+        skip = blocks;
+    }
+
+    ggml_cuda_pool_alloc<float> pm(ctx.pool(), (size_t) P*n_kvh*Q8R_ROWS);
+    ggml_cuda_pool_alloc<float> pl(ctx.pool(), (size_t) P*n_kvh*Q8R_ROWS);
+    ggml_cuda_pool_alloc<half>  po(ctx.pool(), (size_t) P*n_kvh*Q8R_ROWS*Q8R_D);
+    // up to 8 rows: one launch; 9..16: two halves (two slots verifying the same width are the two sequences); 17..31:
+    // launches of 8.  Every row is computed alone, so the cut does not change a row's result.
+    const int n_first = n_q <= Q8R_MAX_Q ? n_q : n_q <= 2*Q8R_MAX_Q ? (n_q + 1)/2 : Q8R_MAX_Q;
+    for (int q0 = 0; q0 < n_q; q0 += n_first) {
+        const int nq = std::min(n_first, n_q - q0);
+        const char * Qd = (const char *) Q->data + q0*Q->nb[1];
+        const char * Md = (const char *) mask->data + q0*mask->nb[1];
+        if (q8r_sw() == 2) {
+            flash_attn_q8r<2><<<dim3(P, n_kvh), Q8R_THREADS, 0, stream>>>(
+                Qd, (const char *) K->data, (const char *) V->data, Md, skip, pm.get(), pl.get(), (_Float16 *) po.get(), scale*Q8R_LOG2E,
+                n_kv, nq, gqa, P, Q->nb[1], Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2], mask->nb[1]);
+        } else {
+            flash_attn_q8r<0><<<dim3(P, n_kvh), Q8R_THREADS, 0, stream>>>(
+                Qd, (const char *) K->data, (const char *) V->data, Md, skip, pm.get(), pl.get(), (_Float16 *) po.get(), scale*Q8R_LOG2E,
+                n_kv, nq, gqa, P, Q->nb[1], Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2], mask->nb[1]);
+        }
+        CUDA_CHECK(cudaGetLastError());
+        flash_attn_q8r_combine<<<dim3(gqa*nq, n_kvh), Q8R_D, 0, stream>>>(
+            pm.get(), pl.get(), (const _Float16 *) po.get(), (char *) dst->data + q0*dst->nb[2], P, gqa, dst->nb[1], dst->nb[2]);
+        CUDA_CHECK(cudaGetLastError());
+        if (q8r_combine_check()) {
+            // the loop's merge into a scratch copy of the output rows (same strides), then the comparison
+            const int64_t nh = (int64_t) n_kvh*gqa;
+            ggml_cuda_pool_alloc<char> ref(ctx.pool(), (size_t) ((nq - 1)*dst->nb[2] + (nh - 1)*dst->nb[1] + 4*Q8R_D));
+            flash_attn_q8r_combine_ref<<<dim3(gqa*nq, n_kvh), Q8R_D, 0, stream>>>(
+                pm.get(), pl.get(), (const _Float16 *) po.get(), ref.get(), P, gqa, dst->nb[1], dst->nb[2]);
+            flash_attn_q8r_combine_cmp<<<dim3(nq, (unsigned) nh), Q8R_D, 0, stream>>>(
+                (const char *) dst->data + q0*dst->nb[2], ref.get(), nq, (int) nh, dst->nb[1], dst->nb[2]);
+            CUDA_CHECK(cudaGetLastError());
+        }
+    }
+}
