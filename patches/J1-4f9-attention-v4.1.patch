+void ggml_vec_dot_q8_0r_q8_0r(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n % QK8_0R == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q8_0r * GGML_RESTRICT x = vx;
+    const block_q8_0r * GGML_RESTRICT y = vy;
+    float sumf = 0;
+    for (int ib = 0; ib < n / QK8_0R; ++ib) {
+        for (int g = 0; g < QK8_0R / QK8_0; ++g) {
+            int sumi = 0;
+            for (int j = 0; j < QK8_0; j++) {
+                sumi += x[ib].qs[g*QK8_0 + j]*y[ib].qs[g*QK8_0 + j];
+            }
+            sumf += sumi*(GGML_CPU_FP16_TO_FP32(x[ib].d[g])*GGML_CPU_FP16_TO_FP32(y[ib].d[g]));
+        }
+    }
+    *s = sumf;
+}
