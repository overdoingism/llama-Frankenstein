+// q8_0r K / V (BigOne's KV cache type): until a kernel of its own takes the op, the flash attention sees a copy of the
+// op with f16 K and V (converted into a pool buffer each at launch; contiguous strides)
+static bool ggml_cuda_fattn_q8r(const ggml_tensor * dst) {
+    return dst->src[1]->type == GGML_TYPE_Q8_0R || (dst->src[2] && dst->src[2]->type == GGML_TYPE_Q8_0R);
+}
+
+static void ggml_cuda_fattn_as_f16(const ggml_tensor * t, ggml_tensor & t16, void * data) {
+    t16 = *t;
+    t16.type = GGML_TYPE_F16;
+    t16.data = data;
+    t16.view_src = nullptr;
+    t16.view_offs = 0;
+    t16.nb[0] = sizeof(half);
+    for (int i = 1; i < GGML_MAX_DIMS; ++i) {
+        t16.nb[i] = t16.nb[i - 1] * t16.ne[i - 1];
+    }
+}
