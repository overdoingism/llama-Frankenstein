+// q8_0r: q8_0's rule for each group of 32 of a 256-value block, the codes first and the 8 deltas after them
+static __device__ void quantize_f32_q8_0r_block(const float * __restrict__ x, block_q8_0r * __restrict__ y) {
+#pragma unroll 1
+    for (int g = 0; g < QK8_0R / QK8_0; ++g) {
+        float amax = 0.0f;
+        for (int j = 0; j < QK8_0; j++) {
+            amax = fmaxf(amax, fabsf(x[g * QK8_0 + j]));
+        }
+        const float d  = amax / ((1 << 7) - 1);
+        const float id = d ? 1.0f/d : 0.0f;
+        y->d[g] = d;
+        for (int j = 0; j < QK8_0; ++j) {
+            y->qs[g * QK8_0 + j] = roundf(x[g * QK8_0 + j]*id);
+        }
+    }
+}
