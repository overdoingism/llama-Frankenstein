+    static const int v = [] {
+        const char * f = getenv("FRANK_FA_FP8");
+        if (f != nullptr) return atoi(f);
+        const char * a = getenv("FRANK_ALL");
+        return a != nullptr && a[0] == '0' && a[1] == '\0' ? 0 : 1;
+    }();
+    return v;
+}
+int lf_min_kv() { static const int v = getenv("FRANK_FA_FP8_MIN_KV") ? atoi(getenv("FRANK_FA_FP8_MIN_KV")) : 512; return v; }
+int lf_min_t() { static const int v = getenv("FRANK_FA_FP8_MIN_T") ? atoi(getenv("FRANK_FA_FP8_MIN_T")) : 32; return v; }
+
+typedef int   lf_v2i __attribute__((ext_vector_type(2)));
+typedef int   lf_v4i __attribute__((ext_vector_type(4)));
+
+// software pipeline for a run of NLOAD LDS operand loads each feeding 2 WMMAs: keep one load ahead
+template <int NLOAD>
+static __device__ __forceinline__ void lf_pipe_ds_wmma() {
+    __builtin_amdgcn_sched_group_barrier(0x100, 2, 0);
+#pragma unroll
+    for (int i = 0; i < NLOAD - 2; ++i) {
+        __builtin_amdgcn_sched_group_barrier(0x008, 2, 0);
+        __builtin_amdgcn_sched_group_barrier(0x100, 1, 0);
+    }
+    __builtin_amdgcn_sched_group_barrier(0x008, 4, 0);
+}
+
+// software pipeline for NGRP groups of NL LDS operand loads, each group feeding 2*NL WMMAs into NL different
+// accumulators: the next group's loads go between the first and the second half of the current group's WMMAs
+// (sched_group_barrier masks: 0x100 = DS read, 0x008 = MFMA/WMMA)
+template <int NGRP, int NL>
+static __device__ __forceinline__ void lf_pipe_ds_wmma_grp() {
+    __builtin_amdgcn_sched_group_barrier(0x100, NL, 0);
+#pragma unroll
+    for (int i = 0; i < NGRP - 1; ++i) {
+        __builtin_amdgcn_sched_group_barrier(0x008, NL, 0);
+        __builtin_amdgcn_sched_group_barrier(0x100, NL, 0);
+        __builtin_amdgcn_sched_group_barrier(0x008, NL, 0);
+    }
+    __builtin_amdgcn_sched_group_barrier(0x008, 2 * NL, 0);
+}
+
+// The tile loop's barriers only order shared-memory accesses, as the RDNA4 decode band's do (flash_attn_ext_f16_iter_barrier
+// in fattn-mma-f16.cuh): its global reads are of buffers no thread of the grid writes, and __syncthreads() would also
+// invalidate the vector cache.
+static __device__ __forceinline__ void lf_fa_iter_barrier() {
+#if defined(AMD_WMMA_AVAILABLE)
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+#else
+    __syncthreads();
+#endif // defined(AMD_WMMA_AVAILABLE)
+}
+
+// The WMMAs of 2 accumulators go in turn (a WMMA right after the one that wrote its accumulator waits for it) where that
+// was measured faster on gfx1201: head 128, head 256 with 4 or more waves (with fewer, 2 accumulators spill in the loop),
+// head 64 with up to 3 waves (with more, up to 11% slower).  The other shapes keep one accumulator at a time.
+template <int G, int D>
+constexpr bool lf_interleave() { return D == 128 || (D == 256 && G >= 4) || (D == 64 && G <= 3); }
+
+// Operand-pair layout: along the reduction axis (K and Q: dims, V^T: keys) the 8-byte units of each 32-element group
+// are stored as (step 0, half 0), (step 1, half 0), (step 0, half 1), (step 1, half 1), so the lane that reads half h
+// finds the operands of two consecutive 16-wide WMMA steps in one 16-byte load.  K and Q use the same order, so the
+// dot products are unchanged.  lf_pair_unit maps a natural 8-byte unit index (0..3 in the group) to its slot.
+static __device__ __forceinline__ int lf_pair_unit(const int u) { return u == 1 ? 2 : (u == 2 ? 1 : u); }
+typedef float lf_v8f __attribute__((ext_vector_type(8)));
+
+// A KV row of one head in q8_0 (34-byte blocks: scale, 32 codes) or, R, in q8_0r (BigOne: the 256 codes, then the 8 group
+// scales; the same values): the scale of group b and the code of value i
+template <bool R> static __device__ __forceinline__ const half * lf_q8_scale(const char * row, const int b) {
+    return (const half *) (R ? row + 256 + 2 * b : row + b * 34);
+}
+template <bool R> static __device__ __forceinline__ const char * lf_q8_code(const char * row, const int i) {
+    return R ? row + i : row + (i / 32) * 34 + 2 + i % 32;
+}
+
+// 8 q8_0 values (one lane's share of a 256-vector: block l/4, bytes (l%4)*8 .. +7) as floats; 2-byte aligned reads
+template <bool R>
+static __device__ __forceinline__ void lf_q8_0_load8(const char * __restrict__ row, const int lane, float * v) {
+    const float d = __half2float(*lf_q8_scale<R>(row, lane / 4));
+    const uint16_t * q = (const uint16_t *) lf_q8_code<R>(row, lane * 8);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const uint16_t w = q[j];
+        v[2 * j + 0] = d * (float) (int8_t) (w & 0xFF);
+        v[2 * j + 1] = d * (float) (int8_t) (w >> 8);
+    }
+}
+
+// the conversion does not saturate: a value beyond +-448 becomes NaN, and a NaN V times a zero probability is still NaN.
+// Values scaled by their own amax never exceed 448; the clamp is the guarantee for anything else.
+static __device__ __forceinline__ float lf_fp8_sat(const float x) { return fminf(fmaxf(x, -448.f), 448.f); }
+
+static __device__ __forceinline__ uint2 lf_pack_fp8(const float * v, const float inv) {
+#if defined(RDNA4)
+    int w0 = __builtin_amdgcn_cvt_pk_fp8_f32(lf_fp8_sat(v[0] * inv), lf_fp8_sat(v[1] * inv), 0, false);
+    w0     = __builtin_amdgcn_cvt_pk_fp8_f32(lf_fp8_sat(v[2] * inv), lf_fp8_sat(v[3] * inv), w0, true);
+    int w1 = __builtin_amdgcn_cvt_pk_fp8_f32(lf_fp8_sat(v[4] * inv), lf_fp8_sat(v[5] * inv), 0, false);
+    w1     = __builtin_amdgcn_cvt_pk_fp8_f32(lf_fp8_sat(v[6] * inv), lf_fp8_sat(v[7] * inv), w1, true);
+    return make_uint2((uint32_t) w0, (uint32_t) w1);
+#else
+    GGML_UNUSED_VARS(v, inv);
+    return make_uint2(0, 0);
+#endif // defined(RDNA4)
+}
+
+// the sum of the eight fp8 values lf_pack_fp8 wrote, in fp32: the row sum must count each probability as the fp8 P.V WMMA
+// sees it.  Summed from the fp32 values instead, a weight below the smallest fp8 subnormal (about 2^-18 of the row's
+// running max) counted in l but not in O, so the output came out systematically small, more so the longer the context.
+static __device__ __forceinline__ float lf_sum_fp8(const uint2 w) {
+#if defined(RDNA4)
+    const int a = (int) w.x, b = (int) w.y;
+    return ((__builtin_amdgcn_cvt_f32_fp8(a, 0) + __builtin_amdgcn_cvt_f32_fp8(a, 1)) +
+            (__builtin_amdgcn_cvt_f32_fp8(a, 2) + __builtin_amdgcn_cvt_f32_fp8(a, 3))) +
+           ((__builtin_amdgcn_cvt_f32_fp8(b, 0) + __builtin_amdgcn_cvt_f32_fp8(b, 1)) +
+            (__builtin_amdgcn_cvt_f32_fp8(b, 2) + __builtin_amdgcn_cvt_f32_fp8(b, 3)));
+#else
+    GGML_UNUSED(w);
+    return 0.f;
+#endif // defined(RDNA4)
+}
+
+static __device__ __forceinline__ float lf_wave_max(float a) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = fmaxf(a, __shfl_xor_sync(0xFFFFFFFF, a, o, 32));
+    return a;
+}
+
+// The cells this batch can see, for the amax passes and the conversions: a cell outside it (empty, another sequence, or not yet visible)
+// is never attended, and it must not set a scale either -- it may hold a previous request's data, which made the
+// scales (and so the output) depend on what ran before.  The conversions write it as zero: scaled by the visible amax
+// it could exceed the fp8 range (v3 turned such V values into NaN, and a NaN V times a zero probability is NaN).  Derived mask: the batch's [min tok_lo, max tok_hi] and
+// cell_pos != INT32_MIN; f16 mask: the last query's row (one causal sequence).  vr = (lo, hi), or (1, 0) when unknown.
+__global__ void lf_fa_vis_range(const int * __restrict__ tok_lo, const int * __restrict__ tok_hi, const int n_q, int2 * __restrict__ vr) {
+    int lo = INT32_MAX, hi = INT32_MIN;
+    for (int i = threadIdx.x; i < n_q; i += blockDim.x) { lo = min(lo, tok_lo[i]); hi = max(hi, tok_hi[i]); }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        lo = min(lo, __shfl_xor_sync(0xFFFFFFFF, lo, o, 32));
+        hi = max(hi, __shfl_xor_sync(0xFFFFFFFF, hi, o, 32));
+    }
+    __shared__ int2 w[8];
+    if (threadIdx.x % 32 == 0) w[threadIdx.x / 32] = make_int2(lo, hi);
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        int2 r = w[0];
+        for (int k = 1; k < (int) (blockDim.x / 32); ++k) r = make_int2(min(r.x, w[k].x), max(r.y, w[k].y));
+        *vr = r;
+    }
+}
+
+static __device__ __forceinline__ bool lf_fa_cell_seen(const int j, const int * __restrict__ cell_pos, const int2 * __restrict__ vr,
+        const half * __restrict__ mlast) {
+    if (cell_pos) {
+        const int p = cell_pos[j];
+        return p != INT32_MIN && p >= vr->x && p <= vr->y;
+    }
+    if (mlast) return __half2float(mlast[j]) > -INFINITY;
+    return true;
+}
+
+// K: one wave per (cell, kv head) vector (lanes < D/8, 8 values each) -> k8[hk][j][D] fp8 with ONE scale per kv head
+// (amax from the q8_0 scales, see lf_fa_conv_v_amax), so the score scale is a single constant per (query, head);
+// ks[hk] (cells >= n_kv are zero)
+template <int D, bool R>
+__global__ void lf_fa_conv_k(const char * __restrict__ K, const int64_t nb11, const int64_t nb12, const int n_kv, const int n_kv_pad,
+        const int * __restrict__ cell_pos, const int2 * __restrict__ vr, const half * __restrict__ mlast,
+        const unsigned int * __restrict__ kbits, uint8_t * __restrict__ k8, float * __restrict__ ks) {
+    const int lane = threadIdx.x % 32, j = blockIdx.x * 8 + threadIdx.x / 32, hk = blockIdx.y;
+    if (j >= n_kv_pad) return;
+    float a = 0.f;
+#pragma unroll
+    for (int b = 0; b < D / 32; ++b) a = fmaxf(a, __uint_as_float(kbits[hk * (D / 32) + b]));
+    if (lane >= D / 8) return;
+    float v[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    if (j < n_kv && lf_fa_cell_seen(j, cell_pos, vr, mlast)) lf_q8_0_load8<R>(K + j * nb11 + hk * nb12, lane, v);
+    const float inv = a > 0.f ? 448.f / a : 0.f;
+    *(uint2 *) (k8 + ((size_t) hk * n_kv_pad + j) * D + (lane / 4) * 32 + lf_pair_unit(lane % 4) * 8) = lf_pack_fp8(v, inv);
+    if (j == 0 && lane == 0) ks[hk] = a > 0.f ? a / 448.f : 0.f;
+}
+
+// V pass 1: per (kv head, group of 32 channels) amax over the cells the batch sees.  A q8_0 block's largest |value| is
+// exactly |d| * 127 (quantization maps the block's amax to +-127), so only the scales are read (1/17 of the cache).
+// Threads: (256 / NG) cells x NG = D/32 groups; chunks of 256 cells per block; atomicMax on the float bits.
+template <int D, bool R>
+__global__ void lf_fa_conv_v_amax(const char * __restrict__ V, const int64_t nb21, const int64_t nb22, const int n_kv,
+        const int * __restrict__ cell_pos, const int2 * __restrict__ vr, const half * __restrict__ mlast, unsigned int * __restrict__ vbits) {
+    constexpr int NG = D / 32;
+    const int hk = blockIdx.x, b = threadIdx.x % NG, jj = threadIdx.x / NG, j0 = blockIdx.y * 256;
+    float a = 0.f;
+    for (int j = j0 + jj; j < min(n_kv, j0 + 256); j += 256 / NG) {
+        if (!lf_fa_cell_seen(j, cell_pos, vr, mlast)) continue;
+        a = fmaxf(a, fabsf(__half2float(*lf_q8_scale<R>(V + j * nb21 + hk * nb22, b))));
+    }
+#pragma unroll
+    for (int o = NG; o < 32; o <<= 1) a = fmaxf(a, __shfl_xor_sync(0xFFFFFFFF, a, o, 32));
+    if (threadIdx.x % 32 < NG) atomicMax(&vbits[hk * NG + b], __float_as_uint(a * 127.f));
+}
+template <int D>
+__global__ void lf_fa_conv_v_scale(const unsigned int * __restrict__ vbits, float * __restrict__ vs) {
+    const float a = __uint_as_float(vbits[blockIdx.x * (D / 32) + threadIdx.x / 32]);
+    vs[blockIdx.x * D + threadIdx.x] = a > 0.f ? a / 448.f : 1.f;
+}
+// V pass 2: 64 cells x D channels of one kv head (D threads), transposed through LDS -> v8t[hk][d][j]
+template <int D, bool R>
+__global__ void lf_fa_conv_v(const char * __restrict__ V, const int64_t nb21, const int64_t nb22, const int n_kv, const int n_kv_pad,
+        const int * __restrict__ cell_pos, const int2 * __restrict__ vr, const half * __restrict__ mlast,
+        const float * __restrict__ vs, uint8_t * __restrict__ v8t) {
+#if defined(RDNA4)
+    const int j0 = blockIdx.x * 64, hk = blockIdx.y, i = threadIdx.x;
+    __shared__ uint8_t tile[D][64 + 4];
+    const float inv = vs[hk * D + i] > 0.f ? 1.f / vs[hk * D + i] : 0.f;
+    for (int jj = 0; jj < 64; ++jj) {
+        const int j = j0 + jj;
+        uint8_t q = 0;
+        if (j < n_kv && lf_fa_cell_seen(j, cell_pos, vr, mlast)) {
+            const char * row = V + j * nb21 + hk * nb22;
+            q = (uint8_t) __builtin_amdgcn_cvt_pk_fp8_f32(lf_fp8_sat(__half2float(*lf_q8_scale<R>(row, i / 32)) * (float) (int8_t) *lf_q8_code<R>(row, i) * inv), 0.f, 0, false);
+        }
+        tile[i][(jj / 32) * 32 + lf_pair_unit((jj % 32) / 8) * 8 + jj % 8] = q;
+    }
+    __syncthreads();
+    for (int c = i; c < D * 4; c += D) {
+        const int r = c / 4, o = c % 4;
+        uint32_t w[4];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const uint8_t * t = &tile[r][o * 16 + 4 * k];
+            w[k] = t[0] | (t[1] << 8) | (t[2] << 16) | ((uint32_t) t[3] << 24);
+        }
+        *(uint4 *) (v8t + ((size_t) hk * D + r) * n_kv_pad + j0 + o * 16) = make_uint4(w[0], w[1], w[2], w[3]);
+    }
+#else
+    GGML_UNUSED_VARS(V, nb21, nb22, n_kv, n_kv_pad, cell_pos, vr, mlast, vs, v8t);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+// q8_0r: K and V pass 1 in one launch (blockIdx.z: 0 = K into kbits, 1 = V into vbits), the maxima of lf_fa_conv_v_amax:
+// 128 cells a block (independent loads), the block's maxima reduced in LDS, then NG atomics a block instead of NG a wave.
+// The old pass was latency-bound (5.3 ms for both at a 2048-token batch, 87K deep).  max(|d|) * 127 is the max of |d| * 127
+// (the product rounds monotonically), so the bits are the same.  FRANK_FA_FP8_CONV=0: the old passes.
+template <int D, bool R>
+__global__ void lf_fa_conv_kv_amax(const char * __restrict__ K, const int64_t nb11, const int64_t nb12,
+        const char * __restrict__ V, const int64_t nb21, const int64_t nb22, const int n_kv,
+        const int * __restrict__ cell_pos, const int2 * __restrict__ vr, const half * __restrict__ mlast,
+        unsigned int * __restrict__ kbits, unsigned int * __restrict__ vbits) {
+    constexpr int NG = D / 32, CPB = 128, CPP = 256 / NG;   // groups, cells a block, cells a pass
+    const bool isv = blockIdx.z != 0;
+    const char * X = isv ? V : K;
+    const int64_t nb1 = isv ? nb21 : nb11, nb2 = isv ? nb22 : nb12;
+    const int hk = blockIdx.x, b = threadIdx.x % NG, jj = threadIdx.x / NG, j0 = blockIdx.y * CPB;
+    float a = 0.f;
+#pragma unroll
+    for (int k = 0; k < CPB / CPP; ++k) {
+        const int j = j0 + k * CPP + jj;
+        if (j < n_kv && lf_fa_cell_seen(j, cell_pos, vr, mlast)) {
+            a = fmaxf(a, fabsf(__half2float(*lf_q8_scale<R>(X + j * nb1 + hk * nb2, b))));
+        }
+    }
+#pragma unroll
+    for (int o = NG; o < 32; o <<= 1) a = fmaxf(a, __shfl_xor_sync(0xFFFFFFFF, a, o, 32));
+    __shared__ float s[256 / 32][NG];
+    if (threadIdx.x % 32 < NG) s[threadIdx.x / 32][b] = a;
+    __syncthreads();
+    if (threadIdx.x < NG) {
+        float m = s[0][threadIdx.x];
+#pragma unroll
+        for (int w = 1; w < 256 / 32; ++w) m = fmaxf(m, s[w][threadIdx.x]);
+        atomicMax(&(isv ? vbits : kbits)[hk * NG + threadIdx.x], __float_as_uint(m * 127.f));
+    }
+}
+// q8_0r: V pass 2 with 8-byte code loads, the values of lf_fa_conv_v (scale * code * inv, rounded once): D/8 lanes a cell,
+// each converting 8 channels of one 32-channel group (one scale, one inv), D/(D/8) = 8 cells a pass; the same transposed
+// tile and store.  The old pass read one code byte a thread a cell (64 dependent rounds), ~42% of the bandwidth.
+template <int D>
+__global__ void lf_fa_conv_v8(const char * __restrict__ V, const int64_t nb21, const int64_t nb22, const int n_kv, const int n_kv_pad,
+        const int * __restrict__ cell_pos, const int2 * __restrict__ vr, const half * __restrict__ mlast,
+        const float * __restrict__ vs, uint8_t * __restrict__ v8t) {
+#if defined(RDNA4)
+    constexpr int LPC = D / 8, CPP = D / LPC;   // lanes a cell, cells a pass
+    const int j0 = blockIdx.x * 64, hk = blockIdx.y, i = threadIdx.x;
+    const int u = i % LPC, cl = i / LPC;        // channels 8u .. 8u+7 of cell cl of each pass
+    __shared__ uint8_t tile[D][64 + 4];
+    const float inv = vs[hk * D + 8 * u] > 0.f ? 1.f / vs[hk * D + 8 * u] : 0.f;
+#pragma unroll
+    for (int p = 0; p < 64; p += CPP) {
+        const int jj = p + cl, j = j0 + jj;
+        uint32_t w0 = 0, w1 = 0;
+        if (j < n_kv && lf_fa_cell_seen(j, cell_pos, vr, mlast)) {
+            const char * row = V + j * nb21 + hk * nb22;
+            const float d = __half2float(*lf_q8_scale<true>(row, u / 4));
+            const uint2 c = *(const uint2 *) lf_q8_code<true>(row, 8 * u);
+            uint8_t q[8];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const int8_t code = (int8_t) (((e < 4 ? c.x : c.y) >> (8 * (e % 4))) & 0xFF);
+                q[e] = (uint8_t) __builtin_amdgcn_cvt_pk_fp8_f32(lf_fp8_sat(d * (float) code * inv), 0.f, 0, false);
+            }
+            w0 = q[0] | (q[1] << 8) | (q[2] << 16) | ((uint32_t) q[3] << 24);
+            w1 = q[4] | (q[5] << 8) | (q[6] << 16) | ((uint32_t) q[7] << 24);
+        }
+        const int col = (jj / 32) * 32 + lf_pair_unit((jj % 32) / 8) * 8 + jj % 8;
+#pragma unroll
+        for (int e = 0; e < 8; ++e) tile[8 * u + e][col] = (uint8_t) (((e < 4 ? w0 : w1) >> (8 * (e % 4))) & 0xFF);
+    }
+    __syncthreads();
+    for (int c = i; c < D * 4; c += D) {
+        const int r = c / 4, o = c % 4;
+        uint32_t w[4];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const uint8_t * t = &tile[r][o * 16 + 4 * k];
+            w[k] = t[0] | (t[1] << 8) | (t[2] << 16) | ((uint32_t) t[3] << 24);
+        }
+        *(uint4 *) (v8t + ((size_t) hk * D + r) * n_kv_pad + j0 + o * 16) = make_uint4(w[0], w[1], w[2], w[3]);
+    }
+#else
+    GGML_UNUSED_VARS(V, nb21, nb22, n_kv, n_kv_pad, cell_pos, vr, mlast, vs, v8t);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// FRANK_FA_FP8_CONV_CHECK=1 (testing only): the old passes into scratch, compared byte for byte with the new ones
+__device__ unsigned long long lf_fa_conv_n_checked = 0, lf_fa_conv_n_bad = 0;
+static __global__ void lf_fa_conv_cmp(const uint32_t * __restrict__ a, const uint32_t * __restrict__ b, const int64_t n, const int what) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const unsigned long long c = atomicAdd(&lf_fa_conv_n_checked, 1ull) + 1;
+    if (a[i] != b[i]) {
+        const unsigned long long nb = atomicAdd(&lf_fa_conv_n_bad, 1ull);
+        if (nb < 8) printf("fa fp8 conv check: %s word %lld differs: %08x vs %08x\n", what == 0 ? "kbits" : what == 1 ? "vbits" : "v8t",
+                           (long long) i, a[i], b[i]);
+    }
+    if (c == 1 || (c & ((1ull << 24) - 1)) == 0) printf("fa fp8 conv check: %llu words checked, %llu differ\n", c, lf_fa_conv_n_bad);
+}
+
+// Q: one wave per (token, head) vector (lanes < D/8) -> q8[t][h][D], qs[t][h] (tokens >= n_q are zero)
+template <int D>
+__global__ void lf_fa_conv_q(const char * __restrict__ Q, const int64_t nb01, const int64_t nb02, const int n_q, const int n_q_pad, const int HQ,
+        uint8_t * __restrict__ q8, float * __restrict__ qs) {
+    const int lane = threadIdx.x % 32, t = blockIdx.x * 8 + threadIdx.x / 32, h = blockIdx.y;
+    if (t >= n_q_pad) return;
+    float v[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    if (t < n_q && lane < D / 8) {
+        const float4 * p = (const float4 *) (Q + t * nb01 + h * nb02 + lane * 32);
+        const float4 a = p[0], b = p[1];
+        v[0] = a.x; v[1] = a.y; v[2] = a.z; v[3] = a.w; v[4] = b.x; v[5] = b.y; v[6] = b.z; v[7] = b.w;
+    }
+    float a = 0.f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) a = fmaxf(a, fabsf(v[i]));
+    a = lf_wave_max(a);
+    const float inv = a > 0.f ? 448.f / a : 0.f;
+    if (lane < D / 8) *(uint2 *) (q8 + ((size_t) t * HQ + h) * D + (lane / 4) * 32 + lf_pair_unit(lane % 4) * 8) = lf_pack_fp8(v, inv);
+    if (lane == 0) qs[(size_t) t * HQ + h] = a > 0.f ? a / 448.f : 0.f;
+}
+
+// derived mask: per 64-key tile, the (min, max) cell position (INT32_MIN in .x when a cell of the tile is never visible)
+__global__ void lf_fa_tile_range(const int * __restrict__ cell_pos, const int n_kv, int2 * __restrict__ trange) {
+    const int j = blockIdx.x * LF_KT + threadIdx.x;   // 64 threads
+    const int p = j < n_kv ? cell_pos[j] : INT32_MIN;
+    int mn = p, mx = p;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        mn = min(mn, __shfl_xor_sync(0xFFFFFFFF, mn, o, 32));
+        mx = max(mx, __shfl_xor_sync(0xFFFFFFFF, mx, o, 32));
+    }
+    __shared__ int2 w[2];
+    if (threadIdx.x % 32 == 0) w[threadIdx.x / 32] = make_int2(mn, mx);
+    __syncthreads();
+    if (threadIdx.x == 0) trange[blockIdx.x] = make_int2(min(w[0].x, w[1].x), max(w[0].y, w[1].y));
+}
+
+// Block = one kv head x TQB groups of LF_QB tokens; wave w = Q head hk*G + w%G for group w/G.  Visibility: derived (cell_pos,
+// tok_lo, tok_hi) or an f16 mask tensor (added), or none.  Writes a split's unnormalized O (x vs) and (max, sum).
+// QK and PV issue their WMMAs in the order lf_interleave() picks; each accumulator adds its products in the same order either way.
+// TQB > 1 (BigOne 6c): the groups share the K / V tile staging (one tile in LDS for TQB*LF_QB tokens instead of one a
+// LF_QB-token block); each wave keeps its group's window, full-tile test and tile skips, the same splits and the same
+// arithmetic, so its partial is bit for bit the TQB = 1 block's.  A tile no wave needs is not staged.
+template <int G, int D, int TQB = 1>
+__global__ void __launch_bounds__(TQB * G * 32, 1) lf_fa_attn(
+        const uint8_t * __restrict__ q8, const float * __restrict__ qs,
+        const uint8_t * __restrict__ k8, const float * __restrict__ ks,
+        const uint8_t * __restrict__ v8t, const float * __restrict__ vs,
+        const int * __restrict__ cell_pos, const int * __restrict__ tok_lo, const int * __restrict__ tok_hi, const int2 * __restrict__ trange,
+        const char * __restrict__ mask, const int64_t nb31,
+        half * __restrict__ part, float2 * __restrict__ ml,
+        const int n_q, const int n_q_pad, const int n_kv, const int n_kv_pad, const float scale_log2) {
+#if defined(RDNA4)
+    constexpr int LF_KS = D + 16;      // LDS bytes per key row of K
+    __shared__ __attribute__((aligned(16))) uint8_t Ks[LF_KT * LF_KS];
+    __shared__ __attribute__((aligned(16))) uint8_t Vs[D * LF_VS];
+    const int tid = threadIdx.x, lane = tid % 32, g = (tid / 32) % G, tg = tid / 32 / G;
+    const int HQ = gridDim.y * G;
+    const int t0 = (blockIdx.x * TQB + tg) * LF_QB, hk = blockIdx.y, h = hk * G + g;
+    const bool dead = TQB > 1 && t0 >= n_q_pad;   // a group past the padded queries: stages tiles, computes and stores nothing
+    const int tq = t0 + lane % 16;
+    const int tqc = min(tq, n_q - 1);
+    const int lo = cell_pos ? tok_lo[tqc] : 0, hi = cell_pos ? tok_hi[tqc] : 0;
+    const half * mrow = mask ? (const half *) (mask + (int64_t) tqc * nb31) : nullptr;
+    // the block's query window (derived mask): a tile whose cells all lie in [lo_max, hi_min] is visible to every query
+    int lo_max = lo, lo_min = lo, hi_min = hi, hi_max = hi;
+#pragma unroll
+    for (int o = 1; o < 16; o <<= 1) {
+        lo_max = max(lo_max, __shfl_xor_sync(0xFFFFFFFF, lo_max, o, 32)); lo_min = min(lo_min, __shfl_xor_sync(0xFFFFFFFF, lo_min, o, 32));
+        hi_min = min(hi_min, __shfl_xor_sync(0xFFFFFFFF, hi_min, o, 32)); hi_max = max(hi_max, __shfl_xor_sync(0xFFFFFFFF, hi_max, o, 32));
+    }
+    // TQB > 1: the union of the groups' windows decides whether the block stages a tile at all
+    int blo_min = lo_min, bhi_max = hi_max;
+    if constexpr (TQB > 1) {
+        __shared__ int2 s_win[TQB];
+        if (g == 0 && lane == 0) s_win[tg] = dead ? make_int2(INT32_MAX, INT32_MIN) : make_int2(lo_min, hi_max);
+        __syncthreads();
+#pragma unroll
+        for (int i = 0; i < TQB; ++i) { blo_min = min(blo_min, s_win[i].x); bhi_max = max(bhi_max, s_win[i].y); }
+    }
+
+    lf_v2i qa[D / 16];
+#pragma unroll
+    for (int g2 = 0; g2 < D / 32; ++g2) {
+        const lf_v4i q4 = dead ? lf_v4i{0, 0, 0, 0} : *(const lf_v4i *) (q8 + ((size_t) tq * HQ + h) * D + g2 * 32 + (lane / 16) * 16);
+        qa[2 * g2] = lf_v2i{q4.x, q4.y}; qa[2 * g2 + 1] = lf_v2i{q4.z, q4.w};
+    }
+    const float kqc = dead ? 0.f : qs[(size_t) tq * HQ + h] * ks[hk] * scale_log2;  // score = kqc * (K8 . Q8), log2 domain
+    constexpr bool ORD  = lf_interleave<G, D>();
+    constexpr int  NACC = 2;
+
+    lf_v8f o[D / 16];
+#pragma unroll
+    for (int i = 0; i < D / 16; ++i) o[i] = lf_v8f{0, 0, 0, 0, 0, 0, 0, 0};
+    float m = -INFINITY, l = 0.f;
+
+    const int ntile = n_kv_pad / LF_KT;
+    const int nsplit = gridDim.z, per = (ntile + nsplit - 1) / nsplit;
+    const int kt_begin = blockIdx.z * per, kt_end = min(ntile, kt_begin + per);
+    for (int kt = kt_begin; kt < kt_end; ++kt) {
+        const int k0 = kt * LF_KT;
+        // tile visibility (derived mask): skip tiles no query of the block sees; "full" tiles need no per-element test.
+        // Everything here is uniform over the block (all waves share the tokens).
+        bool full = cell_pos == nullptr && mrow == nullptr && k0 + LF_KT <= n_kv;
+        bool wskip = dead;   // this wave computes nothing on the tile (TQB > 1)
+        if (cell_pos) {
+            const int2 r = trange[kt];
+            if (r.y < blo_min || (r.x != INT32_MIN && r.x > bhi_max)) continue;             // no query of the block sees any cell
+            if constexpr (TQB > 1) wskip = wskip || r.y < lo_min || (r.x != INT32_MIN && r.x > hi_max);   // none of this group's
+            full = r.x != INT32_MIN && r.x >= lo_max && r.y <= hi_min && k0 + LF_KT <= n_kv;
+        }
+
+        // tile loads without conditions or clamped indices: chunk c = tid + i*NT for the full rounds, then the remainder
+        // chunks loaded by every thread (duplicates rewrite the same bytes).  Walking pointers (base + i * step) keep the
+        // register cost independent of the number of rounds (small G has many).  K's tile is contiguous in k8; V^T's
+        // rows are n_kv_pad apart.  NT is a multiple of 32, so (c / 4, c % 4) and (c / (D/16), c % (D/16)) advance by
+        // fixed amounts per round.
+        {
+            constexpr int NT = TQB * G * 32, NC = LF_KT * (D / 16), NFULL = NC / NT, NREM = NC - NFULL * NT, NB = 3;
+            static_assert(NT % (D / 16) == 0 || (D / 16) % NT == 0, "K chunk walk");
+            const uint8_t * kb = k8 + ((size_t) hk * n_kv_pad + k0) * D;
+            const uint8_t * vb = v8t + (size_t) hk * D * n_kv_pad + k0;
+            auto kst_off = [&](const int c) { return (c / (D / 16)) * LF_KS + (c % (D / 16)) * 16; };
+            auto vst_off = [&](const int c) { return (c / (LF_KT / 16)) * LF_VS + (c % (LF_KT / 16)) * 16; };
+            {
+                const uint8_t * kp = kb + (size_t) tid * 16;
+#pragma unroll
+                for (int i0 = 0; i0 < NFULL; i0 += NB) {
+                    uint4 w[NB];
+#pragma unroll
+                    for (int i = 0; i < NB; ++i) if (i0 + i < NFULL) w[i] = *(const uint4 *) (kp + (size_t) (i0 + i) * NT * 16);
+#pragma unroll
+                    for (int i = 0; i < NB; ++i) if (i0 + i < NFULL) *(uint4 *) &Ks[kst_off(tid + (i0 + i) * NT)] = w[i];
+                    __builtin_amdgcn_sched_barrier(0);
+                }
+                if constexpr (NREM > 0) { const int c = NFULL * NT + tid % NREM; *(uint4 *) &Ks[kst_off(c)] = *(const uint4 *) (kb + (size_t) c * 16); }
+            }
+            {
+                const uint8_t * vp = vb + (size_t) (tid / (LF_KT / 16)) * n_kv_pad + (tid % (LF_KT / 16)) * 16;
+                const size_t vstep = (size_t) (NT / (LF_KT / 16)) * n_kv_pad;
+#pragma unroll
+                for (int i0 = 0; i0 < NFULL; i0 += NB) {
+                    uint4 w[NB];
+#pragma unroll
+                    for (int i = 0; i < NB; ++i) if (i0 + i < NFULL) w[i] = *(const uint4 *) (vp + (i0 + i) * vstep);
+#pragma unroll
+                    for (int i = 0; i < NB; ++i) if (i0 + i < NFULL) *(uint4 *) &Vs[vst_off(tid + (i0 + i) * NT)] = w[i];
+                    __builtin_amdgcn_sched_barrier(0);
+                }
+                if constexpr (NREM > 0) {
+                    const int c = NFULL * NT + tid % NREM;
+                    *(uint4 *) &Vs[vst_off(c)] = *(const uint4 *) (vb + (size_t) (c / (LF_KT / 16)) * n_kv_pad + (c % (LF_KT / 16)) * 16);
+                }
+            }
+        }
+        lf_fa_iter_barrier();
+
+        if (!wskip) {   // wave-uniform; TQB = 1: always
+        lf_v8f s[LF_KT / 16];
+        if constexpr (ORD) {
+#pragma unroll
+        for (int ks0 = 0; ks0 < LF_KT / 16; ks0 += NACC) {
+#pragma unroll
+            for (int j = 0; j < NACC; ++j) s[ks0 + j] = lf_v8f{0, 0, 0, 0, 0, 0, 0, 0};
+#pragma unroll
+            for (int g2 = 0; g2 < D / 32; ++g2) {
+                lf_v4i k4[NACC];
+#pragma unroll
+                for (int j = 0; j < NACC; ++j) k4[j] = *(const lf_v4i *) &Ks[((ks0 + j) * 16 + lane % 16) * LF_KS + g2 * 32 + (lane / 16) * 16];
+#pragma unroll
+                for (int j = 0; j < NACC; ++j)
+                    s[ks0 + j] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{k4[j].x, k4[j].y}, qa[2 * g2],     s[ks0 + j]);
+#pragma unroll
+                for (int j = 0; j < NACC; ++j)
+                    s[ks0 + j] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{k4[j].z, k4[j].w}, qa[2 * g2 + 1], s[ks0 + j]);
+            }
+        }
+        lf_pipe_ds_wmma_grp<(LF_KT / 16 / NACC) * (D / 32), NACC>();
+        } else {
+#pragma unroll
+        for (int ks_ = 0; ks_ < LF_KT / 16; ++ks_) {
+            s[ks_] = lf_v8f{0, 0, 0, 0, 0, 0, 0, 0};
+#pragma unroll
+            for (int g2 = 0; g2 < D / 32; ++g2) {
+                const lf_v4i k4 = *(const lf_v4i *) &Ks[(ks_ * 16 + lane % 16) * LF_KS + g2 * 32 + (lane / 16) * 16];
+                s[ks_] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{k4.x, k4.y}, qa[2 * g2],     s[ks_]);
+                s[ks_] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{k4.z, k4.w}, qa[2 * g2 + 1], s[ks_]);
+            }
+        }
+        lf_pipe_ds_wmma<(LF_KT / 16) * (D / 32)>();
+        }
+        float mt = -INFINITY;
+        float cc = kqc;   // full tiles keep the raw dot products (scaled inside the exp2's fma); others are pre-scaled
+        if (full) {
+#pragma unroll
+            for (int ks_ = 0; ks_ < LF_KT / 16; ++ks_)
+#pragma unroll
+                for (int v = 0; v < 8; ++v) mt = fmaxf(mt, s[ks_][v]);
+            mt *= kqc;    // kqc >= 0
+        } else {
+            cc = 1.f;
+#pragma unroll
+            for (int ks_ = 0; ks_ < LF_KT / 16; ++ks_)
+#pragma unroll
+                for (int v = 0; v < 8; ++v) {
+                    const int kk = ks_ * 16 + v + 8 * (lane / 16), j = k0 + kk;
+                    float x = s[ks_][v] * kqc;
+                    bool vis = j < n_kv;
+                    if (vis && cell_pos) {
+                        const int p = cell_pos[j];
+                        vis = p >= lo && p <= hi;
+                    }
+                    if (vis && mrow) x += __half2float(mrow[j]) * 1.4426950408889634f; // scores are in the log2 domain
+                    x = vis ? x : -INFINITY;
+                    s[ks_][v] = x;
+                    mt = fmaxf(mt, x);
+                }
+        }
+        mt = fmaxf(mt, __shfl_xor_sync(0xFFFFFFFF, mt, 16, 32));
+        const float mn    = fmaxf(m, mt);
+        const float alpha = mn == -INFINITY ? 1.f : __builtin_amdgcn_exp2f(m - mn);
+        const float msub  = (mn == -INFINITY ? 0.f : mn) - 8.f;   // P is produced x 2^8 (fp8 range), l likewise
+        m = mn;
+        float ls = 0.f;
+        lf_v2i p8[LF_KT / 16];
+#pragma unroll
+        for (int ks_ = 0; ks_ < LF_KT / 16; ++ks_) {
+            float p[8];
+#pragma unroll
+            for (int v = 0; v < 8; ++v) p[v] = __builtin_amdgcn_exp2f(fmaf(s[ks_][v], cc, -msub));
+            const uint2 w = lf_pack_fp8(p, 1.f);
+            ls += lf_sum_fp8(w);
+            p8[ks_] = lf_v2i{(int) w.x, (int) w.y};
+        }
+        l = l * alpha + ls;
+        if (__ballot(alpha != 1.f)) { // the running max moved for some query of this wave (exact: x * 1 == x)
+#pragma unroll
+            for (int i = 0; i < D / 16; ++i) o[i] *= alpha;
+        }
+        if constexpr (ORD) {
+#pragma unroll
+        for (int g2 = 0; g2 < LF_KT / 32; ++g2)
+#pragma unroll
+            for (int i0 = 0; i0 < D / 16; i0 += NACC) {
+                lf_v4i v4[NACC];
+#pragma unroll
+                for (int j = 0; j < NACC; ++j) v4[j] = *(const lf_v4i *) &Vs[((i0 + j) * 16 + lane % 16) * LF_VS + g2 * 32 + (lane / 16) * 16];
+#pragma unroll
+                for (int j = 0; j < NACC; ++j)
+                    o[i0 + j] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{v4[j].x, v4[j].y}, p8[2 * g2],     o[i0 + j]);
+#pragma unroll
+                for (int j = 0; j < NACC; ++j)
+                    o[i0 + j] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{v4[j].z, v4[j].w}, p8[2 * g2 + 1], o[i0 + j]);
+            }
+        lf_pipe_ds_wmma_grp<(LF_KT / 32) * (D / 16 / NACC), NACC>();
+        } else {
+#pragma unroll
+        for (int i = 0; i < D / 16; ++i)
+#pragma unroll
+            for (int g2 = 0; g2 < LF_KT / 32; ++g2) {
+                const lf_v4i v4 = *(const lf_v4i *) &Vs[(i * 16 + lane % 16) * LF_VS + g2 * 32 + (lane / 16) * 16];
+                o[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{v4.x, v4.y}, p8[2 * g2],     o[i]);
+                o[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(lf_v2i{v4.z, v4.w}, p8[2 * g2 + 1], o[i]);
+            }
+        lf_pipe_ds_wmma<(D / 16) * (LF_KT / 32)>();
+        }
+        }   // !wskip
+        lf_fa_iter_barrier();
+    }
+    l += __shfl_xor_sync(0xFFFFFFFF, l, 16, 32);
+    if (tq >= n_q) return;
+    // partial result normalized by its own sum (a weighted mean of V, so f16 holds it); the combine re-weights by l
+    half * po = part + (size_t) blockIdx.z * n_q_pad * HQ * D;
+    const float linv = l > 0.f ? 1.f / l : 0.f;
+#pragma unroll
+    for (int i = 0; i < D / 16; ++i)
+#pragma unroll
+        for (int v = 0; v < 8; ++v) {
+            const int d = i * 16 + v + 8 * (lane / 16);
+            po[((size_t) tq * HQ + h) * D + d] = __float2half(o[i][v] * vs[hk * D + d] * linv);
+        }
+    if (lane < 16) ml[(size_t) blockIdx.z * n_q_pad * HQ + (size_t) tq * HQ + h] = make_float2(m, l);
+#else
+    GGML_UNUSED_VARS(q8, qs, k8, ks, v8t, vs, cell_pos, tok_lo, tok_hi, trange, mask, nb31, part, ml, n_q, n_q_pad, n_kv, n_kv_pad, scale_log2);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// FRANK_FA_FP8_ATTN_CHECK=1 (testing only): a TQB > 1 launch's partials against the TQB = 1 blocks', rows t < n_q
+__device__ unsigned long long lf_fa_attn_n_checked = 0, lf_fa_attn_n_bad = 0;
+template <int D>
+__global__ void lf_fa_attn_cmp(const half * __restrict__ pa, const half * __restrict__ pb, const float2 * __restrict__ ma,
+        const float2 * __restrict__ mb, const int n_q_pad, const int HQ) {
+    const int row = blockIdx.x, sp = blockIdx.y, d = threadIdx.x;
+    const size_t r = (size_t) sp * n_q_pad * HQ + row;
+    const uint16_t a = __half_as_ushort(pa[r * D + d]), b = __half_as_ushort(pb[r * D + d]);
+    bool bad = a != b;
+    if (d == 0) bad = bad || __float_as_uint(ma[r].x) != __float_as_uint(mb[r].x) || __float_as_uint(ma[r].y) != __float_as_uint(mb[r].y);
+    const unsigned long long c = atomicAdd(&lf_fa_attn_n_checked, 1ull) + 1;
+    if (bad) {
+        const unsigned long long nb = atomicAdd(&lf_fa_attn_n_bad, 1ull);
+        if (nb < 8) printf("fa fp8 attn check: split %d row %d dim %d differs: %04x vs %04x (m, l %g %g vs %g %g)\n", sp, row, d, a, b,
+                           ma[r].x, ma[r].y, mb[r].x, mb[r].y);
+    }
+    if (c == 1 || (c & ((1ull << 24) - 1)) == 0) printf("fa fp8 attn check: %llu values checked, %llu differ\n", c, lf_fa_attn_n_bad);
+}
+
+// merge the splits: out[t][h][d] = sum_s w_s O_s / sum_s w_s l_s, w_s = 2^(m_s - M); (fully masked rows: 0)
+template <int D>
+__global__ void lf_fa_combine(const half * __restrict__ part, const float2 * __restrict__ ml, float * __restrict__ dst,
+        const int n_q_pad, const int HQ, const int nsplit) {
+    const int row = blockIdx.x, d = threadIdx.x; // row = t*HQ + h
+    float M = -INFINITY;
+    for (int s = 0; s < nsplit; ++s) M = fmaxf(M, ml[(size_t) s * n_q_pad * HQ + row].x);
+    float num = 0.f, den = 0.f;
+    if (M != -INFINITY) {
+        for (int s = 0; s < nsplit; ++s) {
+            const float2 v = ml[(size_t) s * n_q_pad * HQ + row];
+            if (v.x == -INFINITY) continue;
+            const float w = exp2f(v.x - M);
+            num += w * v.y * __half2float(part[(size_t) s * n_q_pad * HQ * D + (size_t) row * D + d]);
+            den += w * v.y;
+        }
+    }
+    dst[(size_t) row * D + d] = den > 0.f ? num / den : 0.f;
+}
+
+// the same merge with four rows a block and four dims a thread (8-byte part loads, 16-byte stores): the one-row blocks
+// stayed near 290-370 GB/s, this one 570-600 (BigOne 6, f8bench).  Each output's statements are the one-row kernel's, in
+// the same split order.  FRANK_FA_FP8_COMBINE4=0: the one-row kernel.
+template <int D>
+__global__ void lf_fa_combine4(const half * __restrict__ part, const float2 * __restrict__ ml, float * __restrict__ dst,
+        const int n_q_pad, const int HQ, const int nsplit, const int nrows) {
+    const int row = blockIdx.x * 4 + threadIdx.x / (D / 4), d = 4 * (threadIdx.x % (D / 4)); // row = t*HQ + h
+    if (row >= nrows) return;
+    float M = -INFINITY;
+    for (int s = 0; s < nsplit; ++s) M = fmaxf(M, ml[(size_t) s * n_q_pad * HQ + row].x);
+    float num0 = 0.f, num1 = 0.f, num2 = 0.f, num3 = 0.f, den = 0.f;
+    if (M != -INFINITY) {
+        for (int s = 0; s < nsplit; ++s) {
+            const float2 v = ml[(size_t) s * n_q_pad * HQ + row];
+            if (v.x == -INFINITY) continue;
+            const float w = exp2f(v.x - M);
+            const uint2 u = *(const uint2 *) &part[(size_t) s * n_q_pad * HQ * D + (size_t) row * D + d];
+            const half2 p0 = *(const half2 *) &u.x, p1 = *(const half2 *) &u.y;
+            num0 += w * v.y * __low2float(p0);
+            num1 += w * v.y * __high2float(p0);
+            num2 += w * v.y * __low2float(p1);
+            num3 += w * v.y * __high2float(p1);
+            den += w * v.y;
+        }
+    }
+    float4 o;
+    o.x = den > 0.f ? num0 / den : 0.f;
+    o.y = den > 0.f ? num1 / den : 0.f;
+    o.z = den > 0.f ? num2 / den : 0.f;
+    o.w = den > 0.f ? num3 / den : 0.f;
+    *(float4 *) &dst[(size_t) row * D + d] = o;
+}
+
+// FRANK_FA_FP8_COMBINE_CHECK=1 (testing only): the four-row merge against the one-row kernel's, bit for bit
+__device__ unsigned long long lf_fa_comb_n_checked = 0, lf_fa_comb_n_bad = 0;
+__global__ void lf_fa_combine_cmp(const float * __restrict__ a, const float * __restrict__ b, const int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const uint32_t x = __float_as_uint(a[i]), y = __float_as_uint(b[i]);
+    const unsigned long long c = atomicAdd(&lf_fa_comb_n_checked, 1ull) + 1;
+    if (x != y) {
+        const unsigned long long nb = atomicAdd(&lf_fa_comb_n_bad, 1ull);
+        if (nb < 8) printf("fa fp8 combine check: value %lld differs: %08x vs %08x\n", (long long) i, x, y);
+    }
+    if (c == 1 || (c & ((1ull << 26) - 1)) == 0) printf("fa fp8 combine check: %llu values checked, %llu differ\n", c, lf_fa_comb_n_bad);
+}
+
+// One persistent scratch per stream for a call's operands (fp8 K, fp8 V^T, fp8 Q, their scales, the split partials),
+// sized on first use for the whole KV cache (the K view's source tensor) and never shrunk, so a growing prefix does
+// not reallocate (each reallocation waits for the stream: growing by 25% cost 1.5% of a 30K prefill).  The ggml pool keeps every size it has handed out, and these requests grow
+// with the prefix, so a long prefill left one buffer per size behind (Q5_K_M 100K: +2.2 GiB, and on Windows that spills
+// into shared memory instead of failing).  Per stream: the main and the draft model may run on different streams.
+struct lf_fa_arena {
+    char * ptr  = nullptr;
+    size_t size = 0;
+};
+std::mutex g_lf_fa_arena_mutex;
+std::map<cudaStream_t, lf_fa_arena> g_lf_fa_arena;
+
+// nullptr when the device has no room (the caller then takes one pool buffer for this call).  need: this call;
+// want: the size for the whole cache, allocated when the scratch has to grow
+char * lf_fa_arena_get(cudaStream_t stream, const size_t need, const size_t want) {
+    std::lock_guard<std::mutex> lock(g_lf_fa_arena_mutex);
+    lf_fa_arena & a = g_lf_fa_arena[stream];
+    if (a.size < need) {
+        if (a.ptr) {
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            CUDA_CHECK(cudaFree(a.ptr));
+            a.ptr = nullptr; a.size = 0;
+        }
+        size_t sz = std::max(need, want);
+        if (cudaMalloc((void **) &a.ptr, sz) != cudaSuccess) {
+            (void) cudaGetLastError();
+            sz = need + need / 4; // the whole cache does not fit: this call with 25% headroom
+            if (cudaMalloc((void **) &a.ptr, sz) != cudaSuccess) {
+                (void) cudaGetLastError();
+                a.ptr = nullptr;
+                return nullptr;
+            }
+        }
+        a.size = sz;
+    }
+    return a.ptr;
+}
+
+size_t lf_fa_align(const size_t n) { return (n + 255) / 256 * 256; }
+
+template <int D>
+void lf_fa_run(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0], * K = dst->src[1], * V = dst->src[2], * mask = dst->src[3];
+    const bool derived = dst->src[6] != nullptr;   // the derived form: src[6] cell positions, src[7] / src[8] the window (src[5]: kv_rows)
+    cudaStream_t stream = ctx.stream();
+    ggml_cuda_pool & pool = ctx.pool();
+    const int n_q = (int) Q->ne[1], HQ = (int) Q->ne[2], n_kv = (int) K->ne[1], HKV = (int) K->ne[2], G = HQ / HKV;
+    const int n_q_pad  = (n_q + LF_QB - 1) / LF_QB * LF_QB;
+    const int n_kv_pad = (n_kv + LF_KT - 1) / LF_KT * LF_KT;
+    float scale;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+
+    // split the keys: about one split per 80 tiles at 128 query blocks (measured on gfx1201, head 256: 8K -> 2,
+    // 32K -> 6, 90K -> 8 at ubatch 512), fewer when the query grid alone is larger; at least 2 tiles per split
+    const int base = (n_q_pad / LF_QB) * HKV, ntile = n_kv_pad / LF_KT;
+    int nsplit = std::max(1, std::min({LF_MAXSPLIT, (int) (((int64_t) ntile * 128 + (int64_t) 40 * base) / ((int64_t) 80 * base)), ntile / 2}));
+
+    // operands of this call, carved from the per-stream scratch (sizes in elements); the same layout for the whole KV
+    // cache (n_kv_cap keys, the most splits) gives the size reserved on first use
+    const int64_t n_kv_cap = std::max<int64_t>(n_kv_pad, K->view_src ? (K->view_src->ne[1] + LF_KT - 1) / LF_KT * LF_KT : 0);
+    auto layout_bytes = [&](const int64_t nkv, const int ns, size_t * out) {
+        const size_t sz[] = { (size_t) HKV * nkv * D, (size_t) HKV * nkv * D, (size_t) n_q_pad * HQ * D, HKV * sizeof(float),
+                              (size_t) HKV * D * sizeof(float), (size_t) n_q_pad * HQ * sizeof(float),
+                              (size_t) HKV * (D / 32) * sizeof(unsigned int), (size_t) HKV * (D / 32) * sizeof(unsigned int),
+                              (size_t) ns * n_q_pad * HQ * D * sizeof(half), (size_t) ns * n_q_pad * HQ * sizeof(float2),
+                              (derived ? (size_t) nkv / LF_KT : 1) * sizeof(int2), sizeof(int2) };
+        size_t t = 0;
+        for (int i = 0; i < 12; ++i) { if (out) out[i] = sz[i]; t += lf_fa_align(sz[i]); }
+        return t;
+    };
+    const size_t want = layout_bytes(n_kv_cap, LF_MAXSPLIT, nullptr);
+    size_t sizes[12];
+    const size_t total = layout_bytes(n_kv_pad, nsplit, sizes);
+    char * scratch = lf_fa_arena_get(stream, total, want);
+    ggml_cuda_pool_alloc<char> fallback(pool);
+    if (scratch == nullptr) scratch = fallback.alloc(total);
+    char * cur = scratch;
+    auto carve = [&](const size_t b) { char * r = cur; cur += lf_fa_align(b); return r; };
+    uint8_t      * k8    = (uint8_t *)      carve(sizes[0]);
+    uint8_t      * v8t   = (uint8_t *)      carve(sizes[1]);
+    uint8_t      * q8    = (uint8_t *)      carve(sizes[2]);
+    float        * ks    = (float *)        carve(sizes[3]);
+    float        * vs    = (float *)        carve(sizes[4]);
+    float        * qs    = (float *)        carve(sizes[5]);
+    unsigned int * vbits = (unsigned int *) carve(sizes[6]);
+    unsigned int * kbits = (unsigned int *) carve(sizes[7]);
+    half         * part  = (half *)         carve(sizes[8]);
+    float2       * ml    = (float2 *)       carve(sizes[9]);
+    int2         * trange = (int2 *)        carve(sizes[10]);
+    int2         * vrange = (int2 *)        carve(sizes[11]);
+
+    // the cells this batch sees (for the amax passes): derived mask (one sequence) -> range of positions; f16 mask -> every
+    // cell.  The f16 mask is also the form of a ubatch with several sequences, where the last query's row is one sequence's
+    // view only: the other sequences' cells were converted as zeros.  Every cell (all of them finite) keeps each query's own
+    // cells; its own mask row still decides what it attends to.
+    const int   * cell_pos = derived ? (const int *) dst->src[6]->data : nullptr;
+    const int   * tok_lo   = derived ? (const int *) dst->src[7]->data : nullptr;
+    const int   * tok_hi   = derived ? (const int *) dst->src[8]->data : nullptr;
+    const char  * mdata    = !derived && mask ? (const char *) mask->data : nullptr;
+    const int64_t nb31     = !derived && mask ? mask->nb[1] : 0;
+    const half  * mlast    = nullptr;
+    if (derived) lf_fa_vis_range<<<1, 256, 0, stream>>>(tok_lo, tok_hi, n_q, vrange);
+
+    // the K / V conversions for q8_0 or q8_0r (head 256 only); the same values, so the same fp8 operands
+    auto conv_kv = [&](auto r) {
+        constexpr bool R = decltype(r)::value;
+        if constexpr (R) {
+            static const bool conv8 = getenv("FRANK_FA_FP8_CONV") == nullptr || atoi(getenv("FRANK_FA_FP8_CONV")) != 0;
+            static const bool check = getenv("FRANK_FA_FP8_CONV_CHECK") != nullptr && atoi(getenv("FRANK_FA_FP8_CONV_CHECK")) != 0;
+            if (conv8) {
+                constexpr int NG = D / 32;
+                CUDA_CHECK(cudaMemsetAsync(kbits, 0, (size_t) HKV * NG * sizeof(unsigned int), stream));
+                CUDA_CHECK(cudaMemsetAsync(vbits, 0, (size_t) HKV * NG * sizeof(unsigned int), stream));
+                lf_fa_conv_kv_amax<D, true><<<dim3(HKV, (n_kv + 127) / 128, 2), 256, 0, stream>>>((const char *) K->data, K->nb[1], K->nb[2],
+                    (const char *) V->data, V->nb[1], V->nb[2], n_kv, cell_pos, vrange, mlast, kbits, vbits);
+                lf_fa_conv_k<D, true><<<dim3((n_kv_pad + 7) / 8, HKV), 256, 0, stream>>>((const char *) K->data, K->nb[1], K->nb[2], n_kv, n_kv_pad, cell_pos, vrange, mlast, kbits, k8, ks);
+                lf_fa_conv_v_scale<D><<<HKV, D, 0, stream>>>(vbits, vs);
+                lf_fa_conv_v8<D><<<dim3(n_kv_pad / 64, HKV), D, 0, stream>>>((const char *) V->data, V->nb[1], V->nb[2], n_kv, n_kv_pad, cell_pos, vrange, mlast, vs, v8t);
+                if (check) {
+                    const int64_t nv = (int64_t) HKV * D * n_kv_pad;
+                    ggml_cuda_pool_alloc<unsigned int> kb(pool, (size_t) 2 * HKV * NG);
+                    ggml_cuda_pool_alloc<uint8_t> vt(pool, (size_t) nv);
+                    CUDA_CHECK(cudaMemsetAsync(kb.get(), 0, (size_t) 2 * HKV * NG * sizeof(unsigned int), stream));
+                    lf_fa_conv_v_amax<D, true><<<dim3(HKV, (n_kv + 255) / 256), 256, 0, stream>>>((const char *) K->data, K->nb[1], K->nb[2], n_kv, cell_pos, vrange, mlast, kb.get());
+                    lf_fa_conv_v_amax<D, true><<<dim3(HKV, (n_kv + 255) / 256), 256, 0, stream>>>((const char *) V->data, V->nb[1], V->nb[2], n_kv, cell_pos, vrange, mlast, kb.get() + HKV * NG);
+                    lf_fa_conv_v<D, true><<<dim3(n_kv_pad / 64, HKV), D, 0, stream>>>((const char *) V->data, V->nb[1], V->nb[2], n_kv, n_kv_pad, cell_pos, vrange, mlast, vs, vt.get());
+                    lf_fa_conv_cmp<<<(HKV * NG + 255) / 256, 256, 0, stream>>>(kbits, kb.get(), HKV * NG, 0);
+                    lf_fa_conv_cmp<<<(HKV * NG + 255) / 256, 256, 0, stream>>>(vbits, kb.get() + HKV * NG, HKV * NG, 1);
+                    lf_fa_conv_cmp<<<(unsigned) ((nv / 4 + 255) / 256), 256, 0, stream>>>((const uint32_t *) v8t, (const uint32_t *) vt.get(), nv / 4, 2);
+                }
+                return;
+            }
+        }
+        CUDA_CHECK(cudaMemsetAsync(kbits, 0, (size_t) HKV * (D / 32) * sizeof(unsigned int), stream));
+        lf_fa_conv_v_amax<D, R><<<dim3(HKV, (n_kv + 255) / 256), 256, 0, stream>>>((const char *) K->data, K->nb[1], K->nb[2], n_kv, cell_pos, vrange, mlast, kbits);
+        lf_fa_conv_k<D, R><<<dim3((n_kv_pad + 7) / 8, HKV), 256, 0, stream>>>((const char *) K->data, K->nb[1], K->nb[2], n_kv, n_kv_pad, cell_pos, vrange, mlast, kbits, k8, ks);
+        CUDA_CHECK(cudaMemsetAsync(vbits, 0, (size_t) HKV * (D / 32) * sizeof(unsigned int), stream));
+        lf_fa_conv_v_amax<D, R><<<dim3(HKV, (n_kv + 255) / 256), 256, 0, stream>>>((const char *) V->data, V->nb[1], V->nb[2], n_kv, cell_pos, vrange, mlast, vbits);
+        lf_fa_conv_v_scale<D><<<HKV, D, 0, stream>>>(vbits, vs);
+        lf_fa_conv_v<D, R><<<dim3(n_kv_pad / 64, HKV), D, 0, stream>>>((const char *) V->data, V->nb[1], V->nb[2], n_kv, n_kv_pad, cell_pos, vrange, mlast, vs, v8t);
+    };
+    if constexpr (D == 256) {
+        if (K->type == GGML_TYPE_Q8_0R) {
+            conv_kv(std::true_type{});
+        } else {
+            conv_kv(std::false_type{});
+        }
+    } else {
+        conv_kv(std::false_type{});
+    }
+    lf_fa_conv_q<D><<<dim3(n_q_pad / 8, HQ), 256, 0, stream>>>((const char *) Q->data, Q->nb[1], Q->nb[2], n_q, n_q_pad, HQ, q8, qs);
+
+    const float scale_log2 = scale * 1.4426950408889634f;
+    if (derived) lf_fa_tile_range<<<ntile, LF_KT, 0, stream>>>(cell_pos, n_kv, trange);
+    // TQB token groups a block (BigOne 6c, head 256): FRANK_FA_FP8_QB = 1, 2 or 4 (default 4); the same splits
+    static const int qb = [] { const char * e = getenv("FRANK_FA_FP8_QB"); const int v = e ? atoi(e) : 4; return v == 2 || v == 4 ? v : 1; }();
+    static const bool acheck = getenv("FRANK_FA_FP8_ATTN_CHECK") != nullptr && atoi(getenv("FRANK_FA_FP8_ATTN_CHECK")) != 0;
+    auto launch = [&](auto tqb, half * part_, float2 * ml_) {
+        constexpr int TB = decltype(tqb)::value;
+        const dim3 grid((n_q_pad / LF_QB + TB - 1) / TB, HKV, nsplit);
+#define LF_FA_LAUNCH(g) lf_fa_attn<g, D, TB><<<grid, TB * (g) * 32, 0, stream>>>(q8, qs, k8, ks, v8t, vs, \
+        cell_pos, tok_lo, tok_hi, trange, mdata, nb31, part_, ml_, n_q, n_q_pad, n_kv, n_kv_pad, scale_log2)
+        switch (G) {
+            case 1: LF_FA_LAUNCH(1); break;
+            case 2: LF_FA_LAUNCH(2); break;
+            case 3: LF_FA_LAUNCH(3); break;
+            case 4: LF_FA_LAUNCH(4); break;
+            case 5: LF_FA_LAUNCH(5); break;
+            case 6: LF_FA_LAUNCH(6); break;
+            case 7: LF_FA_LAUNCH(7); break;
+            case 8: LF_FA_LAUNCH(8); break;
+            default: GGML_ABORT("lf_fa_fp8: unsupported GQA ratio %d", G);
+        }
+#undef LF_FA_LAUNCH
+    };
+    int tqb = 1;
+    if constexpr (D == 256) {
+        tqb = qb;
+        if (tqb == 4) {
+            launch(std::integral_constant<int, 4>{}, part, ml);
+        } else if (tqb == 2) {
+            launch(std::integral_constant<int, 2>{}, part, ml);
+        }
+    }
+    if (tqb == 1) {
+        launch(std::integral_constant<int, 1>{}, part, ml);
+    } else if (acheck) {
+        // testing only: the one-group blocks into scratch, every written partial compared bit for bit
+        ggml_cuda_pool_alloc<half>   p1(pool, (size_t) nsplit * n_q_pad * HQ * D);
+        ggml_cuda_pool_alloc<float2> m1(pool, (size_t) nsplit * n_q_pad * HQ);
+        launch(std::integral_constant<int, 1>{}, p1.get(), m1.get());
+        lf_fa_attn_cmp<D><<<dim3(n_q * HQ, nsplit), D, 0, stream>>>(part, p1.get(), ml, m1.get(), n_q_pad, HQ);
+    }
+    // dst is [D, HQ, n_q] contiguous: rows t*HQ + h
+    static const bool combine4 = getenv("FRANK_FA_FP8_COMBINE4") == nullptr || atoi(getenv("FRANK_FA_FP8_COMBINE4")) != 0;
+    static const bool ccheck = getenv("FRANK_FA_FP8_COMBINE_CHECK") != nullptr && atoi(getenv("FRANK_FA_FP8_COMBINE_CHECK")) != 0;
+    if (combine4) {
+        lf_fa_combine4<D><<<(n_q * HQ + 3) / 4, D, 0, stream>>>(part, ml, (float *) dst->data, n_q_pad, HQ, nsplit, n_q * HQ);
+        if (ccheck) {
+            const int64_t n = (int64_t) n_q * HQ * D;
+            ggml_cuda_pool_alloc<float> o1(pool, n);
+            lf_fa_combine<D><<<n_q * HQ, D, 0, stream>>>(part, ml, o1.get(), n_q_pad, HQ, nsplit);
+            lf_fa_combine_cmp<<<(n + 255) / 256, 256, 0, stream>>>((const float *) dst->data, o1.get(), n);
+        }
+    } else {
+        lf_fa_combine<D><<<n_q * HQ, D, 0, stream>>>(part, ml, (float *) dst->data, n_q_pad, HQ, nsplit);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace
+
+bool ggml_cuda_lf_fa_fp8_supported(ggml_backend_cuda_context & ctx, const ggml_tensor * dst) {
+    if (!lf_on()) return false;
+    const ggml_tensor * Q = dst->src[0], * K = dst->src[1], * V = dst->src[2], * mask = dst->src[3];
+    if (!GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ctx.device].cc)) return false;
+    const bool q8r = K->type == GGML_TYPE_Q8_0R && V->type == GGML_TYPE_Q8_0R;   // BigOne's q8_0r cache (head 256)
+    if (Q->type != GGML_TYPE_F32 || !((K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0) || q8r) || dst->type != GGML_TYPE_F32) return false;
+    const int64_t D = K->ne[0];
+    if (q8r && D != 256) return false;
+    if ((D != 64 && D != 128 && D != 256) || Q->ne[0] != D || V->ne[0] != D) return false;
+    if (Q->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1 || K->ne[1] != V->ne[1] || K->ne[2] != V->ne[2]) return false;
+    if (K->ne[1] < lf_min_kv()) return false;
+    if (Q->ne[1] < lf_min_t() || Q->nb[0] != sizeof(float) || Q->nb[1] % 16 != 0 || Q->nb[2] % 16 != 0) return false;
+    if ((uintptr_t) Q->data % 16 != 0) return false;
+    const int64_t HQ = Q->ne[2], HKV = K->ne[2];
+    if (HKV <= 0 || HQ % HKV != 0) return false;
+    const int64_t G = HQ / HKV;
+    if (G < 1 || G > 8) return false;
+    if (D == 256 && G == 1) return false;   // 32-thread blocks at head 256 spill registers
+    if (V->view_src && (V->view_src == K || (V->view_src == K->view_src && V->view_offs == K->view_offs))) return false;
+    if (dst->src[4] != nullptr) return false; // sinks
+    float max_bias, softcap;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (const float *) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.f || softcap != 0.f) return false;
+    const bool derived = dst->src[6] != nullptr;   // the derived form: src[6] cell positions, src[7] / src[8] the window (src[5]: kv_rows)
+    if (!derived && mask && (mask->type != GGML_TYPE_F16 || mask->ne[2] != 1 || mask->ne[3] != 1 || mask->ne[0] < K->ne[1])) return false;
+    if (!ggml_is_contiguous(dst)) return false;
+    return true;
+}
+
+void ggml_cuda_lf_fa_fp8(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    switch (dst->src[1]->ne[0]) {
+        case  64: lf_fa_run< 64>(ctx, dst); break;
+        case 128: lf_fa_run<128>(ctx, dst); break;
+        case 256: lf_fa_run<256>(ctx, dst); break;
+        default: GGML_ABORT("lf_fa_fp8: unsupported head size %lld", (long long) dst->src[1]->ne[0]);
+    }
+}
