diff --git a/ggml/src/ggml-cuda/fp8-pow2.cuh b/ggml/src/ggml-cuda/fp8-pow2.cuh
new file mode 100644
index 000000000..f7a4e061b
--- /dev/null
+++ b/ggml/src/ggml-cuda/fp8-pow2.cuh
@@ -0,0 +1,47 @@
+#pragma once
+// FRANK_FP8_POW2 (on by default; =0, or FRANK_ALL=0 with it unset, turns it off): the fp8 scales of the prefill activations (K1 fp8 and M4's MXFP4 -> fp8 GEMM) and of F8's
+// Q / K / V are powers of two.  The amax a scale is taken from is rounded up to 448 * 2^k, so amax / 448 = 2^k and 448 / amax = 2^-k
+// exactly.  With the scale amax / 448 the whole fp8 grid of a batch (K1: every activation of the batch; F8: a kv head, a group of 32
+// V channels, a query row) moves whenever its largest value moves, so a tiny difference upstream changes the rounding of values far
+// from the one that moved; with a power-of-two scale the grid stays put until the amax crosses a power of two.  e4m3 is a
+// floating-point grid: a power-of-two scale only shifts the exponents, so the values keep their relative precision (the largest
+// value lands in (224, 448] instead of at 448).
+
+#include "common.cuh"
+
+#include <cstdlib>
+
+static inline bool ggml_cuda_fp8_pow2_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_FP8_POW2");
+        const char * a = getenv("FRANK_ALL");
+        const bool v = e != nullptr ? atoi(e) != 0 : !(a != nullptr && a[0] == '0' && a[1] == '\0');
+        if (v) {
+            GGML_LOG_INFO("%s: fp8 activation scales are powers of two (FRANK_FP8_POW2=0 turns it off)\n", __func__);
+        }
+        return v;
+    }();
+    return on;
+}
+
+// the smallest 448 * 2^k >= a (a > 0, finite); a = m * 2^e with m in [0.5, 1) and 448 = 0.875 * 2^9, so no rounding is involved
+static __device__ __forceinline__ float ggml_cuda_fp8_pow2_amax(const float a) {
+    if (!(a > 0.f) || isinf(a)) {
+        return a;
+    }
+    int e;
+    const float m = frexpf(a, &e);
+    return ldexpf(448.f, m <= 0.875f ? e - 9 : e - 8);
+}
+
+// the same on amax values kept as float bits (the atomicMax buffers), in place
+static __global__ void ggml_cuda_fp8_pow2_bits_kernel(unsigned int * __restrict__ bits, const int n) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) {
+        bits[i] = __float_as_uint(ggml_cuda_fp8_pow2_amax(__uint_as_float(bits[i])));
+    }
+}
+
+static inline void ggml_cuda_fp8_pow2_bits(unsigned int * bits, const int n, cudaStream_t stream) {
+    ggml_cuda_fp8_pow2_bits_kernel<<<(n + 255) / 256, 256, 0, stream>>>(bits, n);
+}
