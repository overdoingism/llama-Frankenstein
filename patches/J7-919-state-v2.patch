+static std::atomic<const common_state_mem *> g_state_mem{nullptr};
+static thread_local int g_state_mem_scope  = 0;
+static thread_local int g_state_mem_strict = 0;
+
+void common_state_mem_set(const common_state_mem * m) {
+    g_state_mem.store(m);
+}
+
+bool common_state_mem_lent(const void * p) {
+    const common_state_mem * m = g_state_mem.load();
+    return p != nullptr && m != nullptr && m->contains != nullptr && m->contains(p);
+}
+
+void * common_state_mem_alloc(size_t n) {
+    if (g_state_mem_scope == 0) {
+        return nullptr;
+    }
+    const common_state_mem * m = g_state_mem.load();
+    void * p = m != nullptr && m->alloc != nullptr ? m->alloc(n) : nullptr;
+    if (p == nullptr && g_state_mem_strict > 0) {
+        throw std::bad_alloc();
+    }
+    return p;
+}
+
+bool common_state_mem_release(void * p, size_t n) {
+    const common_state_mem * m = g_state_mem.load();
+    return p != nullptr && m != nullptr && m->release != nullptr && m->release(p, n);
+}
+
+common_state_mem_scope::common_state_mem_scope(bool strict) : strict(strict) {
+    ++g_state_mem_scope;
+    if (strict) {
+        ++g_state_mem_strict;
+    }
+}
+
+common_state_mem_scope::~common_state_mem_scope() {
+    --g_state_mem_scope;
+    if (strict) {
+        --g_state_mem_strict;
+    }
+}
+
+common_state_data common_state_data_lend(size_t n) {
+    common_state_data v;
+    if (n == 0 || g_state_mem.load() == nullptr) {
+        return v;
+    }
+    try {
+        common_state_mem_scope scope(/*strict =*/ true);
+        v.resize(n);
+    } catch (const std::bad_alloc &) {
+        v = {};
+    }
+    return v;
+}
