+                ggml_backend_buffer_free(buf);
+                buf = nullptr;
+            }
+            k *= 0.75;
+        }
+        if (buf == nullptr) {
+            SRV_WRN("pinned host memory: no buffer of %.0f MiB (%s): states and checkpoints stay in pageable memory\n", want / 1048576.0,
+                    dev == nullptr ? "no GPU device" : bt == nullptr ? "the device has no host buffer type" : "allocation failed");
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(mu);
+            base = (uint8_t *) ggml_backend_buffer_get_base(buf);
+            size = ggml_backend_buffer_get_size(buf);
+            budget[CACHE] = (size_t) (cache_bytes * k);
+            budget[CKPT]  = (size_t) (ckpt_bytes  * k);
+            free_ranges[0] = size;
+        }
+        ready.store(true);   // the buffer stays for the process's lifetime
+        if (k < 1.0) {
+            SRV_WRN("pinned host memory: the driver gave %.0f of %.0f MiB; prompt cache %.0f MiB, checkpoints %.0f MiB\n",
+                    size / 1048576.0, want / 1048576.0, budget[CACHE] / 1048576.0, budget[CKPT] / 1048576.0);
+        }
+        SRV_INF("pinned host memory: pool of %.0f MiB ready in %.2f s (prompt cache %.0f MiB, context checkpoints %.0f MiB)\n",
+                size / 1048576.0, (ggml_time_us() - t0) / 1e6, budget[CACHE] / 1048576.0, budget[CKPT] / 1048576.0);
+    });
+}
+
+server_pinned_pool::~server_pinned_pool() {
+    if (th.joinable()) {
+        th.join();
+    }
+    dead.store(true);   // the buffer is never freed: a block given back after this is left alone
+}
+
+uint8_t * server_pinned_pool::alloc(size_t n, size_t & cap, int cls) {
+    if (!ready.load() || n == 0 || dead.load()) {
+        return nullptr;
+    }
+    cap = cap_of(n);
+    std::lock_guard<std::mutex> lock(mu);
+    if (used[cls] + cap > budget[cls]) {
+        return nullptr;
+    }
+    for (auto it = free_ranges.begin(); it != free_ranges.end(); ++it) {   // first fit
+        if (it->second >= cap) {
+            const size_t off = it->first, len = it->second;
+            free_ranges.erase(it);
+            if (len > cap) {
+                free_ranges[off + cap] = len - cap;
+            }
+            used[cls] += cap;
+            return base + off;
+        }
+    }
+    return nullptr;
+}
+
+void server_pinned_pool::free(uint8_t * p, size_t cap, int cls) {
+    if (dead.load()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(mu);
+    used[cls] -= cap;
+    size_t off = (size_t) (p - base), len = cap;
+    auto next = free_ranges.lower_bound(off);
+    if (next != free_ranges.end() && off + len == next->first) {   // merge with the range after
+        len += next->second;
+        next = free_ranges.erase(next);
+    }
+    if (next != free_ranges.begin()) {   // and the one before
+        auto prev = std::prev(next);
+        if (prev->first + prev->second == off) {
+            off = prev->first;
+            len += prev->second;
+            free_ranges.erase(prev);
+        }
+    }
+    free_ranges[off] = len;
+}
+
+// "60%", "4096" (MiB), "60%,4096" (the smaller) or 0; nullptr: all of `need`.  ok = false for a malformed setting
+static size_t server_pinned_parse(const char * spec, size_t need, bool & ok) {
+    ok = true;
+    if (spec == nullptr) {
+        return need;
+    }
+    size_t res = SIZE_MAX;
+    std::string item;
+    std::stringstream ss(spec);
+    while (std::getline(ss, item, ',')) {
+        while (!item.empty() && isspace((unsigned char) item.back())) {
+            item.pop_back();
+        }
+        while (!item.empty() && isspace((unsigned char) item.front())) {
+            item.erase(item.begin());
+        }
+        if (item.empty()) {
+            continue;
+        }
+        char * end = nullptr;
+        const double v = strtod(item.c_str(), &end);
+        if (end == item.c_str() || v < 0) {
+            ok = false;
+            return need;
+        }
+        size_t b;
+        if (*end == '%' && end[1] == '\0') {
+            b = (size_t) (need * (v / 100.0));
+        } else if (*end == '\0') {
+            b = (size_t) (v * 1048576.0);
+        } else {
+            ok = false;
+            return need;
+        }
+        res = std::min(res, b);
+    }
+    return res == SIZE_MAX ? need : res;
+}
+
+// the host-memory guard of server_pinned_init (SIZE_MAX where the memory cannot be read); mem_total / mem_avail for the log
+static size_t server_pinned_guard(size_t & mem_total, size_t & mem_avail) {
+    mem_total = mem_avail = 0;
+#if defined(__linux__)
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (f != nullptr) {
+        char line[256];
+        while (fgets(line, sizeof(line), f) != nullptr) {
+            unsigned long long kb = 0;
+            if (sscanf(line, "MemTotal: %llu kB", &kb) == 1) {
+                mem_total = (size_t) kb * 1024;
+            } else if (sscanf(line, "MemAvailable: %llu kB", &kb) == 1) {
+                mem_avail = (size_t) kb * 1024;
+            }
+        }
+        fclose(f);
+    }
+#elif defined(_WIN32)
+    MEMORYSTATUSEX ms;
+    ms.dwLength = sizeof(ms);
+    if (GlobalMemoryStatusEx(&ms)) {
+        mem_total = (size_t) ms.ullTotalPhys;
+        mem_avail = (size_t) ms.ullAvailPhys;
+    }
+#endif
+    if (mem_total == 0 || mem_avail == 0) {
+        return SIZE_MAX;
+    }
+    const size_t half = mem_total / 2 > (2ull << 30) ? mem_total / 2 - (2ull << 30) : 0;
+    return std::min(half, mem_avail / 4 * 3);
+}
+
+// the context checkpoints' lender (common_state_mem): the pool's CKPT budget
+static void * server_ckpt_mem_alloc(size_t n) {
+    size_t cap = 0;
+    return server_pinned().alloc(n, cap, server_pinned_pool::CKPT);
+}
+
+static bool server_ckpt_mem_release(void * p, size_t n) {
+    server_pinned_pool & pool = server_pinned();
+    if (!pool.contains(p)) {
+        return false;
+    }
+    pool.free((uint8_t *) p, server_pinned_pool::cap_of(n), server_pinned_pool::CKPT);
+    return true;
+}
+
+static bool server_ckpt_mem_contains(const void * p) {
+    return server_pinned().contains(p);
+}
+
+void server_pinned_init(size_t cache_need, size_t ckpt_need, const std::string & ckpt_note) {
+    const char * cache_spec = getenv("FRANK_SERVER_CACHE_PINNED");
+    const char * ckpt_spec  = getenv("FRANK_SERVER_CKPT_PINNED");
+    bool ok_cache = true, ok_ckpt = true;
+    size_t cache_b = server_pinned_parse(cache_spec, cache_need, ok_cache);
+    size_t ckpt_b  = server_pinned_parse(ckpt_spec,  ckpt_need,  ok_ckpt);
+    if (!ok_cache) {
+        SRV_WRN("pinned host memory: FRANK_SERVER_CACHE_PINNED=\"%s\" is not \"N%%\", \"MiB\", \"N%%,MiB\" or 0: using 100%%\n", cache_spec);
+    }
+    if (!ok_ckpt) {
+        SRV_WRN("pinned host memory: FRANK_SERVER_CKPT_PINNED=\"%s\" is not \"N%%\", \"MiB\", \"N%%,MiB\" or 0: using 100%%\n", ckpt_spec);
+    }
+    size_t mem_total = 0, mem_avail = 0;
+    const size_t guard = server_pinned_guard(mem_total, mem_avail);
+    const size_t want = cache_b + ckpt_b;
+    if (want > guard) {
+        const double k = guard / (double) want;
+        SRV_WRN("pinned host memory: %.0f MiB asked, the host-memory guard allows %.0f MiB (RAM %.1f GiB, available %.1f GiB): "
+                "both budgets scaled by %.2f\n", want / 1048576.0, guard / 1048576.0, mem_total / 1073741824.0,
+                mem_avail / 1073741824.0, k);
+        cache_b = (size_t) (cache_b * k);
+        ckpt_b  = (size_t) (ckpt_b  * k);
+    }
+    SRV_INF("pinned host memory: prompt cache %.0f of %.0f MiB needed (FRANK_SERVER_CACHE_PINNED %s); context checkpoints %.0f of "
+            "%.0f MiB needed (%s; FRANK_SERVER_CKPT_PINNED %s) -- settings: \"60%%\", \"4096\" (MiB), \"60%%,4096\" or 0 = off\n",
+            cache_b / 1048576.0, cache_need / 1048576.0, cache_spec ? cache_spec : "unset = 100%",
+            ckpt_b / 1048576.0, ckpt_need / 1048576.0, ckpt_note.c_str(), ckpt_spec ? ckpt_spec : "unset = 100%");
+    if (ckpt_b > 0) {
+        static const common_state_mem lender = { server_ckpt_mem_alloc, server_ckpt_mem_release, server_ckpt_mem_contains };
+        common_state_mem_set(&lender);
+    }
+    server_pinned().init(cache_b, ckpt_b);
+}
