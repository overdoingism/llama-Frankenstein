 //
 
 // leave default-inserted elements uninitialized; callers must fill them before use
+// Memory an application lends to the context checkpoints' state buffers (e.g. pinned host memory that device copies reach
+// directly): common_prompt_checkpoint::update_* allocate inside a common_state_mem_scope, where common_no_init_allocator asks
+// the lender first; every buffer goes back to whoever gave it (the lender says by the address).  update_* / load_* pass
+// LLAMA_STATE_SEQ_FLAGS_HOST_PINNED for a buffer in lent memory.  Nothing is lent unless common_state_mem_set() was called.
+struct common_state_mem {
+    void * (*alloc)(size_t n) = nullptr;               // nullptr: declined (the heap is used)
+    bool   (*release)(void * p, size_t n) = nullptr;   // true: p was lent (and is taken back)
+    bool   (*contains)(const void * p) = nullptr;      // p is in lent memory
+};
+void common_state_mem_set(const common_state_mem * m);   // m must outlive every buffer
+bool common_state_mem_lent(const void * p);
+void * common_state_mem_alloc(size_t n);                 // the allocator's side: nullptr outside a scope or when declined
+bool   common_state_mem_release(void * p, size_t n);
+// allocations on this thread in its lifetime may be lent; strict: a declined one throws std::bad_alloc instead of using the heap
+struct common_state_mem_scope {
+    explicit common_state_mem_scope(bool strict = false);
+    ~common_state_mem_scope();
+    common_state_mem_scope(const common_state_mem_scope &) = delete;
+    common_state_mem_scope & operator=(const common_state_mem_scope &) = delete;
+private:
+    bool strict;
+};
+
 template <typename T>
 struct common_no_init_allocator : std::allocator<T> {
     template <typename U> struct rebind { using other = common_no_init_allocator<U>; };
@@ -1499,11 +1524,26 @@ struct common_no_init_allocator : std::allocator<T> {
     template <typename U> common_no_init_allocator(const common_no_init_allocator<U> &) {}
 
     template <typename U> void construct(U * p) { ::new ((void *) p) U; }
+
+    T * allocate(std::size_t n) {
+        if (void * p = common_state_mem_alloc(n * sizeof(T))) {
+            return (T *) p;
+        }
+        return std::allocator<T>::allocate(n);
+    }
+    void deallocate(T * p, std::size_t n) {
+        if (!common_state_mem_release(p, n * sizeof(T))) {
+            std::allocator<T>::deallocate(p, n);
+        }
+    }
 };
 
 // sequence state data, filled by llama_state_seq_get_data_ext()
 using common_state_data = std::vector<uint8_t, common_no_init_allocator<uint8_t>>;
 
