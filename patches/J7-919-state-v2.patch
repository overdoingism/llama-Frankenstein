index a5196edfb..e85bac462 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -1072,13 +1072,49 @@ extern "C" {
 // Getting the state for a seq_id with this flag invalidates all prior states gotten for that seq_id with this flag.
 #define LLAMA_STATE_SEQ_FLAGS_ON_DEVICE 2
 
+// llama_state_seq_get_data_ext only: return once the device copies are queued; the host copy into dst finishes on a
+// worker thread.  dst must not be read, written or freed before llama_state_seq_wait() (every other state call on the
+// context, and llama_free, wait first).  Host states only: with LLAMA_STATE_SEQ_FLAGS_ON_DEVICE, or when the copy is
+// small or cannot be tracked with events, the call completes as without the flag.
+#define LLAMA_STATE_SEQ_FLAGS_ASYNC 4
+
+// host states only: the caller's buffer (dst of a get, src of a set) is pinned host memory the devices can copy to and from
+// directly, so the device copies go straight to / from it, without the context's staging buffer and host memcpy
+#define LLAMA_STATE_SEQ_FLAGS_HOST_PINNED 8
+
+// llama_state_seq_get_data_ext with LLAMA_STATE_SEQ_FLAGS_ASYNC and LLAMA_STATE_SEQ_FLAGS_HOST_PINNED only: the device copies
+// run on a stream of their own (one per device, created on first use) instead of the context's, so the work queued on
+// the context after the call does not wait for them.  The caller keeps the sequence's state unchanged (no decode of it,
+// no seq_rm / seq_cp / moves of its cells) until llama_state_seq_pending() is false or llama_state_seq_wait() returned.
+// Without either of the other two flags, or when a device has no such stream, the copies stay on the context's stream.
+#define LLAMA_STATE_SEQ_FLAGS_COPY_STREAM 16
+
     typedef uint32_t llama_state_seq_flags;
 
+    // waits for the host copy of a state saved with LLAMA_STATE_SEQ_FLAGS_ASYNC (returns at once if none is pending)
+    LLAMA_API void llama_state_seq_wait(struct llama_context * ctx);
+
+    // whether the copy of a state saved with LLAMA_STATE_SEQ_FLAGS_ASYNC is still running (does not block)
+    LLAMA_API bool llama_state_seq_pending(struct llama_context * ctx);
+
+    // the copies a context ran asynchronously are numbered: right after a save with LLAMA_STATE_SEQ_FLAGS_ASYNC this is
+    // its number; llama_state_seq_async_done() tells whether that copy has finished (a later one implies it has, since
+    // each waits for the one before)
+    LLAMA_API uint64_t llama_state_seq_async_ticket(struct llama_context * ctx);
+    LLAMA_API bool     llama_state_seq_async_done  (struct llama_context * ctx, uint64_t ticket);
+
     LLAMA_API size_t llama_state_seq_get_size_ext(
             struct llama_context * ctx,
                     llama_seq_id   seq_id,
            llama_state_seq_flags   flags);
 
+    // An upper bound of llama_state_seq_get_size_ext(ctx, seq_id, flags) for any one sequence, from the shapes of the
+    // context's cache tensors (no sequence has to hold data, e.g. right after the context is created); 0 when the memory
+    // cannot tell
+    LLAMA_API size_t llama_state_seq_get_size_max_ext(
+            struct llama_context * ctx,
+           llama_state_seq_flags   flags);
+
     LLAMA_API size_t llama_state_seq_get_data_ext(
