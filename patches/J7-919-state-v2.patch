+// State buffers in pinned host memory: a save or a restore is one device copy per tensor straight to / from the buffer
+// (LLAMA_STATE_SEQ_FLAGS_HOST_PINNED) instead of a copy staged through the context's pinned chunk into a pageable buffer
+// (8K tokens' 443 MiB: ~130 ms; a 150 MiB recurrent checkpoint: ~16 ms of host copy per restore).  One allocation, made on a
+// background thread at startup and kept for the process's lifetime, so its pages are zeroed once and then reused; two budgets
+// in it: the prompt cache's states (CACHE) and the context checkpoints (CKPT; lent to their buffers through common_state_mem),
+// set by server_pinned_init.  A buffer past its budget, without a free range of its size, or asked for before the pool is
+// ready takes pageable memory as before.
+struct server_pinned_pool {
+    enum cls_t { CACHE = 0, CKPT = 1 };
+    void init(size_t cache_bytes, size_t ckpt_bytes);
+    uint8_t * alloc(size_t n, size_t & cap, int cls);   // nullptr: not ready, over the budget, or no free range of n bytes
+    void free(uint8_t * p, size_t cap, int cls);
+    bool contains(const void * p) const {
+        return ready.load() && (const uint8_t *) p >= base && (const uint8_t *) p < base + size;
+    }
+    static size_t cap_of(size_t n) { const size_t unit = 64u << 10; return (n + unit - 1) / unit * unit; }
+    bool gone() const { return dead.load(); }
+    ~server_pinned_pool();
+private:
+    std::mutex mu;
+    std::thread th;
+    std::atomic<bool> ready{false};
+    std::atomic<bool> dead{false};
+    uint8_t * base = nullptr;
+    size_t size = 0;
+    size_t budget[2] = { 0, 0 };
+    size_t used[2]   = { 0, 0 };
+    std::map<size_t, size_t> free_ranges;   // offset -> bytes
+};
+server_pinned_pool & server_pinned();
+
+// FRANK_SERVER_CACHE_PINNED (the prompt cache) and FRANK_SERVER_CKPT_PINNED (the context checkpoints): "60%" of what is needed,
+// "4096" MiB, "60%,4096" (the smaller), 0 = off; unset = 100% of what is needed.  cache_need: the cache size limit; ckpt_need:
+// every checkpoint the context can hold (ckpt_note says how it was counted).  Both are then held under a host-memory guard
+// (the total at most half the RAM less 2 GiB -- the GPU driver's default limit for pinned host memory is half the RAM -- and
+// 3/4 of the memory available at startup).  Registers the checkpoint budget as the lender of common_state_mem.
+void server_pinned_init(size_t cache_need, size_t ckpt_need, const std::string & ckpt_note);
