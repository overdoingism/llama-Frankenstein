+    }
+    size_t per_cell = 32;                        // the cell's metadata (state_write_meta), with room to spare
+    size_t fixed    = 64 + 8 * v_cells.size();   // the stream and layer headers
+    for (const auto & layer : layers) {
+        const uint32_t il = layer.il;
+        if (const ggml_tensor * k = layer.k_stream.empty() ? nullptr : layer.k_stream[0]) {
+            per_cell += ggml_row_size(k->type, hparams.n_embd_k_gqa(il));
+            fixed    += 16;
+        }
+        if (const ggml_tensor * v = layer.v_stream.empty() ? nullptr : layer.v_stream[0]) {
+            per_cell += ggml_row_size(v->type, hparams.n_embd_v_gqa(il));
+            fixed    += 16;
+        }
+    }
+    return fixed + n_cells * per_cell;
