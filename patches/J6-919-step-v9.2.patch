+            ctx->stream_own = nullptr;
+        }
+        return true;
+    }
+    ggml_backend_cuda_context * sc = (ggml_backend_cuda_context *) share->context;
+    if (sc == ctx || sc->device != ctx->device || ctx->stream_own != nullptr) {
+        return false;
+    }
+    cudaStream_t own = ctx->stream(ctx->device, 0);
+    cudaStream_t other = sc->stream(sc->device, 0);
+    ctx->stream_own = own;
+    ctx->streams[ctx->device][0] = other;
+    return true;
