+        step_graph_fn(true);
+    }
+    const auto status = graph_compute(res->get_gf(), true);
+    if (status == GGML_STATUS_SUCCESS && layer_inp_dev && ev_layer_inp_written) {
+        ggml_backend_event_record(ev_layer_inp_written.get(), layer_inp_backend);
+    }
+    return status == GGML_STATUS_SUCCESS ? 0 : -2;
