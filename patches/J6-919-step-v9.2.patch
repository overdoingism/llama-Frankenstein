@@ -2921,6 +2929,126 @@ ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type(int device) {
     return &ggml_backend_cuda_buffer_types[device];
 }
 
+// ------------------------------------------------------------------------------------------------
+// BigOne: the MAPPED buffer type -- pinned system RAM that the device reads in place (cudaHostAllocMapped),
+// presented as memory of `device`.  For a table that the GPU graph gathers a few rows of per batch (the token
+// embedding that LLAMA_DEVICE_INPUT puts on the GPU, for the GPU-resident speculative loop): the GET_ROWS stays
+// in the GPU graph as with a VRAM copy, the table costs no VRAM, and a batch reads only its rows over the bus.
+// It keeps the plain CUDA name function (so `ggml_backend_buft_is_cuda()` holds and the scheduler treats the
+// tensor as this device's, exactly as a VRAM copy) and the plain `free_buffer` (so `ggml_backend_buffer_is_cuda()`
+// holds; the buffer context frees `host_mapped`).  A host buffer type would instead let the scheduler move other
+// ops that read host memory onto the device.  Uploads and reads go through the host mapping after a device sync.
+// Selection is the caller's (llama-model-loader.cpp, FRANK_DEVICE_INPUT_MAPPED).
+
+static char * ggml_cuda_mapped_host_addr(ggml_backend_buffer_t buffer, const void * dev_addr) {
+    const ggml_backend_cuda_buffer_context * ctx = (const ggml_backend_cuda_buffer_context *) buffer->context;
+    return (char *) ctx->host_mapped + ((const char *) dev_addr - (const char *) ctx->dev_ptr);
+}
+
+static enum ggml_status ggml_backend_cuda_mapped_buffer_init_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor) {
+    if (tensor->view_src == nullptr && ggml_is_quantized(tensor->type)) {
+        // padding to 0, as ggml_backend_cuda_buffer_init_tensor
+        const size_t original_size = ggml_nbytes(tensor);
+        const size_t padded_size   = ggml_backend_buft_get_alloc_size(buffer->buft, tensor);
+        if (padded_size > original_size) {
+            memset(ggml_cuda_mapped_host_addr(buffer, (const char *) tensor->data + original_size), 0, padded_size - original_size);
+        }
+    }
+    return GGML_STATUS_SUCCESS;
+}
+
+static void ggml_backend_cuda_mapped_buffer_sync(ggml_backend_buffer_t buffer) {
+    const ggml_backend_cuda_buffer_context * ctx = (const ggml_backend_cuda_buffer_context *) buffer->context;
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+}
+
+static void ggml_backend_cuda_mapped_buffer_memset_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor, uint8_t value, size_t offset, size_t size) {
+    ggml_backend_cuda_mapped_buffer_sync(buffer);
+    memset(ggml_cuda_mapped_host_addr(buffer, (const char *) tensor->data + offset), value, size);
+}
+
+static void ggml_backend_cuda_mapped_buffer_set_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    ggml_backend_cuda_mapped_buffer_sync(buffer);
+    memcpy(ggml_cuda_mapped_host_addr(buffer, (const char *) tensor->data + offset), data, size);
+}
+
+static void ggml_backend_cuda_mapped_buffer_get_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * tensor, void * data, size_t offset, size_t size) {
+    ggml_backend_cuda_mapped_buffer_sync(buffer);
+    memcpy(data, ggml_cuda_mapped_host_addr(buffer, (const char *) tensor->data + offset), size);
+}
+
+static void ggml_backend_cuda_mapped_buffer_clear(ggml_backend_buffer_t buffer, uint8_t value) {
+    ggml_backend_cuda_mapped_buffer_sync(buffer);
+    memset(((ggml_backend_cuda_buffer_context *) buffer->context)->host_mapped, value, buffer->size);
+}
+
+static const ggml_backend_buffer_i ggml_backend_cuda_mapped_buffer_interface = {
+    /* .free_buffer     = */ ggml_backend_cuda_buffer_free_buffer,
+    /* .get_base        = */ ggml_backend_cuda_buffer_get_base,
+    /* .init_tensor     = */ ggml_backend_cuda_mapped_buffer_init_tensor,
+    /* .memset_tensor   = */ ggml_backend_cuda_mapped_buffer_memset_tensor,
+    /* .set_tensor      = */ ggml_backend_cuda_mapped_buffer_set_tensor,
+    /* .get_tensor      = */ ggml_backend_cuda_mapped_buffer_get_tensor,
+    /* .set_tensor_2d   = */ NULL,
+    /* .get_tensor_2d   = */ NULL,
+    /* .cpy_tensor      = */ NULL,
+    /* .clear           = */ ggml_backend_cuda_mapped_buffer_clear,
+    /* .reset           = */ NULL,
+};
+
+static ggml_backend_buffer_t ggml_backend_cuda_mapped_buffer_type_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_cuda_buffer_type_context * buft_ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    ggml_cuda_set_device(buft_ctx->device);
+    void * host = nullptr;
+    cudaError_t err = cudaHostAlloc(&host, size, cudaHostAllocMapped | cudaHostAllocPortable);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_ERROR("%s: allocating %.2f MiB of mapped pinned memory for device %d failed: %s\n", __func__, size / 1024.0 / 1024.0,
+                       buft_ctx->device, cudaGetErrorString(err));
+        return nullptr;
+    }
+    void * dev_ptr = nullptr;
+    err = cudaHostGetDevicePointer(&dev_ptr, host, 0);
+    if (err != cudaSuccess || dev_ptr == nullptr) {
+        (void) cudaGetLastError();
+        GGML_LOG_ERROR("%s: no device mapping for the pinned allocation: %s\n", __func__, cudaGetErrorString(err));
+        CUDA_CHECK(cudaFreeHost(host));
+        return nullptr;
+    }
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(buft_ctx->device, dev_ptr);
+    ctx->host_mapped = host;
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_mapped_buffer_interface, ctx, size);
+}
+
