diff --git a/tests/test-spec-step.cpp b/tests/test-spec-step.cpp
new file mode 100644
index 000000000..b26ad9147
--- /dev/null
+++ b/tests/test-spec-step.cpp
@@ -0,0 +1,1047 @@
+// Checks the device-side speculative steps of ggml-spec-step.h against host references written the way
+// the host path does it: the greedy sampler's argmax, common_sampler_sample_and_accept_n() with the
+// reasoning guard (rguard_apply / rguard_track in common/sampling.cpp), and the DFlash2 lattice walk in
+// common_speculative_draft().  Needs a GPU backend that exports the launchers; skips otherwise.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-spec-step.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+typedef void (*spec_argmax_fn)(ggml_backend_t, const float *, int64_t, int64_t, int64_t, int32_t *);
+typedef void (*spec_accept_fn)(ggml_backend_t, const ggml_spec_accept_params *);
+typedef void (*spec_walk_fn)(ggml_backend_t, const ggml_spec_walk_params *);
+typedef void (*spec_sample_fn)(ggml_backend_t, const ggml_spec_sample_params *);
+typedef void (*spec_write_fn)(ggml_backend_t, const ggml_spec_write_params *);
+typedef void (*spec_wdraft_fn)(ggml_backend_t, const ggml_spec_draft_params *);
+
+static int n_fail = 0;
+
+#define CHECK(cond, ...) do { if (!(cond)) { if (n_fail++ < 20) { fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); fprintf(stderr, __VA_ARGS__); fprintf(stderr, "\n"); } } } while (0)
+
+// device buffers through a ggml context, so the test needs no HIP/CUDA headers
+struct dev_bufs {
+    ggml_context *          ctx = nullptr;
+    ggml_backend_buffer_t   buf = nullptr;
+    std::vector<ggml_tensor *> t;
+
+    ggml_tensor * add(ggml_type type, int64_t n) {
+        if (!ctx) {
+            ggml_init_params ip = { 64 * ggml_tensor_overhead(), nullptr, true };
+            ctx = ggml_init(ip);
+        }
+        t.push_back(ggml_new_tensor_1d(ctx, type, n));
+        return t.back();
+    }
+    void alloc(ggml_backend_t backend) { buf = ggml_backend_alloc_ctx_tensors(ctx, backend); }
+    ~dev_bufs() {
+        if (buf) ggml_backend_buffer_free(buf);
+        if (ctx) ggml_free(ctx);
+    }
+};
+
+// the greedy sampler: the first strictly larger value wins
+static int32_t ref_argmax(const float * row, int64_t n) {
+    int32_t best = 0;
+    for (int64_t i = 1; i < n; ++i) {
+        if (row[i] > row[best]) {
+            best = (int32_t) i;
+        }
+    }
+    return best;
+}
+
+static void test_argmax(ggml_backend_t backend, spec_argmax_fn fn, std::mt19937 & rng) {
+    const int64_t n_rows = 12, n_cols = 248320, stride = n_cols + 64;
+    std::vector<float> x(n_rows * stride, 0.0f);
+    std::normal_distribution<float> nd(0.0f, 4.0f);
+    for (auto & v : x) v = nd(rng);
+    // plant ties, NaN and -inf
+    for (int64_t r = 0; r < n_rows; ++r) {
+        float * row = x.data() + r * stride;
+        const float top = 100.0f + r;
+        const int64_t a = (rng() % n_cols), b = (rng() % n_cols);
+        row[a] = top;
+        row[b] = top;
+        if (r % 3 == 0) row[rng() % n_cols] = NAN;
+        if (r % 4 == 1) row[rng() % n_cols] = -INFINITY;
+    }
+    // a row of -inf only
+    for (int64_t c = 0; c < n_cols; ++c) x[(n_rows - 1) * stride + c] = -INFINITY;
+
+    dev_bufs d;
+    ggml_tensor * tx = d.add(GGML_TYPE_F32, n_rows * stride);
+    ggml_tensor * to = d.add(GGML_TYPE_I32, n_rows);
+    d.alloc(backend);
+    ggml_backend_tensor_set(tx, x.data(), 0, ggml_nbytes(tx));
+    fn(backend, (const float *) tx->data, n_rows, n_cols, stride, (int32_t *) to->data);
+    ggml_backend_synchronize(backend);   // the launchers run on the backend stream; tensor_get does not wait for it
+    std::vector<int32_t> out(n_rows);
+    ggml_backend_tensor_get(to, out.data(), 0, ggml_nbytes(to));
+    for (int64_t r = 0; r < n_rows; ++r) {
+        const int32_t ref = ref_argmax(x.data() + r * stride, n_cols);
+        CHECK(out[r] == ref, "argmax row %lld: %d, reference %d", (long long) r, out[r], ref);
+    }
+}
+
+// the host path's acceptance (greedy), with the guard state kept as common_sampler keeps it
+struct ref_seq {
+    int32_t pos = 0, last = 0;
+    bool guard_in = false;
+    std::vector<int32_t> tail;
+};
+
+static bool ref_tail_matches(const std::vector<int32_t> & tail, const std::vector<int32_t> & tag) {
+    return !tag.empty() && tail.size() >= tag.size() && std::equal(tag.begin(), tag.end(), tail.end() - tag.size());
+}
+
+static std::vector<int32_t> ref_accept(ref_seq & s, const int32_t * target, const int32_t * draft, int n_draft,
+                                       const std::vector<int32_t> & eog, bool guard, int32_t end_tok,
+                                       const std::vector<int32_t> & start, const std::vector<std::vector<int32_t>> & ends,
+                                       const std::vector<int32_t> & stop = {}) {
+    auto is_eog = [&](int32_t id) { return std::binary_search(eog.begin(), eog.end(), id); };
+    auto sample = [&](int j) {
+        int32_t id = target[j];
+        if (guard && s.guard_in && is_eog(id)) {
+            id = end_tok;
+        }
+        return id;
+    };
+    auto accept = [&](int32_t id) {
+        if (!guard) return;
+        size_t n = start.size();
+        for (const auto & e : ends) n = std::max(n, e.size());
+        s.tail.push_back(id);
+        if (s.tail.size() > n) s.tail.erase(s.tail.begin(), s.tail.end() - n);
+        if (ref_tail_matches(s.tail, start)) s.guard_in = true;
+        for (const auto & e : ends) if (ref_tail_matches(s.tail, e)) s.guard_in = false;
+    };
+    std::vector<int32_t> result;
+    int i = 0;
+    for (; i < n_draft; i++) {
+        const int32_t id = sample(i);
+        accept(id);
+        result.push_back(id);
+        if (draft[i] != id || (is_eog(id) && i + 1 < n_draft)) {
+            break;
+        }
+        // FRANK_SPEC_TRIGGER_STOP: the step ends after a stop token (a lazy grammar's trigger)
+        if (std::find(stop.begin(), stop.end(), id) != stop.end()) {
+            i = -1;
+            break;
+        }
+    }
+    if (i == n_draft) {
+        const int32_t id = sample(i);
+        accept(id);
+        result.push_back(id);
+    }
+    s.last = result.back();
+    s.pos += (int32_t) result.size();
+    return result;
+}
+
+static void test_accept(ggml_backend_t backend, spec_accept_fn fn, std::mt19937 & rng) {
+    const int n_seq = 4096, n_rounds = 6;
+    const std::vector<int32_t> eog = { 2, 7, 9 };                 // ascending
+    const int32_t end_tok = 50;                                   // the guard's end tag token
+    const std::vector<int32_t> start = { 40, 41 };                // a two-token start tag
+    const std::vector<std::vector<int32_t>> ends = { { 50 }, { 51, 52, 53 } };
+
+    ggml_spec_guard g = {};
+    g.on = 1; g.end = end_tok;
+    g.n_start = (int32_t) start.size();
+    for (size_t j = 0; j < start.size(); ++j) g.start[j] = start[j];
+    g.n_ends = (int32_t) ends.size();
+    for (size_t e = 0; e < ends.size(); ++e) {
+        g.n_end[e] = (int32_t) ends[e].size();
+        for (size_t j = 0; j < ends[e].size(); ++j) g.ends[e][j] = ends[e][j];
+    }
+
+    // stop tokens (stage 5: a lazy grammar's triggers) on odd rounds, ascending
+    const std::vector<int32_t> stop_ids = { 41, 55 };
+    for (int n_row : { 1, 2, 6, 8, 16 }) {
+        const int n_draft = n_row - 1;
+        dev_bufs d;
+        ggml_tensor * tt = d.add(GGML_TYPE_I32, (int64_t) n_seq * n_row);
+        ggml_tensor * td = d.add(GGML_TYPE_I32, (int64_t) n_seq * std::max(n_draft, 1));
+        ggml_tensor * te = d.add(GGML_TYPE_I32, (int64_t) eog.size());
+        ggml_tensor * ts = d.add(GGML_TYPE_I8,  (int64_t) n_seq * sizeof(ggml_spec_seq));
+        ggml_tensor * tp = d.add(GGML_TYPE_I32, (int64_t) stop_ids.size());
+        d.alloc(backend);
+        ggml_backend_tensor_set(te, eog.data(), 0, ggml_nbytes(te));
+        ggml_backend_tensor_set(tp, stop_ids.data(), 0, ggml_nbytes(tp));
+
+        std::vector<ggml_spec_seq> dseq(n_seq);
+        std::vector<ref_seq> rseq(n_seq);
+        for (int s = 0; s < n_seq; ++s) {
+            memset(&dseq[s], 0, sizeof(dseq[s]));
+            dseq[s].pos = rseq[s].pos = 1000 + s;
+            rseq[s].guard_in = dseq[s].guard_in = (s % 2);
+        }
+        ggml_backend_tensor_set(ts, dseq.data(), 0, ggml_nbytes(ts));
+
+        for (int round = 0; round < n_rounds; ++round) {
+            // small token alphabet so drafts often agree, guard tags appear and EOG shows up
+            std::vector<int32_t> target((size_t) n_seq * n_row), draft((size_t) n_seq * std::max(n_draft, 1), -1);
+            for (int s = 0; s < n_seq; ++s) {
+                const int agree = (int) (rng() % (n_row + 1));
+                for (int j = 0; j < n_row; ++j) {
+                    const int pick = (int) (rng() % 16);
+                    int32_t tok = pick < 3 ? eog[pick] : pick < 5 ? 40 + (pick - 3) : pick < 8 ? 50 + (pick - 5) : 53 + (pick - 8);
+                    target[(size_t) s * n_row + j] = tok;
+                }
+                for (int j = 0; j < n_draft; ++j) {
+                    // the draft agrees with what the host would emit for the first `agree` rows
+                    int32_t t = target[(size_t) s * n_row + j];
+                    draft[(size_t) s * n_draft + j] = j < agree ? t : t + 1000;
+                }
+            }
+            ggml_backend_tensor_set(tt, target.data(), 0, ggml_nbytes(tt));
+            if (n_draft > 0) ggml_backend_tensor_set(td, draft.data(), 0, sizeof(int32_t) * (size_t) n_seq * n_draft);
+
+            ggml_spec_accept_params p = {};
+            p.target = (const int32_t *) tt->data;
+            p.draft  = (const int32_t *) td->data;
+            p.eog    = (const int32_t *) te->data;
+            p.n_eog  = (int32_t) eog.size();
+            p.n_seq  = n_seq;
+            p.n_row  = n_row;
+            p.guard  = g;
+            p.seq    = (ggml_spec_seq *) ts->data;
+            const bool with_stop = round % 2 == 1;
+            p.stop   = (const int32_t *) tp->data;
+            p.n_stop = with_stop ? (int32_t) stop_ids.size() : 0;
+            fn(backend, &p);
+            ggml_backend_synchronize(backend);   // the launchers run on the backend stream; tensor_get does not wait for it
+            ggml_backend_tensor_get(ts, dseq.data(), 0, ggml_nbytes(ts));
+
+            for (int s = 0; s < n_seq; ++s) {
+                // both compare the drafts with the token after the guard's rewrite
+                const auto ref = ref_accept(rseq[s], &target[(size_t) s * n_row], n_draft > 0 ? &draft[(size_t) s * n_draft] : nullptr,
+                                            n_draft, eog, true, end_tok, start, ends, with_stop ? stop_ids : std::vector<int32_t>());
+                const ggml_spec_seq & ds = dseq[s];
+                bool same = ds.n_emit == (int32_t) ref.size() && ds.pos == rseq[s].pos && ds.last == rseq[s].last &&
+                            (ds.guard_in != 0) == rseq[s].guard_in;
+                for (size_t j = 0; same && j < ref.size(); ++j) same = ds.emit[j] == ref[j];
+                CHECK(same, "accept n_row %d round %d seq %d: n_emit %d/%zu pos %d/%d guard %d/%d",
+                      n_row, round, s, ds.n_emit, ref.size(), ds.pos, rseq[s].pos, ds.guard_in, (int) rseq[s].guard_in);
+                bool eog_ref = false;
+                for (int32_t t : ref) eog_ref |= std::binary_search(eog.begin(), eog.end(), t);
+                CHECK((ds.eog != 0) == eog_ref, "accept eog flag n_row %d seq %d", n_row, s);
+            }
+        }
+    }
+}
