+    std::vector<int32_t> v(ids.begin(), ids.end());
+    std::sort(v.begin(), v.end());
+    if (!v.empty()) {
+        ggml_backend_tensor_set(a->t_stop, v.data(), GGML_SPEC_MAX_STOP * sizeof(int32_t), v.size() * sizeof(int32_t));
+    }
+    a->n_stop1 = (int32_t) v.size();
+    a->stop_host[1] = v;
+    return true;
+}
