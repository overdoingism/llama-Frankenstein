+//
+// 1b: temperature
+//
+
+// common_sampler's default chain on one row (llama_sampler_top_k / top_p / min_p / temp / dist): the candidates in
+// logit order (a tie to the lower id), their probabilities and the token drawn with u
+struct ref_sampled {
+    std::vector<int32_t> id;
+    std::vector<float>   p;
+    int32_t              sampled = -1;
+};
+
+static ref_sampled ref_sample(const float * row, int64_t n_vocab, const ggml_spec_chain & ch, double u) {
+    std::vector<std::pair<float, int32_t>> c(n_vocab);
+    for (int64_t i = 0; i < n_vocab; ++i) {
+        const float v = row[i];
+        c[i] = { v != v ? -INFINITY : v, (int32_t) i };
+    }
+    const int k = (int) std::min<int64_t>(ch.top_k, n_vocab);
+    std::partial_sort(c.begin(), c.begin() + k, c.end(), [](const auto & a, const auto & b) {
+        return a.first > b.first || (a.first == b.first && a.second < b.second);
+    });
+    int n = k;
+    std::vector<float> l(k);
+    for (int t = 0; t < k; ++t) l[t] = c[t].first;
+    if (ch.top_p < 1.0f) {
+        std::vector<float> pp(n);
+        float cum = 0.0f;
+        for (int t = 0; t < n; ++t) { pp[t] = expf(l[t] - l[0]); cum += pp[t]; }
+        for (int t = 0; t < n; ++t) pp[t] /= cum;
+        float cs = 0.0f;
+        int last = n;
+        for (int t = 0; t < n; ++t) {
+            cs += pp[t];
+            if (cs >= ch.top_p && t + 1 >= ch.min_keep) { last = t + 1; break; }
+        }
+        n = last;
+    }
+    if (ch.min_p > 0.0f) {
+        const float min_logit = l[0] + logf(ch.min_p);
+        int t = 1;
+        for (; t < n; ++t) if (l[t] < min_logit && t >= ch.min_keep) break;
+        n = t;
+    }
+    for (int t = 0; t < n; ++t) l[t] /= ch.temp;
+    ref_sampled r;
+    r.p.resize(n);
+    int sel = n - 1;
+    if (n == 1) {
+        r.p[0] = 1.0f;
+        sel = 0;
+    } else {
+        std::vector<float> pr(n);
+        double sum_cum = 0.0;
+        for (int t = 0; t < n; ++t) { pr[t] = expf(l[t] - l[0]); sum_cum += pr[t]; }
+        const double sum_tgt = sum_cum * u;
+        double sum_run = 0.0;
+        bool found = false;
+        for (int t = 0; t < n; ++t) {
+            if (!found) { sum_run += pr[t]; if (sum_run >= sum_tgt) { sel = t; found = true; } }
+            r.p[t] = (float) (pr[t] / sum_cum);
+        }
+    }
+    for (int t = 0; t < n; ++t) r.id.push_back(c[t].second);
+    r.sampled = c[sel].second;
+    return r;
+}
+
+static void test_sample(ggml_backend_t backend, spec_sample_fn fn, std::mt19937 & rng) {
+    const int64_t n_rows = 16, n_vocab = 248320, stride = n_vocab + 32;
+    std::vector<float> x(n_rows * stride);
+    std::normal_distribution<float> nd(0.0f, 2.0f);
+    for (int64_t r = 0; r < n_rows; ++r) {
+        float * row = x.data() + r * stride;
+        for (int64_t i = 0; i < n_vocab; ++i) row[i] = nd(rng);
+        // a few clear leaders, some exact ties among them, a NaN and -inf
+        for (int t = 0; t < 30; ++t) row[rng() % n_vocab] = 8.0f + (float) (rng() % 12) * 0.25f;
+        row[rng() % n_vocab] = NAN;
+        row[rng() % n_vocab] = -INFINITY;
+        if (r % 4 == 3) {   // one token far ahead: top_p keeps it alone
+            row[rng() % n_vocab] = 40.0f;
+        }
+        if (r == 5) {       // every logit equal: the radix select leaves ties at the k-th key, the lowest ids win
+            for (int64_t i = 0; i < n_vocab; ++i) row[i] = 1.0f;
+        }
+    }
+    const ggml_spec_chain chains[] = {
+        { 40, 0.95f, 0.05f, 0, 1.0f },
+        { 64, 1.00f, 0.00f, 0, 0.7f },
+        { 20, 0.50f, 0.10f, 0, 1.3f },
+        { 1,  0.95f, 0.05f, 0, 1.0f },
+        { 40, 0.95f, 0.05f, 3, 0.8f },
+    };
+    std::uniform_real_distribution<double> ud(0.0, 1.0);
+    int n_checked = 0;
+    for (const auto & ch : chains) {
+        for (int round = 0; round < 4; ++round) {
+            std::vector<double> u(n_rows);
+            for (auto & v : u) v = ud(rng);
+            dev_bufs d;
+            ggml_tensor * tx = d.add(GGML_TYPE_F32, (int64_t) x.size());
+            ggml_tensor * tu = d.add(GGML_TYPE_I8,  n_rows * (int64_t) sizeof(double));
+            ggml_tensor * tn = d.add(GGML_TYPE_I32, n_rows);
+            ggml_tensor * ti = d.add(GGML_TYPE_I32, n_rows * GGML_SPEC_MAX_K);
+            ggml_tensor * tp = d.add(GGML_TYPE_F32, n_rows * GGML_SPEC_MAX_K);
+            ggml_tensor * ts = d.add(GGML_TYPE_I32, n_rows);
+            d.alloc(backend);
+            ggml_backend_tensor_set(tx, x.data(), 0, ggml_nbytes(tx));
+            ggml_backend_tensor_set(tu, u.data(), 0, ggml_nbytes(tu));
+            ggml_spec_sample_params p = {};
+            p.logits = (const float *) tx->data;
+            p.n_rows = n_rows; p.n_vocab = n_vocab; p.row_stride = stride;
+            p.chain  = ch;
+            p.u      = (const double *) tu->data;
+            p.n_cand = (int32_t *) tn->data; p.cand_id = (int32_t *) ti->data; p.cand_p = (float *) tp->data; p.sampled = (int32_t *) ts->data;
+            fn(backend, &p);
+            ggml_backend_synchronize(backend);
+            std::vector<int32_t> nc(n_rows), ids(n_rows * GGML_SPEC_MAX_K), smp(n_rows);
+            std::vector<float> pp(n_rows * GGML_SPEC_MAX_K);
+            ggml_backend_tensor_get(tn, nc.data(), 0, ggml_nbytes(tn));
+            ggml_backend_tensor_get(ti, ids.data(), 0, ggml_nbytes(ti));
+            ggml_backend_tensor_get(tp, pp.data(), 0, ggml_nbytes(tp));
+            ggml_backend_tensor_get(ts, smp.data(), 0, ggml_nbytes(ts));
+            for (int64_t r = 0; r < n_rows; ++r) {
+                const ref_sampled ref = ref_sample(x.data() + r * stride, n_vocab, ch, u[r]);
+                bool same = nc[r] == (int32_t) ref.id.size() && smp[r] == ref.sampled;
+                float max_dp = 0.0f;
+                for (size_t t = 0; same && t < ref.id.size(); ++t) {
+                    same = ids[r * GGML_SPEC_MAX_K + t] == ref.id[t];
+                    max_dp = std::max(max_dp, std::fabs(pp[r * GGML_SPEC_MAX_K + t] - ref.p[t]));
+                }
+                CHECK(same && max_dp <= 1e-6f, "sample top_k %d top_p %.2f min_p %.2f temp %.1f row %lld: n %d/%zu sampled %d/%d max |dp| %g",
+                      ch.top_k, ch.top_p, ch.min_p, ch.temp, (long long) r, nc[r], ref.id.size(), smp[r], ref.sampled, max_dp);
+                n_checked++;
+            }
+        }
+    }
+    printf("  sample: %d rows checked\n", n_checked);
+}
+
+// the DFlash2 branch of common_speculative_draft() with a temperature
+static std::vector<int32_t> ref_walk_sample(const float * block, int64_t n_embd, int top_k, int n_draft, float temp, const double * u,
+                                            std::vector<int32_t> & q_id, std::vector<float> & q_p) {
+    std::vector<int32_t> out;
+    int32_t pred = 0;
+    for (int i = 1; i <= n_draft; ++i) {
+        const float * row = block + (int64_t) i * n_embd;
+        const float * scores = row + top_k + (int64_t) pred * top_k;
+        pred = (int32_t) std::distance(scores, std::max_element(scores, scores + top_k));
+        std::vector<float> probs(top_k);
+        float sum = 0.0f;
+        for (int k = 0; k < top_k; ++k) { probs[k] = std::exp((scores[k] - scores[pred]) / temp); sum += probs[k]; }
+        for (int k = 0; k < top_k; ++k) probs[k] /= sum;
+        std::vector<int32_t> sorted_idx(top_k);
+        for (int k = 0; k < top_k; ++k) sorted_idx[k] = k;
+        std::sort(sorted_idx.begin(), sorted_idx.end(), [row](int32_t a, int32_t b) { return row[a] < row[b]; });
+        double uu = u[i - 1];
+        for (const int32_t k : sorted_idx) { uu -= probs[k]; if (uu < 0.0) { pred = k; break; } }
+        for (int k = 0; k < top_k; ++k) { q_id.push_back((int32_t) row[k]); q_p.push_back(probs[k]); }
+        out.push_back((int32_t) row[pred]);
+    }
+    return out;
+}
