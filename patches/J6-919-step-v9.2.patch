+const float * llama_context::step_logits_device(int32_t i, int64_t * n_vocab, int64_t * row_stride) {
+    output_reorder();
+    if (step_logits_t == nullptr || step_logits_t->buffer == nullptr || ggml_backend_buffer_is_host(step_logits_t->buffer)) {
+        return nullptr;
+    }
+    const int64_t j = output_resolve_row(i) - step_logits_row0;
+    if (j < 0 || j >= step_logits_t->ne[1]) {
+        return nullptr;   // the row is in an earlier ubatch of the batch
+    }
+    if (n_vocab) {
+        *n_vocab = step_logits_t->ne[0];
+    }
+    if (row_stride) {
+        *row_stride = (int64_t) (step_logits_t->nb[1] / sizeof(float));
+    }
+    return (const float *) ((const char *) step_logits_t->data + j*step_logits_t->nb[1]);
+}
+
+const float * llama_context::step_nextn_device(int64_t * n_embd, int64_t * n_rows) const {
+    if (step_nextn_t == nullptr || step_nextn_t->buffer == nullptr || ggml_backend_buffer_is_host(step_nextn_t->buffer)) {
+        return nullptr;
+    }
+    if (n_embd) {
+        *n_embd = step_nextn_t->ne[0];
+    }
+    if (n_rows) {
+        *n_rows = step_nextn_t->ne[1];
+    }
+    return (const float *) step_nextn_t->data;
+}
