+bool common_speculative_loop_fit(const common_speculative * spec, const char ** why) {
+    const char * r = nullptr;
+    bool dflash = false;
+    if (spec == nullptr) {
+        r = "no drafter";
+    } else {
+        for (const auto & impl : spec->impls) {
+            if (impl->type == COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH2) {
+                dflash = true;
+            } else if (impl->type == COMMON_SPECULATIVE_TYPE_NGRAM_MOD) {
+                const auto * ng = dynamic_cast<const common_speculative_impl_ngram_mod *>(impl.get());
+                if (ng == nullptr || ng->mods.empty()) {
+                    r = "ngram-mod without its per-request prompt table";
+                    break;
+                }
+                if (dflash) {
+                    r = "ngram-mod behind DFlash2";
+                    break;
+                }
+            } else {
+                r = "a drafter besides ngram-mod and DFlash2";
+                break;
+            }
+        }
+        if (r == nullptr && !dflash) {
+            r = "no DFlash2 drafter";
+        }
+    }
+    if (why) {
+        *why = r;
+    }
+    return r == nullptr;
+}
