+    }
+    const uint16_t * hd_mask = (const uint16_t *) llama_step_input_host(cd, "attn_inp_kq_mask#0");
+    const int32_t  * hd_rows = (const int32_t *)  llama_step_input_host(cd, "dflash_inp_rows#0");
+    const int32_t  * hd_tok  = (const int32_t *)  llama_step_input_host(cd, "dflash_inp_tokens#0");
+    if (!hd_mask || !hd_rows || !hd_tok) {
