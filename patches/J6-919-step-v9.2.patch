     ggml_backend_cuda_buffer_context(int device, void * dev_ptr) :
@@ -1841,6 +1845,10 @@ struct ggml_backend_cuda_buffer_context {
             ggml_cuda_slab_work_release(device, slab_off, slab_need);   // the slab owns the region; the slack may go to the arena
             return;
         }
+        if (host_mapped != nullptr) {
+            CUDA_CHECK(cudaFreeHost(host_mapped));
