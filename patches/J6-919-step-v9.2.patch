+int32_t llama_kv_cache::step_cell_free(int32_t * holes, int32_t n_max, int32_t * top, int32_t * head) const {
+    if (n_stream != 1) {
+        return -1;
+    }
+    const auto &   cells = v_cells[0];
+    const uint32_t t     = parked.empty() ? cells.used_max_p1() : cells.used_max_p1_below(park_bound());
