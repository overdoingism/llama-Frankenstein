+    if (ids.size() > GGML_SPEC_MAX_STOP) {
+        a->n_stop = 0;
+        return false;
+    }
+    std::vector<int32_t> v(ids.begin(), ids.end());
+    std::sort(v.begin(), v.end());
+    if (!v.empty()) {
+        ggml_backend_tensor_set(a->t_stop, v.data(), 0, v.size() * sizeof(int32_t));
+    }
+    a->n_stop = (int32_t) v.size();
+    a->stop_host[0] = v;
+    return true;
+}
+
+bool common_step_audit_set_stop1(common_step_audit * a, const std::vector<llama_token> & ids) {
