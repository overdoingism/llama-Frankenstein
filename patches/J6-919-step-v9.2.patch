+
+void common_step_audit_after_draft(common_step_audit * a, llama_context * ctx_dft, bool block,
+                                   const llama_tokens & host_draft, int32_t top_k) {
+    if (a == nullptr || ctx_dft == nullptr || a->arm_draft < 0) {
+        return;
+    }
+    a->arm_draft = -1;
+    if (!a->seq_ok) {
+        return;
+    }
+    ggml_spec_seq s;
+    ggml_backend_tensor_get(a->t_seq, &s, 0, sizeof(s));
+    const int32_t * h_pos = (const int32_t *) llama_step_input_host(ctx_dft, "inp_pos#0");
+    const int64_t * h_k   = (const int64_t *) llama_step_input_host(ctx_dft, "attn_inp_k_idxs#0");
+    if (h_pos == nullptr || h_k == nullptr) {
+        return;
+    }
+    // the drafter's cell offset (its cache is a ring of n_cells): kept while it follows the host, taken again otherwise
+    const int64_t n_cells = llama_step_swa_size(ctx_dft);
+    if (n_cells <= 0) {
+        return;
+    }
+    auto ring = [&](int64_t p) { return (int64_t) s.dcell_off + (p % n_cells + n_cells) % n_cells; };
+    if (!a->dft_ok || h_k[0] != ring(h_pos[0])) {
+        if (a->dft_ok) {
+            a->n_dft_resync++;
+        }
+        s.dcell_off = (int32_t) (h_k[0] - (h_pos[0] % n_cells + n_cells) % n_cells);
+        ggml_backend_tensor_set(a->t_seq, &s, 0, sizeof(s));
+        a->dft_ok = true;
+    }
+    if (!block) {
+        return;
+    }
+    // stage 5: the drafter's first position, from the host's mask: row 0 sees every position from it (or from the window's
+    // start) to the block's last one
+    {
+        const uint16_t * h_mask = (const uint16_t *) llama_step_input_host(ctx_dft, "attn_inp_kq_mask#0");
+        if (h_mask && a->n_kv_dft > 0 && a->n_row_dft > 0) {
+            int64_t cnt0 = 0;
+            for (int64_t j = 0; j < a->n_kv_dft; ++j) {
+                cnt0 += h_mask[j] == 0x0000;
+            }
+            const int32_t lo0 = (int32_t) ((int64_t) h_pos[0] + a->n_row_dft - cnt0);
+            if (lo0 != s.dpos_min) {
+                s.dpos_min = lo0;
+                ggml_backend_tensor_set(a->t_seq, &s, 0, sizeof(s));
+            }
+        }
+    }
+    // the block's mask token and window, from the host's first block
+    if (a->mask_token < 0) {
+        const int32_t  * h_tok  = (const int32_t *)  llama_step_input_host(ctx_dft, "dflash_inp_tokens#0");
+        const uint16_t * h_mask = (const uint16_t *) llama_step_input_host(ctx_dft, "attn_inp_kq_mask#0");
+        const int64_t n_kv = a->n_kv_dft;   // the shadow has no shape: the callback recorded it
+        if (h_tok && h_mask && host_draft.size() >= 1 && n_kv > 0) {
+            // row 0 sees min(window, pos - pos_min + 1) cells of the history and the block's other rows
+            int64_t cnt = 0;
+            for (int64_t j = 0; j < n_kv; ++j) {
+                cnt += h_mask[j] == 0x0000;
+            }
+            const int64_t n_row = a->n_row_dft;
+            const int64_t hist  = cnt - (n_row - 1);
+            if (hist < (int64_t) h_pos[0] - s.pos_min + 1) {
+                a->window     = (int32_t) hist;
+                a->mask_token = h_tok[1];
+            }
+        }
+    }
+    // the device walk over the lattice, against the host's drafts
+    int64_t n_embd = 0, n_rows = 0;
+    const float * lat = llama_step_nextn_device(ctx_dft, &n_embd, &n_rows);
+    if (lat == nullptr || a->walk == nullptr || host_draft.empty() || n_rows < 2 || top_k <= 0) {
+        return;
+    }
+    ggml_spec_walk_params wp = {};
+    wp.lattice = lat;
+    wp.n_embd  = n_embd;
+    wp.n_block = (int32_t) n_rows;
+    wp.top_k   = top_k;
+    wp.n_draft = (int32_t) std::min<int64_t>((int64_t) host_draft.size(), n_rows - 1);
+    wp.n_seq   = 1;
+    wp.draft   = (int32_t *) a->t_walk->data;
+    a->walk(a->backend, &wp);
+    ggml_backend_synchronize(a->backend);
+    std::vector<int32_t> dev(wp.n_draft);
+    ggml_backend_tensor_get(a->t_walk, dev.data(), 0, dev.size() * sizeof(int32_t));
+    bool same = true;
+    for (int j = 0; j < wp.n_draft; ++j) {
+        same = same && dev[j] == host_draft[j];
+    }
+    a->n_walks++;
+    a->walk_same = same;
+    if (!same && a->n_walk_bad++ < 10) {
+        std::string d, h;
+        for (int j = 0; j < wp.n_draft; ++j) {
+            d += std::to_string(dev[j]) + " ";
+            h += std::to_string(host_draft[j]) + " ";
+        }
+        LOG_WRN("%s: walk %lld differs: device [%s], host [%s]\n", __func__, (long long) a->n_walks, d.c_str(), h.c_str());
+    }
+    if (a->n_walks % 64 == 0 && step_audit_reports()) {
+        LOG_WRN("%s: %lld walks checked, %lld differ; drafter state taken again %lld times, %lld drafter input writes\n",
+                __func__, (long long) a->n_walks, (long long) a->n_walk_bad, (long long) a->n_dft_resync, (long long) a->n_dft_writes);
+    }
+}
+
+//
+// Part B: the GPU-resident loop
+//
+
+static bool step_loop_env() {
+    static const bool on = llama_step_loop_enabled();
+    return on;
+}
+
+bool common_step_loop_ready(const common_step_audit * a) {
+    return a != nullptr && step_loop_env() && a->ready && !a->loop_on && a->ctx_dft != nullptr;
+}
+
+// FRANK_STEP_DEBUG's level, read once
+static int step_debug_level() {
+    static const int lvl = [] {
+        const char * e = getenv("FRANK_STEP_DEBUG");
+        return e ? atoi(e) : 0;
+    }();
+    return lvl;
+}
+
+static bool step_loop_fail(common_step_audit * a, const char * why) {
+    // each reason once, then quiet: the host path simply goes on (FRANK_STEP_DEBUG=2: every time)
+    static std::set<std::string> seen;
+    if (step_debug_level() >= 2) {
+        LOG_WRN("%s: the loop cannot start: %s\n", __func__, why);
+    } else if (seen.insert(why).second) {
+        LOG_INF("%s: the loop cannot start: %s (logged once)\n", __func__, why);
+    }
+    a->ready = false;
+    return false;
+}
+
+// a graph's own slab input, of n0 x n1 elements (-1: any); ne gets its shape
+static void * step_loop_input(llama_context * ctx, int32_t which, const char * key, int64_t n0, int64_t n1, int64_t * ne_out = nullptr) {
+    int64_t ne[4] = { 0, 0, 0, 0 };
+    void * p = llama_step_graph_input(ctx, which, key, ne);
+    if (p == nullptr || (n0 >= 0 && ne[0] != n0) || (n1 >= 0 && ne[1] != n1) || ne[2] != 1 || ne[3] != 1) {
+        return nullptr;
+    }
+    if (ne_out) {
+        memcpy(ne_out, ne, sizeof(ne));
+    }
+    return p;
+}
+
+// fill a host stream's ring up to `upto` draws, in chunks, without writing over the draws from `used` on
+static bool step_ring_fill(common_step_audit * a, step_draw_ring & r, int which, int64_t upto, int64_t used,
+                           common_sampler * smpl, llama_seq_id seq_id) {
+    std::vector<double> buf;
+    while (r.filled < upto) {
+        int64_t chunk = std::min<int64_t>(2048, r.n / 4);
+        if (which == 2) {
+            chunk = chunk / a->lp_walk.n_draft * a->lp_walk.n_draft;   // the drafter's: whole steps
+        }
+        if (chunk <= 0 || r.filled + chunk > used + r.n) {
+            return false;
+        }
+        buf.resize(chunk);
+        bool ok = true;
+        if (which == 0) {
+            ok = common_sampler_dist_peek(smpl, (uint64_t) r.filled, buf.data(), (int32_t) chunk);
+        } else if (which == 1) {
+            common_sampler_rng_peek(smpl, (uint64_t) r.filled, buf.data(), (int32_t) chunk);
+        } else {
+            ok = common_speculative_rng_peek(a->spec, seq_id, (uint64_t) r.filled, buf.data(), (int32_t) chunk);
+        }
+        if (!ok) {
+            return false;
+        }
+        const int64_t off = r.filled % r.n;
+        const int64_t n1  = std::min(chunk, r.n - off);
+        ggml_backend_tensor_set(r.t, buf.data(), off * sizeof(double), n1 * sizeof(double));
+        if (n1 < chunk) {
+            ggml_backend_tensor_set(r.t, buf.data() + n1, 0, (chunk - n1) * sizeof(double));
+        }
+        r.filled += chunk;
+    }
+    return true;
+}
+
+// keep the rings ahead of the steps in flight and the one about to be issued
+static bool step_loop_refill(common_step_audit * a) {
+    const int64_t W        = a->n_row;
+    const int64_t ahead    = W * (a->n_issued - a->n_done + 2);
+    const int64_t emitted  = a->pos_known[0] - a->pos0;
+    const int64_t n_draft  = a->lp_walk.n_draft;
+    if (a->cells_mode) {
+        // common_step_loop_begin2(): each sequence with a temperature has its own three streams
+        bool ok = true;
+        for (int k = 0; k < a->n_seq && ok; ++k) {
+            if (!a->temp_k[k]) {
+                continue;
+            }
+            common_sampler * sm  = k == 0 ? a->smpl   : a->smpl1;
+            llama_seq_id     sid = k == 0 ? a->seq_id : a->seq_id1;
+            const int64_t    em  = a->pos_known[k] - (k == 0 ? a->pos0 : a->pos0_1);
+            const int64_t    nr  = k == 0 ? a->n_rng_known : a->n_rng_known1;
+            ok = step_ring_fill(a, k == 0 ? a->r_dist : a->r_dist1, 0, em + ahead + 2048, em, sm, sid) &&
+                 step_ring_fill(a, k == 0 ? a->r_rng  : a->r_rng1,  1, nr + ahead + 2048, nr, sm, sid) &&
+                 step_ring_fill(a, k == 0 ? a->r_walk : a->r_walk1, 2, (a->n_issued + 2) * n_draft + 1024, a->n_done * n_draft, sm, sid);
+        }
+        return ok;
+    }
+    return step_ring_fill(a, a->r_dist, 0, emitted + ahead + 2048, emitted, a->smpl, a->seq_id) &&
+           step_ring_fill(a, a->r_rng,  1, a->n_rng_known + ahead + 2048, a->n_rng_known, a->smpl, a->seq_id) &&
+           step_ring_fill(a, a->r_walk, 2, (a->n_issued + 2) * n_draft + 1024, a->n_done * n_draft, a->smpl, a->seq_id);
+}
+
+void common_step_loop_advance2(common_step_audit * a, int k, int64_t emitted, int64_t n_rng, int64_t n_steps) {
+    if (a == nullptr || !a->cells_mode || k < 0 || k >= a->n_seq || !a->temp_k[k]) {
+        return;
+    }
+    common_sampler * sm = k == 0 ? a->smpl : a->smpl1;
+    common_sampler_dist_advance(sm, (uint64_t) emitted);
+    common_sampler_rng_advance(sm, (uint64_t) n_rng);
+    common_speculative_rng_advance(a->spec, k == 0 ? a->seq_id : a->seq_id1, (uint64_t) (n_steps * a->lp_walk.n_draft));
+}
+
+void common_step_loop_advance(common_step_audit * a, int64_t emitted, int64_t n_rng, int64_t n_steps) {
+    if (a == nullptr || !a->temp_mode || a->cells_mode) {
+        return;
+    }
+    common_sampler_dist_advance(a->smpl, (uint64_t) emitted);
+    common_sampler_rng_advance(a->smpl, (uint64_t) n_rng);
+    common_speculative_rng_advance(a->spec, a->seq_id, (uint64_t) (n_steps * a->lp_walk.n_draft));
+}
+
+bool common_step_loop_begin(common_step_audit * a, llama_seq_id seq_id, const common_rguard_view & guard, int32_t top_k,
+                            int32_t n_draft, int32_t pos_max, llama_pos pos, llama_token last, bool no_eog,
+                            const common_step_loop_temp * temp, int32_t pos_start_max) {
+    if (!common_step_loop_ready(a)) {
+        return false;
+    }
+    if (no_eog && a->suppress == nullptr) {
+        return step_loop_fail(a, "no suppress launcher for ignore_eos");
+    }
+    a->no_eog = no_eog;
+    llama_context * ct = a->ctx_tgt;
+    llama_context * cd = a->ctx_dft;
+    const int32_t W = n_draft + 1;
+    if (W < 2 || W > GGML_SPEC_MAX_ROW || top_k <= 0) {
+        return step_loop_fail(a, "width");
+    }
+    if (a->backend_d == nullptr) {
+        a->backend_d = llama_step_backend(cd);
+    }
+    if (a->backend_d == nullptr || a->write == nullptr || a->wdraft == nullptr || a->walk == nullptr) {
+        return step_loop_fail(a, "no drafter backend or launchers");
+    }
+
+    // the target's verify graph: its inputs and logits
+    int64_t ne[4] = { 0, 0, 0, 0 };
+    ggml_spec_write_params & w = a->lp_write;
+    w = {};
+    w.tokens  = (int32_t *)  step_loop_input(ct, 0, "inp_tokens#0", W, 1);
+    w.pos     = (int32_t *)  step_loop_input(ct, 0, "inp_pos#0", -1, 1, ne);
+    w.n_pos_sections = (int32_t) (ne[0] / W);
+    w.k_idxs  = (int64_t *)  step_loop_input(ct, 0, "attn_inp_k_idxs#0", W, 1);
+    w.v_idxs  = (int64_t *)  step_loop_input(ct, 0, "attn_inp_v_idxs#0", W, 1);
+    w.kq_mask = (uint16_t *) step_loop_input(ct, 0, "attn_inp_kq_mask#0", -1, W, ne);
+    w.n_kv    = ne[0];
+    if (!w.tokens || !w.pos || !w.k_idxs || !w.v_idxs || !w.kq_mask || (w.n_pos_sections != 1 && w.n_pos_sections != 4)) {
+        return step_loop_fail(a, "the target's last graph is not a verify of this width");
+    }
+    if (a->rs_size > 0) {
+        w.rs_size    = a->rs_size;
+        w.rs_replay_all = a->rs_replay_all;
+        w.rs_s_copy  = (int32_t *) step_loop_input(ct, 0, "rs_s_copy#0",    1, 1);
+        w.rs_rows    = (int32_t *) step_loop_input(ct, 0, "rs_a_rows#0",    1, 1);
+        w.rs_replay  = (int32_t *) step_loop_input(ct, 0, "rs_a_replay#0",  1, 1);
+        w.rs_fac_src = (int32_t *) step_loop_input(ct, 0, "rs_a_fac_src#0", 1, 1);
+        w.rs_fac_dst = (int32_t *) step_loop_input(ct, 0, "rs_a_fac_dst#0", 1, 1);
+        if (!w.rs_s_copy || !w.rs_rows || !w.rs_replay || !w.rs_fac_src || !w.rs_fac_dst) {
+            return step_loop_fail(a, "the verify graph lacks the recurrent inputs");
+        }
+    }
+    w.seq   = (ggml_spec_seq *) a->t_seq->data;
+    w.draft = (const int32_t *) a->t_walk->data;
+    w.n_seq = 1;
+    w.n_row = W;
+    // the sequence's cells as the host has them: the mask follows these, not one run of cells (two requests that overlapped
+    // leave their cells interleaved, and the other one's stay after it ends)
+    {
+        if (a->t_cpos == nullptr || a->cpos_stride < w.n_kv) {
+            if (a->cpos_buf) {
+                ggml_backend_buffer_free(a->cpos_buf);
+                a->cpos_buf = nullptr;
+            }
+            if (a->cpos_ctx) {
+                ggml_free(a->cpos_ctx);
+            }
+            ggml_init_params ip = { 2 * ggml_tensor_overhead(), nullptr, true };   // t_cpos and t_free
+            a->cpos_ctx = ggml_init(ip);
+            a->cpos_stride = std::max<int64_t>(w.n_kv, 65536);
+            a->t_cpos   = ggml_new_tensor_1d(a->cpos_ctx, GGML_TYPE_I32, GGML_SPEC_MAX_SEQ * a->cpos_stride);
+            a->t_free   = ggml_new_tensor_1d(a->cpos_ctx, GGML_TYPE_I32, a->cpos_stride);
+            a->cpos_buf = ggml_backend_alloc_ctx_tensors(a->cpos_ctx, a->backend);
+            if (a->cpos_buf == nullptr) {
+                a->t_cpos = nullptr;
+                a->cpos_stride = 0;
+                return step_loop_fail(a, "no memory for the cell positions");
+            }
+        }
+        std::vector<int32_t> cp(w.n_kv);
+        if (llama_step_cell_pos(ct, seq_id, cp.data(), w.n_kv) != (int32_t) w.n_kv) {
+            return step_loop_fail(a, "the target's cell positions");
+        }
+        ggml_backend_tensor_set(a->t_cpos, cp.data(), 0, cp.size() * sizeof(int32_t));
+        w.cell_pos = (int32_t *) a->t_cpos->data;
+    }
+    int64_t ne2[2] = { 0, 0 };
+    a->logits = llama_step_graph_output(ct, 0, 0, ne2, &a->logits_stride);
+    a->n_vocab = ne2[0];
+    if (a->logits == nullptr || ne2[1] != W) {
+        return step_loop_fail(a, "the verify graph's logits");
+    }
+
+    // the drafter's injection (its scheduler's graph) and block (the second scheduler's)
+    const int32_t n_cells = llama_step_swa_size(cd);
+    ggml_spec_draft_params & di = a->lp_inject;
+    ggml_spec_draft_params & db = a->lp_block;
+    di = {};
+    db = {};
+    for (ggml_spec_draft_params * d : { &di, &db }) {
+        const int32_t which = d == &db ? 1 : 0;
+        d->seq        = (const ggml_spec_seq *) a->t_seq->data;
+        d->mode       = which ? GGML_SPEC_DRAFT_BLOCK : GGML_SPEC_DRAFT_INJECT;
+        d->n_row      = W;
+        d->mask_token = a->mask_token;
+        d->window     = a->window;
+        d->n_cells    = n_cells;
+        d->pos        = (int32_t *) step_loop_input(cd, which, "inp_pos#0", -1, 1, ne);
+        d->n_pos_sections = (int32_t) (ne[0] / W);
+        d->k_idxs     = (int64_t *) step_loop_input(cd, which, "attn_inp_k_idxs#0", W, 1);
+        d->v_idxs     = (int64_t *) step_loop_input(cd, which, "attn_inp_v_idxs#0", W, 1);
+        if (which) {
+            d->tokens  = (int32_t *)  step_loop_input(cd, 1, "dflash_inp_tokens#0", W, 1);
+            d->kq_mask = (uint16_t *) step_loop_input(cd, 1, "attn_inp_kq_mask#0", -1, W, ne);
+            d->n_kv    = ne[0];
+            d->mask_ring = d->n_kv <= n_cells ? 1 : 0;   // the attention covers only the ring (llama_kv_cache::get_kv_start())
+        } else {
+            d->rows    = (int32_t *)  step_loop_input(cd, 0, "dflash_inp_rows#0", W, 1);
+        }
+        if (!d->pos || !d->k_idxs || !d->v_idxs || (d->n_pos_sections != 1 && d->n_pos_sections != 4) ||
+            (which ? (!d->tokens || !d->kq_mask) : !d->rows) || n_cells <= 0) {
+            return step_loop_fail(a, which ? "the drafter's last block is not of this width" : "the drafter's last injection is not of this width");
+        }
+    }
+    ggml_spec_walk_params & wk = a->lp_walk;
+    wk = {};
+    wk.lattice = llama_step_graph_output(cd, 1, 1, ne2, nullptr);
+    wk.n_embd  = ne2[0];
+    wk.n_block = W;
+    wk.top_k   = top_k;
+    wk.n_draft = n_draft;
+    wk.n_seq   = 1;
+    wk.draft   = (int32_t *) a->t_walk->data;
+    if (wk.lattice == nullptr || ne2[1] != W) {
+        return step_loop_fail(a, "the block's lattice");
+    }
+
+    ggml_spec_accept_params & ac = a->lp_accept;
+    ac = {};
+    if (!fill_guard(ac.guard, guard)) {
+        return step_loop_fail(a, "the reasoning guard's tags");
+    }
+    ac.target = (const int32_t *) a->t_target->data;
+    ac.draft  = (const int32_t *) a->t_walk->data;
+    ac.eog    = (const int32_t *) a->t_eog->data;
+    ac.n_eog  = a->n_eog;
+    ac.stop   = (const int32_t *) a->t_stop->data;
+    ac.n_stop = a->n_stop;
+    ac.n_seq  = 1;
+    ac.n_row  = W;
+    ac.seq    = (ggml_spec_seq *) a->t_seq->data;
+
+    // events, and the pinned ring the host reads the results from
+    ggml_backend_dev_t dev = ggml_backend_get_device(a->backend);
+    for (ggml_backend_event_t * ev : { &a->ev_acc, &a->ev_walk, &a->ev_ver, &a->ev_inj, &a->ev_host[0], &a->ev_host[1] }) {
+        if (*ev == nullptr) {
+            *ev = ggml_backend_event_new(dev);
+        }
+        if (*ev == nullptr) {
+            return step_loop_fail(a, "no events");
+        }
+    }
+    if (a->ring_buf == nullptr) {
+        ggml_backend_buffer_type_t hb = ggml_backend_dev_host_buffer_type(dev);
+        a->ring_buf = hb ? ggml_backend_buft_alloc_buffer(hb, 2 * sizeof(step_ring_entry)) : nullptr;
+        if (a->ring_buf == nullptr) {
+            return step_loop_fail(a, "no pinned buffer");
+        }
+        a->ring = (step_ring_entry *) ggml_backend_buffer_get_base(a->ring_buf);
+    }
+
+    // where the loop may write: the target's cells off + p must be free up to the verify mask's end, the drafter's ring
+    // cells must lie inside both of its masks, and the context must not end
+    ggml_spec_seq s;
+    ggml_backend_synchronize(a->backend);
+    ggml_backend_tensor_get(a->t_seq, &s, 0, sizeof(s));
+    if (s.pos != pos || s.last != last) {
+        return step_loop_fail(a, "the device state is not at the slot's position");
+    }
+    int32_t lim = std::min<int32_t>((int32_t) (w.n_kv - s.cell_off), pos_max);
+    // the drafter's position p is in ring cell p mod n_cells: while the block's mask does not cover the whole ring, the
+    // loop stops before the residue reaches the first cell it does not cover (the injection writes the same cells)
+    const int64_t n_vis = db.mask_ring ? db.n_kv : db.n_kv - s.dcell_off;
+    if (n_vis < n_cells) {
+        const int64_t r = s.pos % n_cells;
+        lim = (int32_t) std::min<int64_t>(lim, r < n_vis ? (int64_t) s.pos - r + n_vis : (int64_t) s.pos);
+    }
+    // and it stops before the first cell after the sequence that another sequence holds (in a unified cache the other
+    // slot's cells can lie inside the verify graph's range)
+    if (s.pos + 2*W <= lim) {
+        const llama_pos end = llama_step_cells_free_end(ct, seq_id, s.pos, lim, s.cell_off);
+        if (end < 0) {
+            return step_loop_fail(a, "the target's cells after the sequence are not known");
+        }
+        lim = end;
+    }
+    if (s.pos + 2*W > lim) {
+        return step_loop_fail(a, "too close to the end of the graphs' cells");
+    }
+
+    if (s.pos + W > pos_start_max) {
+        return step_loop_fail(a, "too close to the end of the request");
+    }
+    a->n_seq     = 1;
+    a->cells_mode = false;
+    a->n_row     = W;
+    a->pos_known[0] = s.pos;
+    a->pos_limit[0] = lim;
+    a->pos_start_max[0] = pos_start_max;
+    a->n_issued  = 0;
+    a->n_done    = 0;
+
+    // 1b: rejection sampling with the host's streams of uniforms
+    a->temp_mode = temp != nullptr;
+    a->lp_accept.target = (const int32_t *) a->t_target->data;
+    a->lp_walk.u = nullptr;
+    if (temp != nullptr) {
+        if (a->sample == nullptr || temp->smpl == nullptr || temp->spec == nullptr || top_k > GGML_SPEC_MAX_K) {
+            return step_loop_fail(a, "no sampling launcher, sampler or drafter streams");
+        }
+        a->smpl        = temp->smpl;
+        a->spec        = temp->spec;
+        a->seq_id      = seq_id;
+        a->pos0        = s.pos;
+        a->n_rng_known = 0;
+        a->r_dist.n = ggml_nelements(a->r_dist.t);
+        a->r_rng.n  = ggml_nelements(a->r_rng.t);
+        a->r_walk.n = ggml_nelements(a->r_walk.t) / n_draft * n_draft;
+        a->r_dist.filled = a->r_rng.filled = a->r_walk.filled = 0;
+        wk.temp = temp->chain.temp;
+        wk.q_id = (int32_t *) a->t_qid->data;
+        wk.q_p  = (float *)   a->t_qp->data;
+        if (!step_loop_refill(a)) {
+            return step_loop_fail(a, "the host's streams of uniforms");
+        }
+        ggml_spec_sample_params & sp = a->lp_sample;
+        sp = {};
+        sp.logits     = a->logits;
+        sp.n_rows     = W;
+        sp.n_vocab    = a->n_vocab;
+        sp.row_stride = a->logits_stride;
+        sp.chain      = temp->chain;
+        sp.u_ring     = (const double *) a->r_dist.t->data;
+        sp.n_u_ring   = (int32_t) a->r_dist.n;
+        sp.u_pos0     = a->pos0;
+        sp.seq        = (const ggml_spec_seq *) a->t_seq->data;
+        sp.n_cand     = (int32_t *) a->t_nc->data;
+        sp.cand_id    = (int32_t *) a->t_cid->data;
+        sp.cand_p     = (float *)   a->t_cp->data;
+        sp.sampled    = (int32_t *) a->t_smp->data;
+        ac.target     = (const int32_t *) a->t_smp->data;
+        ac.n_cand     = sp.n_cand;
+        ac.cand_id    = sp.cand_id;
+        ac.cand_p     = sp.cand_p;
+        ac.q_id       = wk.q_id;
+        ac.q_p        = wk.q_p;
+        ac.q_k        = top_k;
+        ac.lenience   = temp->lenience;
+        ac.rng        = (const double *) a->r_rng.t->data;
+        ac.n_rng_ring = (int32_t) a->r_rng.n;
+        s.n_rng = 0;
+        ggml_backend_tensor_set(a->t_seq, &s, 0, sizeof(s));
+    }
+    // the drafter's graphs on the target's stream for the loop
+    static const bool one_stream = [] {
+        const char * e = getenv("FRANK_STEP_ONE_STREAM");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (one_stream && a->share_stream != nullptr && a->backend_d != a->backend) {
+        ggml_backend_synchronize(a->backend_d);
+        a->shared = a->share_stream(a->backend_d, a->backend);
+    }
+    a->loop_on   = true;
+    a->n_loops++;
+    return true;
+}
+
+// stage 5: the loop over two sequences in one batch (FRANK_STEP_LOOP_SEQ2; on with the loop unless 0, or unset with FRANK_ALL=0).  The last host step was both slots' verify of
+// W rows each (the graphs the contexts hold are those), and the device state is taken from its inputs, as the host filled
+// them (the slab's shadow), and from the slots: no host step of two sequences is checked on the device.
+static bool step_loop_seq2_env() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_STEP_LOOP_SEQ2");
+        if (e != nullptr) {
+            return atoi(e) != 0;
+        }
+        const char * a = getenv("FRANK_ALL");
+        return !(a != nullptr && a[0] == '0' && a[1] == '\0');
+    }();
+    return on;
+}
+
+bool common_step_loop_seq2_enabled() {
+    return step_loop_env() && step_loop_seq2_env();
+}
+
+bool common_step_loop_begin2(common_step_audit * a, const common_step_loop_seq * sq, int n_seq, int32_t top_k, int32_t n_draft,
+                             const common_step_loop_temp * const * temp) {
+    if (a == nullptr || a->loop_on || !common_step_loop_seq2_enabled() || n_seq < 1 || n_seq > GGML_SPEC_MAX_SEQ) {
+        return false;
+    }
+    const int N = n_seq;
+    llama_context * ct = a->ctx_tgt;
+    llama_context * cd = a->ctx_dft;
+    const int32_t W = n_draft + 1;
+    if (cd == nullptr || W < 2 || W > GGML_SPEC_MAX_ROW || top_k <= 0) {
+        return step_loop_fail(a, "two sequences: width or drafter");
+    }
+    for (int k = 0; k < N; ++k) {
+        if (sq[k].no_eog && a->suppress == nullptr) {
+            return step_loop_fail(a, "no suppress launcher for ignore_eos");
+        }
+        if (sq[k].n_emit < 1 || sq[k].n_emit > W) {
+            return step_loop_fail(a, "two sequences: the last step's tokens");
+        }
+    }
+    if (a->backend_d == nullptr) {
+        a->backend_d = llama_step_backend(cd);
+    }
+    if (a->backend_d == nullptr || a->write == nullptr || a->wdraft == nullptr || a->walk == nullptr) {
+        return step_loop_fail(a, "no drafter backend or launchers");
+    }
+    // the guard runs with one set of tags: both requests must have the same
+    ggml_spec_guard g0, g1;
+    if (!fill_guard(g0, sq[0].guard) || (N > 1 && (!fill_guard(g1, sq[1].guard) || memcmp(&g0, &g1, sizeof(g0)) != 0))) {
+        return step_loop_fail(a, "two sequences: the reasoning guards differ");
+    }
+    // the drafter's mask token and window: from the model when no single host step has shown them yet
+    if (a->mask_token < 0 || a->window <= 0) {
+        const llama_model * md = llama_get_model(cd);
+        a->mask_token = llama_vocab_mask(llama_model_get_vocab(md));
+        a->window     = llama_model_n_swa(md);
+        if (a->mask_token < 0 || a->window <= 0) {
+            return step_loop_fail(a, "two sequences: the drafter's mask token or window");
+        }
+    }
+
+    // the target's verify graph of both sequences: its inputs, the host's fill of them, and its logits
+    int64_t ne[4] = { 0, 0, 0, 0 };
+    ggml_spec_write_params & w = a->lp_write;
+    w = {};
+    w.tokens  = (int32_t *)  step_loop_input(ct, 0, "inp_tokens#0", N * W, 1);
+    w.pos     = (int32_t *)  step_loop_input(ct, 0, "inp_pos#0", -1, 1, ne);
+    w.n_pos_sections = (int32_t) (ne[0] / (N * W));
+    w.k_idxs  = (int64_t *)  step_loop_input(ct, 0, "attn_inp_k_idxs#0", N * W, 1);
+    w.v_idxs  = (int64_t *)  step_loop_input(ct, 0, "attn_inp_v_idxs#0", N * W, 1);
+    w.kq_mask = (uint16_t *) step_loop_input(ct, 0, "attn_inp_kq_mask#0", -1, N * W, ne);
