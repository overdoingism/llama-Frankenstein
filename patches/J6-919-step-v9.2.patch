+static bool ggml_backend_cuda_share_stream(ggml_backend_t backend, ggml_backend_t share) {
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    if (ctx->curr_stream_no != 0) {
+        return false;
+    }
+    if (share == nullptr) {
+        if (ctx->stream_own != nullptr) {
