+
+uint32_t llama_kv_cache::step_ring_base(llama_seq_id seq_id, const llama_kv_cells & cells) const {
+    // a sequence keeps its ring while it has cells; one without any takes the lowest ring that no sequence with cells
+    // holds, so a lone sequence uses the first ring and the attention spans no more cells than it needs
+    if (step_ring.size() != n_seq_max) {
+        step_ring.assign(n_seq_max, -1);
+    }
+    if (step_ring[seq_id] >= 0 && cells.seq_pos_min(seq_id) >= 0) {
+        return (uint32_t) step_ring[seq_id];
+    }
+    std::vector<bool> taken(n_seq_max, false);
+    for (uint32_t s = 0; s < n_seq_max; ++s) {
+        if ((llama_seq_id) s != seq_id && step_ring[s] >= 0 && cells.seq_pos_min((llama_seq_id) s) >= 0) {
+            taken[step_ring[s]] = true;
+        }
+    }
+    int32_t r = 0;
+    while (r < (int32_t) n_seq_max - 1 && taken[r]) {
+        r++;
+    }
+    step_ring[seq_id] = r;
+    return (uint32_t) r;
+}
+
+int32_t llama_kv_cache::step_ring_off(llama_seq_id seq_id) const {
+    if (n_swa == 0 || seq_id < 0 || (size_t) seq_id >= seq_to_stream.size() || (uint32_t) seq_id >= n_seq_max) {
+        return -1;
+    }
+    const auto & cells = v_cells[seq_to_stream[seq_id]];
+    if (cells.seq_pos_min(seq_id) < 0) {
+        return -1;
+    }
+    return (int32_t) (step_ring_base(seq_id, cells) * ring_cells());
+}
