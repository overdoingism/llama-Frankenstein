+
+    // the position tables of both sequences, and their order in the batch: rows k*W.. are slot sq[k]'s verify, whose first
+    // row (always kept) holds the slot's position before the step's tokens
+    if (a->t_cpos == nullptr || a->cpos_stride < w.n_kv) {
