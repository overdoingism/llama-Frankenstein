+            r->filled = 0;
+        }
+        for (int k = 0; k < N; ++k) {
+            const step_draw_ring & rd_ = k == 0 ? a->r_dist : a->r_dist1;
+            const step_draw_ring & rr_ = k == 0 ? a->r_rng  : a->r_rng1;
+            ggml_spec_walk_params & wkk = a->lp_walk_k[k];
+            wkk = wk;
+            wkk.lattice = wk.lattice + (int64_t) k * W * wk.n_embd;
+            wkk.n_seq   = 1;
+            wkk.draft   = (int32_t *) a->t_walk->data + k * n_draft;
+            wkk.u       = nullptr;
+            ggml_spec_accept_params & ak = a->lp_accept_k[k];
+            ak = ac;
+            ak.n_seq   = 1;
+            ak.seq     = (ggml_spec_seq *) a->t_seq->data + k;
+            ak.draft   = (const int32_t *) a->t_walk->data + k * n_draft;
+            ak.stop    = k == 0 ? ac.stop : ac.stop1;
+            ak.n_stop  = k == 0 ? ac.n_stop : ac.n_stop1;
