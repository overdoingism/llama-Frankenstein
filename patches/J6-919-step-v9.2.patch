diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 7b8392b64..7bbb2adce 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -96,6 +96,7 @@
 #include "ggml-cuda/fill.cuh"
 #include "ggml-cuda/lightning-indexer.cuh"
 #include "ggml-cuda/top-k-mask.cuh"
+#include "ggml-cuda/spec-step.cuh"
 #include "ggml.h"
 
 #include <algorithm>
@@ -1824,6 +1825,9 @@ struct ggml_backend_cuda_buffer_context {
         size_t   dev_bytes;  // the unit-aligned VRAM watermark inside one stream of this tensor
     };
     std::vector<vmm_tens>  vmm_tensors;
+    // BigOne: the mapped buffer type -- `dev_ptr` is the device view of this pinned system RAM allocation, freed
+    // here with cudaFreeHost (ggml_backend_cuda_mapped_buffer_type)
+    void * host_mapped = nullptr;
