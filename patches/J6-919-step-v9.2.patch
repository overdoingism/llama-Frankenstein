+            return -1;
+        }
+    }
+    std::vector<int32_t> found;
+    for (int64_t i = (int64_t) t - 1; i >= 0 && (n_free < 0 || (int64_t) found.size() < n_free); --i) {
+        if (cells.is_empty((uint32_t) i)) {
+            if ((int32_t) found.size() >= n_max) {
+                return -1;
+            }
+            found.push_back((int32_t) i);
+        }
+    }
