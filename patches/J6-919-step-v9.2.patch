+    }
+    static ggml_backend_buffer_type bufts[GGML_CUDA_MAX_DEVICES];
+    static bool init[GGML_CUDA_MAX_DEVICES] = {};
+    if (!init[device]) {
+        bufts[device] = {
+            /* .iface    = */ {
+                /* .get_name            = */ ggml_backend_cuda_buffer_type_get_name,
+                /* .alloc_buffer        = */ ggml_backend_cuda_mapped_buffer_type_alloc_buffer,
+                /* .alloc_buffer_n      = */ NULL,
+                /* .get_alignment       = */ ggml_backend_cuda_buffer_type_get_alignment,
+                /* .get_max_size        = */ NULL,
+                /* .get_alloc_size      = */ ggml_backend_cuda_buffer_type_get_alloc_size,
+                /* .get_alloc_size_n    = */ NULL,
+                /* .is_host             = */ NULL,
+            },
+            /* .device   = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device),
+            /* .context  = */ new ggml_backend_cuda_buffer_type_context{device, std::string(GGML_CUDA_NAME) + std::to_string(device) + "_Mapped", 0},
+        };
+        init[device] = true;
+    }
+    return &bufts[device];
+}
