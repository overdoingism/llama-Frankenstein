+            const auto ref = ref_walk(lat.data() + (size_t) s * n_block * n_embd, n_embd, top_k, n_draft);
+            for (int j = 0; j < n_draft; ++j) {
+                CHECK(out[(size_t) s * n_draft + j] == ref[j], "walk n_draft %d seq %d row %d: %d, reference %d",
+                      n_draft, s, j, out[(size_t) s * n_draft + j], ref[j]);
+            }
+        }
+    }
+}
