+        d->n_seq      = which ? N : 1;
+        d->mode       = which ? GGML_SPEC_DRAFT_BLOCK : GGML_SPEC_DRAFT_INJECT;
+        d->n_row      = W;
+        d->mask_token = a->mask_token;
+        d->window     = a->window;
+        d->n_cells    = n_cells;
+        d->pos        = (int32_t *) step_loop_input(cd, which, "inp_pos#0", -1, 1, ne);
+        d->n_pos_sections = (int32_t) (ne[0] / n_g);
+        d->k_idxs     = (int64_t *) step_loop_input(cd, which, "attn_inp_k_idxs#0", n_g, 1);
+        d->v_idxs     = (int64_t *) step_loop_input(cd, which, "attn_inp_v_idxs#0", n_g, 1);
+        if (which) {
+            d->tokens  = (int32_t *)  step_loop_input(cd, 1, "dflash_inp_tokens#0", N * W, 1);
