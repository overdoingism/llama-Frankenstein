diff --git a/ggml/src/ggml-cuda/spec-step.cu b/ggml/src/ggml-cuda/spec-step.cu
new file mode 100644
index 000000000..ced51c088
--- /dev/null
+++ b/ggml/src/ggml-cuda/spec-step.cu
@@ -0,0 +1,903 @@
+// Device-side steps of the GPU-resident speculative loop (ggml-spec-step.h).
+//
+// The acceptance follows common_sampler_sample_and_accept_n() with the greedy sampler, and the walk
+// follows the DFlash2 branch of common_speculative_draft(), so a loop built on these kernels emits the
+// tokens the host path emits.
+
+#include "spec-step.cuh"
+
+#include <cfloat>
+#include <climits>
+
+// the first maximum of each row: ties go to the lower column, as std::max_element and the greedy
+// sampler's strict comparison do.  NaN never wins; a row of NaN or -inf gives column 0.  Two passes: the
+// blocks of a row each take one chunk of it (a row is 250K floats and a verify has only a few rows), then
+// one warp per row combines the chunks.
+#define SPEC_ARGMAX_CHUNK 8192
+
+static __device__ __forceinline__ void spec_argmax_combine(float & best, int & bcol, const float v, const int c) {
+    if (v > best || (v == best && c < bcol)) {
+        best = v;
+        bcol = c;
+    }
+}
+
+static __global__ void spec_argmax_chunk_f32(const float * __restrict__ x, float * __restrict__ part_v, int * __restrict__ part_c,
+                                             const int64_t n_cols, const int64_t row_stride) {
+    const int64_t row   = blockIdx.y;
+    const int64_t chunk = blockIdx.x;
+    const float * src   = x + row * row_stride;
+    const int64_t c0    = chunk * SPEC_ARGMAX_CHUNK;
+    const int64_t c1    = min(c0 + SPEC_ARGMAX_CHUNK, n_cols);
+
+    float best = -INFINITY;
+    int   bcol = INT_MAX;
+    for (int64_t col = c0 + threadIdx.x; col < c1; col += blockDim.x) {
+        const float v = src[col];
+        if (v > best) {   // columns rise along a thread, so a tie keeps the earlier one
+            best = v;
+            bcol = (int) col;
+        }
+    }
+#pragma unroll
+    for (int offset = WARP_SIZE/2; offset > 0; offset >>= 1) {
+        spec_argmax_combine(best, bcol, ggml_cuda_shfl_xor(best, offset, WARP_SIZE), ggml_cuda_shfl_xor(bcol, offset, WARP_SIZE));
+    }
+    __shared__ float s_best[1024/WARP_SIZE];
+    __shared__ int   s_bcol[1024/WARP_SIZE];
+    const int n_warps = blockDim.x / WARP_SIZE;
+    const int lane    = threadIdx.x % WARP_SIZE;
+    const int warp    = threadIdx.x / WARP_SIZE;
+    if (lane == 0) {
+        s_best[warp] = best;
+        s_bcol[warp] = bcol;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        best = lane < n_warps ? s_best[lane] : -INFINITY;
+        bcol = lane < n_warps ? s_bcol[lane] : INT_MAX;
+#pragma unroll
+        for (int offset = WARP_SIZE/2; offset > 0; offset >>= 1) {
+            spec_argmax_combine(best, bcol, ggml_cuda_shfl_xor(best, offset, WARP_SIZE), ggml_cuda_shfl_xor(bcol, offset, WARP_SIZE));
+        }
+        if (lane == 0) {
+            part_v[row * gridDim.x + chunk] = best;
+            part_c[row * gridDim.x + chunk] = bcol;
+        }
+    }
+}
+
+static __global__ void spec_argmax_reduce(const float * __restrict__ part_v, const int * __restrict__ part_c, int32_t * __restrict__ dst,
+                                          const int n_chunks) {
+    const int row  = blockIdx.x;
+    const int lane = threadIdx.x;
+    float best = -INFINITY;
+    int   bcol = INT_MAX;
+    for (int i = lane; i < n_chunks; i += WARP_SIZE) {
+        spec_argmax_combine(best, bcol, part_v[row * n_chunks + i], part_c[row * n_chunks + i]);
+    }
+#pragma unroll
+    for (int offset = WARP_SIZE/2; offset > 0; offset >>= 1) {
+        spec_argmax_combine(best, bcol, ggml_cuda_shfl_xor(best, offset, WARP_SIZE), ggml_cuda_shfl_xor(bcol, offset, WARP_SIZE));
+    }
+    if (lane == 0) {
+        dst[row] = bcol == INT_MAX ? 0 : bcol;
+    }
+}
+
+void ggml_cuda_spec_argmax(ggml_cuda_pool & pool, cudaStream_t stream, const float * x, int64_t n_rows, int64_t n_cols, int64_t row_stride, int32_t * dst) {
+    if (n_rows <= 0) {
+        return;
+    }
+    const int n_chunks = (int) ((n_cols + SPEC_ARGMAX_CHUNK - 1) / SPEC_ARGMAX_CHUNK);
+    ggml_cuda_pool_alloc<float> part_v(pool, n_rows * n_chunks);
+    ggml_cuda_pool_alloc<int>   part_c(pool, n_rows * n_chunks);
+    spec_argmax_chunk_f32<<<dim3((unsigned) n_chunks, (unsigned) n_rows), 256, 0, stream>>>(x, part_v.get(), part_c.get(), n_cols, row_stride);
+    CUDA_CHECK(cudaGetLastError());
+    spec_argmax_reduce<<<(unsigned) n_rows, WARP_SIZE, 0, stream>>>(part_v.get(), part_c.get(), dst, n_chunks);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// the vocabulary's end-of-generation ids are a handful: compared one by one
+static __device__ bool spec_is_eog(const int32_t * eog, const int32_t n_eog, const int32_t id) {
+    bool hit = false;
+    for (int32_t i = 0; i < n_eog; ++i) {
+        hit |= eog[i] == id;
+    }
+    return hit;
+}
+
+static __device__ bool spec_tail_matches(const ggml_spec_seq & s, const int32_t * tag, const int32_t n_tag) {
+    if (n_tag <= 0 || s.n_tail < n_tag) {
+        return false;
+    }
+    for (int j = 0; j < n_tag; ++j) {
+        if (s.tail[s.n_tail - n_tag + j] != tag[j]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// rguard_track(): the tail keeps as many tokens as the longest tag; the start tag enters the block,
+// any end tag leaves it
+static __device__ void spec_guard_track(ggml_spec_seq & s, const ggml_spec_guard & g, const int32_t id) {
+    int n = g.n_start;
+    for (int e = 0; e < g.n_ends; ++e) {
+        n = max(n, g.n_end[e]);
+    }
+    n = min(n, GGML_SPEC_MAX_TAG);
+    if (n <= 0) {
+        return;
+    }
+    if (s.n_tail == n) {
+        for (int j = 1; j < n; ++j) {
+            s.tail[j - 1] = s.tail[j];
+        }
+        s.n_tail = n - 1;
+    }
+    s.tail[s.n_tail++] = id;
+    if (spec_tail_matches(s, g.start, g.n_start)) {
+        s.guard_in = 1;
+    }
+    for (int e = 0; e < g.n_ends; ++e) {
+        if (spec_tail_matches(s, g.ends[e], g.n_end[e])) {
+            s.guard_in = 0;
+        }
+    }
+}
+
+// one thread per sequence: the loop of common_sampler_sample_and_accept_n() over the target's tokens
+static __global__ void spec_accept(const ggml_spec_accept_params p) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= p.n_seq) {
+        return;
+    }
+
+    ggml_spec_seq s = p.seq[i];
+    const int32_t * target = p.target + (int64_t) i * p.n_row;
+    const int32_t * draft  = p.draft  + (int64_t) i * (p.n_row - 1);
+    const int       n_draft = p.n_row - 1;
+    // the second sequence's own list when it has one (a two-sequence loop), else the one list of every sequence
+    const int32_t * stop    = i == 1 && p.stop1 ? p.stop1   : p.stop;
+    const int32_t   n_stop  = i == 1 && p.stop1 ? p.n_stop1 : p.n_stop;
+
+    s.n_emit    = 0;
+    s.eog       = 0;
+    s.guard_hit = 0;
+
+    // rguard_apply() and the tracking of common_sampler_accept() on an emitted token
+    auto emit = [&](int32_t id) -> int32_t {
+        if (p.guard.on && s.guard_in && spec_is_eog(p.eog, p.n_eog, id)) {
+            id = p.guard.end;
+            s.guard_hit = 1;
+        }
+        if (p.guard.on) {
+            spec_guard_track(s, p.guard, id);
+        }
+        s.eog |= spec_is_eog(p.eog, p.n_eog, id);
+        s.emit[s.n_emit++] = id;
+        return id;
+    };
+
+    if (p.cand_p != nullptr) {
+        // common_sampler_sample_and_accept_n_rejection()
+        const float l = p.lenience;
+        int j = 0;
+        for (; j < n_draft; ++j) {
+            const int64_t   r   = (int64_t) i * p.n_row + j;
+            const int32_t   nc  = p.n_cand[r];
+            const int32_t * cid = p.cand_id + r * GGML_SPEC_MAX_K;
+            const float   * cp  = p.cand_p  + r * GGML_SPEC_MAX_K;
+            const int32_t * qid = p.q_id + ((int64_t) i * n_draft + j) * p.q_k;
+            const float   * qp  = p.q_p  + ((int64_t) i * n_draft + j) * p.q_k;
+            auto q_of = [&](int32_t id) {
+                for (int k = 0; k < p.q_k; ++k) {
+                    if (qid[k] == id) {
+                        return qp[k];
+                    }
+                }
+                return 0.0f;
+            };
+            const int32_t x   = draft[j];
+            const float   q_x = q_of(x);
+            float p_x = 0.0f;
+            for (int k = 0; k < nc; ++k) {
+                if (cid[k] == x) {
+                    p_x = cp[k];
+                    break;
+                }
+            }
+            bool accept = q_x > 0.0f && p_x >= l*q_x;
+            if (q_x > 0.0f && !accept) {
+                const float u = p.rng ? (float) p.rng[s.n_rng++ % p.n_rng_ring] : (float) p.u_acc[(int64_t) i * n_draft + j];
+                accept = u < p_x / (l*q_x);
+            }
+            if (accept) {
+                if (emit(x) != x) {
+                    break;   // the guard replaced a drafted end of generation: the drafted rest does not follow
+                }
+                if (spec_is_eog(stop, n_stop, x)) {
+                    break;   // a stop token (the lazy grammar's trigger) ends the step
+                }
+                continue;
+            }
+            // rejected: a token drawn from max(p - q, 0), or the row's own draw
+            float sum = 0.0f;
+            int32_t last = -1;
+            for (int k = 0; k < nc; ++k) {
+                const float rk = cp[k] - q_of(cid[k]);
+                if (rk > 0.0f) {
+                    sum += rk;
+                    last = cid[k];
+                }
+            }
+            int32_t id = target[j];
+            if (sum > 0.0f) {
+                float u = (p.rng ? (float) p.rng[s.n_rng++ % p.n_rng_ring] : (float) p.u_res[i]) * sum;
+                id = last;
+                for (int k = 0; k < nc; ++k) {
+                    const float rk = cp[k] - q_of(cid[k]);
+                    if (rk > 0.0f) {
+                        u -= rk;
+                        if (u <= 0.0f) {
+                            id = cid[k];
+                            break;
+                        }
+                    }
+                }
+            }
+            emit(id);
+            break;
+        }
+        if (j == n_draft) {
+            emit(target[n_draft]);
+        }
+        s.last = s.emit[s.n_emit - 1];
+        s.pos += s.n_emit;
+        p.seq[i] = s;
+        return;
+    }
+
+    for (int j = 0; j <= n_draft; ++j) {
+        int32_t id = target[j];
+        // rguard_apply(): an end of generation inside the reasoning block becomes the end tag
+        if (p.guard.on && s.guard_in && spec_is_eog(p.eog, p.n_eog, id)) {
+            id = p.guard.end;
+            s.guard_hit = 1;
+        }
+        if (p.guard.on) {
+            spec_guard_track(s, p.guard, id);
+        }
+        const bool is_eog = spec_is_eog(p.eog, p.n_eog, id);
+        s.emit[s.n_emit++] = id;
+        s.eog |= is_eog;
+        // a draft past an end of generation is not accepted; a trailing one still is (the next row is the target's); a
+        // stop token (the lazy grammar's trigger) ends the step
+        if (j == n_draft || draft[j] != id || (is_eog && j + 1 < n_draft) || spec_is_eog(stop, n_stop, id)) {
+            break;
+        }
+    }
+
+    s.last = s.emit[s.n_emit - 1];
+    s.pos += s.n_emit;
+    p.seq[i] = s;
+}
+
+// stage 5, two sequences: after the acceptance the cells of the rejected rows are the free cells below the top (ascending,
+// as llama_kv_cache::seq_rm() leaves them for the next find_slot()), and leave their sequence's position table.  One
+// thread: a verify has at most GGML_SPEC_MAX_HOLE rows.
+static __global__ void spec_cells_accept(const ggml_spec_accept_params p) {
+    ggml_spec_cells & c = *p.cells;
+    int32_t hole[2*GGML_SPEC_MAX_HOLE];
+    int     n_hole = 0;
+    // holes the verify did not take stay (it took the lowest free cells: none, as a rule)
+    for (int h = c.n_rows; h < c.n_hole; ++h) {
+        hole[n_hole++] = c.hole[h];
+    }
+    // the rest of the rows took the free cells the loop began with, then the top
+    const int32_t from_list = max(0, min(c.n_rows - c.n_hole, c.n_free - c.free_ptr));
+    const int32_t top = c.top + max(0, c.n_rows - c.n_hole - from_list);
+    c.free_ptr += from_list;
+    for (int i = 0; i < p.n_seq; ++i) {
+        for (int j = p.seq[i].n_emit; j < p.n_row; ++j) {
+            const int32_t cell = c.row_cell[i*p.n_row + j];
+            hole[n_hole++] = cell;
+            if (p.cell_pos) {
+                p.cell_pos[i*p.cell_pos_stride + cell] = -1;
+            }
+        }
+    }
+    for (int a = 1; a < n_hole; ++a) {
+        const int32_t v = hole[a];
+        int b = a - 1;
+        while (b >= 0 && hole[b] > v) {
+            hole[b + 1] = hole[b];
+            b--;
+        }
+        hole[b + 1] = v;
+    }
+    n_hole = min(n_hole, GGML_SPEC_MAX_HOLE);
+    for (int h = 0; h < n_hole; ++h) {
+        c.hole[h] = hole[h];
+    }
+    c.n_hole = n_hole;
+    c.top    = top;
+    c.n_rows = 0;
+}
+
+void ggml_cuda_spec_accept(cudaStream_t stream, const ggml_spec_accept_params & p) {
+    GGML_ASSERT(p.n_row >= 1 && p.n_row <= GGML_SPEC_MAX_ROW);
+    GGML_ASSERT(p.n_seq <= GGML_SPEC_MAX_SEQ || p.cells == nullptr);
+    if (p.n_seq <= 0) {
+        return;
+    }
+    if (!p.cells_only) {
+        spec_accept<<<(p.n_seq + 63) / 64, 64, 0, stream>>>(p);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    if (p.cells) {
+        spec_cells_accept<<<1, 1, 0, stream>>>(p);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+// one thread per sequence: from the anchor's row on, each position takes the first best score given
+// the position before it, and emits that candidate's id
+// one block per sequence (blockDim >= top_k): thread 0 keeps the host's sequential order wherever it decides the result
+// (the argmax, the sum of the probabilities, the walk); the other threads only compute values and the id order
+static __global__ void spec_walk(const ggml_spec_walk_params p) {
+    const int i = blockIdx.x;
+    const int t = threadIdx.x;
+    __shared__ float probs[GGML_SPEC_MAX_K];
+    __shared__ int   order[GGML_SPEC_MAX_K];   // the candidates by ascending id
+    __shared__ int   s_pred, s_best;
+    __shared__ float s_sum;
+
+    const float * block = p.lattice + (int64_t) i * p.n_block * p.n_embd;
+    if (t == 0) {
+        s_pred = 0;
+    }
+    __syncthreads();
+    for (int r = 1; r <= p.n_draft; ++r) {
+        const float * row    = block + (int64_t) r * p.n_embd;
+        const float * scores = row + p.top_k + (int64_t) s_pred * p.top_k;
+        if (t == 0) {
+            int32_t best = 0;
+            for (int k = 1; k < p.top_k; ++k) {
+                if (scores[k] > scores[best]) {
+                    best = k;
+                }
+            }
+            s_best = best;
+        }
+        __syncthreads();
+        const int best = s_best;
+        int pred = best;
+        if (p.u != nullptr) {
+            // softmax(scores / temp), then a draw walking the candidates in ascending id order; a round-off overshoot
+            // keeps the argmax
+            const int64_t d = (int64_t) i * p.n_draft + r - 1;
+            if (t < p.top_k) {
+                probs[t] = expf((scores[t] - scores[best]) / p.temp);
+                int rank = 0;
+                for (int k = 0; k < p.top_k; ++k) {
+                    rank += row[k] < row[t];
+                }
+                order[rank] = t;
+            }
+            __syncthreads();
+            if (t == 0) {
+                float sum = 0.0f;
+                for (int k = 0; k < p.top_k; ++k) {
+                    sum += probs[k];
+                }
+                s_sum = sum;
+            }
+            __syncthreads();
+            if (t < p.top_k) {
+                probs[t] /= s_sum;
+                p.q_id[d * p.top_k + t] = (int32_t) row[t];
+                p.q_p [d * p.top_k + t] = probs[t];
+            }
+            __syncthreads();
+            if (t == 0) {
+                double u = p.u[d];
+                for (int n = 0; n < p.top_k; ++n) {
+                    const int kk = order[n];
+                    u -= probs[kk];
+                    if (u < 0.0) {
+                        pred = kk;
+                        break;
+                    }
+                }
+            }
+        }
+        if (t == 0) {
+            s_pred = pred;
+            p.draft[(int64_t) i * p.n_draft + r - 1] = (int32_t) row[pred];
+        }
+        __syncthreads();
+    }
+}
+
+void ggml_cuda_spec_walk(cudaStream_t stream, const ggml_spec_walk_params & p) {
+    GGML_ASSERT(p.n_draft >= 0 && p.n_draft < p.n_block && p.top_k >= 1 && p.top_k <= GGML_SPEC_MAX_K);
+    if (p.n_seq <= 0 || p.n_draft == 0) {
+        return;
+    }
+    spec_walk<<<p.n_seq, GGML_SPEC_MAX_K, 0, stream>>>(p);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// one thread per batch row
+static __global__ void spec_write_verify(const ggml_spec_write_params p) {
+    const int r = blockIdx.x * blockDim.x + threadIdx.x;
+    const int n = p.n_seq * p.n_row;
+    if (r >= n) {
+        return;
+    }
+    const int i = r / p.n_row;   // sequence
+    const int j = r % p.n_row;   // row within it
+    const ggml_spec_seq & s = p.seq[i];
+    const int32_t pos = s.pos + j;
+    if (p.tokens) {
+        p.tokens[r] = j == 0 ? s.last : p.draft[(int64_t) i * (p.n_row - 1) + j - 1];
+    }
+    if (p.pos) {
+        if (p.n_pos_sections == 4) {
+            p.pos[0*n + r] = pos;
+            p.pos[1*n + r] = pos;
+            p.pos[2*n + r] = pos;
+            p.pos[3*n + r] = 0;
+        } else {
+            p.pos[r] = pos;
+        }
+    }
+    int64_t cell = (int64_t) pos + s.cell_off;
+    if (p.cells) {
+        // two sequences: the holes, then the cells from the top (ggml_spec_cells)
+        const ggml_spec_cells & c = *p.cells;
+        const int32_t n_list = max(0, c.n_free - c.free_ptr);
+        cell = r < c.n_hole ? c.hole[r] : r - c.n_hole < n_list ? c.free_list[c.free_ptr + r - c.n_hole]
+                                                                : (int64_t) c.top + (r - c.n_hole - n_list);
+        p.cells->row_cell[r] = (int32_t) cell;
+        if (r == 0) {
+            p.cells->n_rows = n;
+        }
+    }
+    if (p.k_idxs) {
+        p.k_idxs[r] = cell;
+    }
+    if (p.v_idxs) {
+        p.v_idxs[r] = cell;
+    }
+    // the cells this verify writes hold its positions (over rejected rows of the last one); the mask follows
+    if (p.cell_pos && cell < p.n_kv) {
+        p.cell_pos[i*p.cell_pos_stride + cell] = pos;
+    }
+}
+
+// the packed mask: a thread per (cell, row)
+static __global__ void spec_write_mask(const ggml_spec_write_params p) {
+    const int64_t idx = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t n   = p.n_kv * p.n_seq * p.n_row;
+    if (idx >= n) {
+        return;
+    }
+    const int64_t j  = idx % p.n_kv;    // cell
+    const int64_t rr = idx / p.n_kv;    // row of the batch
+    const int     i  = (int) (rr / p.n_row);   // its sequence
+    const int64_t r  = rr % p.n_row;    // its row within the sequence
+    const ggml_spec_seq & s = p.seq[i];
+    if (p.cell_pos) {
+        // row r sees the sequence's cells up to its own position, wherever they are
+        const int32_t cp = p.cell_pos[i*p.cell_pos_stride + j];
+        p.kq_mask[idx] = (cp >= 0 && cp <= s.pos + r) ? 0x0000 : 0xFC00;
+        return;
+    }
+    const int64_t c0 = (int64_t) s.pos_min + s.cell_off;
+    const int64_t c1 = (int64_t) s.pos + r + s.cell_off;
+    p.kq_mask[idx] = (j >= c0 && j <= c1) ? 0x0000 : 0xFC00;   // f16 0, -inf
+}
+
+// the recurrent inputs (llama_memory_recurrent::anchor_input and s_copy): a rollback of r rows of the last verify
+// reads the state from the start of that verify (plane 1) and replays its accepted rows; the factor rows alternate.
+// rs_replay_all: plane 0 is not written, so also no rollback (r 0) reads plane 1 and replays all the rows
+static __global__ void spec_write_rs(const ggml_spec_write_params p) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= p.n_seq) {
+        return;
+    }
+    ggml_spec_seq & s = p.seq[i];
+    const int32_t r = s.n_emit < s.n_row_prev ? s.n_row_prev - s.n_emit : 0;
+    const int32_t fpar_prev = s.rs_fpar;
+    const int32_t fpar      = s.rs_fpar ^ 1;
+    if (p.rs_s_copy)  p.rs_s_copy[i]  = r * p.rs_size + s.rs_src0;
+    const bool from1 = r > 0 || (p.rs_replay_all && s.n_row_prev > 0);
+    if (p.rs_rows)    p.rs_rows[i]    = from1 ? p.rs_size + s.rs_src0 : s.rs_src0;
+    if (p.rs_replay)  p.rs_replay[i]  = from1 ? s.n_row_prev - r : 0;
+    if (p.rs_fac_src) p.rs_fac_src[i] = fpar_prev * p.rs_size + s.rs_src0;
+    if (p.rs_fac_dst) p.rs_fac_dst[i] = fpar * p.rs_size + s.rs_cell;
+    s.rs_fpar    = fpar;
+    s.n_row_prev = p.n_row;
+}
+
+void ggml_cuda_spec_write_verify(cudaStream_t stream, const ggml_spec_write_params & p) {
+    GGML_ASSERT(p.n_pos_sections == 1 || p.n_pos_sections == 4);
+    const int n = p.n_seq * p.n_row;
+    if (n <= 0) {
+        return;
+    }
+    spec_write_verify<<<(n + 63) / 64, 64, 0, stream>>>(p);
+    CUDA_CHECK(cudaGetLastError());
+    GGML_ASSERT(p.n_seq == 1 || (p.n_seq <= GGML_SPEC_MAX_SEQ && p.cells && p.cell_pos));
+    if (p.kq_mask && p.n_kv > 0) {
+        const int64_t nm = p.n_kv * n;
+        spec_write_mask<<<(unsigned) ((nm + 255) / 256), 256, 0, stream>>>(p);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    if (p.rs_size > 0) {
+        spec_write_rs<<<(p.n_seq + 63) / 64, 64, 0, stream>>>(p);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+static __global__ void spec_write_draft_rows(const ggml_spec_draft_params p) {
+    const int r = blockIdx.x * blockDim.x + threadIdx.x;   // row of the batch
+    const int n = max(p.n_seq, 1) * p.n_row;
+    if (r >= n) {
+        return;
+    }
+    const int i  = r / p.n_row;   // its sequence
+    const int jr = r % p.n_row;   // its row within the sequence
+    const ggml_spec_seq & s = p.seq[i];
+    const int32_t pos = s.pos + jr;
+    if (p.rows) {
+        p.rows[r] = p.row0 + r;
+    }
+    if (p.tokens) {
+        p.tokens[r] = jr == 0 ? s.last : p.mask_token;
+    }
+    if (p.pos) {
+        if (p.n_pos_sections == 4) {
+            p.pos[0*n + r] = pos;
+            p.pos[1*n + r] = pos;
+            p.pos[2*n + r] = pos;
+            p.pos[3*n + r] = 0;
+        } else {
+            p.pos[r] = pos;
+        }
+    }
+    const int64_t cell = (int64_t) s.dcell_off + ((int64_t) pos % p.n_cells + p.n_cells) % p.n_cells;
+    if (p.k_idxs) {
+        p.k_idxs[r] = cell;
+    }
+    if (p.v_idxs) {
+        p.v_idxs[r] = cell;
+    }
+}
+
+static __global__ void spec_write_draft_mask(const ggml_spec_draft_params p) {
+    const int64_t idx = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= p.n_kv * max(p.n_seq, 1) * p.n_row) {
+        return;
+    }
+    const int64_t j  = idx % p.n_kv;
+    const int64_t rr = idx / p.n_kv;
+    const int     i  = (int) (rr / p.n_row);
+    const int64_t r  = rr % p.n_row;
+    const ggml_spec_seq & s = p.seq[i];
+    const int64_t lo_pos  = max((int64_t) s.pos + r - (p.window - 1), (int64_t) max(s.pos_min, s.dpos_min));
+    const int64_t end_pos = (int64_t) s.pos + p.n_row - 1;
+    // the position cell j holds: the latest one up to the block's end that maps to it (cells outside the ring: none)
+    const int64_t jr = p.mask_ring ? j : j - s.dcell_off;
+    if (jr < 0 || jr >= p.n_cells) {
+        p.kq_mask[idx] = 0xFC00;
+        return;
+    }
+    const int64_t r_end = (end_pos % p.n_cells + p.n_cells) % p.n_cells;
+    const int64_t pj    = end_pos - ((r_end - jr) % p.n_cells + p.n_cells) % p.n_cells;
+    p.kq_mask[idx] = pj >= lo_pos ? 0x0000 : 0xFC00;
+}
+
+void ggml_cuda_spec_write_draft(cudaStream_t stream, const ggml_spec_draft_params & p) {
+    GGML_ASSERT(p.n_pos_sections == 1 || p.n_pos_sections == 4);
+    GGML_ASSERT(p.n_cells > 0);
+    GGML_ASSERT(p.n_seq <= GGML_SPEC_MAX_SEQ);
+    const int n = max(p.n_seq, 1) * p.n_row;
+    if (n <= 0) {
+        return;
+    }
+    spec_write_draft_rows<<<(n + 63) / 64, 64, 0, stream>>>(p);
+    CUDA_CHECK(cudaGetLastError());
+    if (p.kq_mask && p.n_kv > 0) {
+        const int64_t nm = p.n_kv * n;
+        spec_write_draft_mask<<<(unsigned) ((nm + 255) / 256), 256, 0, stream>>>(p);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+static __global__ void spec_suppress_f32(float * __restrict__ x, const int64_t n_rows, const int64_t row_stride,
+                                         const int32_t * __restrict__ ids, const int32_t n_ids) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_rows * n_ids) {
+        return;
+    }
+    x[(i / n_ids) * row_stride + ids[i % n_ids]] = -INFINITY;
+}
+
+void ggml_cuda_spec_suppress(cudaStream_t stream, float * x, int64_t n_rows, int64_t row_stride, const int32_t * ids, int32_t n_ids) {
+    const int64_t n = n_rows * n_ids;
+    if (n <= 0) {
+        return;
+    }
+    spec_suppress_f32<<<(unsigned) ((n + 255) / 256), 256, 0, stream>>>(x, n_rows, row_stride, ids, n_ids);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// the target's sampler chain (ggml_spec_sample_params): each row's top k by blocks of SPEC_TOPK_CHUNK logits sorted in
+// LDS, the blocks' best merged and sorted again, then the chain on the k left
+#define SPEC_TOPK_CHUNK 4096
+
+static __device__ __forceinline__ bool spec_before(const float va, const int ia, const float vb, const int ib) {
+    return va > vb || (va == vb && ia < ib);
+}
+
+// bitonic sort of n pairs (n a power of two) in shared memory, best first
+static __device__ void spec_bitonic(float * v, int * id, const int n) {
+    for (int k = 2; k <= n; k <<= 1) {
+        for (int j = k >> 1; j > 0; j >>= 1) {
+            for (int a = threadIdx.x; a < n; a += blockDim.x) {
+                const int b = a ^ j;
+                if (b > a) {
+                    const bool up   = (a & k) == 0;
+                    const bool swap = up ? spec_before(v[b], id[b], v[a], id[a]) : spec_before(v[a], id[a], v[b], id[b]);
+                    if (swap) {
+                        const float tv = v[a]; v[a] = v[b]; v[b] = tv;
+                        const int   ti = id[a]; id[a] = id[b]; id[b] = ti;
+                    }
+                }
+            }
+            __syncthreads();
+        }
+    }
+}
+
+// the order of floats as unsigned keys (larger float, larger key); -0 counts as +0 and NaN as -inf, as the comparisons do
+static __device__ __forceinline__ uint32_t spec_key(float v) {
+    if (v != v) {
+        v = -INFINITY;
+    }
+    if (v == 0.0f) {
+        v = 0.0f;
+    }
+    const uint32_t u = __float_as_uint(v);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+#define SPEC_TOPK_THREADS 256
+#define SPEC_TOPK_PER     (SPEC_TOPK_CHUNK / SPEC_TOPK_THREADS)
+#define SPEC_TOPK_SMALL   256
+
+// the best k of n (<= SPEC_TOPK_CHUNK) pairs given through get(i), best first, into ov/oi: a radix select finds the k-th
+// best key, the pairs at or above it are sorted (all n of them only when ties leave too many)
+template <typename Get>
+static __device__ void spec_block_topk(const int n, const int k, Get get, float * v, int * id, float * ov, int * oi) {
+    __shared__ int hist[256];
+    __shared__ int s_sel, s_krem, s_m;
+
+    float    rv[SPEC_TOPK_PER];
+    int      ri[SPEC_TOPK_PER];
+    uint32_t rk[SPEC_TOPK_PER];
+#pragma unroll
+    for (int e = 0; e < SPEC_TOPK_PER; ++e) {
+        const int i = e * SPEC_TOPK_THREADS + threadIdx.x;
+        if (i < n) {
+            get(i, rv[e], ri[e]);
+            if (rv[e] != rv[e]) {
+                rv[e] = -INFINITY;
+            }
+        } else {
+            rv[e] = -INFINITY;
+            ri[e] = INT_MAX;
+        }
+        rk[e] = i < n ? spec_key(rv[e]) : 0u;   // padding below every real key
+    }
+
+    // the k-th best key, 8 bits at a time
+    uint32_t prefix = 0, mask = 0;
+    if (threadIdx.x == 0) {
+        s_krem = k;
+    }
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        for (int b = threadIdx.x; b < 256; b += SPEC_TOPK_THREADS) {
+            hist[b] = 0;
+        }
+        __syncthreads();
+#pragma unroll
+        for (int e = 0; e < SPEC_TOPK_PER; ++e) {
+            if ((rk[e] & mask) == prefix) {
+                atomicAdd(&hist[(rk[e] >> shift) & 255], 1);
+            }
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            int cum = 0, sel = 0;
+            for (int b = 255; b >= 0; --b) {
+                if (cum + hist[b] >= s_krem) {
+                    sel = b;
+                    break;
+                }
+                cum += hist[b];
+            }
+            s_krem -= cum;
+            s_sel   = sel;
+        }
+        __syncthreads();
+        prefix |= (uint32_t) s_sel << shift;
+        mask   |= 255u << shift;
+    }
+    const uint32_t thr = prefix;
+
+    // the pairs at or above it
+    if (threadIdx.x == 0) {
+        s_m = 0;
+    }
+    __syncthreads();
+#pragma unroll
+    for (int e = 0; e < SPEC_TOPK_PER; ++e) {
+        if (rk[e] >= thr && ri[e] != INT_MAX) {
+            const int j = atomicAdd(&s_m, 1);
+            if (j < SPEC_TOPK_SMALL) {
+                v[j]  = rv[e];
+                id[j] = ri[e];
+            }
+        }
+    }
+    __syncthreads();
+    const int m = s_m;
+    int n_sort = SPEC_TOPK_SMALL;
+    if (m <= SPEC_TOPK_SMALL) {
+        while (n_sort / 2 >= m && n_sort > 64) {
+            n_sort /= 2;
+        }
+        for (int t = m + threadIdx.x; t < n_sort; t += SPEC_TOPK_THREADS) {
+            v[t]  = -INFINITY;
+            id[t] = INT_MAX;
+        }
+    } else {
+        // many ties at the k-th key: every pair
+#pragma unroll
+        for (int e = 0; e < SPEC_TOPK_PER; ++e) {
+            v[e * SPEC_TOPK_THREADS + threadIdx.x]  = rv[e];
+            id[e * SPEC_TOPK_THREADS + threadIdx.x] = ri[e];
+        }
+        n_sort = SPEC_TOPK_CHUNK;
+    }
+    __syncthreads();
+    spec_bitonic(v, id, n_sort);
+    for (int t = threadIdx.x; t < k; t += SPEC_TOPK_THREADS) {
+        ov[t] = v[t];
+        oi[t] = id[t];
+    }
+    __syncthreads();
+}
+
+static __global__ void spec_topk_chunk(const float * __restrict__ x, const int64_t n_vocab, const int64_t row_stride, const int k,
+                                       float * __restrict__ part_v, int * __restrict__ part_i) {
+    __shared__ float v[SPEC_TOPK_CHUNK];
+    __shared__ int   id[SPEC_TOPK_CHUNK];
+    const int64_t row = blockIdx.y;
+    const int64_t c0  = (int64_t) blockIdx.x * SPEC_TOPK_CHUNK;
+    const int     n   = (int) min((int64_t) SPEC_TOPK_CHUNK, n_vocab - c0);
+    const float * src = x + row * row_stride + c0;
+    const int64_t o   = (row * gridDim.x + blockIdx.x) * k;
+    spec_block_topk(n, k, [&](int i, float & val, int & idx) { val = src[i]; idx = (int) (c0 + i); }, v, id, part_v + o, part_i + o);
+}
+
+static __global__ void spec_topk_chain(const float * __restrict__ part_v, const int * __restrict__ part_i, const int n_in,
+                                       const ggml_spec_sample_params p, const int k) {
+    __shared__ float v[SPEC_TOPK_CHUNK];
+    __shared__ int   id[SPEC_TOPK_CHUNK];
+    __shared__ float bv[GGML_SPEC_MAX_K];
+    __shared__ int   bi[GGML_SPEC_MAX_K];
+    const int64_t row = blockIdx.x;
+    spec_block_topk(n_in, k, [&](int i, float & val, int & idx) { val = part_v[row * n_in + i]; idx = part_i[row * n_in + i]; },
+                    v, id, bv, bi);
+    if (threadIdx.x != 0) {
+        return;
+    }
+
+    const ggml_spec_chain & ch = p.chain;
+    int n = k;
+    float l[GGML_SPEC_MAX_K];
+    for (int t = 0; t < n; ++t) {
+        l[t] = bv[t];
+    }
+    // top_p: softmax over the candidates (llama_sampler_softmax_impl), the shortest prefix reaching p
+    if (ch.top_p < 1.0f) {
+        float pp[GGML_SPEC_MAX_K];
+        float cum = 0.0f;
+        for (int t = 0; t < n; ++t) {
+            pp[t] = expf(l[t] - l[0]);
+            cum += pp[t];
+        }
+        float cs = 0.0f;
+        int last = n;
+        for (int t = 0; t < n; ++t) {
+            cs += pp[t] / cum;
+            if (cs >= ch.top_p && t + 1 >= ch.min_keep) {
+                last = t + 1;
+                break;
+            }
+        }
+        n = last;
+    }
+    // min_p, sorted: the first token always stays
+    if (ch.min_p > 0.0f) {
+        const float min_logit = l[0] + logf(ch.min_p);
+        int t = 1;
+        for (; t < n; ++t) {
+            if (l[t] < min_logit && t >= ch.min_keep) {
+                break;
+            }
+        }
+        n = t;
+    }
+    for (int t = 0; t < n; ++t) {
+        l[t] /= ch.temp;
+    }
+    // dist: the probabilities, and the draw (the running sum in double reaching sum * u; the last one if none does)
+    int32_t * cid = p.cand_id + row * GGML_SPEC_MAX_K;
+    float   * cp  = p.cand_p  + row * GGML_SPEC_MAX_K;
+    int sel = n - 1;
+    if (n == 1) {
+        cp[0] = 1.0f;
+        sel = 0;
+    } else {
+        float pr[GGML_SPEC_MAX_K];
+        double sum_cum = 0.0;
+        for (int t = 0; t < n; ++t) {
+            pr[t] = expf(l[t] - l[0]);
+            sum_cum += pr[t];
+        }
+        const double u = p.u_ring ? p.u_ring[(int64_t) (p.seq->pos - p.u_pos0 + row) % p.n_u_ring] : p.u[row];
+        const double sum_tgt = sum_cum * u;
+        double sum_run = 0.0;
+        bool found = false;
+        for (int t = 0; t < n; ++t) {
+            if (!found) {
+                sum_run += pr[t];
+                if (sum_run >= sum_tgt) {
+                    sel = t;
+                    found = true;
+                }
+            }
+            cp[t] = (float) (pr[t] / sum_cum);
+        }
+    }
+    for (int t = 0; t < n; ++t) {
+        cid[t] = bi[t];
+    }
+    p.n_cand[row]  = n;
+    p.sampled[row] = bi[sel];
+}
+
+void ggml_cuda_spec_sample(ggml_cuda_pool & pool, cudaStream_t stream, const ggml_spec_sample_params & p) {
+    if (p.n_rows <= 0) {
+        return;
+    }
+    const int k = (int) std::min<int64_t>(p.chain.top_k, p.n_vocab);
+    GGML_ASSERT(k >= 1 && k <= GGML_SPEC_MAX_K && p.chain.temp > 0.0f);
+    const int n_chunks = (int) ((p.n_vocab + SPEC_TOPK_CHUNK - 1) / SPEC_TOPK_CHUNK);
+    const int n_in     = n_chunks * k;
+    GGML_ASSERT(n_in <= SPEC_TOPK_CHUNK);
+    ggml_cuda_pool_alloc<float> part_v(pool, p.n_rows * n_in);
+    ggml_cuda_pool_alloc<int>   part_i(pool, p.n_rows * n_in);
+    spec_topk_chunk<<<dim3((unsigned) n_chunks, (unsigned) p.n_rows), SPEC_TOPK_THREADS, 0, stream>>>(p.logits, p.n_vocab, p.row_stride, k, part_v.get(), part_i.get());
+    CUDA_CHECK(cudaGetLastError());
+    spec_topk_chain<<<(unsigned) p.n_rows, SPEC_TOPK_THREADS, 0, stream>>>(part_v.get(), part_i.get(), n_in, p, k);
+    CUDA_CHECK(cudaGetLastError());
+}
+
