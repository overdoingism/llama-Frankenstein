+            }
+        }
+        a->spec    = (a->temp_k[0] ? temp[0] : temp[1])->spec;
+        a->smpl    = a->temp_k[0] ? temp[0]->smpl : nullptr;
+        a->seq_id  = sq[0].seq_id;
+        a->pos0    = st[0].pos;
+        a->smpl1   = a->temp_k[1] ? temp[1]->smpl : nullptr;
+        a->seq_id1 = N > 1 ? sq[1].seq_id : 0;
+        a->pos0_1  = N > 1 ? st[1].pos : 0;
+        a->n_rng_known = a->n_rng_known1 = 0;
+        for (step_draw_ring * r : { &a->r_dist, &a->r_rng, &a->r_dist1, &a->r_rng1 }) {
+            r->n = ggml_nelements(r->t);
+            r->filled = 0;
+        }
+        for (step_draw_ring * r : { &a->r_walk, &a->r_walk1 }) {
