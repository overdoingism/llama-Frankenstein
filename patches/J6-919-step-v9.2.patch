+bool llama_step_slab_env() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_STEP_SLAB");
+        return (e != nullptr && atoi(e) != 0) || llama_step_loop_env();
+    }();
+    return on;
+}
+
+// FRANK_STEP_LOOP: 1 on, 0 off.  Unset: on where it was measured -- one GPU, a ROCm one, on Linux (per step -5.7..-5.9 % at
+// 8K / 110K with drafts) and on Windows (-6.2..-7.7 % at 8K / 32K / 110K), greedy output the same as the host path; off
+// with several GPUs (not tested) and with FRANK_ALL=0.  Read on the first call, after the model's devices are registered.
+bool llama_step_loop_env() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_STEP_LOOP");
+        if (e != nullptr) {
+            return atoi(e) != 0;
+        }
+        const char * a = getenv("FRANK_ALL");
+        if (a != nullptr && a[0] == '0' && a[1] == '\0') {
+            return false;
+        }
+        int n_gpu = 0;
+        bool rocm = true;
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                ++n_gpu;
+                rocm = rocm && strcmp(ggml_backend_reg_name(ggml_backend_dev_backend_reg(dev)), "ROCm") == 0;
+            }
+        }
+        return n_gpu == 1 && rocm;
+    }();
+    return on;
+}
+
+bool llama_step_loop_enabled() {
+    return llama_step_loop_env();
+}
+
+bool llama_step_audit_env() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_STEP_AUDIT");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
