+
+llama_step_slab::llama_step_slab(ggml_backend_buffer_type_t buft, ggml_backend_buffer_type_t host_buft, size_t size) : size(size) {
+    buf  = ggml_backend_buft_alloc_buffer(buft, size);
+    host = ggml_backend_buft_alloc_buffer(host_buft, size);
+    if (buf == nullptr || host == nullptr || !ggml_backend_buffer_is_host(host)) {
+        throw std::runtime_error("llama_step_slab: failed to allocate the input slab");
+    }
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+    align = std::max(ggml_backend_buft_get_alignment(buft), ggml_backend_buft_get_alignment(host_buft));
+
+    ggml_init_params ip = { ggml_tensor_overhead(), nullptr, true };
+    ctx = ggml_init(ip);
+    all = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, (int64_t) size);
+    ggml_set_name(all, "step_slab");
+    if (ggml_backend_tensor_alloc(buf, all, ggml_backend_buffer_get_base(buf)) != GGML_STATUS_SUCCESS) {
+        throw std::runtime_error("llama_step_slab: failed to map the input slab");
+    }
+}
+
+llama_step_slab::~llama_step_slab() {
+    if (ctx) {
+        ggml_free(ctx);
+    }
+    if (buf) {
+        ggml_backend_buffer_free(buf);
+    }
+    if (host) {
+        ggml_backend_buffer_free(host);
+    }
+}
+
+void llama_step_slab::begin_fill(const ggml_cgraph * gf) {
+    const auto & bound_last = bound.at(gf);
+    char * dev_base  = (char *) ggml_backend_buffer_get_base(buf);
+    char * host_base = (char *) ggml_backend_buffer_get_base(host);
+    for (ggml_tensor * t : bound_last) {
+        GGML_ASSERT(t->buffer == buf);
+        t->data   = host_base + ((char *) t->data - dev_base);
+        t->buffer = host;
+    }
+}
+
+void llama_step_slab::audit(const ggml_cgraph * gf) {
+    if (queried.empty()) {
+        return;
+    }
+    std::vector<char> dev(used);
+    ggml_backend_tensor_get(all, dev.data(), 0, used);
+    char * host_base = (char *) ggml_backend_buffer_get_base(host);
+
+    // coverage: an input no device writer asked for, whose host value changed since this graph's last fill, is a
+    // per-step input the loop would leave stale
+    {
+        std::vector<char> & prev = last_fill[gf];
+        if (prev.size() == used) {
+            for (const ggml_tensor * t : bound.at(gf)) {
+                const size_t off = (const char *) t->data - host_base;
+                std::string key;
+                for (const slot & sl : slot_list) {
+                    if (sl.offset == off) {
+                        key = sl.key;
+                        break;
+                    }
+                }
+                if (std::find(queried.begin(), queried.end(), key) != queried.end()) {
+                    continue;
+                }
+                if (memcmp(prev.data() + off, host_base + off, ggml_nbytes(t)) != 0) {
+                    if (changed_unwritten[key]++ < 3) {
+                        LLAMA_LOG_WARN("%s: %s changed since the last fill and no device writer wrote it\n", __func__, key.c_str());
+                    }
+                }
+            }
+        }
+        prev.assign(host_base, host_base + used);
+    }
+    for (const std::string & key : queried) {
+        auto it = by_key.find(key);
+        if (it == by_key.end()) {
+            continue;
+        }
+        const slot & s = slot_list[it->second];
+        // the bytes of the bound tensor (its current size, which may be less than the slot)
+        size_t nbytes = 0;
+        for (const ggml_tensor * t : bound.at(gf)) {
+            if ((const char *) t->data == host_base + s.offset) {
+                nbytes = ggml_nbytes(t);
+                break;
+            }
+        }
+        if (nbytes == 0) {
+            continue;
+        }
+        audit_count & c = audit_counts[key];
+        c.n++;
+        if (memcmp(dev.data() + s.offset, host_base + s.offset, nbytes) != 0) {
+            c.bad++;
+            if (c.bad <= 5) {
+                const size_t esz = ggml_type_size(s.type);
+                size_t k = 0;
+                while (k + esz <= nbytes && memcmp(dev.data() + s.offset + k, host_base + s.offset + k, esz) == 0) {
+                    k += esz;
+                }
+                long long dv = 0, hv = 0;
+                memcpy(&dv, dev.data() + s.offset + k, std::min<size_t>(esz, sizeof(dv)));
+                memcpy(&hv, host_base + s.offset + k, std::min<size_t>(esz, sizeof(hv)));
+                LLAMA_LOG_WARN("%s: %s differs at element %zu: device %lld, host %lld (%zu bytes)\n", __func__,
+                        key.c_str(), k / esz, dv, hv, nbytes);
+            }
+        }
+    }
+    if (++n_audits % 64 == 0) {
+        std::string line;
+        for (const auto & [k, c] : audit_counts) {
+            line += " " + k + " " + std::to_string(c.bad) + "/" + std::to_string(c.n);
+        }
+        std::string ch;
+        for (const auto & [k, n] : changed_unwritten) {
+            ch += " " + k + " " + std::to_string(n);
+        }
+        LLAMA_LOG_WARN("%s: device-written inputs, mismatches / checks:%s; changed without a device writer:%s\n", __func__,
+                line.c_str(), ch.empty() ? " none" : ch.c_str());
+    }
+}
+
+void llama_step_slab::dump(const ggml_cgraph * gf) {
+    if (n_dumps++ >= 400) {
+        return;
+    }
+    std::string line;
+    for (const ggml_tensor * t : bound.at(gf)) {
+        const int64_t n = ggml_nelements(t);
+        std::string v;
+        if ((t->type == GGML_TYPE_I32 || t->type == GGML_TYPE_I64) && n <= 32) {
+            for (int64_t i = 0; i < n; ++i) {
+                const long long x = t->type == GGML_TYPE_I32 ? ((const int32_t *) t->data)[i] : ((const int64_t *) t->data)[i];
+                v += (i ? "," : "") + std::to_string(x);
+            }
+        } else if (t->type == GGML_TYPE_F16 && strstr(t->name, "mask") != nullptr) {
+            // per row: the first and last visible cell and the number of visible cells
+            const uint16_t * m = (const uint16_t *) t->data;
+            for (int64_t r = 0; r < t->ne[1]; ++r) {
+                int64_t lo = -1, hi = -1, cnt = 0;
+                for (int64_t j = 0; j < t->ne[0]; ++j) {
+                    if (m[r*t->ne[0] + j] != 0xFC00) {
+                        if (lo < 0) lo = j;
+                        hi = j;
+                        cnt++;
+                    }
+                }
+                v += (r ? " " : "") + std::to_string(lo) + ".." + std::to_string(hi) + "/" + std::to_string(cnt);
+            }
+        } else {
+            continue;
+        }
+        line += std::string(" ") + t->name + "=[" + v + "]";
+    }
+    LLAMA_LOG_WARN("%s: fill %lld:%s\n", __func__, (long long) n_dumps, line.c_str());
+}
+
+void llama_step_slab::end_fill(const ggml_cgraph * gf) {
+    if (llama_step_audit_env()) {
+        audit(gf);
+    }
+    if (llama_step_debug_env() >= 2) {
+        dump(gf);
+    }
+    queried.clear();
+    querying = false;
+    const auto & bound_last = bound.at(gf);
+    char * dev_base  = (char *) ggml_backend_buffer_get_base(buf);
+    char * host_base = (char *) ggml_backend_buffer_get_base(host);
+    for (ggml_tensor * t : bound_last) {
+        GGML_ASSERT(t->buffer == host);
+        t->data   = dev_base + ((char *) t->data - host_base);
+        t->buffer = buf;
+    }
+    if (used > 0) {
+        ggml_backend_tensor_set(all, host_base, 0, used);
+    }
+}
+
+bool llama_step_slab::bind(ggml_cgraph * gf) {
+    std::vector<ggml_tensor *> & bound_last = bound[gf];
+    bound_last.clear();
+
+    std::set<const ggml_tensor *> seen;
+    std::map<std::string, int>    occurrence;
+    char * base = (char *) ggml_backend_buffer_get_base(buf);
+
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        const ggml_tensor * node = ggml_graph_node(gf, i);
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            ggml_tensor * t = node->src[j];
+            if (t == nullptr) {
+                continue;
+            }
+            if (t->view_src != nullptr) {
+                t = t->view_src;   // a view of an input: the input itself is placed
+            }
+            if (!(t->flags & GGML_TENSOR_FLAG_INPUT) || t->buffer != nullptr || !seen.insert(t).second) {
+                continue;
+            }
+
+            const std::string key    = std::string(t->name) + "#" + std::to_string(occurrence[t->name]++);
+            const size_t      nbytes = ggml_backend_buffer_get_alloc_size(buf, t);
+
+            auto it = by_key.find(key);
+            if (it == by_key.end() || slot_list[it->second].nbytes < nbytes) {
+                // a new input, or one that grew (another n_kv bucket): a new slot; the old one stays,
+                // since a captured graph of the old shape may still be replayed.  A grown input gets twice
+                // its old slot, so an n_kv that grows by 256 cells at a time does not use the slab up.
+                const size_t want   = it == by_key.end() ? nbytes : std::max(nbytes, 2*slot_list[it->second].nbytes);
+                const size_t offset = GGML_PAD(used, align);
+                if (offset + want > size) {
+                    LLAMA_LOG_ERROR("%s: input slab full (%zu of %zu bytes used, %s needs %zu)\n",
+                            __func__, used, size, key.c_str(), want);
+                    return false;
+                }
+                used = offset + want;
+                slot s = { key, offset, want, t->type, { t->ne[0], t->ne[1], t->ne[2], t->ne[3] } };
+                if (it == by_key.end()) {
+                    by_key[key] = slot_list.size();
+                    slot_list.push_back(s);
+                } else {
+                    slot_list[it->second] = s;
+                }
+                it = by_key.find(key);
+            }
+
+            const slot & s = slot_list[it->second];
+            const enum ggml_status st = ggml_backend_tensor_alloc(buf, t, base + s.offset);
+            if (st != GGML_STATUS_SUCCESS) {
+                LLAMA_LOG_ERROR("%s: failed to place %s in the input slab\n", __func__, key.c_str());
+                return false;
+            }
+            bound_last.push_back(t);
+        }
+    }
+    return true;
+}
+
+void llama_step_slab::report(ggml_cgraph * gf, ggml_backend_sched_t sched) const {
+    if (llama_step_debug_env() <= 0) {
+        return;
+    }
+    const auto & bound_last = bound.at(gf);
+    LLAMA_LOG_WARN("%s: %zu inputs in the slab, %zu of %zu bytes used\n", __func__, bound_last.size(), used, size);
+    for (const ggml_tensor * t : bound_last) {
+        std::set<std::string> readers;
+        for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+            ggml_tensor * node = ggml_graph_node(gf, i);
+            for (int j = 0; j < GGML_MAX_SRC; ++j) {
+                const ggml_tensor * s = node->src[j];
+                if (s != nullptr && (s == t || s->view_src == t)) {
+                    ggml_backend_t b = ggml_backend_sched_get_tensor_backend(sched, node);
+                    readers.insert(b ? ggml_backend_name(b) : "?");
+                }
+            }
+        }
+        std::string rs;
+        for (const auto & r : readers) {
+            rs += (rs.empty() ? "" : ",") + r;
+        }
+        LLAMA_LOG_WARN("%s:   %-32s %-5s [%lld, %lld, %lld, %lld] read by %s\n", __func__, t->name, ggml_type_name(t->type),
+                (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3], rs.c_str());
+    }
+}
+
+void * llama_step_slab::addr(const std::string & key) const {
+    auto it = by_key.find(key);
+    if (it == by_key.end()) {
+        return nullptr;
+    }
+    if (querying) {
+        queried.push_back(key);
+    }
+    return (char *) ggml_backend_buffer_get_base(buf) + slot_list[it->second].offset;
+}
+
+bool llama_step_slab::shape(const ggml_cgraph * gf, const std::string & key, int64_t ne[4]) const {
+    auto it = by_key.find(key);
+    auto bt = bound.find(gf);
+    if (it == by_key.end() || bt == bound.end()) {
+        return false;
+    }
+    const size_t off = slot_list[it->second].offset;
+    const char * dev_base  = (const char *) ggml_backend_buffer_get_base(buf);
+    const char * host_base = (const char *) ggml_backend_buffer_get_base(host);
+    for (const ggml_tensor * t : bt->second) {
+        if ((const char *) t->data == dev_base + off || (const char *) t->data == host_base + off) {
+            for (int d = 0; d < 4; ++d) {
+                ne[d] = t->ne[d];
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+void * llama_step_slab::graph_addr(const ggml_cgraph * gf, const std::string & key, int64_t ne[4]) const {
+    auto bt = bound.find(gf);
+    if (bt == bound.end()) {
+        return nullptr;
+    }
+    // bind() numbered the occurrences of a name in the order it placed the inputs, which is this list's order
+    std::map<std::string, int> occurrence;
+    for (ggml_tensor * t : bt->second) {
+        if (std::string(t->name) + "#" + std::to_string(occurrence[t->name]++) != key) {
+            continue;
+        }
+        if (ne) {
+            for (int d = 0; d < 4; ++d) {
+                ne[d] = t->ne[d];
+            }
+        }
+        // outside begin_fill() / end_fill() the bound tensors point into the device slab
+        GGML_ASSERT(t->buffer == buf);
+        return t->data;
+    }
+    return nullptr;
+}
+
+void * llama_step_slab::host_addr(const std::string & key) const {
+    auto it = by_key.find(key);
+    if (it == by_key.end()) {
+        return nullptr;
+    }
+    return (char *) ggml_backend_buffer_get_base(host) + slot_list[it->second].offset;
+}
diff --git a/src/llama-step.h b/src/llama-step.h
new file mode 100644
index 000000000..e06ca4948
--- /dev/null
+++ b/src/llama-step.h
@@ -0,0 +1,108 @@
+#pragma once
+
+// BigOne: the GPU-resident speculative loop.
+//
+// llama_step_slab holds a context's graph inputs in device memory the loop owns.  After a graph is
+// built, every input tensor a node reads is placed in the slab at an address fixed per input (its
+// name, its occurrence and its size), before the scheduler allocates the graph.  The scheduler then
+// treats the inputs like weights: no copy and no wait per compute, and a rebuilt graph of the same
+// shape reads the same addresses, so a captured device graph stays valid.  The loop's device kernels
+// write the inputs there.  The host path still fills them with set_inputs(): between begin_fill() and
+// end_fill() the bound tensors point into a host shadow laid out like the slab, and end_fill() uploads
+// the used part of the slab in one copy.  That copy does not run on the backend's stream: the caller waits
+// for the backend first (process_ubatch), since graphs queued there read the same slots.
+//
+// FRANK_STEP_SLAB=1 attaches a slab to every context (for checking that binding changes nothing);
+// FRANK_STEP_DEBUG=1 lists the bound inputs and the backend of each one's readers (at WARN, so llama-server shows it);
+// FRANK_STEP_DEBUG=2 also logs the values of the first 400 fills: small integer inputs whole, a mask as the visible
+// cell range of each row.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstddef>
+#include <map>
+#include <string>
+#include <vector>
+
+struct llama_step_slab {
+    struct slot {
+        std::string key;      // name#occurrence
+        size_t      offset;
+        size_t      nbytes;
+        ggml_type   type;
+        int64_t     ne[4];
+    };
+
+    // buft: the device buffer type; host_buft: a host buffer type for the shadow (pinned if the device has one)
+    llama_step_slab(ggml_backend_buffer_type_t buft, ggml_backend_buffer_type_t host_buft, size_t size);
+    ~llama_step_slab();
+
+    llama_step_slab(const llama_step_slab &) = delete;
+    llama_step_slab & operator=(const llama_step_slab &) = delete;
+
+    // place every not yet allocated input tensor that a node of gf reads; returns false if the slab is full.
+    // A context can keep several graphs alive (two schedulers), so the bound tensors are kept per graph.
+    bool bind(ggml_cgraph * gf);
+
+    // gf was rebuilt without binding (its address may be reused): drop what was recorded for it
+    void forget(const ggml_cgraph * gf) { bound.erase(gf); }
+
+    bool is_bound(const ggml_cgraph * gf) const { return bound.count(gf) != 0; }
+
+    // after the scheduler has split the graph: log the bound inputs and who reads them (FRANK_STEP_DEBUG)
+    void report(ggml_cgraph * gf, ggml_backend_sched_t sched) const;
+
+    // set_inputs() of a bound graph: point its inputs at the host shadow, then back and upload
+    void begin_fill(const ggml_cgraph * gf);
+    void end_fill(const ggml_cgraph * gf);
+
+    // device address of a bound input (name#occurrence), nullptr if there is none; host_addr: its place in the shadow
+    void * addr(const std::string & key) const;
+    void * host_addr(const std::string & key) const;
+
+    // the device address and shape of graph gf's own input (key name#occurrence): an input of the same name in another
+    // graph may sit in another slot (the slot grew); nullptr if gf has no such input
+    void * graph_addr(const ggml_cgraph * gf, const std::string & key, int64_t ne[4]) const;
+
+    // the shape of a bound input in graph gf (an input's slot may be larger than its current tensor)
+    bool shape(const ggml_cgraph * gf, const std::string & key, int64_t ne[4]) const;
+
+    // FRANK_STEP_AUDIT: the inputs a device writer asked for (addr() between begin_query() and end_fill()) are
+    // compared with what set_inputs() put in the shadow, before the upload; counts are logged
+    void begin_query() { queried.clear(); querying = true; }
+    void end_query()   { querying = false; }
+
+    const std::vector<slot> & slots() const { return slot_list; }
+
+private:
+    ggml_backend_buffer_t buf   = nullptr;
+    ggml_backend_buffer_t host  = nullptr;   // the shadow, same offsets as buf
+    ggml_context *        ctx   = nullptr;   // holds `all`
+    ggml_tensor *         all   = nullptr;   // one tensor spanning buf, for the upload
+    size_t                size  = 0;
+    size_t                used  = 0;
+    size_t                align = 1;
+
+    std::map<std::string, size_t> by_key;      // key -> index in slot_list
+    std::vector<slot>             slot_list;
+    std::map<const ggml_cgraph *, std::vector<ggml_tensor *>> bound;   // per graph, the tensors bind() placed
+
+    mutable bool                    querying = false;
+    mutable std::vector<std::string> queried;
+    struct audit_count { int64_t n = 0, bad = 0; };
+    std::map<std::string, audit_count> audit_counts;
+    std::map<const ggml_cgraph *, std::vector<char>> last_fill;   // per graph, the shadow of the last audited fill
+    std::map<std::string, int64_t>   changed_unwritten;            // inputs that changed between fills, not device-written
+    int64_t                          n_audits = 0;
+    void audit(const ggml_cgraph * gf);
+    int64_t                          n_dumps  = 0;
+    void dump(const ggml_cgraph * gf);   // FRANK_STEP_DEBUG >= 2: the host's values of the first fills
+};
+
+// FRANK_STEP_SLAB / FRANK_STEP_DEBUG, read once; the GPU-resident loop (FRANK_STEP_LOOP, on by default on Linux with one
+// ROCm GPU; common/step-audit.h) implies FRANK_STEP_SLAB=1
+bool llama_step_slab_env();
+bool llama_step_loop_env();
+int  llama_step_debug_env();
+bool llama_step_audit_env();   // FRANK_STEP_AUDIT
