+bool llama_context::step_restore_memory(llama_seq_id seq_id, const llama_step_restore & r) {
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory.get())) {
+        return hybrid->get_mem_attn()->step_restore(seq_id, r.p_lo, r.p_hi, r.p_end, r.tokens, 0, r.cell_off, r.cells) &&
+               hybrid->get_mem_recr()->step_restore(seq_id, r.rs_p0, r.rs_n, r.rs_fpar);
+    }
+    if (auto * iswa = dynamic_cast<llama_kv_cache_iswa *>(memory.get())) {
+        llama_kv_cache * base = iswa->get_base();
+        return base->step_restore(seq_id, r.p_lo, r.p_hi, r.p_end, r.tokens, base->step_has_layers() ? 0 : 2, r.cell_off,
+                                  base->step_has_layers() ? r.cells : nullptr) &&
+               iswa->get_swa()->step_restore(seq_id, r.p_lo, r.p_hi, r.p_end, r.tokens, 1, r.ring_off);
+    }
+    if (auto * kv = dynamic_cast<llama_kv_cache *>(memory.get())) {
+        return kv->step_restore(seq_id, r.p_lo, r.p_hi, r.p_end, r.tokens, 0, r.cell_off, r.cells);
+    }
+    return false;
+}
+
+llama_pos llama_context::step_cells_free_end(llama_seq_id seq_id, llama_pos p_lo, llama_pos p_hi, int32_t cell_off) const {
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory.get())) {
+        return hybrid->get_mem_attn()->step_cells_free_end(seq_id, p_lo, p_hi, cell_off);
+    }
+    if (auto * kv = dynamic_cast<llama_kv_cache *>(memory.get())) {
+        return kv->step_cells_free_end(seq_id, p_lo, p_hi, cell_off);
+    }
+    return -1;
+}
