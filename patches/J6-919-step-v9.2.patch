+        ggml_backend_tensor_get(to, out.data(), 0, ggml_nbytes(to));
+        ggml_backend_tensor_get(tqi, qi.data(), 0, ggml_nbytes(tqi));
+        ggml_backend_tensor_get(tqp, qp.data(), 0, ggml_nbytes(tqp));
+        for (int s = 0; s < n_seq; ++s) {
+            std::vector<int32_t> rqi; std::vector<float> rqp;
+            const auto ref = ref_walk_sample(lat.data() + (size_t) s * n_block * n_embd, n_embd, top_k, n_draft, temp, &u[(size_t) s * n_draft], rqi, rqp);
+            bool same = true;
+            float max_dq = 0.0f;
+            for (int j = 0; j < n_draft; ++j) same = same && out[(size_t) s * n_draft + j] == ref[j];
+            for (size_t t = 0; t < rqi.size(); ++t) {
+                same = same && qi[(size_t) s * n_draft * top_k + t] == rqi[t];
+                max_dq = std::max(max_dq, std::fabs(qp[(size_t) s * n_draft * top_k + t] - rqp[t]));
+            }
+            CHECK(same && max_dq <= 1e-6f, "walk sample temp %.1f seq %d: drafts or q differ (max |dq| %g)", temp, s, max_dq);
+        }
+    }
+}
+
+// common_sampler_sample_and_accept_n_rejection() on given candidates (p per row, q per draft) and uniforms, with the guard
+static std::vector<int32_t> ref_reject(ref_seq & s, int n_draft, const int32_t * draft, const int32_t * sampled,
+                                       const std::vector<std::vector<std::pair<int32_t, float>>> & pc,
+                                       const std::vector<std::vector<std::pair<int32_t, float>>> & qc,
+                                       float l, const double * u_acc, double u_res,
+                                       const std::vector<int32_t> & eog, int32_t end_tok,
+                                       const std::vector<int32_t> & start, const std::vector<std::vector<int32_t>> & ends,
+                                       const std::vector<int32_t> & stop = {}) {
+    auto is_eog = [&](int32_t id) { return std::binary_search(eog.begin(), eog.end(), id); };
+    auto guard = [&](int32_t id) { return s.guard_in && is_eog(id) ? end_tok : id; };
+    auto track = [&](int32_t id) {
+        size_t n = start.size();
+        for (const auto & e : ends) n = std::max(n, e.size());
+        s.tail.push_back(id);
+        if (s.tail.size() > n) s.tail.erase(s.tail.begin(), s.tail.end() - n);
+        if (ref_tail_matches(s.tail, start)) s.guard_in = true;
+        for (const auto & e : ends) if (ref_tail_matches(s.tail, e)) s.guard_in = false;
+    };
+    auto prob = [](const std::vector<std::pair<int32_t, float>> & v, int32_t id) {
+        for (const auto & e : v) if (e.first == id) return e.second;
+        return 0.0f;
+    };
+    std::vector<int32_t> result;
+    int i = 0;
+    for (; i < n_draft; ++i) {
+        const float q_x = prob(qc[i], draft[i]);
+        const float p_x = prob(pc[i], draft[i]);
+        bool accept = q_x > 0.0f && p_x >= l*q_x;
+        if (q_x > 0.0f && !accept) accept = (float) u_acc[i] < p_x / (l*q_x);
+        if (accept) {
+            const int32_t id = guard(draft[i]);
+            track(id); result.push_back(id);
+            if (id != draft[i]) break;
+            if (std::find(stop.begin(), stop.end(), id) != stop.end()) { i = -1; break; }
+            continue;
+        }
+        std::vector<std::pair<int32_t, float>> res;
+        float sum = 0.0f;
+        for (const auto & e : pc[i]) {
+            const float r = e.second - prob(qc[i], e.first);
+            if (r > 0.0f) { res.push_back({ e.first, r }); sum += r; }
+        }
+        int32_t id = sampled[i];
+        if (sum > 0.0f) {
+            float uu = (float) u_res * sum;
+            id = res.back().first;
+            for (const auto & e : res) { uu -= e.second; if (uu <= 0.0f) { id = e.first; break; } }
+        }
+        id = guard(id);
+        track(id); result.push_back(id);
+        break;
+    }
+    if (i == n_draft) {
+        const int32_t id = guard(sampled[i]);
+        track(id); result.push_back(id);
+    }
+    s.last = result.back();
+    s.pos += (int32_t) result.size();
+    return result;
+}
+
+static void test_accept_reject(ggml_backend_t backend, spec_accept_fn fn, std::mt19937 & rng) {
+    const int n_seq = 2048, n_row = 6, n_draft = n_row - 1, q_k = 8, n_rounds = 4;
+    const std::vector<int32_t> eog = { 2, 7, 9 };
+    const int32_t end_tok = 50;
+    const std::vector<int32_t> start = { 40, 41 };
+    const std::vector<std::vector<int32_t>> ends = { { 50 }, { 51, 52, 53 } };
+    ggml_spec_guard g = {};
+    g.on = 1; g.end = end_tok;
+    g.n_start = (int32_t) start.size();
+    for (size_t j = 0; j < start.size(); ++j) g.start[j] = start[j];
+    g.n_ends = (int32_t) ends.size();
+    for (size_t e = 0; e < ends.size(); ++e) {
+        g.n_end[e] = (int32_t) ends[e].size();
+        for (size_t j = 0; j < ends[e].size(); ++j) g.ends[e][j] = ends[e][j];
+    }
+    std::uniform_real_distribution<double> uu(0.0, 1.0);
+    const std::vector<int32_t> stop_ids = { 41, 55 };   // stage 5: stop tokens on odd rounds
+    for (float l : { 1.0f, 0.8663f }) {
+        dev_bufs d;
+        ggml_tensor * tt  = d.add(GGML_TYPE_I32, (int64_t) n_seq * n_row);
+        ggml_tensor * td  = d.add(GGML_TYPE_I32, (int64_t) n_seq * n_draft);
+        ggml_tensor * te  = d.add(GGML_TYPE_I32, (int64_t) eog.size());
+        ggml_tensor * ts  = d.add(GGML_TYPE_I8,  (int64_t) n_seq * sizeof(ggml_spec_seq));
+        ggml_tensor * tnc = d.add(GGML_TYPE_I32, (int64_t) n_seq * n_row);
+        ggml_tensor * tci = d.add(GGML_TYPE_I32, (int64_t) n_seq * n_row * GGML_SPEC_MAX_K);
+        ggml_tensor * tcp = d.add(GGML_TYPE_F32, (int64_t) n_seq * n_row * GGML_SPEC_MAX_K);
+        ggml_tensor * tqi = d.add(GGML_TYPE_I32, (int64_t) n_seq * n_draft * q_k);
+        ggml_tensor * tqp = d.add(GGML_TYPE_F32, (int64_t) n_seq * n_draft * q_k);
+        ggml_tensor * tua = d.add(GGML_TYPE_I8,  (int64_t) n_seq * n_draft * sizeof(double));
+        ggml_tensor * tur = d.add(GGML_TYPE_I8,  (int64_t) n_seq * sizeof(double));
+        ggml_tensor * tp  = d.add(GGML_TYPE_I32, (int64_t) stop_ids.size());
+        d.alloc(backend);
+        ggml_backend_tensor_set(te, eog.data(), 0, ggml_nbytes(te));
+        ggml_backend_tensor_set(tp, stop_ids.data(), 0, ggml_nbytes(tp));
+        std::vector<ggml_spec_seq> dseq(n_seq);
+        std::vector<ref_seq> rseq(n_seq);
+        for (int s = 0; s < n_seq; ++s) {
+            memset(&dseq[s], 0, sizeof(dseq[s]));
+            dseq[s].pos = rseq[s].pos = 1000 + s;
+            rseq[s].guard_in = dseq[s].guard_in = (s % 2);
+        }
+        ggml_backend_tensor_set(ts, dseq.data(), 0, ggml_nbytes(ts));
+        for (int round = 0; round < n_rounds; ++round) {
+            // a small alphabet: p and q overlap, guard tags and EOG appear
+            auto tok = [&]() { const int pick = (int) (rng() % 24); return pick < 3 ? eog[pick] : pick < 5 ? 40 + (pick - 3) : pick < 8 ? 50 + (pick - 5) : 53 + (pick - 8); };
+            std::vector<int32_t> sampled((size_t) n_seq * n_row), draft((size_t) n_seq * n_draft), nc((size_t) n_seq * n_row);
+            std::vector<int32_t> ci((size_t) n_seq * n_row * GGML_SPEC_MAX_K, -1), qi((size_t) n_seq * n_draft * q_k);
+            std::vector<float>   cp((size_t) n_seq * n_row * GGML_SPEC_MAX_K, 0.0f), qp((size_t) n_seq * n_draft * q_k);
+            std::vector<double>  ua((size_t) n_seq * n_draft), ur(n_seq);
+            std::vector<std::vector<std::vector<std::pair<int32_t, float>>>> pcs(n_seq), qcs(n_seq);
+            for (int s = 0; s < n_seq; ++s) {
+                pcs[s].resize(n_row); qcs[s].resize(n_draft);
+                for (int j = 0; j < n_row; ++j) {
+                    const int n = 1 + (int) (rng() % 12);
+                    std::vector<int32_t> ids;
+                    while ((int) ids.size() < n) { const int32_t t = tok(); if (std::find(ids.begin(), ids.end(), t) == ids.end()) ids.push_back(t); }
+                    std::vector<float> w(n); float sum = 0.0f;
+                    for (auto & v : w) { v = (float) uu(rng) + 0.01f; sum += v; }
+                    nc[(size_t) s * n_row + j] = n;
+                    for (int t = 0; t < n; ++t) {
+                        ci[((size_t) s * n_row + j) * GGML_SPEC_MAX_K + t] = ids[t];
+                        cp[((size_t) s * n_row + j) * GGML_SPEC_MAX_K + t] = w[t] / sum;
+                        pcs[s][j].push_back({ ids[t], w[t] / sum });
+                    }
+                    sampled[(size_t) s * n_row + j] = ids[rng() % n];
+                }
+                for (int j = 0; j < n_draft; ++j) {
+                    std::vector<int32_t> ids;
+                    while ((int) ids.size() < q_k) { const int32_t t = (int32_t) (rng() % 64); if (std::find(ids.begin(), ids.end(), t) == ids.end()) ids.push_back(t); }
+                    std::vector<float> w(q_k); float sum = 0.0f;
+                    for (auto & v : w) { v = (float) uu(rng) + 0.01f; sum += v; }
+                    for (int t = 0; t < q_k; ++t) {
+                        qi[((size_t) s * n_draft + j) * q_k + t] = ids[t];
+                        qp[((size_t) s * n_draft + j) * q_k + t] = w[t] / sum;
+                        qcs[s][j].push_back({ ids[t], w[t] / sum });
+                    }
+                    // the draft is one of q's candidates, often one p likes
+                    draft[(size_t) s * n_draft + j] = rng() % 2 ? pcs[s][j][0].first : ids[rng() % q_k];
+                    if (std::find(ids.begin(), ids.end(), draft[(size_t) s * n_draft + j]) == ids.end()) {
+                        qi[((size_t) s * n_draft + j) * q_k] = draft[(size_t) s * n_draft + j];
+                        qcs[s][j][0].first = draft[(size_t) s * n_draft + j];
+                    }
+                    ua[(size_t) s * n_draft + j] = uu(rng);
+                }
+                ur[s] = uu(rng);
+            }
+            ggml_backend_tensor_set(tt, sampled.data(), 0, ggml_nbytes(tt));
+            ggml_backend_tensor_set(td, draft.data(), 0, ggml_nbytes(td));
+            ggml_backend_tensor_set(tnc, nc.data(), 0, ggml_nbytes(tnc));
+            ggml_backend_tensor_set(tci, ci.data(), 0, ggml_nbytes(tci));
+            ggml_backend_tensor_set(tcp, cp.data(), 0, ggml_nbytes(tcp));
+            ggml_backend_tensor_set(tqi, qi.data(), 0, ggml_nbytes(tqi));
+            ggml_backend_tensor_set(tqp, qp.data(), 0, ggml_nbytes(tqp));
+            ggml_backend_tensor_set(tua, ua.data(), 0, ggml_nbytes(tua));
+            ggml_backend_tensor_set(tur, ur.data(), 0, ggml_nbytes(tur));
+            ggml_spec_accept_params p = {};
+            p.target = (const int32_t *) tt->data; p.draft = (const int32_t *) td->data;
+            p.eog = (const int32_t *) te->data; p.n_eog = (int32_t) eog.size();
+            p.n_seq = n_seq; p.n_row = n_row; p.guard = g; p.seq = (ggml_spec_seq *) ts->data;
+            p.n_cand = (const int32_t *) tnc->data; p.cand_id = (const int32_t *) tci->data; p.cand_p = (const float *) tcp->data;
+            p.q_id = (const int32_t *) tqi->data; p.q_p = (const float *) tqp->data; p.q_k = q_k;
+            p.lenience = l; p.u_acc = (const double *) tua->data; p.u_res = (const double *) tur->data;
+            const bool with_stop = round % 2 == 1;
+            p.stop = (const int32_t *) tp->data; p.n_stop = with_stop ? (int32_t) stop_ids.size() : 0;
+            fn(backend, &p);
+            ggml_backend_synchronize(backend);
+            ggml_backend_tensor_get(ts, dseq.data(), 0, ggml_nbytes(ts));
+            for (int s = 0; s < n_seq; ++s) {
+                const auto ref = ref_reject(rseq[s], n_draft, &draft[(size_t) s * n_draft], &sampled[(size_t) s * n_row], pcs[s], qcs[s],
+                                            l, &ua[(size_t) s * n_draft], ur[s], eog, end_tok, start, ends,
+                                            with_stop ? stop_ids : std::vector<int32_t>());
+                const ggml_spec_seq & ds = dseq[s];
+                bool same = ds.n_emit == (int32_t) ref.size() && ds.pos == rseq[s].pos && ds.last == rseq[s].last &&
+                            (ds.guard_in != 0) == rseq[s].guard_in;
+                for (size_t j = 0; same && j < ref.size(); ++j) same = ds.emit[j] == ref[j];
+                CHECK(same, "reject l %.4f round %d seq %d: n_emit %d/%zu pos %d/%d", l, round, s, ds.n_emit, ref.size(), ds.pos, rseq[s].pos);
+            }
+        }
+    }
+}
+
+//
+// stage 5: two sequences in one batch
+//
+
+// llama_kv_cache's bookkeeping of one stream, as far as a verify of two sequences touches it: find_slot() (from the head,
+// one cell at a time, the head back to 0 when it is far past the used cells), apply_ubatch() (the head after the last
+// cell), seq_rm() (the head at the first freed cell when that is lower)
+struct ref_kv {
+    std::vector<int> seq, pos;   // -1: empty
+    uint32_t head = 0;
+    int used() const { int n = 0; for (int x : seq) n += x >= 0; return n; }
+    std::vector<int> find(int n_tokens) const {
+        std::vector<int> res;
+        uint32_t h = head;
+        if (h > (uint32_t) (used() + 2*n_tokens) || h >= seq.size()) {
+            h = 0;
+        }
+        uint32_t tested = 0;
+        while ((int) res.size() < n_tokens && tested < seq.size()) {
+            if (h >= seq.size()) {
+                h = 0;
+            }
+            if (seq[h] < 0) {
+                res.push_back((int) h);
+            }
+            h++;
+            tested++;
+        }
+        return res;
+    }
+    void rm(int s, int p0) {
+        uint32_t nh = (uint32_t) seq.size();
+        for (uint32_t i = 0; i < seq.size(); ++i) {
+            if (seq[i] == s && pos[i] >= p0) {
+                seq[i] = -1;
+                pos[i] = -1;
+                if (nh == seq.size()) {
+                    nh = i;
+                }
+            }
+        }
+        if (nh != seq.size() && nh < head) {
+            head = nh;
+        }
+    }
+};
+
+// mode 1: one verify runs on the host first; mode 2: a third sequence held a run of cells between the prompts and was
+// removed (a freed region below the working cells).  The device starts from the host's cells as llama_step_cell_free()
+// reports them (the free cells below the highest used one, and the cell past it).
+static void test_cells2(ggml_backend_t backend, spec_write_fn fw, spec_accept_fn fa, std::mt19937 & rng, int mode) {
+    const bool host_first = mode == 1;
+    const int N_KV = 1024, W = 6, N = 2;
+    ref_kv kv;
+    kv.seq.assign(N_KV, -1);
+    kv.pos.assign(N_KV, -1);
+    // two prompts, as their prefill lays them out
+    int P[2] = { 37, 291 };
+    int c = 0;
+    for (int k = 0; k < N; ++k) {
+        for (int p = 0; p < P[k]; ++p, ++c) {
+            kv.seq[c] = k;
+            kv.pos[c] = p;
+        }
+        if (mode == 2 && k == 0) {
+            for (int p = 0; p < 200; ++p, ++c) {
+                kv.seq[c] = 2;
+                kv.pos[c] = p;
+            }
+        }
+    }
+    kv.head = c;
+    if (mode == 2) {
+        kv.rm(2, 0);
+    }
+    if (host_first) {
+        const std::vector<int> ref = kv.find(N * W);
+        for (int r = 0; r < N * W; ++r) {
+            kv.seq[ref[r]] = r / W;
+            kv.pos[ref[r]] = P[r / W] + r % W;
+        }
+        kv.head = ref.back() + 1;
+        for (int k = 0; k < N; ++k) {
+            P[k] += 1 + (int) (rng() % W);
+            kv.rm(k, P[k]);
+        }
+        c = 0;
+        for (int i = 0; i < N_KV; ++i) {
+            if (kv.seq[i] >= 0) {
+                c = i + 1;
+            }
+        }
+    }
+
+    dev_bufs d;
+    ggml_tensor * t_seq   = d.add(GGML_TYPE_I8,  N * sizeof(ggml_spec_seq));
+    ggml_tensor * t_cells = d.add(GGML_TYPE_I8,  sizeof(ggml_spec_cells));
+    ggml_tensor * t_cpos  = d.add(GGML_TYPE_I32, N * N_KV);
+    ggml_tensor * t_draft = d.add(GGML_TYPE_I32, N * (W - 1));
+    ggml_tensor * t_tgt   = d.add(GGML_TYPE_I32, N * W);
+    ggml_tensor * t_eog   = d.add(GGML_TYPE_I32, 1);
+    ggml_tensor * t_tok   = d.add(GGML_TYPE_I32, N * W);
+    ggml_tensor * t_pos   = d.add(GGML_TYPE_I32, 4 * N * W);
+    ggml_tensor * t_k     = d.add(GGML_TYPE_I64, N * W);
+    ggml_tensor * t_v     = d.add(GGML_TYPE_I64, N * W);
+    ggml_tensor * t_mask  = d.add(GGML_TYPE_F16, (int64_t) N_KV * N * W);
+    ggml_tensor * t_free  = d.add(GGML_TYPE_I32, N_KV);
+    d.alloc(backend);
+
+    ggml_spec_seq st[N] = {};
+    for (int k = 0; k < N; ++k) {
+        st[k].pos  = P[k];
+        st[k].last = 100 + k;
+    }
+    ggml_spec_cells cells = {};
+    cells.top = c;
+    std::vector<int32_t> free_cells;
+    for (int i = 0; i < c; ++i) {
+        if (kv.seq[i] < 0) {
+            free_cells.push_back(i);
+        }
+    }
+    if (!free_cells.empty()) {
+        ggml_backend_tensor_set(t_free, free_cells.data(), 0, free_cells.size() * sizeof(int32_t));
+    }
+    cells.free_list = (const int32_t *) t_free->data;
+    cells.n_free    = (int32_t) free_cells.size();
+    std::vector<int32_t> cpos(N * N_KV, -1);
+    for (int i = 0; i < N_KV; ++i) {
+        if (kv.seq[i] >= 0) {
+            cpos[kv.seq[i] * N_KV + i] = kv.pos[i];
+        }
+    }
+    ggml_backend_tensor_set(t_seq, st, 0, sizeof(st));
+    ggml_backend_tensor_set(t_cells, &cells, 0, sizeof(cells));
+    ggml_backend_tensor_set(t_cpos, cpos.data(), 0, cpos.size() * sizeof(int32_t));
+
+    ggml_spec_write_params wp = {};
+    wp.seq = (ggml_spec_seq *) t_seq->data;
+    wp.draft = (const int32_t *) t_draft->data;
+    wp.n_seq = N;
+    wp.n_row = W;
+    wp.n_pos_sections = 4;
+    wp.tokens = (int32_t *) t_tok->data;
+    wp.pos = (int32_t *) t_pos->data;
+    wp.k_idxs = (int64_t *) t_k->data;
+    wp.v_idxs = (int64_t *) t_v->data;
+    wp.kq_mask = (uint16_t *) t_mask->data;
+    wp.n_kv = N_KV;
+    wp.cell_pos = (int32_t *) t_cpos->data;
+    wp.cell_pos_stride = N_KV;
+    wp.cells = (ggml_spec_cells *) t_cells->data;
+
+    ggml_spec_accept_params ap = {};
+    ap.target = (const int32_t *) t_tgt->data;
+    ap.draft  = (const int32_t *) t_draft->data;
+    ap.eog    = (const int32_t *) t_eog->data;
+    ap.n_eog  = 0;
+    ap.n_seq  = N;
+    ap.n_row  = W;
+    ap.seq    = (ggml_spec_seq *) t_seq->data;
+    ap.cells  = (ggml_spec_cells *) t_cells->data;
+    ap.cell_pos = (int32_t *) t_cpos->data;
+    ap.cell_pos_stride = N_KV;
+
+    int pos[N] = { P[0], P[1] };
+    std::vector<int64_t> kidx(N * W);
+    std::vector<uint16_t> mask((size_t) N_KV * N * W);
+    for (int step = 0; step < 60; ++step) {
+        // the host: the verify's cells, sequence-major
+        const std::vector<int> ref = kv.find(N * W);
+        CHECK((int) ref.size() == N * W, "cells2 step %d: the reference found %zu cells", step, ref.size());
+        for (int r = 0; r < N * W; ++r) {
+            kv.seq[ref[r]] = r / W;
+            kv.pos[ref[r]] = pos[r / W] + r % W;
+        }
+        kv.head = ref.back() + 1;
+        // the device
+        std::vector<int32_t> draft(N * (W - 1)), tgt(N * W);
+        int n_emit[N];
+        for (int k = 0; k < N; ++k) {
+            n_emit[k] = 1 + (int) (rng() % W);
+            for (int j = 0; j < W; ++j) {
+                tgt[k * W + j] = 1000 + (int) (rng() % 1000);
+            }
+            for (int j = 0; j < W - 1; ++j) {
+                draft[k * (W - 1) + j] = j < n_emit[k] - 1 ? tgt[k * W + j] : tgt[k * W + j] + 1;
+            }
+        }
+        ggml_backend_tensor_set(t_draft, draft.data(), 0, draft.size() * sizeof(int32_t));
+        ggml_backend_tensor_set(t_tgt, tgt.data(), 0, tgt.size() * sizeof(int32_t));
+        fw(backend, &wp);
+        ggml_backend_synchronize(backend);
+        ggml_backend_tensor_get(t_k, kidx.data(), 0, kidx.size() * sizeof(int64_t));
+        ggml_backend_tensor_get(t_mask, mask.data(), 0, mask.size() * sizeof(uint16_t));
+        for (int r = 0; r < N * W; ++r) {
+            CHECK(kidx[r] == ref[r], "cells2 step %d row %d: device cell %lld, host %d", step, r, (long long) kidx[r], ref[r]);
+        }
+        int n_bad = 0;
+        for (int r = 0; r < N * W; ++r) {
+            const int k = r / W, p = pos[k] + r % W;
+            for (int j = 0; j < N_KV; ++j) {
+                const bool vis = kv.seq[j] == k && kv.pos[j] <= p;
+                n_bad += (mask[(size_t) r * N_KV + j] == 0x0000) != vis;
+            }
+        }
+        CHECK(n_bad == 0, "cells2 step %d: %d mask entries differ", step, n_bad);
+        fa(backend, &ap);
+        ggml_backend_synchronize(backend);
+        ggml_backend_tensor_get(t_seq, st, 0, sizeof(st));
+        for (int k = 0; k < N; ++k) {
+            CHECK(st[k].n_emit == n_emit[k], "cells2 step %d seq %d: emitted %d, wanted %d", step, k, st[k].n_emit, n_emit[k]);
+            pos[k] += n_emit[k];
+            CHECK(st[k].pos == pos[k], "cells2 step %d seq %d: position %d, wanted %d", step, k, st[k].pos, pos[k]);
+            kv.rm(k, pos[k]);
+        }
+    }
+    // the device's position tables are the host's cells
+    ggml_backend_tensor_get(t_cpos, cpos.data(), 0, cpos.size() * sizeof(int32_t));
+    int n_bad = 0;
+    for (int k = 0; k < N; ++k) {
+        for (int j = 0; j < N_KV; ++j) {
+            n_bad += cpos[k * N_KV + j] != (kv.seq[j] == k ? kv.pos[j] : -1);
+        }
+    }
+    CHECK(n_bad == 0, "cells2: %d position table entries differ from the host's cells", n_bad);
+}
+
+// the drafter's inputs of two sequences are those of each sequence on its own, side by side
+static void test_draft2(ggml_backend_t backend, spec_wdraft_fn fd, std::mt19937 & rng) {
+    const int W = 6, N = 2, N_KV = 2 * 2304, N_CELLS = 2304;
+    dev_bufs d;
+    ggml_tensor * t_seq  = d.add(GGML_TYPE_I8,  N * sizeof(ggml_spec_seq));
+    ggml_tensor * t_tok  = d.add(GGML_TYPE_I32, N * W);
+    ggml_tensor * t_pos  = d.add(GGML_TYPE_I32, 4 * N * W);
+    ggml_tensor * t_k    = d.add(GGML_TYPE_I64, N * W);
+    ggml_tensor * t_mask = d.add(GGML_TYPE_F16, (int64_t) N_KV * N * W);
+    ggml_tensor * t_tok1  = d.add(GGML_TYPE_I32, W);
+    ggml_tensor * t_pos1  = d.add(GGML_TYPE_I32, 4 * W);
+    ggml_tensor * t_k1    = d.add(GGML_TYPE_I64, W);
+    ggml_tensor * t_mask1 = d.add(GGML_TYPE_F16, (int64_t) N_KV * W);
+    d.alloc(backend);
+    for (int it = 0; it < 20; ++it) {
+        ggml_spec_seq st[N] = {};
+        for (int k = 0; k < N; ++k) {
+            st[k].pos       = 50 + (int) (rng() % 6000);
+            st[k].last      = 7 + k;
+            st[k].dcell_off = k * N_CELLS;
+            st[k].dpos_min  = (int) (rng() % 2) ? 0 : st[k].pos - (int) (rng() % 100);
+        }
+        ggml_backend_tensor_set(t_seq, st, 0, sizeof(st));
+        ggml_spec_draft_params p = {};
+        p.seq = (const ggml_spec_seq *) t_seq->data;
+        p.n_seq = N;
+        p.mode = GGML_SPEC_DRAFT_BLOCK;
+        p.n_row = W;
+        p.n_pos_sections = 4;
+        p.mask_token = 99;
+        p.window = 2048;
+        p.n_kv = N_KV;
+        p.mask_ring = 0;
+        p.n_cells = N_CELLS;
+        p.tokens = (int32_t *) t_tok->data;
+        p.pos = (int32_t *) t_pos->data;
+        p.k_idxs = (int64_t *) t_k->data;
+        p.v_idxs = nullptr;
+        p.kq_mask = (uint16_t *) t_mask->data;
+        fd(backend, &p);
+        std::vector<int32_t> tok(N * W), pos(4 * N * W);
+        std::vector<int64_t> kk(N * W);
+        std::vector<uint16_t> mask((size_t) N_KV * N * W);
+        ggml_backend_synchronize(backend);
+        ggml_backend_tensor_get(t_tok, tok.data(), 0, tok.size() * sizeof(int32_t));
+        ggml_backend_tensor_get(t_pos, pos.data(), 0, pos.size() * sizeof(int32_t));
+        ggml_backend_tensor_get(t_k, kk.data(), 0, kk.size() * sizeof(int64_t));
+        ggml_backend_tensor_get(t_mask, mask.data(), 0, mask.size() * sizeof(uint16_t));
+        for (int k = 0; k < N; ++k) {
+            ggml_spec_draft_params q = p;
+            q.seq = (const ggml_spec_seq *) t_seq->data + k;
+            q.n_seq = 1;
+            q.tokens = (int32_t *) t_tok1->data;
+            q.pos = (int32_t *) t_pos1->data;
+            q.k_idxs = (int64_t *) t_k1->data;
+            q.kq_mask = (uint16_t *) t_mask1->data;
+            fd(backend, &q);
+            std::vector<int32_t> tok1(W), pos1(4 * W);
+            std::vector<int64_t> kk1(W);
+            std::vector<uint16_t> mask1((size_t) N_KV * W);
+            ggml_backend_synchronize(backend);
+            ggml_backend_tensor_get(t_tok1, tok1.data(), 0, tok1.size() * sizeof(int32_t));
+            ggml_backend_tensor_get(t_pos1, pos1.data(), 0, pos1.size() * sizeof(int32_t));
+            ggml_backend_tensor_get(t_k1, kk1.data(), 0, kk1.size() * sizeof(int64_t));
+            ggml_backend_tensor_get(t_mask1, mask1.data(), 0, mask1.size() * sizeof(uint16_t));
+            for (int r = 0; r < W; ++r) {
+                CHECK(tok[k * W + r] == tok1[r] && kk[k * W + r] == kk1[r], "draft2 it %d seq %d row %d: token or cell differs", it, k, r);
+                for (int sct = 0; sct < 4; ++sct) {
+                    CHECK(pos[sct * N * W + k * W + r] == pos1[sct * W + r], "draft2 it %d seq %d row %d: position differs", it, k, r);
+                }
+            }
+            CHECK(memcmp(mask.data() + (size_t) k * W * N_KV, mask1.data(), mask1.size() * sizeof(uint16_t)) == 0,
+                  "draft2 it %d seq %d: mask differs", it, k);
+        }
+    }
+}
+
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (!dev) {
+        printf("test-spec-step: no GPU device, skipped\n");
+        return 0;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    auto f_argmax = (spec_argmax_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_argmax");
+    auto f_accept = (spec_accept_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_accept");
+    auto f_walk   = (spec_walk_fn)   ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_walk");
+    if (!f_argmax || !f_accept || !f_walk) {
+        printf("test-spec-step: %s exports no spec-step launchers, skipped\n", ggml_backend_reg_name(reg));
+        return 0;
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    std::mt19937 rng(42);
+
+    test_argmax(backend, f_argmax, rng);
+    test_accept(backend, f_accept, rng);
+    test_walk(backend, f_walk, rng);
+    test_walk_sample(backend, f_walk, rng);
+    test_accept_reject(backend, f_accept, rng);
+    auto f_write  = (spec_write_fn)  ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_write_verify");
+    auto f_wdraft = (spec_wdraft_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_write_draft");
+    if (f_write && f_wdraft) {
+        for (int mode = 0; mode < 3; ++mode) {
+            test_cells2(backend, f_write, f_accept, rng, mode);
+        }
+        test_draft2(backend, f_wdraft, rng);
+    } else {
+        CHECK(false, "no ggml_backend_cuda_spec_write_verify / write_draft");
+    }
+    if (auto f_sample = (spec_sample_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_sample")) {
+        test_sample(backend, f_sample, rng);
+    } else {
+        CHECK(false, "no ggml_backend_cuda_spec_sample");
+    }
+
+    ggml_backend_free(backend);
+    printf("test-spec-step: %s\n", n_fail ? "FAIL" : "OK");
+    return n_fail ? 1 : 0;
+}
