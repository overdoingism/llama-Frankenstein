+const float * llama_context::step_graph_output(int32_t which, int32_t kind, int64_t ne[2], int64_t * row_stride) {
+    llm_graph_result * res = step_res(which);
+    ggml_tensor * t = res == nullptr ? nullptr : kind == 0 ? res->get_logits() : res->get_h_nextn();
+    if (t == nullptr || t->buffer == nullptr || ggml_backend_buffer_is_host(t->buffer)) {
+        return nullptr;
+    }
+    if (ne) {
+        ne[0] = t->ne[0];
+        ne[1] = t->ne[1];
+    }
+    if (row_stride) {
+        *row_stride = (int64_t) (t->nb[1] / sizeof(float));
+    }
+    return (const float *) t->data;
+}
