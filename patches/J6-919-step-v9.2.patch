+            }
+            wkk.temp = temp[k]->chain.temp;
+            wkk.q_id = (int32_t *) a->t_qid->data + (int64_t) k * n_draft * top_k;
+            wkk.q_p  = (float *)   a->t_qp->data  + (int64_t) k * n_draft * top_k;
+            ggml_spec_sample_params & sp = a->lp_sample_k[k];
+            sp = {};
+            sp.logits     = a->logits + (int64_t) k * W * a->logits_stride;
+            sp.n_rows     = W;
+            sp.n_vocab    = a->n_vocab;
+            sp.row_stride = a->logits_stride;
+            sp.chain      = temp[k]->chain;
+            sp.u_ring     = (const double *) rd_.t->data;
+            sp.n_u_ring   = (int32_t) rd_.n;
+            sp.u_pos0     = st[k].pos;
+            sp.seq        = (const ggml_spec_seq *) a->t_seq->data + k;
+            sp.n_cand     = (int32_t *) a->t_nc->data  + k * W;
+            sp.cand_id    = (int32_t *) a->t_cid->data + (int64_t) k * W * GGML_SPEC_MAX_K;
+            sp.cand_p     = (float *)   a->t_cp->data  + (int64_t) k * W * GGML_SPEC_MAX_K;
+            sp.sampled    = (int32_t *) a->t_smp->data + k * W;
+            ak.target     = sp.sampled;
+            ak.n_cand     = sp.n_cand;
+            ak.cand_id    = sp.cand_id;
+            ak.cand_p     = sp.cand_p;
+            ak.q_id       = wkk.q_id;
+            ak.q_p        = wkk.q_p;
+            ak.q_k        = top_k;
+            ak.lenience   = temp[k]->lenience;
+            ak.rng        = (const double *) rr_.t->data;
+            ak.n_rng_ring = (int32_t) rr_.n;
+        }
+        a->lp_cells = ac;
+        a->lp_cells.cells_only = 1;
+        if (!step_loop_refill(a)) {
+            return step_loop_fail(a, "two sequences: the host's streams of draws");
+        }
+    }
+
+    static const bool one_stream = [] {
+        const char * e = getenv("FRANK_STEP_ONE_STREAM");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (one_stream && a->share_stream != nullptr && a->backend_d != a->backend) {
+        a->shared = a->share_stream(a->backend_d, a->backend);
+    }
+    a->loop_on = true;
+    a->n_loops++;
+    a->n_loops2 += N > 1;
+    return true;
+}
+
+int64_t common_step_loop_cell_pos(common_step_audit * a, int k, int32_t * out, int64_t n) {
+    if (a == nullptr || a->loop_on || a->t_cpos == nullptr || k < 0 || k >= a->n_seq || n > a->n_cpos) {
+        return -1;
+    }
+    ggml_backend_tensor_get(a->t_cpos, out, (size_t) k * a->cpos_stride * sizeof(int32_t), (size_t) n * sizeof(int32_t));
+    return n;
+}
+
+int32_t common_step_loop_n_seq(const common_step_audit * a) {
+    return a == nullptr ? 0 : a->n_seq;
+}
+
+int64_t common_step_loop_n_cpos(const common_step_audit * a) {
+    return a == nullptr ? 0 : a->n_cpos;
+}
+
+// FRANK_STEP_CHECK (on unless 0): the host checks each loop step's result against the step before it -- the position moved
+// by the tokens emitted, the last token, the recurrent state's parity and rows -- and, for a greedy sequence without a
+// reasoning-guard replacement, the acceptance itself: the emitted tokens are the target's, the accepted drafts equal them,
+// and the step ended at the first draft that differs (or at an end of generation or a stop token).  A mismatch is logged and
+// the loop issues no more steps (the host takes the state again from the device, step_audit_follow).  The step's results
+// are already read back; the targets add N * W tokens to the same copy.
+static bool step_check_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_STEP_CHECK");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+static void step_loop_check(common_step_audit * a, int slot) {
+    const step_ring_entry & e = a->ring[slot];
+    const int W = a->n_row;
+    for (int k = 0; k < a->n_seq; ++k) {
+        const ggml_spec_seq & s = e.seq[k];
+        ggml_spec_seq &       p = a->chk_prev[k];
+        const bool greedy = a->cells_mode ? !a->temp_k[k] : !a->temp_mode;
+        const char * why = nullptr;
+        if (s.n_emit < 1 || s.n_emit > W) {
+            why = "the emitted count";
+        } else if (s.pos != p.pos + s.n_emit) {
+            why = "the position";
+        } else if (s.last != s.emit[s.n_emit - 1]) {
+            why = "the last token";
+        } else if (a->rs_size > 0 && (s.rs_fpar != (p.rs_fpar ^ 1) || s.n_row_prev != W || s.rs_cell != p.rs_cell)) {
+            why = "the recurrent state";
+        } else if (greedy && !s.guard_hit) {
+            const int32_t * t = e.target + (int64_t) k * W;
+            const int32_t * d = e.drafts + (int64_t) k * (W - 1);
+            for (int j = 0; j < s.n_emit && why == nullptr; ++j) {
+                if (s.emit[j] != t[j]) {
+                    why = "an emitted token is not the target's";
+                }
+            }
+            for (int j = 0; j + 1 < s.n_emit && why == nullptr; ++j) {
+                if (d[j] != t[j]) {
+                    why = "an accepted draft is not the target's";
+                }
+            }
+            const int j = s.n_emit - 1;
+            auto is_stop = [&](int32_t id) {
+                for (const auto & v : a->stop_host) {
+                    if (std::binary_search(v.begin(), v.end(), id)) {
+                        return true;
+                    }
+                }
+                return false;
+            };
+            if (why == nullptr && s.n_emit < W && d[j] == t[j] && !s.eog && !is_stop(t[j])) {
+                why = "the step ended at a draft equal to the target's";
+            }
+        }
+        a->n_chk++;
+        if (why != nullptr) {
+            a->n_chk_bad++;
+            if (a->n_chk_bad <= 20) {
+                LOG_WRN("%s: loop step %lld, sequence %d: %s (emitted %d, position %d after %d, last %d) -- the loop issues no more steps\n",
+                        __func__, (long long) a->n_done, k, why, s.n_emit, s.pos, p.pos, s.last);
+            }
+            a->chk_halt = true;
+        }
+        p = s;
+    }
+}
+
+bool common_step_loop_issue(common_step_audit * a) {
+    if (a == nullptr || !a->loop_on) {
+        return false;
+    }
+    if (step_check_on()) {
+        if (a->n_issued == 0) {
+            // the state the first step starts from (common_step_loop_begin / _begin2 set it on the device)
+            ggml_backend_synchronize(a->backend);
+            ggml_backend_tensor_get(a->t_seq, a->chk_prev, 0, (size_t) a->n_seq * sizeof(ggml_spec_seq));
+            a->chk_halt = false;
+        } else if (a->chk_halt) {
+            return false;
+        }
+    }
+    const int32_t W = a->n_row;
+    const int     N = a->n_seq;
+    // the steps in flight may each advance by W; this one then writes W more positions, and must start where the host
+    // would still draft at full width.  Two sequences: their cells also come from the top, at most N*W a step.
+    for (int k = 0; k < N; ++k) {
+        if ((int64_t) a->pos_known[k] + (int64_t) W * (a->n_issued - a->n_done + 1) > a->pos_limit[k] ||
+            (int64_t) a->pos_known[k] + (int64_t) W * (a->n_issued - a->n_done) > a->pos_start_max[k]) {
+            return false;
+        }
+    }
+    if (a->cells_mode && (int64_t) a->top_known + (int64_t) N * W * (a->n_issued - a->n_done + 1) > a->cell_limit) {
+        return false;
+    }
+    const bool per_seq = a->cells_mode && a->temp_mode;   // each sequence walked, sampled and accepted on its own
+    if (a->temp_mode) {
+        if (!step_loop_refill(a)) {
+            return false;
+        }
+        // the drafter's draws of this step
+        if (per_seq) {
+            for (int k = 0; k < N; ++k) {
+                const step_draw_ring & rw = k == 0 ? a->r_walk : a->r_walk1;
+                a->lp_walk_k[k].u = a->temp_k[k] ? (const double *) rw.t->data + (a->n_issued * a->lp_walk.n_draft) % rw.n : nullptr;
+            }
+        } else {
+            a->lp_walk.u = (const double *) a->r_walk.t->data + (a->n_issued * a->lp_walk.n_draft) % a->r_walk.n;
+        }
+    }
+    ggml_backend_t bt = a->backend;
+    ggml_backend_t bd = a->backend_d;
+    llama_context * cd = a->ctx_dft;
+    const int slot = (int) (a->n_issued % 2);
+
+    // 1. the drafter's block from the last acceptance, and the drafts walked from its lattice
+    if (a->n_issued > 0) {
+        ggml_backend_event_wait(bd, a->ev_acc);
+    }
+    a->wdraft(bd, &a->lp_block);
+    if (llama_step_replay(cd, 1) != 0) {
+        LOG_ERR("%s: replaying the drafter's block failed\n", __func__);
+        return false;
+    }
+    if (per_seq) {
+        for (int k = 0; k < N; ++k) {
+            a->walk(bd, &a->lp_walk_k[k]);
+        }
+    } else {
+        a->walk(bd, &a->lp_walk);
+    }
+    ggml_backend_event_record(a->ev_walk, bd);
+
+    // 2. the target's verify of [last, drafts]
+    ggml_backend_event_wait(bt, a->ev_walk);
+    a->write(bt, &a->lp_write);
+    if (llama_step_replay(a->ctx_tgt, 0) != 0) {
+        LOG_ERR("%s: replaying the target's verify failed\n", __func__);
+        return false;
+    }
+    ggml_backend_event_record(a->ev_ver, bt);
+
+    // 3. the drafter's injection of the verify's rows, at the positions before the acceptance
+    ggml_backend_event_wait(bd, a->ev_ver);
+    for (int k = 0; k < N; ++k) {
+        // two sequences: the host injects each one's rows on its own, into the one graph the drafter holds
+        a->wdraft(bd, a->cells_mode ? &a->lp_inject_k[k] : &a->lp_inject);
+        if (k == N - 1) {
+            ggml_backend_event_record(a->ev_inj, bd);
+        }
+        if (llama_step_replay(cd, 0) != 0) {
+            LOG_ERR("%s: replaying the drafter's injection failed\n", __func__);
+            return false;
+        }
+    }
+    llama_step_layer_inp_read(cd);
+
+    // 4. the acceptance, once the injection's writer has read the state; the result goes to the host's ring
+    for (int k = 0; k < N; ++k) {
+        if (k == 0 ? a->no_eog : a->no_eog_1) {
+            a->suppress(bt, const_cast<float *>(a->logits) + (int64_t) k * W * a->logits_stride, W, a->logits_stride,
+                        (const int32_t *) a->t_eog->data, a->n_eog);
+        }
+    }
+    if (per_seq) {
+        for (int k = 0; k < N; ++k) {
+            if (a->temp_k[k]) {
+                a->sample(bt, &a->lp_sample_k[k]);
+            } else {
+                a->argmax(bt, a->logits + (int64_t) k * W * a->logits_stride, W, a->n_vocab, a->logits_stride,
+                          (int32_t *) a->t_target->data + k * W);
+            }
+        }
+        ggml_backend_event_wait(bt, a->ev_inj);
+        for (int k = 0; k < N; ++k) {
+            a->accept(bt, &a->lp_accept_k[k]);
+        }
+        a->accept(bt, &a->lp_cells);
+    } else {
+        if (a->temp_mode) {
+            a->sample(bt, &a->lp_sample);
+        } else {
+            a->argmax(bt, a->logits, (int64_t) N * W, a->n_vocab, a->logits_stride, (int32_t *) a->t_target->data);
+        }
+        ggml_backend_event_wait(bt, a->ev_inj);
+        a->accept(bt, &a->lp_accept);
+    }
+    ggml_backend_tensor_get_async(bt, a->t_seq, a->ring[slot].seq, 0, N * sizeof(ggml_spec_seq));
+    ggml_backend_tensor_get_async(bt, a->t_walk, a->ring[slot].drafts, 0, (size_t) N * (W - 1) * sizeof(int32_t));
+    if (step_check_on()) {
+        ggml_backend_tensor_get_async(bt, a->t_target, a->ring[slot].target, 0, (size_t) N * W * sizeof(int32_t));
+    }
+    if (a->cells_mode) {
+        ggml_backend_tensor_get_async(bt, a->t_cells, &a->ring[slot].top, offsetof(ggml_spec_cells, top), sizeof(int32_t));
+    }
+    ggml_backend_event_record(a->ev_acc, bt);
+    ggml_backend_event_record(a->ev_host[slot], bt);
+    a->n_issued++;
+    a->n_loop_steps++;
+    a->n_loop2_steps += N > 1;   // (one sequence set up by common_step_loop_begin2() counts as one)
+    return true;
+}
+
+int64_t common_step_loop_pending(const common_step_audit * a) {
+    return a == nullptr ? 0 : a->n_issued - a->n_done;
+}
+
+const ggml_spec_seq * common_step_loop_wait(common_step_audit * a) {
+    if (a == nullptr || !a->loop_on || a->n_done >= a->n_issued) {
+        return nullptr;
+    }
+    const int slot = (int) (a->n_done % 2);
+    ggml_backend_event_synchronize(a->ev_host[slot]);
+    a->n_done++;
+    if (step_check_on()) {
+        step_loop_check(a, slot);
+    }
+    for (int k = 0; k < a->n_seq; ++k) {
+        a->pos_known[k] = a->ring[slot].seq[k].pos;
+    }
+    a->top_known   = a->ring[slot].top;
+    a->n_rng_known = a->ring[slot].seq[0].n_rng;
+    a->n_rng_known1 = a->n_seq > 1 ? a->ring[slot].seq[1].n_rng : 0;
+    return a->ring[slot].seq;
+}
+
+bool common_step_loop_end(common_step_audit * a, ggml_spec_seq * last_exec) {
+    if (a == nullptr || !a->loop_on) {
+        return false;
+    }
+    ggml_backend_synchronize(a->backend_d);
+    ggml_backend_synchronize(a->backend);
+    if (a->shared) {
+        a->share_stream(a->backend_d, nullptr);
+        a->shared = false;
+    }
+    a->loop_on = false;
+    a->ready   = false;   // the next host step checks the state again
+    if (a->n_issued == 0) {
+        return false;
+    }
+    for (int k = 0; k < a->n_seq; ++k) {
+        last_exec[k] = a->ring[(a->n_issued - 1) % 2].seq[k];
+    }
+    if (a->n_loops % 16 == 1 || step_debug_level() >= 1) {
+        LOG_INF("%s: %lld loops (%lld of two sequences), %lld device steps (%lld of two; this one %lld); host checks %lld, %lld mismatches\n", __func__,
+                (long long) a->n_loops, (long long) a->n_loops2, (long long) a->n_loop_steps, (long long) a->n_loop2_steps,
+                (long long) a->n_issued, (long long) a->n_chk, (long long) a->n_chk_bad);
+    }
+    return true;
+}
+
+const int32_t * common_step_loop_last_drafts(const common_step_audit * a) {
+    if (a == nullptr || a->n_done == 0) {
+        return nullptr;
+    }
+    return a->ring[(a->n_done - 1) % 2].drafts;
+}
diff --git a/common/step-audit.h b/common/step-audit.h
new file mode 100644
index 000000000..1681c61c5
--- /dev/null
+++ b/common/step-audit.h
@@ -0,0 +1,117 @@
+#pragma once
+
+// BigOne, stage 1a.3 part A: the device-side acceptance (ggml-spec-step.h) checked against the host's, step by
+// step, inside the host loop.  FRANK_STEP_AUDIT=1 turns it on.  For a greedy request, after the host has
+// accepted, the target's argmax and the acceptance run again on the device from the same logits, drafts and
+// reasoning-guard state, and the emitted tokens and the guard state must be the same; the host's result is the
+// one that is used.  Mismatches are logged (the first ones in full) with a summary every 64 checked steps.
+//
+// Part A2: the sequence's device state is kept across steps (position, last token, KV cell offset), and before
+// the next verify decode the device writes that verify's tokens, positions and KV cells into the target's step
+// slab (needs FRANK_STEP_SLAB=1); the slab compares them with what set_inputs() writes.  A state that does not
+// follow the host's (a new request, a rejected guard check) is taken again from the host and counted.
+
+#include "llama.h"
+#include "sampling.h"
+#include "ggml-spec-step.h"
+
+#include <vector>
+
+struct common_step_audit;
+struct common_speculative;
+
+// 1b: a request with a temperature -- its sampler chain and lenience, and the slot's sampler and speculator, whose
+// streams of uniforms the loop takes in the order the host would
+struct common_step_loop_temp {
+    ggml_spec_chain      chain;
+    float                lenience = 1.0f;
+    common_sampler     * smpl     = nullptr;
+    common_speculative * spec     = nullptr;
+};
+
+// nullptr when the audit is off, or the context has no GPU backend exporting the launchers
+common_step_audit * common_step_audit_init(llama_context * ctx_tgt);
+void                common_step_audit_free(common_step_audit * a);
+
+// idxs: the batch rows of the verify (draft.size() + 1); pre: the guard state before the host's acceptance;
+// accepted: what the host emitted; post_in: the host's guard state after it
+void common_step_audit_accept(common_step_audit * a, llama_context * ctx_tgt, const std::vector<int> & idxs,
+                              const llama_tokens & draft, const common_rguard_view & pre,
+                              const std::vector<llama_token> & accepted, bool post_in);
+
+// a host step of a request with a temperature (the device does not accept for it): the device state takes the host's
+// result, so the loop can start after it
+void common_step_audit_adopt(common_step_audit * a, llama_context * ctx_tgt, const llama_tokens & draft,
+                             const common_rguard_view & post, const std::vector<llama_token> & accepted);
+
+// stage 5: the tokens a step ends after (a lazy grammar's trigger tokens while it awaits them; common_sampler_trigger_stop_*),
+// for the acceptance of host steps that follow and of the loop's steps; false (none set) if there are too many
+bool common_step_audit_set_stop(common_step_audit * a, const std::vector<llama_token> & ids);
+// the second sequence's, for common_step_loop_begin2()
+bool common_step_audit_set_stop1(common_step_audit * a, const std::vector<llama_token> & ids);
+
+// around the target's verify decode: the device writes that decode's inputs from its state and these drafts
+void common_step_audit_arm   (common_step_audit * a, const llama_tokens & draft);
+void common_step_audit_disarm(common_step_audit * a);
+
+// Part A5, the DFlash2 drafter: around its inject decode (before the acceptance) and its block decode (after it)
+// the device writes the drafter graph's inputs (ggml_spec_draft_params) from the same state; after each, the state
+// the drafter needs (its cell offset; the mask token and window) is taken from the host's fill when it is missing
+// or does not follow, and after the block the device walks the lattice and the drafts are compared with the host's
+void common_step_audit_arm_draft  (common_step_audit * a, llama_context * ctx_dft, bool block);
+void common_step_audit_after_draft(common_step_audit * a, llama_context * ctx_dft, bool block,
+                                   const llama_tokens & host_draft, int32_t top_k);
+
+// Part B (FRANK_STEP_LOOP=1, implies the slab and the checks above): the GPU-resident loop.  After a host step that was
+// checked equal, the loop replays the three graphs the contexts hold (the drafter's block, the target's verify, the
+// drafter's injection) with inputs written on the device, accepts on the device, and hands each step's state to the host
+// through a pinned ring; the host never waits between steps (it issues one step ahead).
+bool common_step_loop_ready(const common_step_audit * a);
+// set the loop up from the graphs the contexts hold; false: not now, the host path goes on.  pos_max: positions at and
+// above it are not written (the context's end); pos, last: the slot's next position and last token (checked against the
+// device state); no_eog: the request ignores the end of generation (its tokens get -inf logits before the argmax);
+// pos_start_max: the last position a step may start at (beyond it the host drafts fewer tokens, near n_predict)
+bool common_step_loop_begin(common_step_audit * a, llama_seq_id seq_id, const common_rguard_view & guard, int32_t top_k,
+                            int32_t n_draft, int32_t pos_max, llama_pos pos, llama_token last, bool no_eog,
+                            const common_step_loop_temp * temp, int32_t pos_start_max);
+// issue one step; false if another step might not fit the graphs' cells (the loop then ends)
+bool common_step_loop_issue(common_step_audit * a);
+int64_t common_step_loop_pending(const common_step_audit * a);
+// the oldest issued step's state after its acceptance (emit[0..n_emit), eog, pos); waits for it
+const ggml_spec_seq * common_step_loop_wait(common_step_audit * a);
+// wait for the device; last_exec[n_seq]: the state after the last issued step (false if none was)
+bool common_step_loop_end(common_step_audit * a, ggml_spec_seq * last_exec);
+// 1b, after common_step_loop_end(): advance the host's streams past the draws of the committed steps (emitted: their
+// tokens; n_rng: the sampler stream's draws, from the last committed state; n_steps: their count)
+void common_step_loop_advance(common_step_audit * a, int64_t emitted, int64_t n_rng, int64_t n_steps);
+// the drafts of the step common_step_loop_wait() returned last (n_draft of them), for debugging
+const int32_t * common_step_loop_last_drafts(const common_step_audit * a);
+
+// stage 5: the loop over two sequences in one batch (FRANK_STEP_LOOP_SEQ2=1 with FRANK_STEP_LOOP=1), when the last host step
+// verified both slots together, W rows each; with the switch on, one sequence is set up this way too (the cells as find_slot()
+// hands them out, where the loop of common_step_loop_begin() keeps one run from the first row's cell).  The issue, wait (it returns both sequences' states), end and undo calls above
+// serve it too.  A temperature (either slot): each sequence is walked, sampled and accepted on its own, with its own streams.
+struct common_step_loop_seq {
+    llama_seq_id       seq_id;
+    common_rguard_view guard;
+    llama_pos          pos;            // the slot's next position
+    llama_token        last;           // and last token
+    int32_t            n_emit;         // the tokens its last verify emitted
+    bool               no_eog;
+    int32_t            pos_max;
+    int32_t            pos_start_max;
+};
+bool    common_step_loop_seq2_enabled();
+// the drafter's context, when no host step of one slot has armed it yet
+void    common_step_audit_set_drafter(common_step_audit * a, llama_context * ctx_dft);
+// sq: the n_seq (1 or 2) slots in the order of the batch (ascending sequence id); temp[k]: slot k's temperature, nullptr if
+// greedy; false: not now, the host path goes on
+bool    common_step_loop_begin2(common_step_audit * a, const common_step_loop_seq * sq, int n_seq, int32_t top_k, int32_t n_draft,
+                                const common_step_loop_temp * const * temp);
+// after common_step_loop_end(), sequence k with a temperature: as common_step_loop_advance() for one sequence
+void    common_step_loop_advance2(common_step_audit * a, int k, int64_t emitted, int64_t n_rng, int64_t n_steps);
+int32_t common_step_loop_n_seq (const common_step_audit * a);
+// after common_step_loop_end(): the position sequence k holds in each of the target's first n cells (-1 none), as the
+// device left them, and how many cells the tables cover
+int64_t common_step_loop_cell_pos(common_step_audit * a, int k, int32_t * out, int64_t n);
+int64_t common_step_loop_n_cpos  (const common_step_audit * a);
diff --git a/ggml/include/ggml-spec-step.h b/ggml/include/ggml-spec-step.h
new file mode 100644
index 000000000..5c2353393
--- /dev/null
+++ b/ggml/include/ggml-spec-step.h
@@ -0,0 +1,254 @@
+#pragma once
+
+// Device-side steps of a speculative-decoding loop that runs on the GPU without the host between
+// steps: the target's greedy tokens, the acceptance of the drafts, and the DFlash2 lattice walk.
+// The CUDA/HIP backend exports the launchers through ggml_backend_reg_get_proc_address():
+//
+//   "ggml_backend_cuda_spec_argmax"  void (*)(ggml_backend_t, const float * x, int64_t n_rows, int64_t n_cols,
+//                                             int64_t row_stride, int32_t * dst)
+//   "ggml_backend_cuda_spec_accept"  void (*)(ggml_backend_t, const struct ggml_spec_accept_params *)
+//   "ggml_backend_cuda_spec_walk"    void (*)(ggml_backend_t, const struct ggml_spec_walk_params *)
+//   "ggml_backend_cuda_spec_write_verify" void (*)(ggml_backend_t, const struct ggml_spec_write_params *)
+//   "ggml_backend_cuda_spec_write_draft"  void (*)(ggml_backend_t, const struct ggml_spec_draft_params *)
+//   "ggml_backend_cuda_spec_sample"       void (*)(ggml_backend_t, const struct ggml_spec_sample_params *)
+//   "ggml_backend_cuda_share_stream"      bool (*)(ggml_backend_t backend, ggml_backend_t share): backend runs on share's
+//                                         main stream (share NULL: its own again); the caller synchronizes around it
+//   "ggml_backend_cuda_spec_suppress"     void (*)(ggml_backend_t, float * x, int64_t n_rows, int64_t row_stride,
+//                                                  const int32_t * ids, int32_t n_ids): x[r][ids[i]] = -inf (a logit bias
+//                                                  of -inf, as ignore_eos gives the end-of-generation tokens)
+//
+// Each runs on the backend's stream, after the work already queued there.  Every pointer in the
+// parameter structs is device memory.
+//
+// The draft acceptance runs on the device so the host does not wait on it between steps, as in
+// TensorRT-LLM's ReDrafter (drafting and validation inside the engine).
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GGML_SPEC_MAX_ROW  16   // verify rows of one sequence (drafts + 1)
+#define GGML_SPEC_MAX_K    64   // candidates of a sampled row (top_k) and of a drafter's lattice row
+#define GGML_SPEC_MAX_TAG   8   // tokens of one reasoning-guard tag
+#define GGML_SPEC_MAX_ENDS  4   // end tags of the reasoning block
+#define GGML_SPEC_MAX_STOP  8   // stop tokens of a step (ggml_spec_accept_params.stop)
+#define GGML_SPEC_MAX_SEQ   2   // sequences of one loop
+#define GGML_SPEC_MAX_HOLE  (GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_ROW)
+
+// one sequence of the loop
+struct ggml_spec_seq {
+    int32_t pos;                        // position of the next verify's first row
+    int32_t last;                       // the last emitted token, the next verify's first row
+    int32_t n_emit;                     // tokens the last acceptance emitted: accepted drafts + 1
+    int32_t eog;                        // the last acceptance emitted an end of generation
+    int32_t guard_in;                   // reasoning guard: inside the reasoning block
+    int32_t guard_hit;                  // the guard replaced a token in the last acceptance
+    int32_t n_tail;
+    int32_t tail[GGML_SPEC_MAX_TAG];    // the last emitted tokens, as many as the longest guard tag
+    int32_t emit[GGML_SPEC_MAX_ROW];    // the tokens the last acceptance emitted
+    int32_t cell_off;                   // KV cell of position p = p + cell_off (the sequence's cells are one run)
+    int32_t pos_min;                    // the sequence's first position in the KV cache
+    // the recurrent (Gated DeltaNet) state's anchored rollback (FRANK_RS_ANCHOR): the sequence's state cell, the
+    // cell its state is read from, the parity of its replay-factor rows, and the rows of the last verify
+    int32_t rs_cell;
+    int32_t rs_src0;
+    int32_t rs_fpar;
+    int32_t n_row_prev;
+    int32_t dcell_off;                  // the drafter's KV cell of position p = dcell_off + p mod n_cells (its ring)
+    int32_t n_rng;                      // draws taken from the rejection sampling's stream (ggml_spec_accept_params.rng)
+    // stage 5: the drafter's first position -- its ring holds every position from here on (a prompt is ingested from its
+    // tail, and a reused prompt may have left the drafter without the positions below its own ingested tail)
+    int32_t dpos_min;
+};
+
+// stage 5, a unified cache: the target's cells as llama_kv_cache::find_slot() hands them out when no free cell lies below its
+// head -- the free cells in ascending order, then the cells from the top up.  A verify takes the lowest free cells, so the
+// cells of its rejected rows (the holes) lie below every other free cell: the order is the holes, then the free cells the loop
+// began with (free_list, from free_ptr on), then the top.  A verify's rows, sequence-major, take them in that order
+// (ggml_spec_write_params.cells); after its acceptance the cells of its rejected rows are the new holes
+// (ggml_spec_accept_params.cells).
+struct ggml_spec_cells {
+    int32_t n_hole;
+    int32_t hole[GGML_SPEC_MAX_HOLE];       // ascending
+    int32_t top;                            // the cells from here up are free
+    int32_t n_rows;                         // rows of the last written verify
+    int32_t row_cell[GGML_SPEC_MAX_HOLE];   // the cell each of them took
+    const int32_t * free_list;              // the free cells below the top when the loop began, ascending (device memory)
+    int32_t n_free;
+    int32_t free_ptr;                       // the first one not handed out yet
+};
+
+// the reasoning guard (FRANK_REASONING_GUARD): an end of generation sampled inside the reasoning block
+// is emitted as the block's end tag instead; the tags are token sequences matched on the emitted tail
+struct ggml_spec_guard {
+    int32_t on;
+    int32_t end;                                         // the token emitted in place of the end of generation
+    int32_t n_start;
+    int32_t start[GGML_SPEC_MAX_TAG];
+    int32_t n_ends;
+    int32_t n_end[GGML_SPEC_MAX_ENDS];
+    int32_t ends[GGML_SPEC_MAX_ENDS][GGML_SPEC_MAX_TAG];
+};
+
+struct ggml_spec_accept_params {
+    const int32_t * target;       // [n_seq * n_row] the target's token at every verify row (greedy: its argmax; with a
+                                  // temperature: the token its distribution drew, ggml_spec_sample_params.sampled)
+    const int32_t * draft;        // [n_seq * (n_row - 1)] the drafts that were verified
+    const int32_t * eog;          // [n_eog] end-of-generation ids
+    int32_t         n_eog;
+    int32_t         n_seq;
+    int32_t         n_row;        // verify rows per sequence, 1..GGML_SPEC_MAX_ROW
+    struct ggml_spec_guard guard;
+    struct ggml_spec_seq * seq;   // [n_seq] read and advanced
+    // tokens a step ends after once emitted (a lazy grammar's trigger tokens: past one the host verifies under the grammar),
+    // ascending; n_stop 0: none
+    const int32_t * stop;
+    int32_t         n_stop;
+    const int32_t * stop1;        // the second sequence's when not NULL (else every sequence takes stop)
+    int32_t         n_stop1;
+    // stage 5, two sequences: the cells of the rejected rows become the holes, and leave the position tables
+    // (ggml_spec_write_params.cell_pos)
+    struct ggml_spec_cells * cells;
+    int32_t       * cell_pos;
+    int64_t         cell_pos_stride;
+    int32_t         cells_only;   // only that (the sequences were accepted one at a time, each with its own draws)
+
+    // with a temperature (cand_p not null): rejection sampling, as common_sampler_sample_and_accept_n_rejection().  A
+    // draft x is accepted when p(x) >= l*q(x), else with probability p(x) / (l*q(x)); a rejected one is replaced by a
+    // token drawn from max(p - q, 0) (or the row's own draw if that is empty) and ends the step; when every draft is
+    // accepted the last row's draw follows.  p: the target's candidates per row (ggml_spec_sample_params), q: the
+    // drafter's per draft (ggml_spec_walk_params).
+    const int32_t * n_cand;       // [n_seq * n_row]
+    const int32_t * cand_id;      // [n_seq * n_row * GGML_SPEC_MAX_K]
+    const float   * cand_p;
+    const int32_t * q_id;         // [n_seq * (n_row - 1) * q_k]
+    const float   * q_p;
+    int32_t         q_k;
+    float           lenience;     // l (1: plain rejection sampling)
+    const double  * u_acc;        // [n_seq * (n_row - 1)] the uniform of each draft's test (used as a float)
+    const double  * u_res;        // [n_seq] the uniform of the residual draw (used as a float)
+    // or, when rng is not null, the draws in the order the host takes them from its stream: the draw seq.n_rng is
+    // rng[seq.n_rng mod n_rng_ring] (one sequence), and seq.n_rng counts them
+    const double  * rng;
+    int32_t         n_rng_ring;
+};
+
+struct ggml_spec_walk_params {
+    const float * lattice;        // [n_seq * n_block * n_embd]: per row, top_k candidate ids (as float), then
+                                  // top_k x top_k scores (candidate k given predecessor p at p * top_k + k)
+    int64_t       n_embd;         // floats per lattice row
+    int32_t       n_block;        // lattice rows per sequence; row 0 is the anchor
+    int32_t       top_k;
+    int32_t       n_draft;        // drafts kept per sequence, at most n_block - 1
+    int32_t       n_seq;
+    int32_t     * draft;          // [n_seq * n_draft] out
+
+    // probabilistic drafts (u not null), as the DFlash2 branch of common_speculative_draft() with a temperature: each
+    // position draws from softmax(scores / temp) over its candidates, walked in ascending id order; q gets every
+    // candidate's id and probability (q_k = top_k entries per draft)
+    float          temp;
+    const double * u;             // [n_seq * n_draft]
+    int32_t      * q_id;          // [n_seq * n_draft * top_k] out
+    float        * q_p;
+};
+
+// the target's sampler chain on the device for every verify row: top_k -> top_p -> min_p -> temperature -> dist, the
+// order and arithmetic of common_sampler's default chain (llama_sampler_*_apply).  Out: the candidates left, sorted by
+// logit (highest first; a tie goes to the lower id), their probabilities, and the token the dist sampler draws with the
+// row's uniform.  NaN logits never become candidates.
+struct ggml_spec_chain {
+    int32_t top_k;                // 1..GGML_SPEC_MAX_K
+    float   top_p;                // >= 1: off
+    float   min_p;                // <= 0: off
+    int32_t min_keep;
+    float   temp;                 // > 0
+};
+
+struct ggml_spec_sample_params {
+    const float * logits;         // [n_rows] rows, row_stride floats apart
+    int64_t       n_rows;
+    int64_t       n_vocab;
+    int64_t       row_stride;
+    struct ggml_spec_chain chain;
+    const double * u;             // [n_rows] the dist sampler's uniform
+    // or, when u_ring is not null, the stream of the dist sampler's draws, one per emitted token: row r of a verify
+    // starting at seq.pos takes u_ring[(seq.pos - u_pos0 + r) mod n_u_ring] (one sequence)
+    const double * u_ring;
+    int32_t        n_u_ring;
+    int32_t        u_pos0;
+    const struct ggml_spec_seq * seq;
+    int32_t      * n_cand;        // [n_rows] out
+    int32_t      * cand_id;       // [n_rows * GGML_SPEC_MAX_K] out
+    float        * cand_p;        // [n_rows * GGML_SPEC_MAX_K] out
+    int32_t      * sampled;       // [n_rows] out
+};
+
+// the inputs of the next target verify, written from the sequence's state: row 0 is the last emitted token,
+// rows 1.. the drafts; positions pos.. (n_pos_sections 4: three sections of positions and a zero one, as the batch
+// expands a token's position to [p, p, p, 0]); the KV cells pos + cell_off.  Any output pointer may be null.
+struct ggml_spec_write_params {
+    struct ggml_spec_seq * seq;         // [n_seq]
+    const int32_t * draft;              // [n_seq * (n_row - 1)]
+    int32_t         n_seq;
+    int32_t         n_row;              // rows per sequence; the batch holds n_seq * n_row rows, sequence-major
+    int32_t         n_pos_sections;     // 1 or 4
+    int32_t       * tokens;             // [n_seq * n_row]
+    int32_t       * pos;                // [n_pos_sections * n_seq * n_row]
+    int64_t       * k_idxs;             // [n_seq * n_row]
+    int64_t       * v_idxs;             // [n_seq * n_row]
+    // the packed f16 KQ mask [n_kv, n_seq * n_row]: row r sees the cells of positions pos_min .. its own (0), not the
+    // others (-inf)
+    uint16_t      * kq_mask;
+    int64_t         n_kv;
+    // stage 5: the position the sequence holds in each cell, -1 for none (empty, or another sequence's) [n_kv].  With it
+    // the mask follows the cells -- a history that is not one run (two requests that overlapped leave their cells
+    // interleaved) -- and the write records the verify's new cells in it.  NULL: positions pos_min.. are one run from
+    // cell_off.  Two sequences: one table each, cell_pos_stride apart, and the cells come from `cells` (not cell_off).
+    int32_t       * cell_pos;
+    int64_t         cell_pos_stride;
+    struct ggml_spec_cells * cells;
+    // the recurrent inputs, one per sequence (rs_size: the recurrent cache's cells).  Writing them advances the
+    // state's parity and n_row_prev, so they are written once per verify.
+    int32_t         rs_size;
+    int32_t         rs_replay_all;   // llama_step_rs_replay_all: every verify starts from plane 1
+    int32_t       * rs_s_copy;
+    int32_t       * rs_rows;
+    int32_t       * rs_replay;
+    int32_t       * rs_fac_src;
+    int32_t       * rs_fac_dst;
+};
+
+// the inputs of a DFlash2 drafter graph (n_seq sequences, rows sequence-major; each sequence has its own ring).  INJECT (before the acceptance): the target's feature rows
+// 0..n_row-1 of the verify just run, at its positions seq.pos..; BLOCK (after it): [seq.last, mask_token x n_row-1]
+// at seq.pos.., and the packed KQ mask [n_kv, n_row]: row r sees the drafter's cells from position
+// seq.pos + r - (window - 1) (not below seq.pos_min) to the block's last one.  The sequence's drafter cache is a ring
+// of n_cells starting at cell seq.dcell_off (llama_kv_cache::find_slot in step mode): position p is in cell
+// seq.dcell_off + p mod n_cells.
+enum { GGML_SPEC_DRAFT_INJECT = 0, GGML_SPEC_DRAFT_BLOCK = 1 };
+
+struct ggml_spec_draft_params {
+    const struct ggml_spec_seq * seq;   // [n_seq]
+    int32_t    n_seq;                   // 0 counts as 1
+    int32_t    mode;
+    int32_t    n_row;                   // rows per sequence
+    int32_t    n_pos_sections;          // 1 or 4
+    int32_t    mask_token;
+    int32_t    window;
+    int64_t    n_kv;
+    int32_t    mask_ring;               // the mask covers only the sequence's ring: column j is the ring's cell j
+                                        // (otherwise column j is cell j)
+    int64_t    n_cells;                 // the ring's cells
+    int32_t    row0;                    // INJECT: the target's feature row of the first row (rows row0, row0 + 1, ...)
+    int32_t  * rows;                    // INJECT: [n_seq * n_row]
+    int32_t  * tokens;                  // BLOCK:  [n_seq * n_row]
+    int32_t  * pos;                     // [n_pos_sections * n_seq * n_row]
+    int64_t  * k_idxs;                  // [n_seq * n_row]
+    int64_t  * v_idxs;                  // [n_seq * n_row]
+    uint16_t * kq_mask;                 // BLOCK: [n_kv, n_seq * n_row]
+};
+
+#ifdef __cplusplus
+}
+#endif
