+#include "step-audit.h"
+#include "speculative.h"
+
+#include "log.h"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-spec-step.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <string>
+
+typedef void (*spec_argmax_fn)(ggml_backend_t, const float *, int64_t, int64_t, int64_t, int32_t *);
+typedef void (*spec_accept_fn)(ggml_backend_t, const ggml_spec_accept_params *);
+typedef void (*spec_write_fn)(ggml_backend_t, const ggml_spec_write_params *);
+typedef void (*spec_wdraft_fn)(ggml_backend_t, const ggml_spec_draft_params *);
+typedef void (*spec_walk_fn)(ggml_backend_t, const ggml_spec_walk_params *);
+typedef void (*spec_suppress_fn)(ggml_backend_t, float *, int64_t, int64_t, const int32_t *, int32_t);
+typedef void (*spec_sample_fn)(ggml_backend_t, const ggml_spec_sample_params *);
+typedef bool (*share_stream_fn)(ggml_backend_t, ggml_backend_t);
+
+// 1b: a host stream of uniforms the device takes in order -- filled ahead from the host's generator (peeked, not
+// drawn), the host's generator advanced past what the loop used when it ends
+struct step_draw_ring {
+    ggml_tensor * t      = nullptr;   // doubles
+    int64_t       n      = 0;         // entries used (a multiple of the draws per step for the drafter's)
+    int64_t       filled = 0;         // draws written since the loop began
+};
+
+// one issued step's results in the pinned ring the host reads
+struct step_ring_entry {
+    ggml_spec_seq seq[GGML_SPEC_MAX_SEQ];                         // the state after the step's acceptance
+    int32_t       drafts[GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_ROW];  // the drafts it verified
+    int32_t       target[GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_ROW];  // FRANK_STEP_CHECK: the target's token of each row (argmax)
+    int32_t       top;                                            // two sequences: the target cells' top after it
+};
+
+struct common_step_audit {
+    ggml_backend_t        backend = nullptr;
+    spec_argmax_fn        argmax  = nullptr;
+    spec_accept_fn        accept  = nullptr;
+    ggml_context *        ctx     = nullptr;
+    ggml_backend_buffer_t buf     = nullptr;
+    ggml_tensor *         t_target = nullptr;
+    ggml_tensor *         t_draft  = nullptr;
+    ggml_tensor *         t_eog    = nullptr;
+    ggml_tensor *         t_seq    = nullptr;
+    int32_t               n_eog    = 0;
+    ggml_tensor *         t_stop   = nullptr;   // stage 5: the tokens a step ends after (a lazy grammar's triggers)
+    int32_t               n_stop   = 0;
+    int32_t               n_stop1  = 0;         // the second sequence's (after the first list, GGML_SPEC_MAX_STOP on)
+
+    int64_t n_checked  = 0;
+    int64_t n_mismatch = 0;
+    int64_t n_skipped  = 0;
+
+    // A2
+    spec_write_fn write    = nullptr;
+    bool          seq_ok   = false;   // the device state follows the host's
+    bool          armed    = false;
+    llama_tokens  draft;
+    int64_t       n_resync = 0;
+    int64_t       n_writes = 0;
+    int32_t       rs_size  = 0;   // the target's recurrent cache cells (0: no recurrent inputs)
+    int32_t       rs_replay_all = 0;   // llama_step_rs_replay_all
+    int64_t       n_kv     = 0;   // the KQ mask's cells in the last armed verify
+
+    // A5
+    llama_context * ctx_tgt    = nullptr;
+    llama_context * ctx_dft    = nullptr;
+    spec_wdraft_fn  wdraft     = nullptr;
+    spec_walk_fn    walk       = nullptr;
+    int             arm_draft  = -1;      // -1 none, 0 inject, 1 block
+    bool            dft_ok     = false;   // dcell_off follows the host
+    int32_t         mask_token = -1;
+    int32_t         window     = 0;
+    int64_t         n_kv_dft   = 0;   // the drafter block's KQ mask cells and rows, from the last armed block
+    int64_t         n_row_dft  = 0;
+    ggml_tensor *   t_walk     = nullptr;
+    int64_t         n_walks = 0, n_walk_bad = 0, n_dft_resync = 0, n_dft_writes = 0;
+    bool            walk_same  = false;   // the last block's device walk equalled the host's drafts
+
+    // Part B, the GPU-resident loop
+    bool                  ready     = false;   // the last host step was checked equal: the device state follows the host
+    bool                  loop_on   = false;
+    ggml_backend_t        backend_d = nullptr;   // the drafter's GPU backend (its stream)
+    ggml_backend_event_t  ev_acc  = nullptr, ev_walk = nullptr, ev_ver = nullptr, ev_inj = nullptr;
+    ggml_backend_event_t  ev_host[2] = { nullptr, nullptr };
+    ggml_backend_buffer_t ring_buf  = nullptr;   // pinned: per issued step (two slots), the state after its acceptance
+    step_ring_entry *     ring      = nullptr;
+    int64_t               n_issued  = 0, n_done = 0;
+    int32_t               n_row     = 0;        // W
+    // per sequence (stage 5: two of them with common_step_loop_begin2())
+    int32_t               pos_known[GGML_SPEC_MAX_SEQ]     = {};   // the position after the last waited step
+    int32_t               pos_limit[GGML_SPEC_MAX_SEQ]     = {};   // a step may write positions below this
+    int32_t               pos_start_max[GGML_SPEC_MAX_SEQ] = {};   // a step may start at or below this (the host drafts at full width)
+    spec_suppress_fn      suppress  = nullptr;
+    spec_sample_fn        sample    = nullptr;
+
+    // 1b: a temperature (rejection sampling); the host's streams and the device's per-step buffers
+    bool                  temp_mode = false;
+    common_sampler *      smpl      = nullptr;
+    common_speculative *  spec      = nullptr;
+    llama_seq_id          seq_id    = 0;
+    int32_t               pos0      = 0;      // the position the loop began at (the dist draws are counted from it)
+    int32_t               n_rng_known  = 0;   // the sampler stream's draws, as of the last waited step
+    step_draw_ring        r_dist, r_rng, r_walk;
+    ggml_tensor *         t_qid = nullptr, * t_qp = nullptr, * t_nc = nullptr, * t_cid = nullptr, * t_cp = nullptr, * t_smp = nullptr;
+    ggml_spec_sample_params lp_sample = {};
+    bool                  no_eog    = false;    // ignore_eos: the end-of-generation logits are -inf before the argmax
+    bool                  no_eog_1  = false;    // the second sequence's
+    const float *         logits    = nullptr;
+    int64_t               n_vocab   = 0, logits_stride = 0;
+    ggml_spec_write_params  lp_write  = {};
+    ggml_spec_draft_params  lp_inject = {}, lp_block = {};
+    ggml_spec_walk_params   lp_walk   = {};
+    ggml_spec_accept_params lp_accept = {};
+    int64_t               n_loops = 0, n_loop_steps = 0;
+
+    // stage 5: the drafter's graphs run on the target's stream during the loop (FRANK_STEP_ONE_STREAM, default on): two
+    // streams whose waits on each other are queued ahead can land on hardware queues that slow every dispatch down
+    share_stream_fn       share_stream = nullptr;
+    bool                  shared       = false;
+
+    // stage 5: the position the sequence holds in each target cell (the verify mask follows it), filled at the loop's start;
+    // two sequences: a table each, cpos_stride apart
+    ggml_context *        cpos_ctx = nullptr;
+    ggml_backend_buffer_t cpos_buf = nullptr;
+    ggml_tensor *         t_cpos   = nullptr;
+    int64_t               cpos_stride = 0;
+    ggml_tensor *         t_free   = nullptr;   // common_step_loop_begin2(): the free cells below the top (ggml_spec_cells.free_list)
+
+    // stage 5: two sequences in one batch (common_step_loop_begin2(), FRANK_STEP_LOOP_SEQ2=1); cells_mode: the loop was set
+    // up by it (one or two sequences): the cells come from ggml_spec_cells, each sequence has its own launch parameters
+    int32_t               n_seq      = 1;
+    bool                  cells_mode = false;
+    // FRANK_STEP_CHECK (step_loop_check): each sequence's state before the step being checked, the stop lists as the host
+    // set them, the counts, and a mismatch seen (the loop issues no more steps)
+    ggml_spec_seq         chk_prev[GGML_SPEC_MAX_SEQ] = {};
+    std::vector<int32_t>  stop_host[2];
+    int64_t               n_chk      = 0;
+    int64_t               n_chk_bad  = 0;
+    bool                  chk_halt   = false;
+    ggml_tensor *         t_cells    = nullptr;   // ggml_spec_cells: the target's free cells as find_slot() hands them out
+    int32_t               top_known  = 0;         // their top after the last waited step
+    int32_t               cell_limit = 0;         // a step's cells must lie below this (the verify graph's cells)
+    int64_t               n_cpos     = 0;         // cells in each position table
+    int64_t               n_loops2 = 0, n_loop2_steps = 0;
+    // a temperature in a two-sequence loop: each sequence is sampled, walked and accepted on its own with its own streams
+    // (sequence 0 keeps the fields of 1b above: smpl, seq_id, pos0, n_rng_known, r_*); then one launch updates the cells
+    bool                  temp_k[GGML_SPEC_MAX_SEQ] = {};
+    common_sampler *      smpl1 = nullptr;
+    llama_seq_id          seq_id1 = 0;
+    int32_t               pos0_1 = 0;
+    int32_t               n_rng_known1 = 0;
+    step_draw_ring        r_dist1, r_rng1, r_walk1;
+    ggml_spec_sample_params lp_sample_k[GGML_SPEC_MAX_SEQ] = {};
+    ggml_spec_walk_params   lp_walk_k[GGML_SPEC_MAX_SEQ]   = {};
+    ggml_spec_accept_params lp_accept_k[GGML_SPEC_MAX_SEQ] = {};
+    ggml_spec_accept_params lp_cells = {};
+    // two sequences: the host injects each sequence's verify rows into the drafter on its own (W rows a decode), so the loop
+    // replays the injection graph once per sequence
+    ggml_spec_draft_params  lp_inject_k[GGML_SPEC_MAX_SEQ] = {};
+};
+
+// FRANK_STEP_AUDIT: the device also writes the inputs of host steps, for the slab to compare.  Without it (the loop
+// alone) host steps only record the graphs' shapes: the state follows the host through the checks at the acceptance.
+static bool step_audit_writes() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_STEP_AUDIT");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+// the target's step slab asks for the verify inputs: the device writes them from its state
+static void step_audit_prefill_draft(llama_context * ctx, common_step_audit * a) {
+    if (a->arm_draft < 0 || !a->seq_ok || !a->dft_ok || a->wdraft == nullptr) {
+        return;
+    }
+    const bool block = a->arm_draft == 1;
+    const char * row_key = block ? "dflash_inp_tokens#0" : "dflash_inp_rows#0";
+    int64_t ne[4] = { 0, 0, 0, 0 };
+    if (!llama_step_input_shape(ctx, row_key, ne)) {
+        return;
+    }
+    if (block) {
+        int64_t nm[4] = { 0, 0, 0, 0 };
+        a->n_row_dft = ne[0];
+        a->n_kv_dft  = llama_step_input_shape(ctx, "attn_inp_kq_mask#0", nm) ? nm[0] : 0;
+        if (a->mask_token < 0 || a->window <= 0) {
+            return;
+        }
+    }
+    if (!step_audit_writes()) {
+        return;
+    }
+    ggml_spec_draft_params p = {};
+    p.seq            = (const ggml_spec_seq *) a->t_seq->data;
+    p.mode           = block ? GGML_SPEC_DRAFT_BLOCK : GGML_SPEC_DRAFT_INJECT;
+    p.n_row          = (int32_t) ne[0];
+    p.n_pos_sections = 4;
+    p.mask_token     = a->mask_token;
+    p.window         = a->window;
+    p.n_cells        = llama_step_swa_size(ctx);
+    if (p.n_cells <= 0) {
+        return;
+    }
+    if (block) {
+        p.tokens = (int32_t *) llama_step_input_device(ctx, row_key);
+        int64_t nm[4] = { 0, 0, 0, 0 };
+        if (llama_step_input_shape(ctx, "attn_inp_kq_mask#0", nm) && nm[1] == ne[0] && nm[2] == 1 && nm[3] == 1) {
+            p.kq_mask = (uint16_t *) llama_step_input_device(ctx, "attn_inp_kq_mask#0");
+            p.n_kv    = nm[0];
+            // a mask no wider than a ring covers only the sequence's ring (llama_kv_cache::get_kv_start())
+            p.mask_ring = p.n_kv <= p.n_cells ? 1 : 0;
+        }
+    } else {
+        p.rows = (int32_t *) llama_step_input_device(ctx, row_key);
+    }
+    p.pos    = (int32_t *) llama_step_input_device(ctx, "inp_pos#0");
+    p.k_idxs = (int64_t *) llama_step_input_device(ctx, "attn_inp_k_idxs#0");
+    p.v_idxs = (int64_t *) llama_step_input_device(ctx, "attn_inp_v_idxs#0");
+    a->wdraft(a->backend, &p);
+    a->n_dft_writes++;
+}
+
+static void step_audit_prefill(llama_context * ctx, void * user) {
+    auto * a = (common_step_audit *) user;
+    if (ctx != a->ctx_tgt) {
+        step_audit_prefill_draft(ctx, a);
+        return;
+    }
+    if (!a->armed) {
+        return;
+    }
+    int64_t ne[4] = { 0, 0, 0, 0 };
+    a->n_kv = llama_step_input_shape(ctx, "attn_inp_kq_mask#0", ne) && ne[1] == (int64_t) a->draft.size() + 1 && ne[2] == 1 && ne[3] == 1 ? ne[0] : 0;
+    if (!step_audit_writes() || !a->seq_ok || a->write == nullptr || a->draft.size() + 1 > GGML_SPEC_MAX_ROW) {
+        return;
+    }
+    if (!a->draft.empty()) {
+        ggml_backend_tensor_set(a->t_draft, a->draft.data(), 0, a->draft.size() * sizeof(int32_t));
+    }
+    ggml_spec_write_params p = {};
+    p.seq            = (ggml_spec_seq *) a->t_seq->data;
+    p.draft          = (const int32_t *) a->t_draft->data;
+    p.n_seq          = 1;
+    p.n_row          = (int32_t) a->draft.size() + 1;
+    p.n_pos_sections = 4;
+    p.tokens = (int32_t *) llama_step_input_device(ctx, "inp_tokens#0");
+    p.pos    = (int32_t *) llama_step_input_device(ctx, "inp_pos#0");
+    p.k_idxs = (int64_t *) llama_step_input_device(ctx, "attn_inp_k_idxs#0");
+    p.v_idxs = (int64_t *) llama_step_input_device(ctx, "attn_inp_v_idxs#0");
+    if (a->n_kv > 0) {
+        p.kq_mask = (uint16_t *) llama_step_input_device(ctx, "attn_inp_kq_mask#0");
+        p.n_kv    = a->n_kv;
+    }
+    if (a->rs_size > 0) {
+        p.rs_size    = a->rs_size;
+        p.rs_replay_all = a->rs_replay_all;
+        p.rs_s_copy  = (int32_t *) llama_step_input_device(ctx, "rs_s_copy#0");
+        p.rs_rows    = (int32_t *) llama_step_input_device(ctx, "rs_a_rows#0");
+        p.rs_replay  = (int32_t *) llama_step_input_device(ctx, "rs_a_replay#0");
+        p.rs_fac_src = (int32_t *) llama_step_input_device(ctx, "rs_a_fac_src#0");
+        p.rs_fac_dst = (int32_t *) llama_step_input_device(ctx, "rs_a_fac_dst#0");
+    }
+    a->write(a->backend, &p);
+    a->n_writes++;
+}
+
+static bool step_env(const char * name) {
+    const char * e = getenv(name);
+    return e != nullptr && atoi(e) != 0;
+}
+
+// the audit's own reports (its periodic counts, why the loop was not ready): with FRANK_STEP_AUDIT=1 or FRANK_STEP_DEBUG.
+// A mismatch between the device and the host is always reported.
+static bool step_audit_reports() {
+    static const bool on = step_env("FRANK_STEP_AUDIT") || step_env("FRANK_STEP_DEBUG");
+    return on;
+}
+
+common_step_audit * common_step_audit_init(llama_context * ctx_tgt) {
+    static const bool on = step_env("FRANK_STEP_AUDIT") || llama_step_loop_enabled();
+    if (!on || ctx_tgt == nullptr) {
+        return nullptr;
+    }
+    ggml_backend_t backend = llama_step_backend(ctx_tgt);
+    if (backend == nullptr) {
+        LOG_WRN("%s: no GPU backend, the step audit is off\n", __func__);
+        return nullptr;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+    auto * f_argmax = (spec_argmax_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_argmax");
+    auto * f_accept = (spec_accept_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_accept");
+    auto * f_write  = (spec_write_fn)  ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_write_verify");
+    if (f_argmax == nullptr || f_accept == nullptr) {
+        LOG_WRN("%s: the backend exports no spec-step launchers, the step audit is off\n", __func__);
+        return nullptr;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx_tgt));
+    std::vector<int32_t> eog;
+    for (llama_token id = 0; id < llama_vocab_n_tokens(vocab); ++id) {
+        if (llama_vocab_is_eog(vocab, id)) {
+            eog.push_back(id);
+        }
+    }
+
+    auto * a = new common_step_audit();
+    a->backend = backend;
+    a->argmax  = f_argmax;
+    a->accept  = f_accept;
+    a->n_eog   = (int32_t) eog.size();
+    a->write   = f_write;
+    a->rs_size = llama_step_rs_size(ctx_tgt);
+    a->rs_replay_all = llama_step_rs_replay_all(ctx_tgt) ? 1 : 0;
+    a->ctx_tgt = ctx_tgt;
+    a->wdraft  = (spec_wdraft_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_write_draft");
+    a->walk    = (spec_walk_fn)   ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_walk");
+    a->suppress = (spec_suppress_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_suppress");
+    a->sample   = (spec_sample_fn)   ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_spec_sample");
+    a->share_stream = (share_stream_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_share_stream");
+
+    ggml_init_params ip = { 40 * ggml_tensor_overhead(), nullptr, true };
+    a->ctx      = ggml_init(ip);
+    a->t_target = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_ROW);
+    a->t_draft  = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_ROW);
+    a->t_eog    = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, std::max<int64_t>(1, a->n_eog));
+    a->t_seq    = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I8,  (int64_t) (GGML_SPEC_MAX_SEQ * sizeof(ggml_spec_seq)));
+    a->t_walk   = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_ROW);
+    a->t_stop   = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_SEQ * GGML_SPEC_MAX_STOP);   // stage 5: a list per sequence
+    a->t_cells  = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I8,  (int64_t) sizeof(ggml_spec_cells));
+    // 1b
+    a->t_qid    = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_HOLE * GGML_SPEC_MAX_K);
+    a->t_qp     = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F32, GGML_SPEC_MAX_HOLE * GGML_SPEC_MAX_K);
+    a->t_nc     = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_HOLE);
+    a->t_cid    = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_HOLE * GGML_SPEC_MAX_K);
+    a->t_cp     = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F32, GGML_SPEC_MAX_HOLE * GGML_SPEC_MAX_K);
+    a->t_smp    = ggml_new_tensor_1d(a->ctx, GGML_TYPE_I32, GGML_SPEC_MAX_HOLE);
+    a->r_dist.t = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F64, 8192);
+    a->r_rng.t  = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F64, 8192);
+    a->r_walk.t = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F64, 16384);
+    a->r_dist1.t = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F64, 8192);
+    a->r_rng1.t  = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F64, 8192);
+    a->r_walk1.t = ggml_new_tensor_1d(a->ctx, GGML_TYPE_F64, 16384);
+    a->buf      = ggml_backend_alloc_ctx_tensors(a->ctx, backend);
+    if (a->n_eog > 0) {
+        ggml_backend_tensor_set(a->t_eog, eog.data(), 0, eog.size() * sizeof(int32_t));
+    }
+    llama_step_set_prefill(ctx_tgt, step_audit_prefill, a);
+    if (step_env("FRANK_STEP_AUDIT")) {
+        LOG_WRN("%s: step audit on (%d end-of-generation ids)\n", __func__, a->n_eog);
+    } else {
+        LOG_INF("%s: the GPU-resident loop's device-side step state is set up (%d end-of-generation ids)\n", __func__, a->n_eog);
+    }
+    return a;
+}
+
+void common_step_audit_free(common_step_audit * a) {
+    if (a == nullptr) {
+        return;
+    }
+    for (ggml_backend_event_t ev : { a->ev_acc, a->ev_walk, a->ev_ver, a->ev_inj, a->ev_host[0], a->ev_host[1] }) {
+        if (ev) {
+            ggml_backend_event_free(ev);
+        }
+    }
+    if (a->cpos_buf) {
+        ggml_backend_buffer_free(a->cpos_buf);
+    }
+    if (a->cpos_ctx) {
+        ggml_free(a->cpos_ctx);
+    }
+    if (a->ring_buf) {
+        ggml_backend_buffer_free(a->ring_buf);
+    }
+    if (a->buf) {
+        ggml_backend_buffer_free(a->buf);
+    }
+    if (a->ctx) {
+        ggml_free(a->ctx);
+    }
+    delete a;
+}
+
+static bool fill_guard(ggml_spec_guard & g, const common_rguard_view & v) {
+    memset(&g, 0, sizeof(g));
+    if (!v.on) {
+        return true;
+    }
+    if (v.start.size() > GGML_SPEC_MAX_TAG || v.ends.size() > GGML_SPEC_MAX_ENDS) {
+        return false;
+    }
+    g.on      = 1;
+    g.end     = v.end;
+    g.n_start = (int32_t) v.start.size();
+    for (size_t j = 0; j < v.start.size(); ++j) {
+        g.start[j] = v.start[j];
+    }
+    g.n_ends = (int32_t) v.ends.size();
+    for (size_t e = 0; e < v.ends.size(); ++e) {
+        if (v.ends[e].size() > GGML_SPEC_MAX_TAG) {
+            return false;
+        }
+        g.n_end[e] = (int32_t) v.ends[e].size();
+        for (size_t j = 0; j < v.ends[e].size(); ++j) {
+            g.ends[e][j] = v.ends[e][j];
+        }
+    }
+    return true;
+}
+// a host batch that moved a sequence's recurrent cell (its factor rows were read from one cell and written to another)
+// right before the device takes the state: logged for the first few
+static void step_rs_moved_note(int32_t from, int32_t to) {
+    static int n = 0;
+    if (from != to && n < 5) {
+        n++;
+        LOG_WRN("%s: the last host batch moved a recurrent cell (%d -> %d); the device reads the state from cell %d\n", __func__, from, to, to);
+    }
+}
+
+
+// the device state before a host verify's acceptance: kept from the last step when it follows the host (this verify's
+// first row, as the host filled it, is the device's position and token), taken again from the host's fill otherwise.
+// False (and seq_ok cleared) if the fill is not there.
+static bool step_audit_follow(common_step_audit * a, llama_context * ctx_tgt, int n_row, ggml_spec_seq & s) {
+    ggml_backend_tensor_get(a->t_seq, &s, 0, sizeof(s));
+    const int32_t * h_pos = (const int32_t *) llama_step_input_host(ctx_tgt, "inp_pos#0");
+    const int32_t * h_tok = (const int32_t *) llama_step_input_host(ctx_tgt, "inp_tokens#0");
+    const int64_t * h_k   = (const int64_t *) llama_step_input_host(ctx_tgt, "attn_inp_k_idxs#0");
+    const int32_t  * h_fdst = (const int32_t *)  llama_step_input_host(ctx_tgt, "rs_a_fac_dst#0");
+    const int32_t  * h_fsrc = (const int32_t *)  llama_step_input_host(ctx_tgt, "rs_a_fac_src#0");
+    const uint16_t * h_mask = (const uint16_t *) llama_step_input_host(ctx_tgt, "attn_inp_kq_mask#0");
+    if (h_pos && h_tok && h_k) {
+        const bool rs_ok = a->rs_size == 0 || (h_fdst && s.rs_fpar == h_fdst[0] / a->rs_size && s.rs_cell == h_fdst[0] % a->rs_size);
+        if (!a->seq_ok || s.pos != h_pos[0] || s.last != h_tok[0] || (int64_t) s.pos + s.cell_off != h_k[0] || !rs_ok) {
+            if (a->seq_ok) {
+                a->n_resync++;
+            }
+            const int32_t dcell_off = s.dcell_off;   // the drafter's own state, checked separately
+            const int32_t dpos_min  = s.dpos_min;
+            memset(&s, 0, sizeof(s));
+            s.dcell_off = dcell_off;
+            s.dpos_min  = dpos_min;
+            s.pos      = h_pos[0];
+            s.last     = h_tok[0];
+            s.cell_off = (int32_t) (h_k[0] - h_pos[0]);
+            // the first cell row 0 of this verify could see: the sequence's first position
+            if (h_mask && a->n_kv > 0) {
+                int64_t j0 = 0;
+                while (j0 < a->n_kv && h_mask[j0] != 0x0000) {
+                    j0++;
+                }
+                s.pos_min = (int32_t) (j0 - s.cell_off);
+            }
+            if (a->rs_size > 0 && h_fdst && h_fsrc) {
+                // the next step reads the state where this host batch wrote it (its cell), not where the batch read it
+                // from: find_slot() may have moved the cell (two sequences in one batch are put in order)
+                s.rs_fpar    = h_fdst[0] / a->rs_size;
+                s.rs_cell    = h_fdst[0] % a->rs_size;
+                s.rs_src0    = s.rs_cell;
+                step_rs_moved_note(h_fsrc[0] % a->rs_size, s.rs_cell);
+            }
+            s.n_row_prev = n_row;
+        }
+        a->seq_ok = true;
+        return true;
+    }
+    memset(&s, 0, sizeof(s));
+    a->seq_ok = false;
+    return false;
+}
+
+void common_step_audit_accept(common_step_audit * a, llama_context * ctx_tgt, const std::vector<int> & idxs,
+                              const llama_tokens & draft, const common_rguard_view & pre,
+                              const std::vector<llama_token> & accepted, bool post_in) {
+    if (a == nullptr) {
+        return;
+    }
+    const int n_row = (int) draft.size() + 1;
+    ggml_spec_accept_params p = {};
+    if (n_row > GGML_SPEC_MAX_ROW || (int) idxs.size() != n_row || !fill_guard(p.guard, pre)) {
+        a->n_skipped++;
+        return;
+    }
+
+    // the target's token at every verify row, from the logits still on the device
+    for (int k = 0; k < n_row; ++k) {
+        int64_t n_vocab = 0, stride = 0;
+        const float * row = llama_step_logits_device(ctx_tgt, idxs[k], &n_vocab, &stride);
+        if (row == nullptr) {
+            a->n_skipped++;
+            return;
+        }
+        a->argmax(a->backend, row, 1, n_vocab, stride, (int32_t *) a->t_target->data + k);
+    }
+
+    if (!draft.empty()) {
+        ggml_backend_tensor_set(a->t_draft, draft.data(), 0, draft.size() * sizeof(int32_t));
+    }
+    // the device state: kept from the last step when it follows the host (this verify's first row, as the host
+    // filled it, is the device's position and token), taken again from the host otherwise
+    ggml_spec_seq s;
+    step_audit_follow(a, ctx_tgt, n_row, s);
+    s.guard_in = pre.in ? 1 : 0;
+    const size_t n_tail = std::min(pre.tail.size(), (size_t) GGML_SPEC_MAX_TAG);
+    s.n_tail = (int32_t) n_tail;
+    for (size_t j = 0; j < n_tail; ++j) {
+        s.tail[j] = pre.tail[pre.tail.size() - n_tail + j];
+    }
+    ggml_backend_tensor_set(a->t_seq, &s, 0, sizeof(s));
+
+    p.target = (const int32_t *) a->t_target->data;
+    p.draft  = (const int32_t *) a->t_draft->data;
+    p.eog    = (const int32_t *) a->t_eog->data;
+    p.n_eog  = a->n_eog;
+    p.stop   = (const int32_t *) a->t_stop->data;
+    p.n_stop = a->n_stop;
+    p.n_seq  = 1;
+    p.n_row  = n_row;
+    p.seq    = (ggml_spec_seq *) a->t_seq->data;
+    a->accept(a->backend, &p);
+    ggml_backend_synchronize(a->backend);
+    ggml_backend_tensor_get(a->t_seq, &s, 0, sizeof(s));
+
+    bool same = s.n_emit == (int32_t) accepted.size() && (!pre.on || (s.guard_in != 0) == post_in);
+    for (size_t j = 0; same && j < accepted.size(); ++j) {
+        same = s.emit[j] == accepted[j];
+    }
+    a->n_checked++;
+    a->ready = same && a->seq_ok && a->dft_ok && a->walk_same && a->mask_token >= 0 && a->window > 0;
+    static const bool loop_env = llama_step_loop_enabled();
+    if (!a->ready && loop_env && step_audit_reports()) {
+        static int n_why = 0;
+        if (n_why++ < 10) {
+            LOG_WRN("%s: not ready for the loop: same %d, seq %d, drafter %d, walk %d, mask token %d, window %d\n", __func__,
+                    same, a->seq_ok, a->dft_ok, a->walk_same, a->mask_token, a->window);
+        }
+    }
+    a->walk_same = false;
+    if (!same) {
+        a->n_mismatch++;
+        if (a->n_mismatch <= 20) {
+            std::string dev, host;
+            for (int j = 0; j < s.n_emit; ++j) {
+                dev += std::to_string(s.emit[j]) + " ";
+            }
+            for (llama_token t : accepted) {
+                host += std::to_string(t) + " ";
+            }
+            LOG_WRN("%s: step %lld mismatch: device emits [%s] (guard %d), host [%s] (guard %d), %d rows\n", __func__,
+                    (long long) a->n_checked, dev.c_str(), s.guard_in, host.c_str(), post_in ? 1 : 0, n_row);
+        }
+    }
+    if (a->n_checked % 64 == 0 && step_audit_reports()) {
+        LOG_WRN("%s: %lld steps checked, %lld mismatches, %lld skipped; device state taken again from the host %lld times, %lld input writes\n", __func__,
+                (long long) a->n_checked, (long long) a->n_mismatch, (long long) a->n_skipped, (long long) a->n_resync, (long long) a->n_writes);
+    }
+}
+
+void common_step_audit_adopt(common_step_audit * a, llama_context * ctx_tgt, const llama_tokens & draft,
+                             const common_rguard_view & post, const std::vector<llama_token> & accepted) {
+    if (a == nullptr || accepted.empty() || accepted.size() > GGML_SPEC_MAX_ROW) {
+        return;
+    }
+    ggml_spec_seq s;
+    if (!step_audit_follow(a, ctx_tgt, (int) draft.size() + 1, s)) {
+        a->ready = false;
+        return;
+    }
+    // the host's acceptance, as the device's would leave the state
+    s.n_emit    = (int32_t) accepted.size();
+    s.eog       = 0;
+    s.guard_hit = 0;
+    for (size_t j = 0; j < accepted.size(); ++j) {
+        s.emit[j] = accepted[j];
+    }
+    s.last     = accepted.back();
+    s.pos     += s.n_emit;
+    s.guard_in = post.in ? 1 : 0;
+    const size_t n_tail = std::min(post.tail.size(), (size_t) GGML_SPEC_MAX_TAG);
+    s.n_tail = (int32_t) n_tail;
+    for (size_t j = 0; j < n_tail; ++j) {
+        s.tail[j] = post.tail[post.tail.size() - n_tail + j];
+    }
+    s.n_rng = 0;
+    ggml_backend_tensor_set(a->t_seq, &s, 0, sizeof(s));
+    // sampled drafts cannot be walked again without the drafter's draws: the walk is checked by greedy requests only
+    a->ready = a->seq_ok && a->dft_ok && a->mask_token >= 0 && a->window > 0;
+}
+
+bool common_step_audit_set_stop(common_step_audit * a, const std::vector<llama_token> & ids) {
+    if (a == nullptr) {
+        return false;
