+// see ggml_cuda_lf_kq8_mul_mat_add); false: not taken (another mode, or not supported)
+bool ggml_cuda_lf_mxfp4_mul_mat_add(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst,
+                                    float * y, const float * c);
