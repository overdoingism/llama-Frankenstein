+// BigOne GLU16: both inputs hold 16-bit products of type TI; the producer paths (fixed-KEEP fp8 activation, channel amax) read
+// them directly.  false: neither path applies (the caller widens them and runs the f32 path).  dst may take the gate's memory
+// (GGML_GLU_INPLACE): an f32 output written at twice the stride the 16-bit inputs are read would overwrite inputs other threads
+// still read, so a kernel that writes dst reads an overlapping input from a copy.
+template <float (*op)(float), typename TI>
+static bool unary_gated_16_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const TI * x, const TI * g, const int64_t nc,
+        cudaStream_t stream) {
+    float * d = (float *) dst->data;
+    const int64_t ne = ggml_nelements(dst);
+    ggml_cuda_pool_alloc<TI> cx(ctx.pool()), cg(ctx.pool());
+    auto apart = [&]() {
+        auto overlaps = [&](const void * p) {
+            const char * a = (const char *) p, * b = (const char *) d;
+            return a < b + ne*sizeof(float) && b < a + ne*sizeof(TI);
+        };
+        if (overlaps(x)) {
+            cx.alloc(ne);
+            CUDA_CHECK(cudaMemcpyAsync(cx.get(), x, ne*sizeof(TI), cudaMemcpyDeviceToDevice, stream));
+            x = cx.get();
+        }
+        if (overlaps(g)) {
+            cg.alloc(ne);
+            CUDA_CHECK(cudaMemcpyAsync(cg.get(), g, ne*sizeof(TI), cudaMemcpyDeviceToDevice, stream));
+            g = cg.get();
+        }
+    };
+    ggml_cuda_lf_kq8_fp8_dst fd;
+    if (ggml_cuda_lf_kq8_fp8_take(ctx, dst, &fd)) {
