+// into stays in the 64 MB Infinity Cache at this size, so the f16 -> fp8 step does not read it back from DRAM (64 MiB: -4%)
+constexpr int64_t LF_KQ8_CHUNK_BYTES = 32ll << 20;
+// K1 takes a matmul of FRANK_KQ_BLAS_MIN_T tokens or more when the weight has 20M elements or more, and of 1024 tokens or
+// more otherwise: below 1024 tokens the fixed cost of a K1 call (amax, conversion, GEMM) beats MMQ only on large weights
+// (gfx1201, fp8: Qwen3.8-27B's 26..131M-element matrices +17..42% at 512..1023 tokens; the 1..17M-element dense matrices of
+// Qwen3.6-35B-A3B -1..-7%).  FRANK_KQ_BLAS_MIN_T=1024: 1024 for every weight, as before.
+// The default is 384 for fp8 and i8, 640 for f16: f16 writes the whole weight in f16 for every batch, so it needs more
+// tokens to pay for that (gfx1201, a 27B Q4_K_M / UD-Q5_K_M / UD-Q4_K_XL, one batch from empty, f16 against MMQ: 0.86..0.92
+// at 384 tokens, 0.92..0.99 at 512, 1.04..1.12 at 640, 1.12..1.22 at 1024, 1.23..1.34 at 2048).  f16 never takes fewer
+// than 256 tokens: its algorithm buckets (LF_KQ_BUCKET) start at 256 tokens.
+int lf_kq_min_t() {
+    static const int t = [] {
+        const char * e  = getenv("FRANK_KQ_BLAS_MIN_T");
+        const bool  f16 = lf_kq_mode() == 1;
+        const int   v   = e ? atoi(e) : (f16 ? 640 : 384);
+        return f16 ? std::max(v, 256) : v;
+    }();
+    return t;
+}
+constexpr int64_t LF_KQ_SMALL_T_MIN_WEIGHTS = 20ll << 20;
+int lf_kq_log()   { static const int l = getenv("FRANK_KQ_BLAS_LOG")   ? atoi(getenv("FRANK_KQ_BLAS_LOG"))   : 0;    return l; }
+// FRANK_KQ_BLAS_ALGOS selects how the algorithms are chosen (nothing is ever read from or written to a file):
+//   unset          gfx1201: def.gfx1201v1; other GPUs: tune
+//   def.gfx1201v1  no timing: the highest-ranked candidate in the built-in gfx1201 priority list v1 (fixed results)
+//   K1a2.<base64>  a table printed at startup: no timing; anything missing takes the heuristic's first candidate
+//   tune           time the candidates on fixed pseudo-random activations at startup (the choice can differ from run
+//                  to run) and print the table
+//   0 / anything that does not parse: no timing, hipBLASLt's first heuristic candidate
+// Every mode prints its choices as a K1a2 table after the startup warm-up.
+const char * lf_kq_algos_env() { static const char * p = getenv("FRANK_KQ_BLAS_ALGOS"); return p && *p ? p : nullptr; }
+bool g_lf_kq_timed = false; // set by lf_kq_algos_init
+bool lf_kq_timed() { return g_lf_kq_timed; }
