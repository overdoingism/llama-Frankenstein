+static void glu16_widen(const void * x, float * y, const int64_t n, cudaStream_t stream) {
+    const unsigned nb = (unsigned) ((n + 255) / 256);
+    glu16_widen_kernel<<<nb, 256, 0, stream>>>((const half *) x, y, n);
