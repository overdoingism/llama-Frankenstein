+// gfx1201 priority list v1: hipBLASLt solution indices of the f16 x f16 -> f32 GEMM (TN, alpha vector), best first.
+// Measured with tools/k1probe on gfx1201 / hipBLASLt 100401 8d1ae90e (Linux and Windows TheRock ROCm 10 builds are the
+// same), 80 (rows, tokens, K) shapes of the K1 path (K 5120 / 6144 / 17408, rows 48..17408, 1024..2048 tokens), on
+// random operands: ordered by geometric-mean slowdown against each shape's fastest candidate.  Taking the first listed
+// candidate the heuristic offers was 2.8% slower than the fastest on average (the heuristic's own first: 20.7%).
+// Used by def.gfx1201v1 and as the tie-break among near-equal timed candidates.
+const int LF_KQ_PRIO_GFX1201_V1[] = {
+    135741, 135732, 135625, 135716, 135382, 135627, 135631, 135378, 135383, 135375, 135361, 135633, 135311, 135381,
+    135628, 135189, 135187, 135727, 135630, 135626, 135349, 135376, 135657, 135712, 135365, 135609, 135647, 135616,
+    135380, 135620, 135613, 135765, 135740, 135648, 135651, 135602, 135372, 135623, 135601, 135624, 135605, 135697,
+    135660, 135210, 135341, 135695, 135379, 135209, 135688, 135362, 135310, 135359, 135617, 135696, 135659, 135661,
+    135532, 135384, 135761, 135699, 135764, 135559, 135301, 135749, 135505, 135186, 135303, 135254, 135738, 135760,
+    135700, 135733, 135307, 135787, 135227, 135213, 135653, 135743, 135652, 135202, 135654, 135698, 135655, 135621,
+    135650, 135702, 135404, 135216, 135703, 135694, 135638, 135255, 135462, 135640, 135664, 135678, 135321, 135641,
+    135636, 135367, 135691, 135679, 135785, 135683, 135680, 135769, 135687, 135693, 135669, 135786, 135685
+};
+constexpr uint32_t LF_KQ_PRIO_GFX1201_V1_LIB = 0x5cfec541u; // FNV-1a("hipblaslt 100401 8d1ae90e")
+// Token counts share an algorithm per 256-token bucket (floor(T / 256)), so a prompt's odd-sized last batch does not
+// trigger its own tuning (and its own, possibly different, choice).
+constexpr int LF_KQ_BUCKET = 256;
+
+// weight rows converted per GEMM call, from FRANK_KQ_BLAS_CHUNK_MB (f16 MiB per chunk, 0 = the whole matrix):
+// a multiple of 256 rows, at least 256
+int lf_kq_chunk_rows(const int M, const int K) {
+    static const int mb = getenv("FRANK_KQ_BLAS_CHUNK_MB") ? atoi(getenv("FRANK_KQ_BLAS_CHUNK_MB")) : 0;
+    if (mb <= 0) return M;
+    const int64_t rows = ((int64_t) mb << 20) / (2 * (int64_t) K);
+    return (int) std::min<int64_t>(M, std::max<int64_t>(256, rows / 256 * 256));
+}
+
+// the shape conditions shared by will_take (graph fusion stand-down) and supported (dispatch)
+bool lf_kq_shape_ok(const ggml_tensor * src0, const ggml_tensor * src1) {
+    if (!ggml_is_quantized(src0->type) || src0->type == GGML_TYPE_MXFP4 || ggml_get_to_fp16_cuda(src0->type) == nullptr) return false;
+    if (src1->type != GGML_TYPE_F32 || src0->ne[2] != 1 || src0->ne[3] != 1) return false;
+    const int64_t T = src1->ne[1] * src1->ne[2] * src1->ne[3];
+    const int64_t min_t = src0->ne[0] * src0->ne[1] >= LF_KQ_SMALL_T_MIN_WEIGHTS ? lf_kq_min_t() : std::max(lf_kq_min_t(), 1024);
+    return src0->ne[0] % 64 == 0 && src0->ne[1] % 16 == 0 && T >= min_t && T <= INT32_MAX / 8 && src0->ne[1] <= INT32_MAX / 8;
+}
+
+#if defined(FRANK_HIPBLASLT)
+
+__device__ __forceinline__ float lf_block_max(float v) {
+    __shared__ float red[256];
+    red[threadIdx.x] = v;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] = fmaxf(red[threadIdx.x], red[threadIdx.x + s]);
+        __syncthreads();
+    }
+    return red[0];
+}
+
+// batch amax of the activations (non-negative floats compare as their bit patterns)
+__global__ void lf_kq_act_amax(const float * __restrict__ x, const int K, unsigned int * __restrict__ gbits) {
+    const float * row = x + (size_t) blockIdx.x * K;
+    float a = 0.f;
+    for (int k = threadIdx.x; k < K; k += blockDim.x) a = fmaxf(a, fabsf(row[k]));
+    a = lf_block_max(a);
+    if (threadIdx.x == 0) atomicMax(gbits, __float_as_uint(a));
+}
+
+// f16 activations with one power-of-two scale (amax < 2^15 after scaling): exact scaling, f16 rounding only
+__global__ void lf_kq_act_f16(const float * __restrict__ x, half * __restrict__ xh, const unsigned int * __restrict__ gbits,
+        float * __restrict__ sx, const int K) {
+    const float amax = __uint_as_float(*gbits);
+    int e = 0;
+    frexpf(amax, &e);
+    const float inv = amax > 0.f ? ldexpf(1.f, 15 - e) : 0.f;
+    const float * row = x + (size_t) blockIdx.x * K;
+    half * out = xh + (size_t) blockIdx.x * K;
+    for (int k = threadIdx.x; k < K; k += blockDim.x) out[k] = __float2half(row[k] * inv);
+    if (blockIdx.x == 0 && threadIdx.x == 0) *sx = amax > 0.f ? ldexpf(1.f, e - 15) : 1.f;
+}
+
+// alpha[m] = the batch activation scale (hipBLASLt's per-row alpha vector)
+__global__ void lf_kq_alpha(const float * __restrict__ sx, float * __restrict__ av, const int M) {
+    const int m = blockIdx.x * blockDim.x + threadIdx.x;
+    if (m < M) av[m] = *sx;
+}
+
+// fixed pseudo-random f16 operands for timing: K1's warm-up runs repeated BOS tokens, whose identical activation columns
+// draw less power than real activations and ranked the candidates differently in 39 of 80 probed shapes
+__global__ void lf_kq_fill_rand(half * __restrict__ x, const int64_t n) {
+    for (int64_t i = blockIdx.x * (int64_t) blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x * blockDim.x) {
+        uint32_t h = (uint32_t) i * 2654435761u + 0x9E3779B9u;
+        h ^= h >> 16; h *= 0x7FEB352Du; h ^= h >> 15; h *= 0x846CA68Bu; h ^= h >> 16;
+        const float u = ((float) (h & 0xFFFF) + (float) (h >> 16)) / 65535.f - 1.f; // triangular in [-1, 1]
+        x[i] = __float2half(u * 2048.f);
+    }
+}
+
+#define LF_KQ_CHECK(x) do { const hipblasStatus_t st_ = (x); if (st_ != HIPBLAS_STATUS_SUCCESS) GGML_ABORT("%s failed: status %d", #x, (int) st_); } while (0)
+
+struct lf_kq_layout {
+    hipblasLtMatmulDesc_t   desc = nullptr;
+    hipblasLtMatrixLayout_t la = nullptr, lb = nullptr, lc = nullptr;
+};
+struct lf_kq_algo {
+    hipblasLtMatmulAlgo_t algo{};
+    size_t                ws  = 0;
+    int                   idx = -1; // hipBLASLt solution index
+    bool                  ok  = false;
+};
+// One persistent scratch per stream (f16 activations | batch scale | f16 weight chunk | alpha vector | workspace),
+// grown on first use of a larger shape: the ggml pool would keep a freed buffer of every size it has seen.  Per stream,
+// not per device: the main model and the draft model run on different streams and may overlap.
+// The f16 activations and their scale stay at the start, so matmuls of one graph with the same input (q / k / v,
+// DeltaNet's qkv / z / alpha / beta, gate / up) convert it once: like the Q8_1 input cache, an entry holds until the
+// next graph (an input tensor is written once and is not changed while later matmuls of the graph still read it).
+struct lf_kq_scratch {
+    char * ptr  = nullptr;
+    size_t size = 0;
+    // the input whose conversion is in the scratch
+    const ggml_tensor * x_src = nullptr;
+    const void *        x_data = nullptr;
+    int                 x_T = 0, x_K = 0;
+    uint64_t            x_gen = 0;
+};
+typedef std::tuple<int, int, int, int, int> lf_kq_key; // (device, rows per call, T or bucket, K, M)
+struct lf_kq_state {
+    std::mutex mutex;
+    hipblasLtHandle_t handle = nullptr;
+    std::map<lf_kq_key, lf_kq_layout> layouts;  // per exact T
+    std::map<lf_kq_key, lf_kq_algo>   bucket;   // per T bucket: the chosen algorithm
+    std::map<lf_kq_key, lf_kq_algo>   resolved; // per exact T: the bucket's algorithm, checked for this T
+    std::map<cudaStream_t, lf_kq_scratch> scratch;
+    int probe[GGML_CUDA_MAX_DEVICES] = {}; // 0 = not tried, 1 = hipBLASLt has f16 kernels here, -1 = it has not
+    // algorithm table (FRANK_KQ_BLAS_ALGOS)
+    bool algos_init = false, algos_use = false, algos_missing_warned = false;
+    bool def_mode = false;          // def.gfx1201v1
+    std::map<int, int> prio;        // solution index -> position in the gfx1201 priority list (gfx1201 only)
+    std::map<std::tuple<int, int, int, int>, int> table; // (rows per call, bucket, K, M) -> hipBLASLt solution index
+};
+lf_kq_state & lf_kq() { static lf_kq_state s; return s; }
+std::atomic<uint64_t> g_lf_kq_graph_gen{1}; // advanced at every graph start: invalidates the converted inputs
+
+constexpr size_t LF_KQ_WS_MAX = 64ull << 20; // hipBLASLt workspace limit
+
+size_t lf_kq_align(const size_t n) { return (n + 255) / 256 * 256; }
+constexpr size_t LF_KQ_SCALE_BYTES = 256; // batch scale + amax bits, right after the f16 activations
+size_t lf_kq_scratch_bytes(const int Mc, const int T, const int K, const int M) {
+    return lf_kq_align((size_t) T * K * 2) + LF_KQ_SCALE_BYTES + lf_kq_align((size_t) Mc * K * 2) + lf_kq_align((size_t) M * 4) + LF_KQ_WS_MAX;
+}
+
+bool lf_kq_ready(const int device, cudaStream_t stream, const int Mc, const int T, const int K, const int M) {
+    lf_kq_state & st = lf_kq();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    auto it = st.scratch.find(stream);
+    return st.handle && st.resolved.count({device, Mc, T, K, M}) && it != st.scratch.end() && it->second.size >= lf_kq_scratch_bytes(Mc, T, K, M);
+}
+
+// Algorithm table string: "K1a2." + base64url (no padding) of
+//   u8 format (2) | u32 GPU architecture (FNV-1a of gcnArchName without feature flags, e.g. "gfx1201": must match) |
+//   u32 library (FNV-1a of "hipblaslt <version> <git rev>": a mismatch only warns -- a solution index of another build
+//   may name another kernel, but every choice is checked with matmulIsAlgoSupported before use) |
+//   u8 first bucket | u8 buckets | u8 shapes | u24 base index | u8 delta bytes (1..3) |
+//   per shape: u16 K/16, u16 M/16 (bit 15 set: rows per call == M), [u16 rows/16] |
+//   per shape and bucket: index - base in delta bytes (all ones = no entry) | u32 CRC-32 of everything before
+uint32_t lf_kq_fnv(const std::string & str) {
+    uint32_t h = 2166136261u;
+    for (unsigned char c : str) { h ^= c; h *= 16777619u; }
+    return h;
+}
+uint32_t lf_kq_crc32(const std::vector<uint8_t> & v, const size_t n) {
+    uint32_t c = 0xFFFFFFFFu;
+    for (size_t i = 0; i < n; ++i) {
+        c ^= v[i];
+        for (int k = 0; k < 8; ++k) c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
+    }
+    return ~c;
+}
+const char * LF_KQ_B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+std::string lf_kq_b64enc(const std::vector<uint8_t> & v) {
+    std::string out;
+    for (size_t i = 0; i < v.size(); i += 3) {
+        const uint32_t n = (uint32_t) v[i] << 16 | (i + 1 < v.size() ? (uint32_t) v[i + 1] << 8 : 0) | (i + 2 < v.size() ? v[i + 2] : 0);
+        out += LF_KQ_B64[n >> 18 & 63];
+        out += LF_KQ_B64[n >> 12 & 63];
+        if (i + 1 < v.size()) out += LF_KQ_B64[n >> 6 & 63];
+        if (i + 2 < v.size()) out += LF_KQ_B64[n & 63];
+    }
+    return out;
+}
+bool lf_kq_b64dec(const std::string & s, std::vector<uint8_t> & v) {
+    uint32_t acc = 0; int bits = 0;
+    for (char ch : s) {
+        const char * p = strchr(LF_KQ_B64, ch);
+        if (ch == '\0' || p == nullptr) return false;
+        acc = acc << 6 | (uint32_t) (p - LF_KQ_B64); bits += 6;
+        if (bits >= 8) { bits -= 8; v.push_back((uint8_t) (acc >> bits & 0xFF)); }
+    }
+    return true;
+}
+
+std::string lf_kq_arch_name(const int device) {
+    hipDeviceProp_t prop;
+    CUDA_CHECK(hipGetDeviceProperties(&prop, device));
+    std::string a(prop.gcnArchName);
+    return a.substr(0, a.find(':'));
+}
+std::string lf_kq_lib_name(lf_kq_state & st) {
+    int ver = 0;
+    char rev[256] = {0};
+    hipblasLtGetVersion(st.handle, &ver);
+    hipblasLtGetGitRevision(st.handle, rev);
+    return "hipblaslt " + std::to_string(ver) + " " + std::string(rev);
+}
+
+void lf_kq_algos_init(lf_kq_state & st, const int device) {
+    if (st.algos_init) return;
+    st.algos_init = true;
+    const std::string arch = lf_kq_arch_name(device);
+    if (arch == "gfx1201") { // priority among near-equal timed candidates, and the order of def.gfx1201v1
+        const int n = (int) (sizeof(LF_KQ_PRIO_GFX1201_V1) / sizeof(LF_KQ_PRIO_GFX1201_V1[0]));
+        for (int i = 0; i < n; ++i) st.prio.emplace(LF_KQ_PRIO_GFX1201_V1[i], i);
+    }
+    std::string s;       // whitespace dropped: a table copied from a console often carries the line wraps
+    if (const char * env = lf_kq_algos_env()) {
+        for (const char * c = env; *c; ++c) {
+            if (!isspace((unsigned char) *c)) s += *c;
+        }
+    }
+    if (s.empty()) {
+        s = arch == "gfx1201" ? "def.gfx1201v1" : "tune";
+        fprintf(stderr, "FRANK_KQ_BLAS_ALGOS unset: %s on %s\n", s.c_str(), arch.c_str());
+    }
+    if (s == "tune") {
+        g_lf_kq_timed = true;
+        fprintf(stderr, "FRANK_KQ_BLAS_ALGOS=tune: algorithms timed at startup (the choice can differ from run to run; "
+                        "def.gfx1201v1 or the printed K1a2 table give fixed results)\n");
+        return;
+    }
+    st.algos_use = true; // no timing, whatever happens below
+    std::vector<uint8_t> v;
+    auto bad = [&](const char * why) { fprintf(stderr, "FRANK_KQ_BLAS_ALGOS: %s; using hipBLASLt's first heuristic choice\n", why); };
+    if (s == "0") { fprintf(stderr, "FRANK_KQ_BLAS_ALGOS=0: hipBLASLt's first heuristic choice, no timing\n"); return; }
+    if (s == "def.gfx1201v1") {
+        if (arch != "gfx1201") { bad(("def.gfx1201v1 is for gfx1201, this GPU is " + arch).c_str()); return; }
+        st.def_mode = true;
+        if (lf_kq_fnv(lf_kq_lib_name(st)) != LF_KQ_PRIO_GFX1201_V1_LIB) {
+            fprintf(stderr, "FRANK_KQ_BLAS_ALGOS: def.gfx1201v1 was measured with hipblaslt 100401 8d1ae90e, this is %s; "
+                            "using it anyway\n", lf_kq_lib_name(st).c_str());
+        }
+        fprintf(stderr, "FRANK_KQ_BLAS_ALGOS=def.gfx1201v1: built-in gfx1201 priority list v1, no timing\n");
+        return;
+    }
+    if (s.rfind("K1a1.", 0) == 0) { bad("K1a1 is the old format, time once more for a K1a2 string"); return; }
+    if (s.rfind("K1a2.", 0) != 0 || !lf_kq_b64dec(s.substr(5), v) || v.size() < 21) {
+        bad("not recognized (def.gfx1201v1, K1a2.<table>, tune or 0)"); return;
+    }
+    if (lf_kq_crc32(v, v.size() - 4) != ((uint32_t) v[v.size() - 4] | (uint32_t) v[v.size() - 3] << 8 | (uint32_t) v[v.size() - 2] << 16 | (uint32_t) v[v.size() - 1] << 24)) {
+        bad("checksum mismatch (incomplete copy?)"); return;
+    }
+    size_t o = 0;
+    auto u8  = [&]() { return o < v.size() ? (uint32_t) v[o++] : 0u; };
+    auto u16 = [&]() { const uint32_t a = u8(); return a | u8() << 8; };
+    if (u8() != 2) { bad("unknown format"); return; }
+    const uint32_t arch_lo = u16(), arch_hi = u16();
+    const uint32_t lib_lo  = u16(), lib_hi  = u16();
+    if ((arch_lo | arch_hi << 16) != lf_kq_fnv(lf_kq_arch_name(device))) {
+        bad(("made for another GPU architecture (this is " + lf_kq_arch_name(device) + ")").c_str()); return;
+    }
+    if ((lib_lo | lib_hi << 16) != lf_kq_fnv(lf_kq_lib_name(st))) {
+        fprintf(stderr, "FRANK_KQ_BLAS_ALGOS: made with another hipBLASLt build (this is %s); using it anyway, "
+                        "time once more if prefill got slower\n", lf_kq_lib_name(st).c_str());
+    }
+    const int b0 = (int) u8(), nb = (int) u8(), ns = (int) u8();
+    const uint32_t base_lo = u16(), base_hi = u8();
+    const uint32_t base = base_lo | base_hi << 16;
+    const int db = (int) u8();
+    if (db < 1 || db > 3) { bad("bad delta width"); return; }
+    struct shp { int K, M, mc; };
+    std::vector<shp> sh;
+    for (int i = 0; i < ns; ++i) {
+        const int K = (int) u16() * 16;
+        const uint32_t m = u16();
+        const int M = (int) (m & 0x7FFF) * 16;
+        const int mc = (m & 0x8000) ? M : (int) u16() * 16;
+        sh.push_back({K, M, mc});
+    }
+    const uint32_t none = (1u << (8 * db)) - 1;
+    int n = 0;
+    for (int i = 0; i < ns; ++i) {
+        for (int b = 0; b < nb; ++b) {
+            uint32_t d = 0;
+            for (int k = 0; k < db; ++k) d |= u8() << (8 * k);
+            if (d != none) { st.table[{sh[i].mc, b0 + b, sh[i].K, sh[i].M}] = (int) (base + d); ++n; }
+        }
+    }
+    if (o + 4 != v.size()) { st.table.clear(); bad("length mismatch"); return; }
+    fprintf(stderr, "FRANK_KQ_BLAS_ALGOS: %d choices for %d shapes x %d buckets, no timing\n", n, ns, nb);
+}
+
+std::string lf_kq_algos_export(lf_kq_state & st, const int device) {
+    std::map<std::tuple<int, int, int>, std::map<int, int>> shapes; // (K, M, rows per call) -> bucket -> index
+    int bmin = 1 << 30, bmax = -1;
+    uint32_t imin = 0xFFFFFFFFu, imax = 0;
+    for (const auto & e : st.bucket) {
+        const auto & [dev, mc, b, K, M] = e.first;
+        if (dev != device || !e.second.ok || e.second.idx < 0) continue;
+        shapes[{K, M, mc}][b] = e.second.idx;
+        bmin = std::min(bmin, b); bmax = std::max(bmax, b);
+        imin = std::min(imin, (uint32_t) e.second.idx); imax = std::max(imax, (uint32_t) e.second.idx);
+    }
+    if (shapes.empty() || bmax - bmin + 1 > 255 || shapes.size() > 255 || imax >= (1u << 24)) return "";
+    const int db = imax - imin < 255 ? 1 : (imax - imin < 65535 ? 2 : 3);
+    std::vector<uint8_t> v;
+    auto p8  = [&](uint32_t x) { v.push_back((uint8_t) x); };
+    auto p16 = [&](uint32_t x) { p8(x & 0xFF); p8(x >> 8 & 0xFF); };
+    p8(2);
+    const uint32_t arch = lf_kq_fnv(lf_kq_arch_name(device)), lib = lf_kq_fnv(lf_kq_lib_name(st));
+    p16(arch & 0xFFFF); p16(arch >> 16);
+    p16(lib & 0xFFFF); p16(lib >> 16);
+    p8(bmin); p8(bmax - bmin + 1); p8((uint32_t) shapes.size());
+    p16(imin & 0xFFFF); p8(imin >> 16);
+    p8(db);
+    for (const auto & s : shapes) {
+        const auto & [K, M, mc] = s.first;
+        p16(K / 16);
+        if (mc == M) { p16((M / 16) | 0x8000); } else { p16(M / 16); p16(mc / 16); }
+    }
+    const uint32_t none = (1u << (8 * db)) - 1;
+    for (const auto & s : shapes) {
+        for (int b = bmin; b <= bmax; ++b) {
+            auto it = s.second.find(b);
+            const uint32_t d = it == s.second.end() ? none : (uint32_t) it->second - imin;
+            for (int k = 0; k < db; ++k) p8(d >> (8 * k) & 0xFF);
+        }
+    }
+    const uint32_t c = lf_kq_crc32(v, v.size());
+    p16(c & 0xFFFF); p16(c >> 16);
+    return "K1a2." + lf_kq_b64enc(v);
+}
+
+// Once per device: does this hipBLASLt find f16 kernels for the GPU (its kernel library is a separate directory, see
+// HIPBLASLT_TENSILE_LIBPATH)?  If not, the path stays off with a warning instead of aborting at the first prompt.
+bool lf_kq_probe(const int device) {
+    lf_kq_state & st = lf_kq();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (st.probe[device] != 0) return st.probe[device] > 0;
+    st.probe[device] = -1;
+    if (!st.handle && hipblasLtCreate(&st.handle) != HIPBLAS_STATUS_SUCCESS) {
+        st.handle = nullptr;
+        fprintf(stderr, "FRANK_KQ_BLAS: hipblasLtCreate failed, off\n");
+        return false;
+    }
+    hipblasLtMatmulDesc_t desc = nullptr;
+    hipblasLtMatrixLayout_t la = nullptr, lb = nullptr, lc = nullptr;
+    hipblasLtMatmulPreference_t pref = nullptr;
+    hipblasLtMatmulHeuristicResult_t res[1];
+    int nres = 0;
+    const hipblasOperation_t ta = HIPBLAS_OP_T, tb = HIPBLAS_OP_N;
+    const hipblasLtPointerMode_t pm = HIPBLASLT_POINTER_MODE_ALPHA_DEVICE_VECTOR_BETA_HOST;
+    bool ok = hipblasLtMatmulDescCreate(&desc, HIPBLAS_COMPUTE_32F, HIP_R_32F) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatmulDescSetAttribute(desc, HIPBLASLT_MATMUL_DESC_TRANSA, &ta, sizeof(ta)) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatmulDescSetAttribute(desc, HIPBLASLT_MATMUL_DESC_TRANSB, &tb, sizeof(tb)) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatmulDescSetAttribute(desc, HIPBLASLT_MATMUL_DESC_POINTER_MODE, &pm, sizeof(pm)) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatrixLayoutCreate(&la, HIP_R_16F, 1024, 1024, 1024) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatrixLayoutCreate(&lb, HIP_R_16F, 1024, 1024, 1024) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatrixLayoutCreate(&lc, HIP_R_32F, 1024, 1024, 1024) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatmulPreferenceCreate(&pref) == HIPBLAS_STATUS_SUCCESS &&
+        hipblasLtMatmulAlgoGetHeuristic(st.handle, desc, la, lb, lc, lc, pref, 1, res, &nres) == HIPBLAS_STATUS_SUCCESS && nres > 0;
+    if (pref) hipblasLtMatmulPreferenceDestroy(pref);
+    if (lc) hipblasLtMatrixLayoutDestroy(lc);
+    if (lb) hipblasLtMatrixLayoutDestroy(lb);
+    if (la) hipblasLtMatrixLayoutDestroy(la);
+    if (desc) hipblasLtMatmulDescDestroy(desc);
+    if (!ok) {
+        fprintf(stderr, "FRANK_KQ_BLAS: hipBLASLt has no f16 kernels for this GPU (kernel library not found? set "
+                      "HIPBLASLT_TENSILE_LIBPATH to its hipblaslt\\library directory), off\n");
+        return false;
+    }
+    st.probe[device] = 1;
+    // the mode itself, not the f16 kernels this probe looked for (every K1 mode probes them; the eval line read "f16" here under fp8)
+    fprintf(stderr, "FRANK_KQ_BLAS: hipBLASLt found; K1 prefill GEMM in %s\n", lf_kq_mode_name());
+    return true;
+}
+
+#endif // defined(FRANK_HIPBLASLT)
+
+#if defined(FRANK_HIPBLASLT)
+// ------------------------------------------------------------------------------------------------ fp8 GEMM (K1 fp8 mode, shared with M4)
+// fp8 e4m3 activations with ONE scale for the whole batch (hipBLASLt on gfx1201 has no per-column scale mode, passed as the
+// device-side B scale), converted once per input and graph; the weight side is fp8 [M][K] with a per-row alpha vector.
+__global__ void lf_act_amax_global(const float * __restrict__ x, const int K, unsigned int * __restrict__ gbits) {
+    const float * row = x + (size_t) blockIdx.x * K;
+    float a = 0.f;
+    for (int k = threadIdx.x; k < K; k += blockDim.x) a = fmaxf(a, fabsf(row[k]));
+    __shared__ float red[256];
+    red[threadIdx.x] = a;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] = fmaxf(red[threadIdx.x], red[threadIdx.x + s]);
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) atomicMax(gbits, __float_as_uint(red[0]));
+}
+
+// the same maximum over the whole contiguous activation: float4 grid-stride loads, wave reduction, one atomic per wave (the per-row
+// launch above runs one 256-thread block per token with a shared-memory tree: ~60% slower than the quantization pass that follows);
+// a maximum does not depend on the order, so the result is bit-identical.  FRANK_MXFP4_AMAX=row selects the per-row kernel.
+__global__ void lf_act_amax_flat(const float4 * __restrict__ x, const int64_t n4, unsigned int * __restrict__ gbits) {
+    float a = 0.f;
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < n4; i += (int64_t) gridDim.x * blockDim.x) {
+        const float4 v = x[i];
+        a = fmaxf(a, fmaxf(fmaxf(fabsf(v.x), fabsf(v.y)), fmaxf(fabsf(v.z), fabsf(v.w))));
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a = fmaxf(a, __shfl_xor(a, o, 32));
+    if ((threadIdx.x & 31) == 0) atomicMax(gbits, __float_as_uint(a));
+}
+
+__global__ void lf_quant_act_fp8_global(const float * __restrict__ x, uint8_t * __restrict__ xq, const unsigned int * __restrict__ gbits,
+        float * __restrict__ sx, const int K) {
+#if defined(RDNA4)
+    const float amax = __uint_as_float(*gbits);
+    const float inv  = amax > 0.f ? 448.f / amax : 0.f;
+    const float * row = x + (size_t) blockIdx.x * K;
+    for (int k = 4 * threadIdx.x; k < K; k += 4 * blockDim.x) {
+        const float4 v = *(const float4 *) (row + k);
+        int w = __builtin_amdgcn_cvt_pk_fp8_f32(v.x * inv, v.y * inv, 0, false);
+        w     = __builtin_amdgcn_cvt_pk_fp8_f32(v.z * inv, v.w * inv, w, true);
+        *(int *) (xq + (size_t) blockIdx.x * K + k) = w;
+    }
+    if (blockIdx.x == 0 && threadIdx.x == 0) *sx = amax > 0.f ? amax / 448.f : 1.f;
+#else
+    GGML_UNUSED_VARS(x, xq, gbits, sx, K);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// gfx1201 fp8 priority list v1 for the blaslt path: hipBLASLt solution indices of the fp8 e4m3 x e4m3 -> f32 GEMM (TN, alpha
+// vector, B scale pointer), best first.  Measured with tools/k1probe/k8probe on gfx1201 / hipBLASLt 100401 8d1ae90e, 32 shapes
+// (rows 48..17408, K 5120 / 6144 / 17408, 512..2048 tokens), ordered by geometric-mean slowdown against each shape's fastest
+// candidate.  Weighted by the 27B layer mix, the listed choice is 1.9% slower than the per-shape fastest (the heuristic's first
+// candidate: +20%).
+const int LF_MX_PRIO_GFX1201_V1[] = {
+    131358, 131361, 131375, 131362, 131367, 131364, 131368, 131392, 131425, 131413, 131481, 131497, 131365, 131482,
+    131496, 131485, 131354, 131419, 131448, 131507, 131458, 131395, 131461, 131380, 131503, 131360, 131385, 130764,
+    130744, 130763, 131452, 131446, 131418, 131421, 131410, 131498, 131456, 131506, 131435, 131343, 130774, 130770,
+    130769, 131342, 131049, 130746, 131082, 130759, 131154, 130823, 130765, 131065, 130752, 131152, 130819, 130787,
+    131187, 130828, 131426, 130749, 131033, 131379, 130838, 131067
+};
+
+#define LF_BLT_CHECK(x) do { const hipblasStatus_t st_ = (x); if (st_ != HIPBLAS_STATUS_SUCCESS) GGML_ABORT("%s failed: status %d", #x, (int) st_); } while (0)
+
+struct lf_blt_shape {
+    hipblasLtMatmulDesc_t   desc = nullptr;
+    hipblasLtMatrixLayout_t la = nullptr, lb = nullptr, lc = nullptr;
+    hipblasLtMatmulAlgo_t   algo{};
+    size_t                  ws = 0;
+};
+struct lf_blt_state {
+    std::mutex mutex;
+    hipblasLtHandle_t handle = nullptr;
+    std::map<std::tuple<int, int, int>, lf_blt_shape> shapes;
+    // fp8 activations + batch scale per stream, kept across the MUL_MATs of one graph that read the same input
+    struct act { uint8_t * ptr = nullptr; size_t size = 0; const void * x_src = nullptr; const void * x_data = nullptr;
+                 int T = 0, K = 0; uint64_t gen = 0; };
+    std::map<cudaStream_t, act> acts;
+};
+std::atomic<uint64_t> g_lf_fp8_graph_gen{1}; // advanced at every graph start: invalidates the converted inputs
+lf_blt_state & lf_blt() { static lf_blt_state s; return s; }
+
+// the fp8 GEMM itself on prepared operands (fp8 activations xqp, their scale at sxp_dev): y[M][T] = av[m] * sx * (w8[m] . xq[t]);
+// the caller holds st.mutex
+static int lf_blt_algo_mode() {
+    static const int m = [] {
+        const char * e = getenv("FRANK_MXFP4_ALGOS");
+        if (e && strcmp(e, "timed") == 0) return 2;
+        if (e && strcmp(e, "heur") == 0) return 1;
+        return 0;
+    }();
+    return m;
+}
+
+// c != nullptr: y = the product + c (beta 1, c may be y itself), see ggml_cuda_lf_kq8_mul_mat_add
+// BigOne GLU16: the fp8 GEMM with a 16-bit output (FRANK_KQ_BLAS_GLU16_ALGOS: unset = LF_GLU16_PRIO_GFX1201 first, then the
+// heuristic's order; heur = the heuristic's first candidate; timed = the fastest candidate on the first full batch of each shape)
+// 11-06 e4 (timed, twice the same): algo 129247 for the gate / up shape M=17408 N=2048 K=5248 at 1.27 ms; the heuristic's first,
+// 129254, gives the same bits but prefill was 0.9-1.0% slower overall
+const int LF_GLU16_PRIO_GFX1201[] = { 129247 };
+static int lf_glu16_algo_mode() {
+    static const int m = [] {
+        const char * e = getenv("FRANK_KQ_BLAS_GLU16_ALGOS");
+        if (e && strcmp(e, "timed") == 0) return 2;
+        if (e && strcmp(e, "heur") == 0) return 1;
+        return 0;
+    }();
+    return m;
+}
+
+static std::atomic<bool> g_lf_glu16_off{false};   // hipBLASLt had no algorithm for a 16-bit output: GLU16 stays off
+
+// otype: 0 = f32 output, GGML_TYPE_F16 = y holds M x T f16 values (BigOne GLU16; c must be nullptr).
+// Returns the output type written (0 if hipBLASLt has no algorithm for the 16-bit one: then the f32 product).
+int lf_blt_gemm_q(ggml_backend_cuda_context & ctx, lf_blt_state & st, const float * av, const uint8_t * w8_ptr, uint8_t * xqp,
+        float * sxp_dev, float * y, const int M, const int T, const int K, const float * c = nullptr, const int otype = 0) {
+    cudaStream_t stream = ctx.stream();
+    struct { const uint8_t * get() const { return p; } const uint8_t * p; } w8{w8_ptr};
+    struct { uint8_t * get() const { return p; } uint8_t * p; } xq{xqp};
+    struct { float * get() const { return p; } float * p; } sx{sxp_dev};
+
+    const float beta = 0.f;
+    const float beta_c = 1.f;
+    GGML_ASSERT(otype == 0 || c == nullptr);
+    const int okey = otype == 0 ? 0 : otype == GGML_TYPE_F16 ? 1 << 28 : 2 << 28;
+    lf_blt_shape & sh = st.shapes[{M, T, K | okey}];
+    const bool fresh = sh.desc == nullptr;
+    if (fresh) {
+        LF_BLT_CHECK(hipblasLtMatmulDescCreate(&sh.desc, HIPBLAS_COMPUTE_32F, HIP_R_32F));
+        const hipblasOperation_t ta = HIPBLAS_OP_T, tb = HIPBLAS_OP_N;
+        const hipblasLtPointerMode_t pm = HIPBLASLT_POINTER_MODE_ALPHA_DEVICE_VECTOR_BETA_HOST;
+        LF_BLT_CHECK(hipblasLtMatmulDescSetAttribute(sh.desc, HIPBLASLT_MATMUL_DESC_TRANSA, &ta, sizeof(ta)));
+        LF_BLT_CHECK(hipblasLtMatmulDescSetAttribute(sh.desc, HIPBLASLT_MATMUL_DESC_TRANSB, &tb, sizeof(tb)));
+        LF_BLT_CHECK(hipblasLtMatmulDescSetAttribute(sh.desc, HIPBLASLT_MATMUL_DESC_POINTER_MODE, &pm, sizeof(pm)));
+        LF_BLT_CHECK(hipblasLtMatrixLayoutCreate(&sh.la, HIP_R_8F_E4M3, K, M, K));
+        LF_BLT_CHECK(hipblasLtMatrixLayoutCreate(&sh.lb, HIP_R_8F_E4M3, K, T, K));
+        const hipDataType ct = otype == 0 ? HIP_R_32F : HIP_R_16F;
+        LF_BLT_CHECK(hipblasLtMatrixLayoutCreate(&sh.lc, ct, M, T, M));
+    }
+    const float * sxp = sx.get();
+    LF_BLT_CHECK(hipblasLtMatmulDescSetAttribute(sh.desc, HIPBLASLT_MATMUL_DESC_B_SCALE_POINTER, &sxp, sizeof(sxp)));
+    if (fresh && otype != 0) {   // BigOne GLU16: without an algorithm for the 16-bit output, the f32 product (and GLU16 off)
+        hipblasLtMatmulPreference_t pref;
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceCreate(&pref));
+        hipblasLtMatmulHeuristicResult_t r1[1];
+        int n1 = 0;
+        const bool ok = hipblasLtMatmulAlgoGetHeuristic(st.handle, sh.desc, sh.la, sh.lb, sh.lc, sh.lc, pref, 1, r1, &n1) == HIPBLAS_STATUS_SUCCESS;
+        hipblasLtMatmulPreferenceDestroy(pref);
+        if (!ok || n1 == 0) {
+            hipblasLtMatmulDescDestroy(sh.desc);
+            hipblasLtMatrixLayoutDestroy(sh.la); hipblasLtMatrixLayoutDestroy(sh.lb); hipblasLtMatrixLayoutDestroy(sh.lc);
+            st.shapes.erase({M, T, K | okey});
+            if (!g_lf_glu16_off.exchange(true)) {
+                GGML_LOG_WARN("FRANK_KQ_BLAS_GLU16: hipBLASLt has no fp8 algorithm with an f16 output (M=%d N=%d K=%d): GLU16 off\n",
+                              M, T, K);
+            }
+            return lf_blt_gemm_q(ctx, st, av, w8_ptr, xqp, sxp_dev, y, M, T, K, c, 0);
+        }
+    }
+
+    // algorithm choice: the heuristic's first candidate (default; no timing, the same choice every run), or with
+    // FRANK_MXFP4_ALGOS=timed the fastest of the heuristic's candidates timed on the first full batch of each shape
+    // (T % 512 == 0; the choice can differ from run to run because of timing noise, and so can the outputs)
+    // FRANK_MXFP4_ALGOS: unset = the gfx1201 fp8 priority list (no timing, the same choice every run), heur = the heuristic's
+    // first candidate, timed = the fastest candidate timed on the first full batch (T % 512 == 0) of each shape (old behaviour;
+    // the choice, and so the outputs, can differ from run to run)
+    const int algo_mode = otype != 0 ? lf_glu16_algo_mode() : lf_blt_algo_mode();
+    GGML_ASSERT(c == nullptr || algo_mode != 2);   // the timed runs would add c again
+    if (fresh && algo_mode == 0) {
+        const size_t ws_max = 64ull << 20;
+        hipblasLtMatmulPreference_t pref;
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceCreate(&pref));
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceSetAttribute(pref, HIPBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &ws_max, sizeof(ws_max)));
+        hipblasLtMatmulHeuristicResult_t res[32];
+        int nres = 0;
+        LF_BLT_CHECK(hipblasLtMatmulAlgoGetHeuristic(st.handle, sh.desc, sh.la, sh.lb, sh.lc, sh.lc, pref, 32, res, &nres));
+        hipblasLtMatmulPreferenceDestroy(pref);
+        if (nres == 0) GGML_ABORT("hipBLASLt has no fp8 algorithm for M=%d N=%d K=%d", M, T, K);
+        const int * prio = otype != 0 ? LF_GLU16_PRIO_GFX1201 : LF_MX_PRIO_GFX1201_V1;
+        const int np = otype != 0 ? (int) (sizeof(LF_GLU16_PRIO_GFX1201) / sizeof(LF_GLU16_PRIO_GFX1201[0]))
+                                  : (int) (sizeof(LF_MX_PRIO_GFX1201_V1) / sizeof(LF_MX_PRIO_GFX1201_V1[0]));
+        auto rank_of = [&](const int i) {   // listed candidates first, the rest after them in the heuristic's order
+            const int idx = hipblaslt_ext::getIndexFromAlgo(res[i].algo);
+            for (int k = 0; k < np; ++k) if (prio[k] == idx) return k;
+            return 1000 + i;
+        };
+        int bi = -1;
+        for (int i = 0; i < nres; ++i) {
+            if (res[i].workspaceSize <= ws_max && (bi < 0 || rank_of(i) < rank_of(bi))) bi = i;
+        }
+        if (bi < 0) bi = 0;
+        sh.algo = res[bi].algo;
+        sh.ws   = res[bi].workspaceSize;
+        if (lf_kq_log()) fprintf(stderr, "LF_FP8 blaslt M=%d N=%d K=%d out=%d: priority-list choice %d (rank %d of %d candidates)\n",
+                              M, T, K, otype, hipblaslt_ext::getIndexFromAlgo(res[bi].algo), rank_of(bi), nres);
+    } else if (fresh && (T % 512 != 0 || algo_mode == 1)) {
+        // a prompt's odd-sized last batch: every prompt length is a new shape, so timing it would re-tune on almost every
+        // request -- take the heuristic's first candidate
+        const size_t ws_max = 64ull << 20;
+        hipblasLtMatmulPreference_t pref;
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceCreate(&pref));
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceSetAttribute(pref, HIPBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &ws_max, sizeof(ws_max)));
+        hipblasLtMatmulHeuristicResult_t res[1];
+        int nres = 0;
+        LF_BLT_CHECK(hipblasLtMatmulAlgoGetHeuristic(st.handle, sh.desc, sh.la, sh.lb, sh.lc, sh.lc, pref, 1, res, &nres));
+        hipblasLtMatmulPreferenceDestroy(pref);
+        if (nres == 0) GGML_ABORT("hipBLASLt has no fp8 algorithm for M=%d N=%d K=%d", M, T, K);
+        sh.algo = res[0].algo;
+        sh.ws   = res[0].workspaceSize;
+    } else if (fresh) {
+        // pick the fastest of the heuristic's candidates on the real operands (the last run leaves the right result)
+        const size_t ws_max = 64ull << 20;
+        hipblasLtMatmulPreference_t pref;
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceCreate(&pref));
+        LF_BLT_CHECK(hipblasLtMatmulPreferenceSetAttribute(pref, HIPBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &ws_max, sizeof(ws_max)));
+        hipblasLtMatmulHeuristicResult_t res[16];
+        int nres = 0;
+        LF_BLT_CHECK(hipblasLtMatmulAlgoGetHeuristic(st.handle, sh.desc, sh.la, sh.lb, sh.lc, sh.lc, pref, 16, res, &nres));
+        hipblasLtMatmulPreferenceDestroy(pref);
+        if (nres == 0) GGML_ABORT("hipBLASLt has no fp8 algorithm for M=%d N=%d K=%d", M, T, K);
+        size_t wsz = 0;
+        for (int i = 0; i < nres; ++i) wsz = std::max(wsz, res[i].workspaceSize);
+        ggml_cuda_pool_alloc<char> ws(ctx.pool(), std::max<size_t>(wsz, 1));
+        hipEvent_t e0, e1;
+        CUDA_CHECK(hipEventCreate(&e0)); CUDA_CHECK(hipEventCreate(&e1));
+        float best = 1e30f; int bi = 0;
+        for (int i = 0; i < nres; ++i) {
+            float tsum = 0.f; bool ok = true;
+            for (int r = 0; r < 3 && ok; ++r) {
+                CUDA_CHECK(hipEventRecord(e0, stream));
+                ok = hipblasLtMatmul(st.handle, sh.desc, av, w8.get(), sh.la, xq.get(), sh.lb, &beta, y, sh.lc, y, sh.lc,
+                                     &res[i].algo, ws.get(), res[i].workspaceSize, stream) == HIPBLAS_STATUS_SUCCESS;
+                CUDA_CHECK(hipEventRecord(e1, stream));
+                CUDA_CHECK(hipEventSynchronize(e1));
+                float ms = 0.f; CUDA_CHECK(hipEventElapsedTime(&ms, e0, e1));
+                if (r > 0) tsum += ms;
+            }
+            if (ok && tsum < best) { best = tsum; bi = i; }
+        }
+        CUDA_CHECK(hipEventDestroy(e0)); CUDA_CHECK(hipEventDestroy(e1));
+        sh.algo = res[bi].algo;
+        sh.ws   = res[bi].workspaceSize;
+        if (lf_kq_log()) fprintf(stderr, "LF_FP8 blaslt M=%d N=%d K=%d out=%d: %d candidates, picked %d = algo %d (%.1f us)\n", M, T, K,
+                                 otype, nres, bi, hipblaslt_ext::getIndexFromAlgo(res[bi].algo), best * 500.f);
+    }
+    ggml_cuda_pool_alloc<char> ws(ctx.pool(), std::max<size_t>(sh.ws, 1));
+    LF_BLT_CHECK(hipblasLtMatmul(st.handle, sh.desc, av, w8.get(), sh.la, xq.get(), sh.lb, c ? &beta_c : &beta, c ? c : y, sh.lc, y, sh.lc,
+                                 &sh.algo, ws.get(), sh.ws, stream));
+    return otype;
+}
+
+// fp8 activations (shared per input and graph) + hipBLASLt fp8 GEMM: y[M][T] = av[m] * sx * (w8[m] . xq[t]); the caller holds st.mutex
+int lf_blt_gemm(ggml_backend_cuda_context & ctx, lf_blt_state & st, const ggml_tensor * src1, const float * av, const uint8_t * w8_ptr,
+        const float * x, float * y, const int M, const int T, const int K, const float * c = nullptr, const int otype = 0) {
+    cudaStream_t stream = ctx.stream();
+    static const bool share = !getenv("FRANK_MXFP4_SHARE") || atoi(getenv("FRANK_MXFP4_SHARE")) != 0;
+    lf_blt_state::act & ac = st.acts[stream];
+    const size_t act_bytes = ((size_t) T * K + 255) / 256 * 256 + 256;
+    if (ac.size < act_bytes) {
+        if (ac.ptr) {
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            CUDA_CHECK(cudaFree(ac.ptr));
+        }
+        CUDA_CHECK(cudaMalloc((void **) &ac.ptr, act_bytes));
+        ac.size = act_bytes;
+        ac.x_src = nullptr;
+    }
+    uint8_t * xqp = ac.ptr;
+    float * sxp_dev = (float *) (ac.ptr + ((size_t) T * K + 255) / 256 * 256);
+    unsigned int * gbp = (unsigned int *) (sxp_dev + 16);
+    const ggml_tensor * x_src = src1;
+    while (x_src->view_src != nullptr) x_src = x_src->view_src;
+    const uint64_t gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    if (!share || ac.x_src != x_src || ac.x_data != x || ac.T != T || ac.K != K || ac.gen != gen) {
+        CUDA_CHECK(cudaMemsetAsync(gbp, 0, sizeof(unsigned int), stream));
+        static const bool amax_row = getenv("FRANK_MXFP4_AMAX") && strcmp(getenv("FRANK_MXFP4_AMAX"), "row") == 0;
+        if (amax_row) {
+            lf_act_amax_global<<<T, 256, 0, stream>>>(x, K, gbp);
+        } else {
+            const int64_t n4 = (int64_t) T * K / 4;
+            const int blocks = (int) std::min<int64_t>(2048, (n4 + 255) / 256);
+            lf_act_amax_flat<<<blocks, 256, 0, stream>>>((const float4 *) x, n4, gbp);
+        }
+        lf_quant_act_fp8_global<<<T, 256, 0, stream>>>(x, xqp, gbp, sxp_dev, K);
+        ac.x_src = x_src; ac.x_data = x; ac.T = T; ac.K = K; ac.gen = gen;
+    }
+    return lf_blt_gemm_q(ctx, st, av, w8_ptr, xqp, sxp_dev, y, M, T, K, c, otype);
+}
+
+// ------------------------------------------------------------------------------------------------ K-quant -> fp8 (K1 fp8 mode)
+// FRANK_KQ_BLAS=fp8 (dispatched from ggml_cuda_lf_kq_blas_mul_mat): any quantized weight with a to_fp16 kernel is dequantized to f16 in row
+// chunks and rounded to fp8 e4m3 with one scale per row (row amax / 448, computed once per weight tensor and cached; it also
+// serves as hipBLASLt's per-row alpha), then multiplied with the shared fp8 activations by the hipBLASLt fp8 GEMM below (shared with M4).
+// Lossy: K-quant values are not fp8 values (unlike MXFP4), on top of the fp8 activations.
+__global__ void lf_kq_row_scale(const half * __restrict__ w16, const int K, float * __restrict__ scale) {
+    const half * row = w16 + (size_t) blockIdx.x * K;
+    float a = 0.f;
+    for (int k = threadIdx.x; k < K; k += blockDim.x) a = fmaxf(a, fabsf(__half2float(row[k])));
+    __shared__ float red[256];
+    red[threadIdx.x] = a;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] = fmaxf(red[threadIdx.x], red[threadIdx.x + s]);
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) scale[blockIdx.x] = red[0] > 0.f ? red[0] / 448.f : 1.f;
+}
+
+__global__ void lf_kq_f16_to_fp8(const half * __restrict__ w16, const float * __restrict__ scale, uint8_t * __restrict__ w8,
+        const int K, const int64_t n4) {
+#if defined(RDNA4)
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;   // 4 values per thread
+    if (i >= n4) return;
+    const int64_t e = 4 * i;
+    const float inv = 1.f / scale[e / K];
+    const half2 a = *(const half2 *) (w16 + e), b = *(const half2 *) (w16 + e + 2);
+    int w = __builtin_amdgcn_cvt_pk_fp8_f32(__low2float(a) * inv, __high2float(a) * inv, 0, false);
+    w     = __builtin_amdgcn_cvt_pk_fp8_f32(__low2float(b) * inv, __high2float(b) * inv, w, true);
+    *(int *) (w8 + e) = w;
+#else
+    GGML_UNUSED_VARS(w16, scale, w8, K, n4);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+struct lf_kq_fp8_cache {
+    std::mutex mutex;
+    std::map<std::tuple<const void *, int64_t, int64_t, int>, float *> scale; // per weight tensor: row scales (= alpha vector)
+};
+lf_kq_fp8_cache & lf_kq8() { static lf_kq_fp8_cache c; return c; }
+
+float * lf_kq8_scale_lookup(const ggml_tensor * src0, const int device) {
+    lf_kq_fp8_cache & c = lf_kq8();
+    std::lock_guard<std::mutex> lock(c.mutex);
+    auto it = c.scale.find({src0->data, src0->ne[0], src0->ne[1], device});
+    return it == c.scale.end() ? nullptr : it->second;
+}
+
+// ------------------------------------------------------------------------------------------------ K1 fp8: outlier channels (v3)
+// The fp8 error of a GEMM output is dominated by the few activation channels that are far larger than the rest (the input of
+// ffn_down / attn_output / ssm_out: the largest channel is 30-110x the median).  FRANK_KQ_BLAS_FP8_KEEP=k (default 64, 0 = off,
+// rounded up to a multiple of 8): per input, the k channels with the largest batch amax get a second fp8 term for both
+// operands, appended to the K dimension of the same GEMM:
+//   A row m: [ W8[m][0..K) | W8[m][c_j] | EW8[m][c_j] ]      EW8 = fp8(w/s - W8), the weight's rounding residual
+//   B col t: [ X8[0..K)[t] | RX8[c_j][t] | X8[c_j][t] ]      RX8 = fp8(x/s - X8), the activation's rounding residual
+// so the product adds W8 * RX8 + EW8 * X8 for those channels: their weight and activation rounding errors are corrected up to
+// the second-order term EW8 * RX8.  The scales (row scale, batch scale) are the ones of the plain fp8 mode; K grows by 2k
+// (k 64: 0.7-2.5%).  Measured on Qwen3.8-27B UD-Q5_K_M against an f32 reference (KLD over 400 tokens after a 30K prefill):
+// k 64 halves the fp8 error above K1 f16 (Chinese / English), k 32 removes about 30%; prefill -0.9% / -0.1%.
+int lf_kq_fp8_keep() {
+    static const int k = [] {
+        const char * e = getenv("FRANK_KQ_BLAS_FP8_KEEP");
+        const int v = std::max(0, std::min(e ? atoi(e) : 64, 248));
+        return (v + 7) / 8 * 8;
+    }();
+    return k;
+}
+int lf_kq_fp8_keep_for(const int K) { return K >= 1024 ? lf_kq_fp8_keep() : 0; }
+
+// per-channel amax of a T x K activation batch: one thread per channel and 64 rows, an atomic max per (channel, row block)
+__global__ void lf_kq8_chan_amax(const float * __restrict__ x, const int T, const int K, unsigned int * __restrict__ cbits) {
+    const int k = blockIdx.x * blockDim.x + threadIdx.x;
+    if (k >= K) return;
+    const int t0 = blockIdx.y * 64, t1 = min(T, t0 + 64);
+    float a = 0.f;
+    for (int t = t0; t < t1; ++t) a = fmaxf(a, fabsf(x[(size_t) t * K + k]));
+    atomicMax(cbits + k, __float_as_uint(a));
+}
+
+// the k largest channel amaxes, ordered by amax (ties to the lower channel): keys (amax bits << 32 | ~channel) sorted in
+// shared memory (bitonic, descending).  Stage 1: G blocks each keep the top k of their segment of the channels (and clear
+// their part of the channel -> slot map); stage 2: one block merges the G * k candidates, writes the channels, the slot map
+// (slot j + 1, 0 = not kept) and the batch amax (the scale of the plain fp8 activations, bit-identical to lf_act_amax_flat's).
+static __device__ void lf_kq8_bitonic_desc(unsigned long long * key, const int n) {
+    for (int size = 2; size <= n; size <<= 1) {
+        for (int stride = size >> 1; stride > 0; stride >>= 1) {
+            for (int i = threadIdx.x; i < n / 2; i += blockDim.x) {
+                const int lo = 2 * i - (i & (stride - 1)), hi = lo + stride;
+                const bool desc = (lo & size) == 0;
+                const unsigned long long a = key[lo], b = key[hi];
+                if ((a < b) == desc) { key[lo] = b; key[hi] = a; }
+            }
+            __syncthreads();
+        }
+    }
+}
+static int lf_kq8_pow2(const int n) { int p = 1; while (p < n) p <<= 1; return p; }
+
+__global__ void lf_kq8_topk_part(const unsigned int * __restrict__ cbits, const int K, const int seg, const int P, const int k,
+        unsigned long long * __restrict__ cand, uint8_t * __restrict__ pos) {
+    extern __shared__ unsigned long long key[];
+    const int c0 = blockIdx.x * seg;
+    for (int i = threadIdx.x; i < P; i += blockDim.x) {
+        const int c = c0 + i;
+        key[i] = (i < seg && c < K) ? ((unsigned long long) cbits[c] << 32) | (0xffffffffu - (unsigned int) c) : 0ull;
+        if (i < seg && c < K) pos[c] = 0;
+    }
+    __syncthreads();
+    lf_kq8_bitonic_desc(key, P);
+    for (int j = threadIdx.x; j < k; j += blockDim.x) cand[(size_t) blockIdx.x * k + j] = j < P ? key[j] : 0ull;
+}
+
+__global__ void lf_kq8_topk_merge_sort(const unsigned long long * __restrict__ cand, const int n, const int P, const int k,
+        int * __restrict__ idx, uint8_t * __restrict__ pos, unsigned int * __restrict__ gbits) {
+    extern __shared__ unsigned long long key[];
+    for (int i = threadIdx.x; i < P; i += blockDim.x) key[i] = i < n ? cand[i] : 0ull;
+    __syncthreads();
+    lf_kq8_bitonic_desc(key, P);
+    for (int j = threadIdx.x; j < k; j += blockDim.x) {
+        const int c = (int) (0xffffffffu - (unsigned int) (key[j] & 0xffffffffu));
+        idx[j] = c;
+        pos[c] = (uint8_t) (j + 1);
+    }
+    if (threadIdx.x == 0) *gbits = (unsigned int) (key[0] >> 32);
+}
+
+// stage 2: each of the G lists holds its segment's top k, sorted (descending; distinct keys: the channel is in the low bits).
+// Pairs of lists merge into their top Pk (Pk = k rounded up to a power of two, zero padded): z[i] = max(x[i], y[Pk - 1 - i])
+// keeps the top Pk of both as a bitonic sequence, which log2(Pk) half-cleaner steps sort; log2(G) such levels leave the top k
+// of all G * k candidates in order -- the same channels, order and batch amax as sorting all of them.
+__global__ void lf_kq8_topk_merge(const unsigned long long * __restrict__ cand, const int G, const int k, const int Gp, const int Pk,
+        int * __restrict__ idx, uint8_t * __restrict__ pos, unsigned int * __restrict__ gbits) {
+    extern __shared__ unsigned long long key[];   // Gp lists of Pk
+    for (int i = threadIdx.x; i < Gp * Pk; i += blockDim.x) {
+        const int l = i / Pk, j = i - l * Pk;
+        key[i] = l < G && j < k ? cand[(size_t) l * k + j] : 0ull;
+    }
+    __syncthreads();
+    for (int s = 1; s < Gp; s <<= 1) {            // merge list l (l % 2s == 0) with list l + s, into list l
+        const int nm = Gp / (2 * s);              // merges at this level
+        for (int t = threadIdx.x; t < nm * Pk; t += blockDim.x) {
+            const int m = t / Pk, i = t - m * Pk;
+            unsigned long long * x = key + (size_t) (2 * s * m) * Pk;
+            const unsigned long long * y = x + (size_t) s * Pk;
+            const unsigned long long b = y[Pk - 1 - i];
+            if (b > x[i]) x[i] = b;
+        }
+        __syncthreads();
+        for (int st = Pk / 2; st > 0; st >>= 1) {
+            for (int t = threadIdx.x; t < nm * (Pk / 2); t += blockDim.x) {
+                const int m = t / (Pk / 2), i = t - m * (Pk / 2);
+                unsigned long long * x = key + (size_t) (2 * s * m) * Pk;
+                const int lo = 2 * i - (i & (st - 1)), hi = lo + st;
+                const unsigned long long a = x[lo], b = x[hi];
+                if (a < b) { x[lo] = b; x[hi] = a; }
+            }
+            __syncthreads();
+        }
+    }
+    for (int j = threadIdx.x; j < k; j += blockDim.x) {
+        const int c = (int) (0xffffffffu - (unsigned int) (key[j] & 0xffffffffu));
+        idx[j] = c;
+        pos[c] = (uint8_t) (j + 1);
+    }
+    if (threadIdx.x == 0) *gbits = (unsigned int) (key[0] >> 32);
+}
+
+// the plain fp8 activations (row stride Kp) and, per kept channel, the residual fp8(x/s - X8) and X8 again (B's extra rows).
+// fixed (BigOne 6d, FRANK_KQ_BLAS_FIXED=1|2): gbits is the input's calibrated amax, times margin; every product is clamped to
+// the fp8 range (448), the kept channels' residuals too, so a value past the calibration saturates instead of becoming NaN.
+template <bool fixed>
+__global__ void lf_kq8_quant_act_keep(const float * __restrict__ x, uint8_t * __restrict__ xq, const unsigned int * __restrict__ gbits,
+        float * __restrict__ sx, const int * __restrict__ idx, const int k, const int K, const int Kp, const float margin) {
+#if defined(RDNA4)
+    const float amax = fixed ? __uint_as_float(*gbits) * margin : __uint_as_float(*gbits);
+    const float inv  = amax > 0.f ? 448.f / amax : 0.f;
+    const float * row = x + (size_t) blockIdx.x * K;
+    uint8_t * out = xq + (size_t) blockIdx.x * Kp;
+    auto cl = [](const float v) { return fixed ? fminf(fmaxf(v, -448.f), 448.f) : v; };
+    for (int c = 4 * threadIdx.x; c < K; c += 4 * blockDim.x) {
+        const float4 v = *(const float4 *) (row + c);
+        int w = __builtin_amdgcn_cvt_pk_fp8_f32(cl(v.x * inv), cl(v.y * inv), 0, false);
+        w     = __builtin_amdgcn_cvt_pk_fp8_f32(cl(v.z * inv), cl(v.w * inv), w, true);
+        *(int *) (out + c) = w;
+    }
+    for (int j = threadIdx.x; j < k; j += blockDim.x) {
+        const float x0 = row[idx[j]];
+        const int   q  = __builtin_amdgcn_cvt_pk_fp8_f32(cl(x0 * inv), 0.f, 0, false);
+        const float r  = fmaf(x0, inv, -__builtin_amdgcn_cvt_f32_fp8(q, 0));   // against the exact product: one rounding
+        out[K + j]     = (uint8_t) (__builtin_amdgcn_cvt_pk_fp8_f32(cl(r), 0.f, 0, false) & 0xff);
+        out[K + k + j] = (uint8_t) (q & 0xff);
+    }
+    if (blockIdx.x == 0 && threadIdx.x == 0) *sx = amax > 0.f ? amax / 448.f : 1.f;
+#else
+    GGML_UNUSED_VARS(x, xq, gbits, sx, idx, k, K, Kp, margin);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// BigOne 6d: fixed scales for K1 fp8 (FRANK_KQ_BLAS_FIXED; lossy, within K1's own error).  Per K1 input -- keyed by the weight
+// of the first K1 matmul that reads it -- the calibration batches run the dynamic path and are recorded; from then on that input
+// keeps its KEEP channels and amax (times FRANK_KQ_BLAS_FIXED_MARGIN, default 1): no channel amax (the producers skip theirs
+// too), no top-k, and the activations clamped to the fixed range.  The step towards producers that write the fp8 activations
+// themselves.
+//   0 (default): off -- every batch takes its own amax and KEEP channels (K1 v3).
+//   1: for comparisons, the 6d of 11-05..11-10: each input's first FRANK_KQ_BLAS_FIXED_N batches (4) calibrate, the KEEP
+//      channels of the first one and the largest amax of all.  FRANK_KQ_BLAS_FIXED_KEEP=N with FRANK_KQ_BLAS_FIXED unset is
+//      this mode with N batches (0: off), so the old commands give the old numbers.
+//   2: whole prompts calibrate, and the input is fixed at the first decode step after FRANK_KQ_BLAS_FIXED_MIN_B batches (2) or
+//      FRANK_KQ_BLAS_FIXED_MIN_T tokens (2048) of it -- a prompt is never half dynamic, half fixed; an input short of that keeps
+//      calibrating through the next prompt.  The amax is the largest of all its calibration batches, the KEEP channels the k
+//      with the largest channel amax over all of them (the same top-k as a batch's).
+struct lf_kq8_fixed_cfg_t { int mode = 0; int nbatch = 4; int min_b = 2; long long min_t = 2048; };
+static const lf_kq8_fixed_cfg_t & lf_kq8_fixed_cfg() {
+    static const lf_kq8_fixed_cfg_t c = [] {
+        lf_kq8_fixed_cfg_t r;
+        const char * m = getenv("FRANK_KQ_BLAS_FIXED");
+        const char * old = getenv("FRANK_KQ_BLAS_FIXED_KEEP");
+        if (m != nullptr) {
+            r.mode = std::max(0, std::min(2, atoi(m)));
+        } else if (old != nullptr && atoi(old) > 0) {
+            r.mode = 1; r.nbatch = atoi(old);
+        }
+        if (const char * e = getenv("FRANK_KQ_BLAS_FIXED_N"))     r.nbatch = std::max(1, atoi(e));
+        if (const char * e = getenv("FRANK_KQ_BLAS_FIXED_MIN_B")) r.min_b  = std::max(1, atoi(e));
+        if (const char * e = getenv("FRANK_KQ_BLAS_FIXED_MIN_T")) r.min_t  = std::max(1LL, atoll(e));
+        if (r.mode != 0 && lf_kq_mode() != 2) {   // 6d reads K1 fp8's activation scales only: nothing to fix in another mode
+            GGML_LOG_WARN("FRANK_KQ_BLAS_FIXED=%d: no effect, K1 runs %s (6d works on K1 fp8 only)\n", r.mode, lf_kq_mode_name());
+        } else if (r.mode == 1) {
+            GGML_LOG_WARN("FRANK_KQ_BLAS_FIXED=1: K1 fp8 scales fixed after each input's first %d batches\n", r.nbatch);
+        } else if (r.mode == 2) {
+            GGML_LOG_WARN("FRANK_KQ_BLAS_FIXED=2: K1 fp8 scales fixed at the first decode step after %d batches or %lld tokens of each input\n",
+                          r.min_b, r.min_t);
+        }
+        return r;
+    }();
+    return c;
+}
+static int lf_kq8_fixed_ncal() {   // > 0: fixed scales on (mode 1: its N; mode 2: 1)
+    const lf_kq8_fixed_cfg_t & c = lf_kq8_fixed_cfg();
+    return c.mode == 1 ? c.nbatch : c.mode == 2 ? 1 : 0;
+}
+static float lf_kq8_fixed_margin() {
+    static const float m = [] { const char * e = getenv("FRANK_KQ_BLAS_FIXED_MARGIN"); const float v = e ? (float) atof(e) : 1.0f; return v > 0.f ? v : 1.0f; }();
+    return m;
+}
+struct lf_kq8_fixed {
+    int * idx = nullptr; uint8_t * pos = nullptr; unsigned int * gbits = nullptr;
+    unsigned int * cb_acc = nullptr;   // mode 2: the largest channel amax over the calibration batches
+    int K = 0, kk = 0, ncal = 0; long long ntok = 0;
+    bool pending = false;              // mode 2: locked by a decode step; the KEEP channels are taken at the next use
+    bool ready = false;
+};
+// (first K1 consumer's weight data, K, k, device) -> its fixed KEEP; one allocation per input for the process (under lf_blt().mutex)
+std::map<std::tuple<const void *, int, int, int>, lf_kq8_fixed> g_lf_kq8_fixed;
+static int g_lf_kq8_fixed_open = 0;   // mode 2: inputs recorded and neither locked nor fixed (under lf_blt().mutex)
+static lf_kq8_fixed * lf_kq8_fixed_get(const void * w, const int K, const int kk, const int device, cudaStream_t stream) {
+    lf_kq8_fixed & f = g_lf_kq8_fixed[{w, K, kk, device}];
+    if (f.idx == nullptr) {
+        char * p = nullptr;
+        const size_t o_pos = ((size_t) kk * 4 + 255) / 256 * 256, o_g = o_pos + ((size_t) K + 255) / 256 * 256;
+        CUDA_CHECK(cudaMalloc((void **) &p, o_g + 256));
+        CUDA_CHECK(cudaMemsetAsync(p + o_g, 0, 4, stream));
+        f.idx = (int *) p; f.pos = (uint8_t *) (p + o_pos); f.gbits = (unsigned int *) (p + o_g);
+        f.K = K; f.kk = kk;
+        if (lf_kq8_fixed_cfg().mode == 2) {
+            CUDA_CHECK(cudaMalloc((void **) &f.cb_acc, (size_t) K * 4));
+            CUDA_CHECK(cudaMemsetAsync(f.cb_acc, 0, (size_t) K * 4, stream));
+        }
+    }
+    return &f;
+}
+static const lf_kq8_fixed * lf_kq8_fixed_ready(const void * w, const int K, const int kk, const int device) {
+    if (lf_kq8_fixed_ncal() == 0) return nullptr;
+    auto it = g_lf_kq8_fixed.find({w, K, kk, device});
+    return it != g_lf_kq8_fixed.end() && it->second.ready ? &it->second : nullptr;
+}
+// the startup warm-up's ubatch of repeated BOS tokens is no calibration: called once after it (ggml_cuda_lf_kq_blas_algos_string)
+static void lf_kq8_fixed_reset() {
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    // cudaMemset runs on the legacy stream, which the backends' non-blocking streams do not wait for (and it may return
+    // before it is done): the device is idle before and after it (once per process, after the warm-up)
+    if (!g_lf_kq8_fixed.empty()) CUDA_CHECK(cudaDeviceSynchronize());
+    for (auto & e : g_lf_kq8_fixed) {
+        lf_kq8_fixed & f = e.second;
+        f.ncal = 0; f.ntok = 0; f.pending = f.ready = false;
+        CUDA_CHECK(cudaMemset(f.gbits, 0, 4));
+        if (f.cb_acc != nullptr) CUDA_CHECK(cudaMemset(f.cb_acc, 0, (size_t) f.K * 4));
+    }
+    if (!g_lf_kq8_fixed.empty()) CUDA_CHECK(cudaDeviceSynchronize());
+    g_lf_kq8_fixed_open = 0;
+}
+// the calibration's running amax: the largest batch amax seen (non-negative float bits order as unsigned)
+__global__ void lf_kq8_fixed_amax(unsigned int * __restrict__ fixed, const unsigned int * __restrict__ gbits) {
+    if (threadIdx.x == 0 && *gbits > *fixed) *fixed = *gbits;
+}
+// mode 2: the running channel amax
+__global__ void lf_kq8_fixed_chan_max(unsigned int * __restrict__ acc, const unsigned int * __restrict__ cb, const int K) {
+    const int k = blockIdx.x * blockDim.x + threadIdx.x;
+    if (k < K && cb[k] > acc[k]) acc[k] = cb[k];
+}
+// one calibration batch of an input (the dynamic path's results: idx / pos its KEEP channels, gb its amax, cb its channel amax);
+// under lf_blt().mutex
+static void lf_kq8_fixed_record(lf_kq8_fixed * f, const int * idx, const uint8_t * pos, const unsigned int * gb, const unsigned int * cb,
+        const int T, cudaStream_t stream) {
+    const lf_kq8_fixed_cfg_t & c = lf_kq8_fixed_cfg();
+    if (f->ready || f->pending) return;
+    if (c.mode == 1 && f->ncal == 0) {
+        CUDA_CHECK(cudaMemcpyAsync(f->idx, idx, (size_t) f->kk * 4, cudaMemcpyDeviceToDevice, stream));
+        CUDA_CHECK(cudaMemcpyAsync(f->pos, pos, (size_t) f->K, cudaMemcpyDeviceToDevice, stream));
+    }
+    lf_kq8_fixed_amax<<<1, 32, 0, stream>>>(f->gbits, gb);
+    if (c.mode == 2) {
+        lf_kq8_fixed_chan_max<<<(f->K + 255) / 256, 256, 0, stream>>>(f->cb_acc, cb, f->K);
+        if (f->ncal == 0) g_lf_kq8_fixed_open++;
+    }
+    f->ncal++;
+    f->ntok += T;
+    if (c.mode == 1 && f->ncal >= c.nbatch) f->ready = true;
+}
+// mode 2: a graph whose weight matmuls all take <= 16 tokens is a decode / verify step; it locks every input with enough
+// calibration (its KEEP channels are taken at its next use).  Called at every graph's start.
+static void lf_kq8_fixed_graph_begin(const ggml_cgraph * cgraph) {
+    const lf_kq8_fixed_cfg_t & c = lf_kq8_fixed_cfg();
+    if (c.mode != 2 || cgraph == nullptr) return;
+    lf_blt_state & st = lf_blt();
+    {
+        std::lock_guard<std::mutex> lock(st.mutex);
+        if (g_lf_kq8_fixed_open == 0) return;
+    }
+    long long tmax = 0;
+    bool any = false;
+    for (int i = 0; i < cgraph->n_nodes && tmax <= 16; ++i) {
+        const ggml_tensor * t = cgraph->nodes[i];
+        if (t->op != GGML_OP_MUL_MAT || t->src[1] == nullptr || !ggml_is_quantized(t->src[0]->type)) continue;
+        any = true;
+        tmax = std::max<long long>(tmax, t->src[1]->ne[1] * t->src[1]->ne[2] * t->src[1]->ne[3]);
+    }
+    if (!any || tmax > 16) return;
+    std::lock_guard<std::mutex> lock(st.mutex);
+    int n = 0, nb = 0; long long nt = 0;
+    for (auto & e : g_lf_kq8_fixed) {
+        lf_kq8_fixed & f = e.second;
+        if (f.ready || f.pending || f.ncal == 0 || (f.ncal < c.min_b && f.ntok < c.min_t)) continue;
+        f.pending = true;
+        g_lf_kq8_fixed_open--;
+        n++; nb = std::max(nb, f.ncal); nt = std::max(nt, f.ntok);
+    }
+    static int nlog = 0;
+    if (n > 0 && nlog++ < 4) GGML_LOG_WARN("FRANK_KQ_BLAS_FIXED=2: %d inputs fixed at a decode step after up to %d batches / %lld tokens\n", n, nb, nt);
+}
+
+// lf_kq_f16_to_fp8 with an output row stride that also writes A's extra columns: for a kept channel c (slot j = pos[c] - 1) of row r, W8 at K + j
+// and the rounding residual fp8(w/s - W8) at K + k + j
+__global__ void lf_kq8_f16_to_fp8_keep(const half * __restrict__ w16, const float * __restrict__ scale, const uint8_t * __restrict__ pos,
+        const int k, uint8_t * __restrict__ w8, const int K, const int ld, const int64_t n4) {
+#if defined(RDNA4)
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;   // 4 values per thread
+    if (i >= n4) return;
+    const int64_t e = 4 * i;
+    const int64_t r = e / K, c = e - r * K;
+    const float inv = 1.f / scale[r];
+    const half2 a = *(const half2 *) (w16 + e), b = *(const half2 *) (w16 + e + 2);
+    const float h0 = __low2float(a), h1 = __high2float(a), h2 = __low2float(b), h3 = __high2float(b);
+    int w = __builtin_amdgcn_cvt_pk_fp8_f32(h0 * inv, h1 * inv, 0, false);
+    w     = __builtin_amdgcn_cvt_pk_fp8_f32(h2 * inv, h3 * inv, w, true);
+    uint8_t * out = w8 + r * ld;
+    *(int *) (out + c) = w;
+    const unsigned int p = *(const unsigned int *) (pos + c);
+    if (p != 0u) {
+        // the residuals against the exact products (one rounding, independent of the compiler's contraction choices)
+        const float res[4] = { fmaf(h0, inv, -__builtin_amdgcn_cvt_f32_fp8(w, 0)), fmaf(h1, inv, -__builtin_amdgcn_cvt_f32_fp8(w, 1)),
+                               fmaf(h2, inv, -__builtin_amdgcn_cvt_f32_fp8(w, 2)), fmaf(h3, inv, -__builtin_amdgcn_cvt_f32_fp8(w, 3)) };
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int slot = (int) ((p >> (8 * l)) & 0xffu);
+            if (slot == 0) continue;
+            out[K + slot - 1]     = (uint8_t) ((w >> (8 * l)) & 0xff);
+            out[K + k + slot - 1] = (uint8_t) (__builtin_amdgcn_cvt_pk_fp8_f32(res[l], 0.f, 0, false) & 0xff);
+        }
+    }
+#else
+    GGML_UNUSED_VARS(w16, scale, pos, k, w8, K, ld, n4);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// per stream: the extended fp8 activations of the current input (shared by the K1 fp8 GEMMs of one graph that read it, like
+// the plain fp8 activations): [ xq T x Kp | sx | batch amax | kept channels k | channel amax K | channel -> slot K | top-k candidates ]
+struct lf_kq8_act {
+    char * ptr = nullptr; size_t size = 0;
+    const void * x_src = nullptr; const void * x_data = nullptr;
+    int T = 0, K = 0, k = 0; uint64_t gen = 0;
+    const uint8_t * fixed_pos = nullptr;   // BigOne 6d: the input's fixed channel -> slot map (nullptr: the one in this buffer)
+    // the channel amax filled by the producer of this input (ggml_cuda_lf_kq8_amax_take), valid until the buffer is reused
+    const void * pre_src = nullptr; const void * pre_data = nullptr;
+    int pre_T = 0, pre_K = 0, pre_k = 0; uint64_t pre_gen = 0;
+};
+std::map<cudaStream_t, lf_kq8_act> g_lf_kq8_acts;   // under lf_blt().mutex
+
+// per stream: the weights converted ahead (FRANK_KQ_BLAS_PRECONV, see lf_kq8_preconv_on), one block per later reader of the input
+// whose activations are in the stream's lf_kq8_act; an entry is valid for its matmul node in the graph of generation gen
+struct lf_kq8_pre_entry { const ggml_tensor * mm; uint64_t gen; size_t off; };
+struct lf_kq8_pre {
+    char * ptr = nullptr; size_t size = 0;
+    std::vector<lf_kq8_pre_entry> e;
+    int hits = 0, used = 0, logged = 0;   // this graph's share hits, and those that took weights converted ahead
+    std::string missed;                   // the first few share hits without (for the log)
+};
+std::map<cudaStream_t, lf_kq8_pre> g_lf_kq8_pre;   // under lf_blt().mutex
+// the graph each device is computing (ggml_cuda_lf_kq_blas_graph_begin), and where its last K1 fp8 KEEP matmul was found
+struct lf_kq8_graph_ref { const ggml_cgraph * g = nullptr; int at = 0; uint64_t gen = 0; };
+std::map<int, lf_kq8_graph_ref> g_lf_kq8_graphs;   // under lf_blt().mutex
+
+// the buffer of one input: [ xq T x Kp | sx | batch amax | kept channels k | channel amax K | channel -> slot K | top-k candidates ]
+struct lf_kq8_act_layout {
+    size_t o_sx, o_g, o_idx, o_cb, o_ps, o_cd, need;
+    int G, seg;
+    lf_kq8_act_layout(const int T, const int K, const int kk) {
+        const int Kp = K + 2 * kk;
+        o_sx  = ((size_t) T * Kp + 255) / 256 * 256;
+        o_g   = o_sx + 64; o_idx = o_g + 64; o_cb = o_idx + ((size_t) kk * 4 + 255) / 256 * 256;
+        G     = std::max(1, std::min(64, 4096 / kk));               // stage-1 blocks: G * k candidates <= 4096
+        seg   = (K + G - 1) / G;
+        o_ps  = o_cb + ((size_t) K * 4 + 255) / 256 * 256;
+        o_cd  = o_ps + ((size_t) K + 255) / 256 * 256;
+        need  = o_cd + (size_t) G * kk * 8;
+    }
+};
+void lf_kq8_act_reserve(lf_kq8_act & ac, const size_t need, cudaStream_t stream) {
+    if (ac.size >= need) return;
+    if (ac.ptr) {
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        CUDA_CHECK(cudaFree(ac.ptr));
+    }
+    CUDA_CHECK(cudaMalloc((void **) &ac.ptr, need));
+    ac.size    = need;
+    ac.x_src   = nullptr;
+    ac.pre_src = nullptr;
+}
+
+// producer -> K1 matmul pairs found by ggml_cuda_lf_kq8_amax_mark, one per stream (under lf_blt().mutex)
+struct lf_kq8_amax_pair { const ggml_tensor * prod = nullptr; const ggml_tensor * mm = nullptr; uint64_t gen = 0; bool only_k1 = false; };
+std::map<cudaStream_t, lf_kq8_amax_pair> g_lf_kq8_amax_marks;
+
+// BigOne 6g (GLU16; see lf-kq-blas.cuh): 0 = off (the default), else GGML_TYPE_F16, the type the marked matmuls write
+static int lf_kq8_glu16_type() {
+    static const int t = [] {
+        const char * e = getenv("FRANK_KQ_BLAS_GLU16");
+        const int r = e != nullptr && (strcmp(e, "f16") == 0 || strcmp(e, "1") == 0) ? (int) GGML_TYPE_F16 : 0;
+        if (r != 0 && lf_kq_mode() != 2) {   // the 16-bit products come from K1 fp8's GEMM only (the readers check the mode too)
+            GGML_LOG_WARN("FRANK_KQ_BLAS_GLU16=%s: no effect, K1 runs %s (6g works on K1 fp8 only)\n", e, lf_kq_mode_name());
+        } else if (r != 0) {
+            GGML_LOG_WARN("FRANK_KQ_BLAS_GLU16=%s: K1 fp8 writes the gate / up products as f16 for the GLU (6g, lossy)\n", e);
+        }
+        return r;
+    }();
+    return t;
+}
+// matmuls marked by ggml_cuda_lf_kq8_glu16_window (consumer: the GLU's node index), and the 16-bit products written, per stream
+// (under lf_blt().mutex)
+struct lf_kq8_glu16_mark { const ggml_tensor * mm; int consumer; uint64_t gen; bool taken; };
+std::map<cudaStream_t, std::vector<lf_kq8_glu16_mark>> g_lf_kq8_glu16_marks;
+struct lf_kq8_glu16_pend { const ggml_tensor * t; int type; uint64_t gen; };
+std::map<cudaStream_t, std::vector<lf_kq8_glu16_pend>> g_lf_kq8_glu16_pend;
+// the caller holds lf_blt().mutex and is about to write dst's product: its 16-bit type if marked (0: write f32)
+static int lf_kq8_glu16_claim(const ggml_tensor * dst, cudaStream_t stream) {
+    if (lf_kq8_glu16_type() == 0 || g_lf_glu16_off.load(std::memory_order_relaxed)) return 0;
+    auto it = g_lf_kq8_glu16_marks.find(stream);
+    if (it == g_lf_kq8_glu16_marks.end()) return 0;
+    hipStreamCaptureStatus cs = hipStreamCaptureStatusNone;   // a new GEMM shape is not made while a graph is being captured
+    if (hipStreamIsCapturing(stream, &cs) != hipSuccess || cs != hipStreamCaptureStatusNone) return 0;
+    const uint64_t gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    for (lf_kq8_glu16_mark & m : it->second) {
+        if (m.mm == dst && m.gen == gen && !m.taken) {
+            m.taken = true;
+            return lf_kq8_glu16_type();
+        }
+    }
+    return 0;
+}
+static void lf_kq8_glu16_written(const ggml_tensor * dst, const int type, cudaStream_t stream) {
+    g_lf_kq8_glu16_pend[stream].push_back({ dst, type, g_lf_fp8_graph_gen.load(std::memory_order_relaxed) });
+}
+
+// The weights straight from their quant blocks to fp8: each 256-value super-block is dequantized into LDS by ggml's own device
+// function (the same half values to_fp16 writes), then converted exactly as lf_kq_f16_to_fp8 / lf_kq8_f16_to_fp8_keep do, so the
+// result is the same bytes without the f16 copy going through memory.  k = 0: no kept channels (pos unused, ld = K).
+#define LF_KQ8_DQ(T, nt) struct lf_kq8_dq_##T { static constexpr int nthr = nt; \
+    static __device__ __forceinline__ void run(const void * vx, const int64_t ib, half * y, const int tid) { dequantize_##T(vx, ib, y, tid); } };
+LF_KQ8_DQ(q2_K, 64)    LF_KQ8_DQ(q3_K, 64)   LF_KQ8_DQ(q4_K, 32)   LF_KQ8_DQ(q5_K, 64)    LF_KQ8_DQ(q6_K, 64)
+LF_KQ8_DQ(iq2_xxs, 32) LF_KQ8_DQ(iq2_xs, 32) LF_KQ8_DQ(iq2_s, 32)  LF_KQ8_DQ(iq3_xxs, 32) LF_KQ8_DQ(iq3_s, 32)
+LF_KQ8_DQ(iq1_s, 32)   LF_KQ8_DQ(iq1_m, 32)  LF_KQ8_DQ(iq4_xs, 32)
+#undef LF_KQ8_DQ
+
+// 8 super-blocks per workgroup (dequantized 256 / NT at a time), then each thread converts 8 consecutive values of one super-block
+// (a super-block never spans rows: K % QK_K == 0), with the row, its scale and the output column taken once per thread and one
+// 8-byte store.
+template <typename DQ>
+__launch_bounds__(256)
+__global__ void lf_kq8_q_to_fp8(const void * __restrict__ vx, const float * __restrict__ scale, const uint8_t * __restrict__ pos,
+        const int k, uint8_t * __restrict__ w8, const int K, const int ld, const int64_t nsb) {
+#if defined(RDNA4)
+    constexpr int NT = DQ::nthr, SB = 256 / NT, NB = 8;   // blockDim = NT x SB; NB super-blocks per workgroup
+    __shared__ __align__(16) half buf[NB][QK_K];
+    const int64_t ib0 = (int64_t) blockIdx.x * NB;
+    for (int s = threadIdx.y; s < NB; s += SB) {
+        if (ib0 + s < nsb) DQ::run(vx, ib0 + s, buf[s], threadIdx.x);
+    }
+    __syncthreads();
+    const int t  = threadIdx.y * NT + threadIdx.x;      // 32 threads per super-block, 8 values each
+    const int sb = t / 32, j = 8 * (t % 32);
+    if (ib0 + sb >= nsb) return;
+    const int spb = K / QK_K;
+    const int64_t ib = ib0 + sb;
+    const int64_t r  = ib / spb;
+    const int     c  = (int) (ib - r * spb) * QK_K + j;
+    const float inv = 1.f / scale[r];
+    const half2 * hp = (const half2 *) &buf[sb][j];
+    float h[8];
+#pragma unroll
+    for (int l = 0; l < 4; ++l) { h[2 * l] = __low2float(hp[l]); h[2 * l + 1] = __high2float(hp[l]); }
+    int w[2];
+#pragma unroll
+    for (int q = 0; q < 2; ++q) {
+        w[q] = __builtin_amdgcn_cvt_pk_fp8_f32(h[4 * q + 0] * inv, h[4 * q + 1] * inv, 0, false);
+        w[q] = __builtin_amdgcn_cvt_pk_fp8_f32(h[4 * q + 2] * inv, h[4 * q + 3] * inv, w[q], true);
+    }
+    uint8_t * out = w8 + r * ld;
+    *(uint2 *) (out + c) = make_uint2((unsigned int) w[0], (unsigned int) w[1]);
+    if (k == 0) return;
+#pragma unroll
+    for (int q = 0; q < 2; ++q) {
+        const unsigned int p = *(const unsigned int *) (pos + c + 4 * q);
+        if (p == 0u) continue;
+        const float res[4] = { fmaf(h[4 * q + 0], inv, -__builtin_amdgcn_cvt_f32_fp8(w[q], 0)),
+                               fmaf(h[4 * q + 1], inv, -__builtin_amdgcn_cvt_f32_fp8(w[q], 1)),
+                               fmaf(h[4 * q + 2], inv, -__builtin_amdgcn_cvt_f32_fp8(w[q], 2)),
+                               fmaf(h[4 * q + 3], inv, -__builtin_amdgcn_cvt_f32_fp8(w[q], 3)) };
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int slot = (int) ((p >> (8 * l)) & 0xffu);
+            if (slot == 0) continue;
+            out[K + slot - 1]     = (uint8_t) ((w[q] >> (8 * l)) & 0xff);
+            out[K + k + slot - 1] = (uint8_t) (__builtin_amdgcn_cvt_pk_fp8_f32(res[l], 0.f, 0, false) & 0xff);
+        }
+    }
+#else
+    GGML_UNUSED_VARS(vx, scale, pos, k, w8, K, ld, nsb);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+typedef void (*lf_kq8_q_to_fp8_t)(const void * vx, const float * scale, const uint8_t * pos, int k, uint8_t * w8, int K, int ld,
+        int64_t nsb, cudaStream_t stream);
+template <typename DQ>
+void lf_kq8_q_to_fp8_cuda(const void * vx, const float * scale, const uint8_t * pos, const int k, uint8_t * w8, const int K, const int ld,
+        const int64_t nsb, cudaStream_t stream) {
+    lf_kq8_q_to_fp8<DQ><<<(unsigned) ((nsb + 7) / 8), dim3(DQ::nthr, 256 / DQ::nthr), 0, stream>>>(vx, scale, pos, k, w8, K, ld, nsb);
+}
+// Direct conversion (no LDS round trip): each thread decodes the 8 consecutive values of one super-block that it writes, from
+// 8-byte loads of the packed quants, with the arithmetic of ggml's dequantize_<type> (float, rounded to half), so the fp8 bytes
+// are those of lf_kq8_q_to_fp8<lf_kq8_dq_<type>> and the f16 values those of to_fp16 (FRANK_KQ_BLAS_CHECK=1 compares both on
+// every conversion).  j: the first of the 8 values (a multiple of 8); h: the 8 values, already rounded to half.
+struct lf_kq_dec_q4_K {
+    static __device__ __forceinline__ void dec(const void * vx, const int64_t ib, const int j, float * h) {
+        const block_q4_K * x = (const block_q4_K *) vx + ib;
+        const int il = j / 64, hi = (j / 32) & 1, l0 = j % 32;
+        uint8_t sc, m;
+        get_scale_min_k4(2 * il + hi, x->scales, sc, m);
+        const float dall = __low2half(x->dm);
+        const float dmin = __high2half(x->dm);
+        const float d1 = dall * sc; const float m1 = dmin * m;
+        const uint2 q2 = *(const uint2 *) (x->qs + 32 * il + l0);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const uint8_t q = (uint8_t) (((i < 4 ? q2.x : q2.y) >> (8 * (i & 3))) & 0xff);
+            h[i] = __half2float(hi ? ggml_cuda_cast<half>(d1 * (q >>  4) - m1) : ggml_cuda_cast<half>(d1 * (q & 0xF) - m1));
+        }
+    }
+};
+struct lf_kq_dec_q5_K {
+    static __device__ __forceinline__ void dec(const void * vx, const int64_t ib, const int j, float * h) {
+        const block_q5_K * x = (const block_q5_K *) vx + ib;
+        const int il = j / 64, hi = (j / 32) & 1, l0 = j % 32, is = 2 * il + hi;
+        uint8_t sc, m;
+        get_scale_min_k4(is, x->scales, sc, m);
+        const float dall = __low2half(x->dm);
+        const float dmin = __high2half(x->dm);
+        const float d1 = dall * sc; const float m1 = dmin * m;
+        const uint2 ql2 = *(const uint2 *) (x->qs + 32 * il + l0);
+        const uint2 qh2 = *(const uint2 *) (x->qh + l0);
+        const uint8_t hm = 1 << is;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const uint8_t ql = (uint8_t) (((i < 4 ? ql2.x : ql2.y) >> (8 * (i & 3))) & 0xff);
+            const uint8_t qh = (uint8_t) (((i < 4 ? qh2.x : qh2.y) >> (8 * (i & 3))) & 0xff);
+            h[i] = __half2float(hi ? ggml_cuda_cast<half>(d1 * ((ql >>  4) + (qh & hm ? 16 : 0)) - m1)
+                                   : ggml_cuda_cast<half>(d1 * ((ql & 0xF) + (qh & hm ? 16 : 0)) - m1));
+        }
+    }
+};
+struct lf_kq_dec_iq4_xs {
+    static __device__ __forceinline__ void dec(const void * vx, const int64_t ibs, const int j, float * h) {
+        const block_iq4_xs * x = (const block_iq4_xs *) vx + ibs;
+        const int ib = j / 32, hi = (j / 16) & 1, l0 = j % 16;
+        const float d = (float) x->d * ((((x->scales_l[ib / 2] >> 4 * (ib % 2)) & 0xf) | (((x->scales_h >> 2 * ib) & 3) << 4)) - 32);
+        const uint2 q2 = *(const uint2 *) (x->qs + 16 * ib + l0);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const uint8_t q = (uint8_t) (((i < 4 ? q2.x : q2.y) >> (8 * (i & 3))) & 0xff);
+            h[i] = __half2float(hi ? ggml_cuda_cast<half>(d * kvalues_iq4nl[q >> 4]) : ggml_cuda_cast<half>(d * kvalues_iq4nl[q & 0xf]));
+        }
+    }
+};
+
+struct lf_kq_dec_q6_K {
+    // the 8 values j..j+7 lie in one of dequantize_q6_K's y[0] / y[32] / y[64] / y[96] lanes (quarter qr of half ip): one scale,
+    // 8 consecutive ql and qh bytes, each value `d * sc * (q - 32)` as there
+    static __device__ __forceinline__ void dec(const void * vx, const int64_t ib, const int j, float * h) {
+        const block_q6_K * x = (const block_q6_K *) vx + ib;
+        const int ip = j / 128, qr = (j / 32) & 3, il = j % 32, is = 8 * ip + il / 16;
+        const float d = x->d;
+        const int8_t sc = x->scales[is + 2 * qr];
+        const uint2 ql2 = *(const uint2 *) (x->ql + 64 * ip + 32 * (qr & 1) + il);
+        const uint2 qh2 = *(const uint2 *) (x->qh + 32 * ip + il);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const uint8_t ql = (uint8_t) (((i < 4 ? ql2.x : ql2.y) >> (8 * (i & 3))) & 0xff);
+            const uint8_t qh = (uint8_t) (((i < 4 ? qh2.x : qh2.y) >> (8 * (i & 3))) & 0xff);
+            const int q = (qr < 2 ? (ql & 0xF) : (ql >> 4)) | (((qh >> (2 * qr)) & 3) << 4);
+            h[i] = __half2float(ggml_cuda_cast<half>(d * sc * ((int8_t) q - 32)));
+        }
+    }
+};
+
+// Q8_0 and IQ4_NL (BigOne 6, from the 10-29 k1fuse prototype, f4b60dd07): until now the two-step path (to_fp16, then
+// lf_kq8_f16_to_fp8_keep) on every batch.  The values of ggml's dequantize_block_q8_0_f16 (the int8 code times the half d,
+// exact in float, rounded once to half) and dequantize_block_iq4_nl (d * kvalues_iq4nl, rounded to half).
+struct lf_kq_dec_q8_0 {
+    static __device__ __forceinline__ void dec(const void * vx, const int64_t ib, const int j, float * h) {
+        const block_q8_0 * x = (const block_q8_0 *) vx + ib * (QK_K / QK8_0) + j / QK8_0;
+        const float d = __half2float(x->d);
+        const uint16_t * q2 = (const uint16_t *) (x->qs + j % QK8_0);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const uint16_t v = q2[i];
+            h[2 * i]     = __half2float(ggml_cuda_cast<half>((float) (int8_t) (v & 0xff) * d));
+            h[2 * i + 1] = __half2float(ggml_cuda_cast<half>((float) (int8_t) (v >> 8) * d));
+        }
+    }
+};
+struct lf_kq_dec_iq4_nl {
+    static __device__ __forceinline__ void dec(const void * vx, const int64_t ib, const int j, float * h) {
+        const block_iq4_nl * x = (const block_iq4_nl *) vx + ib * (QK_K / QK4_NL) + j / QK4_NL;
+        const int hi = (j / 16) & 1, l0 = j % 16;
+        const float d = (float) x->d;
+        const uint16_t * q2 = (const uint16_t *) (x->qs + l0);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const uint16_t v = q2[i];
+            const uint8_t a = (uint8_t) (v & 0xff), b = (uint8_t) (v >> 8);
+            h[2 * i]     = __half2float(hi ? ggml_cuda_cast<half>(d * kvalues_iq4nl[a >> 4]) : ggml_cuda_cast<half>(d * kvalues_iq4nl[a & 0xf]));
+            h[2 * i + 1] = __half2float(hi ? ggml_cuda_cast<half>(d * kvalues_iq4nl[b >> 4]) : ggml_cuda_cast<half>(d * kvalues_iq4nl[b & 0xf]));
+        }
+    }
+};
+
+template <typename DEC>
+__launch_bounds__(256)
+__global__ void lf_kq8_direct_to_fp8(const void * __restrict__ vx, const float * __restrict__ scale, const uint8_t * __restrict__ pos,
+        const int k, uint8_t * __restrict__ w8, const int K, const int ld, const int64_t nsb) {
+#if defined(RDNA4)
+    // 16 threads per super-block, 16 values (two decodes of 8) each and one 16-byte store: about the speed of a device copy of
+    // the same bytes (8 values and an 8-byte store per thread reached 86-92% of it; tools/k1conv-bench)
+    const int64_t t  = (int64_t) blockIdx.x * 256 + threadIdx.x;
+    const int64_t ib = t / 16;
+    if (ib >= nsb) return;
+    const int j0 = 16 * (int) (t % 16);
+    float h[2][8];
+    DEC::dec(vx, ib, j0,     h[0]);
+    DEC::dec(vx, ib, j0 + 8, h[1]);
+    const int spb = K / QK_K;
+    const int64_t r = ib / spb;
+    const int     c0 = (int) (ib - r * spb) * QK_K + j0;
+    const float inv = 1.f / scale[r];
+    int w[2][2];
+#pragma unroll
+    for (int v = 0; v < 2; ++v) {
+#pragma unroll
+        for (int q = 0; q < 2; ++q) {
+            w[v][q] = __builtin_amdgcn_cvt_pk_fp8_f32(h[v][4 * q + 0] * inv, h[v][4 * q + 1] * inv, 0, false);
+            w[v][q] = __builtin_amdgcn_cvt_pk_fp8_f32(h[v][4 * q + 2] * inv, h[v][4 * q + 3] * inv, w[v][q], true);
+        }
+    }
+    uint8_t * out = w8 + r * ld;
+    *(uint4 *) (out + c0) = make_uint4((unsigned int) w[0][0], (unsigned int) w[0][1], (unsigned int) w[1][0], (unsigned int) w[1][1]);
+    if (k == 0) return;
+#pragma unroll
+    for (int v = 0; v < 2; ++v) {
+        const int c = c0 + 8 * v;
+#pragma unroll
+        for (int q = 0; q < 2; ++q) {
+            const unsigned int p = *(const unsigned int *) (pos + c + 4 * q);
+            if (p == 0u) continue;
+            const float res[4] = { fmaf(h[v][4 * q + 0], inv, -__builtin_amdgcn_cvt_f32_fp8(w[v][q], 0)),
+                                   fmaf(h[v][4 * q + 1], inv, -__builtin_amdgcn_cvt_f32_fp8(w[v][q], 1)),
+                                   fmaf(h[v][4 * q + 2], inv, -__builtin_amdgcn_cvt_f32_fp8(w[v][q], 2)),
+                                   fmaf(h[v][4 * q + 3], inv, -__builtin_amdgcn_cvt_f32_fp8(w[v][q], 3)) };
+#pragma unroll
+            for (int l = 0; l < 4; ++l) {
+                const int slot = (int) ((p >> (8 * l)) & 0xffu);
+                if (slot == 0) continue;
+                out[K + slot - 1]     = (uint8_t) ((w[v][q] >> (8 * l)) & 0xff);
+                out[K + k + slot - 1] = (uint8_t) (__builtin_amdgcn_cvt_pk_fp8_f32(res[l], 0.f, 0, false) & 0xff);
+            }
+        }
+    }
+#else
+    GGML_UNUSED_VARS(vx, scale, pos, k, w8, K, ld, nsb);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// the same values as f16 (K1's f16 mode), in to_fp16's layout: one 16-byte store per thread
+template <typename DEC>
+__launch_bounds__(256)
+__global__ void lf_kq_direct_to_f16(const void * __restrict__ vx, half * __restrict__ y, const int64_t nsb) {
+    const int64_t t  = (int64_t) blockIdx.x * 256 + threadIdx.x;
+    const int64_t ib = t / 32;
+    if (ib >= nsb) return;
+    const int j = 8 * (int) (t % 32);
+    float h[8];
+    DEC::dec(vx, ib, j, h);
+    half2 o[4];
+#pragma unroll
+    for (int l = 0; l < 4; ++l) o[l] = __halves2half2(__float2half(h[2 * l]), __float2half(h[2 * l + 1]));
+    *(uint4 *) (y + ib * QK_K + j) = *(const uint4 *) o;
+}
+
+static __global__ void lf_kq8_count_diff(const uint8_t * __restrict__ a, const uint8_t * __restrict__ b, const int64_t n, unsigned int * cnt) {
+    const int64_t i = (int64_t) blockIdx.x * 256 + threadIdx.x;
+    if (i < n && a[i] != b[i]) atomicAdd(cnt, 1u);
+}
+
+// FRANK_KQ_BLAS_DIRECT=0: the LDS kernels and to_fp16 as before (A/B in one build)
+static bool lf_kq8_direct() {
+    static const bool on = !getenv("FRANK_KQ_BLAS_DIRECT") || atoi(getenv("FRANK_KQ_BLAS_DIRECT")) != 0;
+    return on;
+}
+// FRANK_KQ_BLAS_DIRECT_B32=0: the 32-element block types (Q8_0, IQ4_NL) on the two-step path as before (BigOne 6 A/B)
+static bool lf_kq8_direct_b32() {
+    static const bool on = lf_kq8_direct() && (!getenv("FRANK_KQ_BLAS_DIRECT_B32") || atoi(getenv("FRANK_KQ_BLAS_DIRECT_B32")) != 0);
+    return on;
+}
+static bool lf_kq8_conv_check() {
+    static const bool on = getenv("FRANK_KQ_BLAS_CHECK") && atoi(getenv("FRANK_KQ_BLAS_CHECK")) != 0;
+    return on;
+}
+// diagnostics: run the direct and the reference conversion into zeroed scratch and count the differing bytes (synchronizes)
+static void lf_kq8_check_report(const char * what, const ggml_type type, const int64_t n, const std::function<void(uint8_t *)> & direct,
+        const std::function<void(uint8_t *)> & ref, cudaStream_t stream) {
+    static std::map<std::string, std::pair<uint64_t, uint64_t>> stats;
+    uint8_t * a; uint8_t * b; unsigned int * cnt;
+    CUDA_CHECK(cudaMalloc((void **) &a, n)); CUDA_CHECK(cudaMalloc((void **) &b, n)); CUDA_CHECK(cudaMalloc((void **) &cnt, 4));
+    CUDA_CHECK(cudaMemsetAsync(a, 0, n, stream)); CUDA_CHECK(cudaMemsetAsync(b, 0, n, stream)); CUDA_CHECK(cudaMemsetAsync(cnt, 0, 4, stream));
+    direct(a); ref(b);
+    lf_kq8_count_diff<<<(unsigned) ((n + 255) / 256), 256, 0, stream>>>(a, b, n, cnt);
+    unsigned int h = 0;
+    CUDA_CHECK(cudaMemcpyAsync(&h, cnt, 4, cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaFree(a)); CUDA_CHECK(cudaFree(b)); CUDA_CHECK(cudaFree(cnt));
+    auto & st = stats[std::string(what) + " " + ggml_type_name(type)];
+    ++st.first; st.second += h != 0;
+    if (h != 0 || (st.first & (st.first - 1)) == 0) {
+        fprintf(stderr, "FRANK_KQ_BLAS_CHECK %s %s: call %llu (%lld bytes): %u bytes differ; calls with a difference so far %llu\n", what,
+                ggml_type_name(type), (unsigned long long) st.first, (long long) n, h, (unsigned long long) st.second);
+    }
+}
+
+template <typename DEC, typename DQ, ggml_type TYPE>
+void lf_kq8_direct_to_fp8_cuda(const void * vx, const float * scale, const uint8_t * pos, const int k, uint8_t * w8, const int K, const int ld,
+        const int64_t nsb, cudaStream_t stream) {
+    auto direct = [&](uint8_t * o) { lf_kq8_direct_to_fp8<DEC><<<(unsigned) ((nsb * 16 + 255) / 256), 256, 0, stream>>>(vx, scale, pos, k, o, K, ld, nsb); };
+    direct(w8);
+    if (!lf_kq8_conv_check()) return;
+    auto ref = [&](uint8_t * o) { lf_kq8_q_to_fp8<DQ><<<(unsigned) ((nsb + 7) / 8), dim3(DQ::nthr, 256 / DQ::nthr), 0, stream>>>(vx, scale, pos, k, o, K, ld, nsb); };
+    lf_kq8_check_report("fp8", TYPE, nsb / (K / QK_K) * ld, direct, ref, stream);
+}
+
+// types without an LDS one-step kernel (Q8_0, IQ4_NL): checked against the two-step path (to_fp16, then lf_kq8_f16_to_fp8_keep)
+template <typename DEC, ggml_type TYPE>
+void lf_kq8_direct2_to_fp8_cuda(const void * vx, const float * scale, const uint8_t * pos, const int k, uint8_t * w8, const int K, const int ld,
+        const int64_t nsb, cudaStream_t stream) {
+    auto direct = [&](uint8_t * o) { lf_kq8_direct_to_fp8<DEC><<<(unsigned) ((nsb * 16 + 255) / 256), 256, 0, stream>>>(vx, scale, pos, k, o, K, ld, nsb); };
+    direct(w8);
+    if (!lf_kq8_conv_check()) return;
+    const int64_t n = nsb * QK_K;
+    auto ref = [&](uint8_t * o) {
+        half * w16;
+        CUDA_CHECK(cudaMalloc((void **) &w16, n * sizeof(half)));
+        ggml_get_to_fp16_cuda(TYPE)(vx, w16, n, stream);
+        lf_kq8_f16_to_fp8_keep<<<(unsigned) ((n / 4 + 255) / 256), 256, 0, stream>>>(w16, scale, pos, k, o, K, ld, n / 4);
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        CUDA_CHECK(cudaFree(w16));
+    };
+    lf_kq8_check_report("fp8", TYPE, nsb / (K / QK_K) * ld, direct, ref, stream);
+}
+
+template <typename DEC, ggml_type TYPE>
+void lf_kq_direct_to_f16_cuda(const void * vx, half * y, const int64_t k, cudaStream_t stream) {
+    if (k % QK_K != 0) { // a Q8_0 / IQ4_NL chunk of rows that is not whole super-blocks (K is only a multiple of 64 here)
+        ggml_get_to_fp16_cuda(TYPE)(vx, y, k, stream);
+        return;
+    }
+    const int64_t nsb = k / QK_K;
+    auto direct = [&](uint8_t * o) { lf_kq_direct_to_f16<DEC><<<(unsigned) ((nsb * 32 + 255) / 256), 256, 0, stream>>>(vx, (half *) o, nsb); };
+    direct((uint8_t *) y);
+    if (!lf_kq8_conv_check()) return;
+    auto ref = [&](uint8_t * o) { ggml_get_to_fp16_cuda(TYPE)(vx, (half *) o, k, stream); };
+    lf_kq8_check_report("f16", TYPE, k * 2, direct, ref, stream);
+}
+
+// f16 conversion for K1's f16 mode: the direct kernels where there is one, else ggml's to_fp16
+static to_fp16_cuda_t lf_kq_to_fp16_for(const ggml_type type) {
+    if (lf_kq8_direct()) {
+        switch (type) {
+            case GGML_TYPE_Q4_K:   return lf_kq_direct_to_f16_cuda<lf_kq_dec_q4_K, GGML_TYPE_Q4_K>;
+            case GGML_TYPE_Q5_K:   return lf_kq_direct_to_f16_cuda<lf_kq_dec_q5_K, GGML_TYPE_Q5_K>;
+            case GGML_TYPE_IQ4_XS: return lf_kq_direct_to_f16_cuda<lf_kq_dec_iq4_xs, GGML_TYPE_IQ4_XS>;
+            case GGML_TYPE_Q6_K:   return lf_kq_direct_to_f16_cuda<lf_kq_dec_q6_K, GGML_TYPE_Q6_K>;
+            case GGML_TYPE_Q8_0:   if (lf_kq8_direct_b32()) return lf_kq_direct_to_f16_cuda<lf_kq_dec_q8_0, GGML_TYPE_Q8_0>; break;
+            case GGML_TYPE_IQ4_NL: if (lf_kq8_direct_b32()) return lf_kq_direct_to_f16_cuda<lf_kq_dec_iq4_nl, GGML_TYPE_IQ4_NL>; break;
+            default: break;
+        }
+    }
+    return ggml_get_to_fp16_cuda(type);
+}
+
+// the one-step conversion of a weight type (super-block types only, rows of whole super-blocks), nullptr: the two-step path
+lf_kq8_q_to_fp8_t lf_kq8_q_to_fp8_for(const ggml_type type, const int K) {
+    if (K % QK_K != 0) return nullptr;
+    switch (type) {
+        case GGML_TYPE_Q2_K:    return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_q2_K>;
+        case GGML_TYPE_Q3_K:    return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_q3_K>;
+        case GGML_TYPE_Q4_K:    return lf_kq8_direct() ? lf_kq8_direct_to_fp8_cuda<lf_kq_dec_q4_K, lf_kq8_dq_q4_K, GGML_TYPE_Q4_K> : lf_kq8_q_to_fp8_cuda<lf_kq8_dq_q4_K>;
+        case GGML_TYPE_Q5_K:    return lf_kq8_direct() ? lf_kq8_direct_to_fp8_cuda<lf_kq_dec_q5_K, lf_kq8_dq_q5_K, GGML_TYPE_Q5_K> : lf_kq8_q_to_fp8_cuda<lf_kq8_dq_q5_K>;
+        case GGML_TYPE_Q6_K:    return lf_kq8_direct() ? lf_kq8_direct_to_fp8_cuda<lf_kq_dec_q6_K, lf_kq8_dq_q6_K, GGML_TYPE_Q6_K> : lf_kq8_q_to_fp8_cuda<lf_kq8_dq_q6_K>;
+        case GGML_TYPE_IQ2_XXS: return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq2_xxs>;
+        case GGML_TYPE_IQ2_XS:  return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq2_xs>;
+        case GGML_TYPE_IQ2_S:   return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq2_s>;
+        case GGML_TYPE_IQ3_XXS: return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq3_xxs>;
+        case GGML_TYPE_IQ3_S:   return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq3_s>;
+        case GGML_TYPE_IQ1_S:   return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq1_s>;
+        case GGML_TYPE_IQ1_M:   return lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq1_m>;
+        case GGML_TYPE_IQ4_XS:  return lf_kq8_direct() ? lf_kq8_direct_to_fp8_cuda<lf_kq_dec_iq4_xs, lf_kq8_dq_iq4_xs, GGML_TYPE_IQ4_XS> : lf_kq8_q_to_fp8_cuda<lf_kq8_dq_iq4_xs>;
+        case GGML_TYPE_Q8_0:    return lf_kq8_direct_b32() ? lf_kq8_direct2_to_fp8_cuda<lf_kq_dec_q8_0, GGML_TYPE_Q8_0> : nullptr;
+        case GGML_TYPE_IQ4_NL:  return lf_kq8_direct_b32() ? lf_kq8_direct2_to_fp8_cuda<lf_kq_dec_iq4_nl, GGML_TYPE_IQ4_NL> : nullptr;
+        default:                return nullptr;
+    }
+}
