+template <int TT>
+static __global__ void __launch_bounds__(256) gdn_conv_norm_wave_kernel(const float * __restrict__ state, const float * __restrict__ x,
+        const float * __restrict__ w, float * __restrict__ y, const int C, const int T, const gdn_conv_snap_args snap,
+        const int nqk, const int ncols, const float eps, const float scale_out, const int head16) {
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int grp  = blockIdx.x * (256 / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+    unsigned short * __restrict__ y16 = (unsigned short *) y;   // rows < head16: bf16, 2C values a row
+    if (grp * 128 >= C) return;   // a whole wave
+    const int  t0 = blockIdx.y * TT;
+    const int  cb = grp * 128 + lane;
+    const bool qk = grp * 128 < nqk;   // wave-uniform
+    float sr[4][3];
+#pragma unroll
+    for (int g = 0; g < 4; ++g) {
+#pragma unroll
+        for (int j = 0; j < 3; ++j) sr[g][j] = t0 < 3 ? state[(cb + 32*g) * 3 + j] : 0.0f;
+    }
+    if (blockIdx.y == 0) {
+        for (int s = 0; s < snap.n; ++s) {
+#pragma unroll
+            for (int g = 0; g < 4; ++g) {
+                const int c = cb + 32*g;
+#pragma unroll
+                for (int j = 0; j < 3; ++j) {
+                    const int jp = snap.col[s] + j;
+                    snap.dst[s][c * 3 + j] = (jp < 3) ? sr[g][jp] : x[(size_t) (jp - 3) * C + c];
+                }
+            }
+        }
+    }
+    float wr[4][4], xw[4][4];
+#pragma unroll
+    for (int g = 0; g < 4; ++g) {
+        const int c = cb + 32*g;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) wr[g][j] = w[c * 4 + j];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) { const int jp = t0 + k; xw[g][k] = (jp < 3) ? sr[g][jp] : x[(size_t) (jp - 3) * C + c]; }
+    }
+    const float b = 0.0f;
+    const int tend = min(T, t0 + TT);
+    for (int t = t0; t < tend; ++t) {
+        float yv[4];
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            float sumf = 0.0f;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) sumf += xw[g][j] * wr[g][j];
+            sumf += b;
+            yv[g] = ggml_cuda_op_silu_single(sumf);
+        }
+        if (qk) {
+#pragma clang fp contract(off)
+            float s[8];
+#pragma unroll
+            for (int g = 0; g < 8; ++g) {
+                float tmp = 0.0f;
+                if (g < 4) {
+                    tmp += yv[g] * yv[g];
+                    tmp = warp_reduce_sum(tmp);
+                }
+                s[g] = tmp;
+            }
+            const float sum   = ((s[0] + s[4]) + (s[2] + s[6])) + ((s[1] + s[5]) + (s[3] + s[7]));
+            const float mean  = sum / ncols;
+            const float scale = rsqrtf(mean + eps);
+            if (t < head16) {
+#pragma unroll
+                for (int g = 0; g < 4; ++g) y16[(size_t) t * 2 * C + cb + 32*g] = gdn_conv_f2bf(scale_out * (scale * yv[g]));
+            } else {
+#pragma unroll
+                for (int g = 0; g < 4; ++g) y[(size_t) t * C + cb + 32*g] = scale_out * (scale * yv[g]);
+            }
+        } else if (t < head16) {
+#pragma unroll
+            for (int g = 0; g < 4; ++g) y16[(size_t) t * 2 * C + cb + 32*g] = gdn_conv_f2bf(yv[g]);
+        } else {
+#pragma unroll
+            for (int g = 0; g < 4; ++g) y[(size_t) t * C + cb + 32*g] = yv[g];
+        }
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            const int c = cb + 32*g;
+            xw[g][0] = xw[g][1]; xw[g][1] = xw[g][2]; xw[g][2] = xw[g][3];
+            const int jp = t + 4; xw[g][3] = (jp < 3) ? sr[g][jp] : ((jp - 3) < T ? x[(size_t) (jp - 3) * C + c] : 0.0f);
+        }
+    }
+}
