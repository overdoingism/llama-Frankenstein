+++ b/ggml/src/ggml-cuda/gdn-chunked-wmma.cuh
@@ -0,0 +1,23 @@
+#pragma once
+#include "common.cuh"
+
+// Chunked prefill for GGML_OP_GATED_DELTA_NET with a scalar gate and S_k == S_v == 128 on RDNA4 (bf16 WMMA operands,
+// f32 accumulation, f32 state across chunks).  The algorithm and the sources are described in gdn-chunked-wmma.cu.
+//
+// On by default where it applies (gated_delta_net.cu takes it in place of the RDNA4 bf16 chunked kernel); FRANK_GDN_OWN=0
+// (or FRANK_ALL=0): off, the RDNA4 bf16 chunked kernel instead and the prefill conv writes f32 rows for it.  Read once.
+bool ggml_cuda_gdn_own_on();
+
+// BigOne 6e: q / k / v as bf16 instead of the srcs' fp32 (the prefill conv's rows, already rounded as this kernel rounds
+// them: the same results); strides in elements
+struct ggml_cuda_gdn_bf16_in {
+    const unsigned short * q = nullptr, * k = nullptr, * v = nullptr;
+    int64_t sq1 = 0, sq2 = 0, sq3 = 0, sv1 = 0, sv2 = 0, sv3 = 0;
+};
+//
+// Same contract as the chunked GDN ops of gated_delta_net_chunked.cuh: n_tokens_limit > 0 processes only the first
+// n_tokens_limit tokens (one sequence only); the final state goes to state_d_ext when it is set, else to the state slot 0
+// of dst (after the attention scores of all n_tokens); in16 != nullptr: q / k / v are the prefill conv's bf16 rows.
+// Returns false when a launch was rejected (the caller then recomputes with the sequential kernel).
+bool ggml_cuda_op_gdn_chunked_wmma(ggml_backend_cuda_context & ctx, ggml_tensor * dst, float * state_d_ext,
+                                   int64_t n_tokens_limit, const ggml_cuda_gdn_bf16_in * in16 = nullptr);
