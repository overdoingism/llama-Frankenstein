+bool ggml_cuda_lf_fp8_gemm_ready(const int M, const int T, const int K) {
+#if defined(FRANK_HIPBLASLT)
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    return st.handle && st.shapes.count({M, T, K});
+#else
+    GGML_UNUSED_VARS(M, T, K);
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+void ggml_cuda_lf_fp8_gemm(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const float * av, const uint8_t * w8, float * y,
+        const int M, const int T, const int K, const float * c) {
+#if defined(FRANK_HIPBLASLT)
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (!st.handle) LF_BLT_CHECK(hipblasLtCreate(&st.handle));
+    lf_blt_gemm(ctx, st, src1, av, w8, (const float *) src1->data, y, M, T, K, c);
+#else
+    GGML_UNUSED_VARS(ctx, src1, av, w8, y, M, T, K, c);
+    GGML_ABORT("the fp8 GEMM needs hipBLASLt");
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+bool ggml_cuda_lf_kq_fp8_ready(const ggml_tensor * src0, const int device, const int M, const int T, const int K) {
+#if defined(FRANK_HIPBLASLT)
+    if (lf_kq8_scale_lookup(src0, device) == nullptr) return false;
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    return st.handle && st.shapes.count({M, T, K + 2 * lf_kq_fp8_keep_for(K)});
+#else
+    GGML_UNUSED_VARS(src0, device, M, T, K);
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+static void ggml_cuda_lf_kq_fp8_keep_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        ggml_tensor * dst, const int kk, float * y, const float * c);
+
+// y: where the product goes (dst->data, or the output of the ADD folded in, which then also passes c)
+static void ggml_cuda_lf_kq_fp8_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst,
+        float * y, const float * c) {
+#if defined(FRANK_HIPBLASLT)
+    if (const int kk = lf_kq_fp8_keep_for((int) src0->ne[0])) {
+        ggml_cuda_lf_kq_fp8_keep_mul_mat(ctx, src0, src1, dst, kk, y, c);
+        return;
+    }
+    cudaStream_t stream = ctx.stream();
+    const int K = (int) src0->ne[0], M = (int) src0->ne[1];
+    const int T = (int) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    const to_fp16_cuda_t to_fp16 = ggml_get_to_fp16_cuda(src0->type);
+    GGML_ASSERT(to_fp16 != nullptr && K % 4 == 0);
+    float * scale = lf_kq8_scale_lookup(src0, ctx.device);
+    const bool first = scale == nullptr;
+    if (first) CUDA_CHECK(cudaMalloc((void **) &scale, (size_t) M * sizeof(float)));
+    // dequantize in row chunks of <= 64 MiB of f16 (whole quant blocks: a row is a multiple of the block size)
+    ggml_cuda_pool_alloc<uint8_t> w8(ctx.pool(), (size_t) M * K);
+    // two steps (the first use, which also takes the row scales, and types without a one-step kernel): dequantize to f16 in
+    // row chunks, then f16 -> fp8
+    auto two_step = [&](uint8_t * dst) {
+        const int rows = (int) std::min<int64_t>(M, std::max<int64_t>(16, LF_KQ8_CHUNK_BYTES / (2ll * K)));
+        ggml_cuda_pool_alloc<half> w16(ctx.pool(), (size_t) rows * K);
+        for (int r0 = 0; r0 < M; r0 += rows) {
+            const int mc = std::min(rows, M - r0);
+            to_fp16((const char *) src0->data + (size_t) r0 * src0->nb[1], w16.get(), (int64_t) mc * K, stream);
+            if (first) lf_kq_row_scale<<<mc, 256, 0, stream>>>(w16.get(), K, scale + r0);
+            const int64_t n4 = (int64_t) mc * K / 4;
+            lf_kq_f16_to_fp8<<<(unsigned) ((n4 + 255) / 256), 256, 0, stream>>>(w16.get(), scale + r0, dst + (size_t) r0 * K, K, n4);
+        }
+    };
+    const lf_kq8_q_to_fp8_t one_step = first ? nullptr : lf_kq8_q_to_fp8_for(src0->type, K);
+    if (one_step) {
+        one_step(src0->data, scale, nullptr, 0, w8.get(), K, K, (int64_t) M * K / QK_K, stream);
+    } else {
+        two_step(w8.get());
+    }
+    if (first) {
+        lf_kq_fp8_cache & c = lf_kq8();
+        std::lock_guard<std::mutex> lock(c.mutex);
+        c.scale[{src0->data, src0->ne[0], src0->ne[1], ctx.device}] = scale;
+    }
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (!st.handle) LF_BLT_CHECK(hipblasLtCreate(&st.handle));
+    const int otype = c == nullptr && y == (float *) dst->data ? lf_kq8_glu16_claim(dst, stream) : 0;   // BigOne GLU16
+    if (lf_blt_gemm(ctx, st, src1, scale, w8.get(), (const float *) src1->data, y, M, T, K, c, otype) != 0) {
+        lf_kq8_glu16_written(dst, otype, stream);
+    }
+    CUDA_CHECK(cudaGetLastError());
+#else
+    GGML_UNUSED_VARS(ctx, src0, src1, dst, y, c);
+    GGML_ABORT("FRANK_KQ_BLAS=fp8 needs hipBLASLt");
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+#if defined(FRANK_HIPBLASLT)
+// FRANK_KQ_BLAS_PRECONV: improves reliability on Windows.
+// The matmuls of one graph that read the same input share its fp8 activations (FRANK_KQ_BLAS_SHARE); the later ones (share
+// hits) would convert their weights right after the previous matmul's GEMM.  With this on, the first matmul of the input, once
+// its activations are done, also converts the weights of the later readers (into a buffer of the stream), then its own, then
+// runs its GEMM; each later reader runs its GEMM on the weights converted ahead.  The same kernels with the same arguments in
+// another order: bit-identical.
+// Costs the buffer (the later readers' fp8 weights together: about 90 MiB for a 27B model's FFN up).
+// Unset or auto (the default) = on in a Windows build, off elsewhere; 1 = on; 0 = off.
+static bool lf_kq8_preconv_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_KQ_BLAS_PRECONV");
+#if defined(_WIN32)
+        const bool def = true;
+#else
+        const bool def = false;
+#endif
+        const bool v = (!e || strcmp(e, "auto") == 0) ? def : atoi(e) != 0;
+        GGML_LOG_INFO("FRANK_KQ_BLAS_PRECONV=%s: %s\n", e ? e : "auto",
+                      v ? "the weights of a share hit are converted with the first reader's" : "off");
+        return v;
+    }();
+    return on;
+}
+
+// the KEEP weight conversion of src0 into w8 (row stride K + 2 kk): one step from the quantized blocks, or (the first use, which
+// also takes the row scales, and types without a one-step kernel) dequantize to f16 in row chunks, then f16 -> fp8
+static void lf_kq8_keep_convert(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, float * scale, const bool first,
+        const uint8_t * posw, const int kk, uint8_t * w8, cudaStream_t stream) {
+    const int K = (int) src0->ne[0], M = (int) src0->ne[1], Kp = K + 2 * kk;
+    const lf_kq8_q_to_fp8_t one_step = first ? nullptr : lf_kq8_q_to_fp8_for(src0->type, K);
+    if (one_step) {
+        one_step(src0->data, scale, posw, kk, w8, K, Kp, (int64_t) M * K / QK_K, stream);
+        return;
+    }
+    const to_fp16_cuda_t to_fp16 = ggml_get_to_fp16_cuda(src0->type);   // as in ggml_cuda_lf_kq_fp8_mul_mat
+    const int rows = (int) std::min<int64_t>(M, std::max<int64_t>(16, LF_KQ8_CHUNK_BYTES / (2ll * K)));
+    ggml_cuda_pool_alloc<half> w16(ctx.pool(), (size_t) rows * K);
+    for (int r0 = 0; r0 < M; r0 += rows) {
+        const int mc = std::min(rows, M - r0);
+        to_fp16((const char *) src0->data + (size_t) r0 * src0->nb[1], w16.get(), (int64_t) mc * K, stream);
+        if (first) lf_kq_row_scale<<<mc, 256, 0, stream>>>(w16.get(), K, scale + r0);
+        const int64_t n4 = (int64_t) mc * K / 4;
+        lf_kq8_f16_to_fp8_keep<<<(unsigned) ((n4 + 255) / 256), 256, 0, stream>>>(w16.get(), scale + r0, posw, kk,
+                                                                               w8 + (size_t) r0 * Kp, K, Kp, n4);
+    }
+}
+
+// the later readers of mm's input that will find its activations ready (mm has just quantized them): the K1 fp8 KEEP matmuls
+// after it reading the same input, up to the first K1 matmul of another input (it takes the stream's activation buffer; the
+// backend may have moved a reader well down the graph); only those whose weights have their row scales already (a first use
+// converts in two steps and takes them itself).  Under lf_blt().mutex.
+struct lf_kq8_later { const ggml_tensor * mm; float * scale; };
+static std::vector<lf_kq8_later> lf_kq8_later_readers(const int device, const ggml_tensor * mm, const ggml_tensor * x_src,
+        const int T, const int K, const int kk, const uint64_t gen) {
+    std::vector<lf_kq8_later> r;
+    auto gi = g_lf_kq8_graphs.find(device);
+    if (gi == g_lf_kq8_graphs.end() || gi->second.g == nullptr || gi->second.gen != gen) return r;
+    lf_kq8_graph_ref & gr = gi->second;
+    const int n = gr.g->n_nodes;
+    int i = -1;
+    for (int k = 0; k < n && i < 0; ++k) {   // the matmuls come in graph order: start where the last one was
+        const int j = (gr.at + k) % n;
+        if (gr.g->nodes[j] == mm) i = j;
+    }
+    if (i < 0) return r;
+    gr.at = i;
+    auto root = [](const ggml_tensor * t) { while (t->view_src != nullptr) t = t->view_src; return t; };
+    for (int j = i + 1; j < n; ++j) {
+        const ggml_tensor * t = gr.g->nodes[j];
+        if (t->op != GGML_OP_MUL_MAT || !ggml_cuda_lf_kq_blas_will_take(t)) continue;
+        const ggml_tensor * s0 = t->src[0], * s1 = t->src[1];
+        const int Tj = (int) (s1->ne[1] * s1->ne[2] * s1->ne[3]);
+        if (root(s1) != x_src || s1->data != mm->src[1]->data || Tj != T || s0->ne[0] != K || lf_kq_fp8_keep_for(K) != kk) break;
+        // ggml_cuda_lf_kq_blas_supported's conditions for the fp8 path
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(s0) || !ggml_is_contiguous(s1) || !ggml_is_contiguous(t) ||
+            s1->ne[0] != K || t->ne[0] != s0->ne[1] || ggml_nrows(t) != T || ggml_get_to_fp16_cuda(s0->type) == nullptr) {
+            continue;
+        }
+        float * scale = lf_kq8_scale_lookup(s0, device);
+        if (scale != nullptr) r.push_back({ t, scale });
+    }
+    return r;
+}
+#endif // defined(FRANK_HIPBLASLT)
+
+// K1 fp8 v3: the plain fp8 GEMM with the outlier channels' second fp8 term appended to K (see lf_kq_fp8_keep)
+static void ggml_cuda_lf_kq_fp8_keep_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        ggml_tensor * dst, const int kk, float * y, const float * c) {
+#if defined(FRANK_HIPBLASLT)
+    cudaStream_t stream = ctx.stream();
+    const int K = (int) src0->ne[0], M = (int) src0->ne[1], Kp = K + 2 * kk;
+    const int T = (int) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    const float * x = (const float *) src1->data;
+    const to_fp16_cuda_t to_fp16 = ggml_get_to_fp16_cuda(src0->type);
+    GGML_ASSERT(to_fp16 != nullptr && K % 4 == 0);
+
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (!st.handle) LF_BLT_CHECK(hipblasLtCreate(&st.handle));
+
+    // activations: once per input and graph
+    lf_kq8_act & ac = g_lf_kq8_acts[stream];
+    const lf_kq8_act_layout L(T, K, kk);
+    const int G = L.G, seg = L.seg;
+    lf_kq8_act_reserve(ac, L.need, stream);
+    uint8_t      * xq  = (uint8_t *) ac.ptr;
+    float        * sx  = (float *) (ac.ptr + L.o_sx);
+    unsigned int * gb  = (unsigned int *) (ac.ptr + L.o_g);
+    int          * idx = (int *) (ac.ptr + L.o_idx);
+    unsigned int * cb  = (unsigned int *) (ac.ptr + L.o_cb);
+    uint8_t      * pos = (uint8_t *) (ac.ptr + L.o_ps);
+    unsigned long long * cand = (unsigned long long *) (ac.ptr + L.o_cd);
+    static const bool share = !getenv("FRANK_KQ_BLAS_SHARE") || atoi(getenv("FRANK_KQ_BLAS_SHARE")) != 0;
+    const ggml_tensor * x_src = src1;
+    while (x_src->view_src != nullptr) x_src = x_src->view_src;
+    const uint64_t gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    const bool miss = !share || ac.x_src != x_src || ac.x_data != x || ac.T != T || ac.K != K || ac.k != kk || ac.gen != gen;
+    if (miss) {
+        if (lf_kq8_fixed_cfg().mode == 2) {
+            // BigOne 6d mode 2: a decode step locked this input -- its KEEP channels are the k largest channel amax of all its
+            // calibration batches (the same top-k as a batch's)
+            auto it = g_lf_kq8_fixed.find({src0->data, K, kk, ctx.device});
+            if (it != g_lf_kq8_fixed.end() && it->second.pending && !it->second.ready) {
+                lf_kq8_fixed & f = it->second;
+                const int P1 = lf_kq8_pow2(std::max(seg, kk)), P2 = lf_kq8_pow2(G * kk);
+                GGML_ASSERT(P1 <= 4096 && P2 <= 4096);
+                lf_kq8_topk_part<<<G, 256, (size_t) P1 * 8, stream>>>(f.cb_acc, K, seg, P1, kk, cand, f.pos);
+                const int Gp = lf_kq8_pow2(G), Pk = lf_kq8_pow2(kk);
+                if (Gp * Pk <= 4096) {
+                    lf_kq8_topk_merge<<<1, 1024, (size_t) Gp * Pk * 8, stream>>>(cand, G, kk, Gp, Pk, f.idx, f.pos, gb);
+                } else {
+                    lf_kq8_topk_merge_sort<<<1, 1024, (size_t) P2 * 8, stream>>>(cand, G * kk, P2, kk, f.idx, f.pos, gb);
+                }
+                f.ready = true;
+                f.pending = false;
+            }
+        }
+        const lf_kq8_fixed * fr = lf_kq8_fixed_ready(src0->data, K, kk, ctx.device);
+        if (fr != nullptr) {
+            // BigOne 6d: the input's fixed channels and amax
+            lf_kq8_quant_act_keep<true><<<T, 256, 0, stream>>>(x, xq, fr->gbits, sx, fr->idx, kk, K, Kp, lf_kq8_fixed_margin());
+            ac.fixed_pos = fr->pos;
+            ac.pre_src   = nullptr;
+        } else {
+            // the producer of this input may have filled the channel amax already (ggml_cuda_lf_kq8_amax_take); a maximum does
+            // not depend on the order, so either way gives the same bits
+            const bool pre = ac.pre_src == x_src && ac.pre_data == x && ac.pre_T == T && ac.pre_K == K && ac.pre_k == kk && ac.pre_gen == gen;
+            if (!pre) {
+                CUDA_CHECK(cudaMemsetAsync(cb, 0, (size_t) K * 4, stream));
+                lf_kq8_chan_amax<<<dim3((K + 255) / 256, (T + 63) / 64), 256, 0, stream>>>(x, T, K, cb);
+                ac.pre_src = nullptr;
+            }
+            const int P1 = lf_kq8_pow2(std::max(seg, kk)), P2 = lf_kq8_pow2(G * kk);
+            GGML_ASSERT(P1 <= 4096 && P2 <= 4096);
+            lf_kq8_topk_part<<<G, 256, (size_t) P1 * 8, stream>>>(cb, K, seg, P1, kk, cand, pos);
+            const int Gp = lf_kq8_pow2(G), Pk = lf_kq8_pow2(kk);
+            if (Gp * Pk <= 4096) {
+                lf_kq8_topk_merge<<<1, 1024, (size_t) Gp * Pk * 8, stream>>>(cand, G, kk, Gp, Pk, idx, pos, gb);
+            } else {   // a KEEP whose padded lists do not fit the 32 KiB of keys: sort all G * k candidates
+                lf_kq8_topk_merge_sort<<<1, 1024, (size_t) P2 * 8, stream>>>(cand, G * kk, P2, kk, idx, pos, gb);
+            }
+            lf_kq8_quant_act_keep<false><<<T, 256, 0, stream>>>(x, xq, gb, sx, idx, kk, K, Kp, 1.f);
+            ac.fixed_pos = nullptr;
+            if (lf_kq8_fixed_ncal() > 0) {   // BigOne 6d: record this calibration batch
+                lf_kq8_fixed_record(lf_kq8_fixed_get(src0->data, K, kk, ctx.device, stream), idx, pos, gb, cb, T, stream);
+            }
+        }
+        ac.x_src = x_src; ac.x_data = x; ac.T = T; ac.K = K; ac.k = kk; ac.gen = gen;
+    }
+
+    // weights: the plain fp8 conversion (row stride Kp) and the kept channels' two extra columns
+    const uint8_t * posw = ac.fixed_pos != nullptr ? ac.fixed_pos : pos;
+    float * scale = lf_kq8_scale_lookup(src0, ctx.device);
+    const bool first = scale == nullptr;
+    if (first) CUDA_CHECK(cudaMalloc((void **) &scale, (size_t) M * sizeof(float)));
+    const uint8_t * w8p = nullptr;
+    if (share && lf_kq8_preconv_on()) {   // FRANK_KQ_BLAS_PRECONV
+        lf_kq8_pre & pr = g_lf_kq8_pre[stream];
+        if (miss) {
+            // the later readers of this input first, into the stream's buffer; then this matmul's own weights as before
+            pr.e.clear();
+            const std::vector<lf_kq8_later> later = lf_kq8_later_readers(ctx.device, dst, x_src, T, K, kk, gen);
+            size_t need = 0;
+            for (const lf_kq8_later & l : later) need += ((size_t) l.mm->src[0]->ne[1] * Kp + 255) / 256 * 256;
+            if (need > pr.size) {
+                if (pr.ptr) {
+                    CUDA_CHECK(cudaStreamSynchronize(stream));
+                    CUDA_CHECK(cudaFree(pr.ptr));
+                }
+                CUDA_CHECK(cudaMalloc((void **) &pr.ptr, need));
+                pr.size = need;
+                GGML_LOG_INFO("FRANK_KQ_BLAS_PRECONV: %.1f MiB for the weights converted ahead\n", need / 1048576.0);
+            }
+            size_t off = 0;
+            for (const lf_kq8_later & l : later) {
+                lf_kq8_keep_convert(ctx, l.mm->src[0], l.scale, false, posw, kk, (uint8_t *) pr.ptr + off, stream);
+                pr.e.push_back({ l.mm, gen, off });
+                off += ((size_t) l.mm->src[0]->ne[1] * Kp + 255) / 256 * 256;
+            }
+        } else {
+            ++pr.hits;
+            for (auto it = pr.e.begin(); it != pr.e.end(); ++it) {
+                if (it->mm == dst && it->gen == gen) {
+                    w8p = (const uint8_t *) pr.ptr + it->off;
+                    pr.e.erase(it);
+                    ++pr.used;
+                    break;
+                }
+            }
+            if (w8p == nullptr && pr.logged < 3 && pr.hits - pr.used <= 4) {
+                pr.missed += std::string(pr.missed.empty() ? "" : ", ") + dst->name;
+            }
+        }
+    }
+    ggml_cuda_pool_alloc<uint8_t> w8(ctx.pool());
+    if (w8p == nullptr) {
+        w8.alloc((size_t) M * Kp);
+        lf_kq8_keep_convert(ctx, src0, scale, first, posw, kk, w8.get(), stream);
+        w8p = w8.get();
+    }
+    if (first) {
+        lf_kq_fp8_cache & c = lf_kq8();
+        std::lock_guard<std::mutex> lock8(c.mutex);
+        c.scale[{src0->data, src0->ne[0], src0->ne[1], ctx.device}] = scale;
+    }
+    const int otype = c == nullptr && y == (float *) dst->data ? lf_kq8_glu16_claim(dst, stream) : 0;   // BigOne GLU16
+    if (lf_blt_gemm_q(ctx, st, scale, w8p, xq, sx, y, M, T, Kp, c, otype) != 0) {
+        lf_kq8_glu16_written(dst, otype, stream);
+    }
+    CUDA_CHECK(cudaGetLastError());
+#else
+    GGML_UNUSED_VARS(ctx, src0, src1, dst, kk, y, c);
+    GGML_ABORT("FRANK_KQ_BLAS=fp8 needs hipBLASLt");
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+// BigOne 6d step 4: whether every reader of node p (views followed) within the next 32 nodes is a K1 fp8 KEEP matmul that takes
+// it whole as its activation -- so it shares the activations the producer writes -- with no other K1 matmul input in between
+// (it would take the stream's activation buffer before the last reader); then nothing reads the producer's f32 output.
+static bool lf_kq8_only_k1_readers(const ggml_cgraph * cgraph, const int p, const ggml_tensor * prod, const ggml_tensor * mm) {
+    if (prod->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+    auto root = [](const ggml_tensor * t) { while (t->view_src != nullptr) t = t->view_src; return t; };
+    const ggml_tensor * rp = root(prod);
+    std::vector<const ggml_tensor *> watch = { prod };
+    int need = ggml_node_get_use_count(cgraph, p), seen = 0;
+    const int end = std::min(cgraph->n_nodes, p + 33);
+    for (int j = p + 1; j < end && seen < need; ++j) {
+        const ggml_tensor * t = cgraph->nodes[j];
+        int uses = 0;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (t->src[s] != nullptr && std::find(watch.begin(), watch.end(), t->src[s]) != watch.end()) ++uses;
+        }
+        if (uses == 0) {
+            if (t->op == GGML_OP_MUL_MAT && ggml_cuda_lf_kq_blas_will_take(t) && root(t->src[1]) != rp) return false;
+            continue;
+        }
+        seen += uses;
+        if (t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE) {
+            if (t->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+            watch.push_back(t);
+            need += ggml_node_get_use_count(cgraph, j);
+            continue;
+        }
+        const ggml_tensor * s1 = t->src[1];
+        if (t->op == GGML_OP_MUL_MAT && uses == 1 && s1 != nullptr && std::find(watch.begin(), watch.end(), s1) != watch.end() &&
+                s1->data == prod->data && ggml_is_contiguous(s1) && ggml_nelements(s1) == ggml_nelements(prod) &&
+                s1->ne[0] == mm->src[1]->ne[0] && ggml_cuda_lf_kq_blas_will_take(t) && lf_kq_fp8_keep_for((int) t->src[0]->ne[0]) > 0) {
+            continue;
+        }
+        return false;
+    }
+    return seen == need;
+}
+
+// K1 fp8 KEEP: the channel amax of a matmul's activation, folded into the kernel that produces it (see lf-kq-blas.cuh)
+void ggml_cuda_lf_kq8_amax_mark(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, const int i) {
+#if defined(FRANK_HIPBLASLT)
+    const ggml_tensor * node = cgraph->nodes[i];
+    if ((node->op != GGML_OP_GLU && node->op != GGML_OP_UNARY && node->op != GGML_OP_RMS_NORM) || lf_kq_mode() != 2) return;
+    const ggml_tensor * prod = nullptr;
+    if (node->op == GGML_OP_GLU) {
+        prod = node;
+    } else if (i + 1 < cgraph->n_nodes && cgraph->nodes[i + 1]->op == GGML_OP_MUL &&
+               (cgraph->nodes[i + 1]->src[0] == node || cgraph->nodes[i + 1]->src[1] == node)) {
+        prod = cgraph->nodes[i + 1];   // a gated unary or an RMS_NORM, each fused with its MUL
+    }
+    if (prod == nullptr || prod->type != GGML_TYPE_F32 || !ggml_is_contiguous(prod) || ggml_nrows(prod) < lf_kq_min_t()) return;
+    auto root = [](const ggml_tensor * t) { while (t->view_src != nullptr) t = t->view_src; return t; };
+    for (int j = i + 1; j < std::min(cgraph->n_nodes, i + 16); ++j) {
+        const ggml_tensor * mm = cgraph->nodes[j];
+        if (mm->op != GGML_OP_MUL_MAT) continue;
+        const ggml_tensor * s1 = mm->src[1];
+        // the matmul reads the producer's output in its own row length (a whole number of the producer's rows: the GDN gate's
+        // 128-value head rows are one 6144-value row of the output projection)
+        if (root(s1) != root(prod) || s1->data != prod->data || !ggml_is_contiguous(s1) || ggml_nelements(s1) != ggml_nelements(prod) ||
+            s1->ne[0] % prod->ne[0] != 0 || (node->op == GGML_OP_RMS_NORM && s1->ne[0] != prod->ne[0])) continue;
+        // another reader first (the GDN layer's small beta / alpha projections): look on for the K1 one
+        if (!ggml_cuda_lf_kq_blas_will_take(mm) || lf_kq_fp8_keep_for((int) mm->src[0]->ne[0]) == 0) continue;
+        // BigOne 6d step 4: with fixed KEEP, whether only K1 matmuls read the output (the producer may then skip its f32 copy)
+        static const bool nof32 = [] { const char * e = getenv("FRANK_KQ_BLAS_FIXED_NOF32"); return e == nullptr || atoi(e) != 0; }();
+        const bool only = nof32 && lf_kq8_fixed_ncal() > 0 && lf_kq8_only_k1_readers(cgraph, prod == node ? i : i + 1, prod, mm);
+        lf_blt_state & st = lf_blt();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        g_lf_kq8_amax_marks[ctx.stream()] = { prod, mm, g_lf_fp8_graph_gen.load(std::memory_order_relaxed), only };
+        return;
+    }
+#else
+    GGML_UNUSED_VARS(ctx, cgraph, i);
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+unsigned int * ggml_cuda_lf_kq8_amax_take(ggml_backend_cuda_context & ctx, const ggml_tensor * producer, int64_t * row_len) {
+#if defined(FRANK_HIPBLASLT)
+    if (lf_kq_mode() != 2) return nullptr;
+    cudaStream_t stream = ctx.stream();
+    const ggml_tensor * mm = nullptr;
+    {
+        lf_blt_state & st = lf_blt();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        auto it = g_lf_kq8_amax_marks.find(stream);
+        if (it == g_lf_kq8_amax_marks.end()) return nullptr;
+        const lf_kq8_amax_pair m = it->second;
+        g_lf_kq8_amax_marks.erase(it);
+        if (m.prod != producer || m.gen != g_lf_fp8_graph_gen.load(std::memory_order_relaxed)) return nullptr;
+        mm = m.mm;
+    }
+    const ggml_tensor * src0 = mm->src[0], * src1 = mm->src[1];
+    const int kk = lf_kq_fp8_keep_for((int) src0->ne[0]);
+    if (kk == 0 || !ggml_cuda_lf_kq_blas_supported(ctx, src0, src1, mm)) return nullptr;
+    const int K = (int) src0->ne[0], T = (int) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    const ggml_tensor * x_src = src1;
+    while (x_src->view_src != nullptr) x_src = x_src->view_src;
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (lf_kq8_fixed_ready(src0->data, K, kk, ctx.device) != nullptr) return nullptr;   // BigOne 6d: no channel amax needed
+    lf_kq8_act & ac = g_lf_kq8_acts[stream];
+    const lf_kq8_act_layout L(T, K, kk);
+    lf_kq8_act_reserve(ac, L.need, stream);
+    unsigned int * cb = (unsigned int *) (ac.ptr + L.o_cb);
+    CUDA_CHECK(cudaMemsetAsync(cb, 0, (size_t) K * 4, stream));
+    *row_len = K;
+    ac.pre_src = x_src; ac.pre_data = src1->data; ac.pre_T = T; ac.pre_K = K; ac.pre_k = kk;
+    ac.pre_gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    return cb;
+#else
+    GGML_UNUSED_VARS(ctx, producer, row_len);
+    return nullptr;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+// BigOne 6d step 2 (see lf-kq-blas.cuh)
+bool ggml_cuda_lf_kq8_fp8_take(ggml_backend_cuda_context & ctx, const ggml_tensor * producer, ggml_cuda_lf_kq8_fp8_dst * d) {
+#if defined(FRANK_HIPBLASLT)
+    static const bool on = [] { const char * e = getenv("FRANK_KQ_BLAS_FIXED_PRODUCER"); return e == nullptr || atoi(e) != 0; }();
+    if (!on || lf_kq_mode() != 2 || lf_kq8_fixed_ncal() == 0) return false;
+    cudaStream_t stream = ctx.stream();
+    const uint64_t gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    const ggml_tensor * mm = nullptr;
+    {
+        lf_blt_state & st = lf_blt();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        auto it = g_lf_kq8_amax_marks.find(stream);
+        if (it == g_lf_kq8_amax_marks.end() || it->second.prod != producer || it->second.gen != gen) return false;
+        mm = it->second.mm;
+        // step 4 needs the readers to share the activations (FRANK_KQ_BLAS_SHARE=0 makes each matmul quantize the f32 output)
+        static const bool share = !getenv("FRANK_KQ_BLAS_SHARE") || atoi(getenv("FRANK_KQ_BLAS_SHARE")) != 0;
+        d->skip_f32 = it->second.only_k1 && share;
+    }
+    const ggml_tensor * src0 = mm->src[0], * src1 = mm->src[1];
+    const int kk = lf_kq_fp8_keep_for((int) src0->ne[0]);
+    if (kk == 0 || !ggml_cuda_lf_kq_blas_supported(ctx, src0, src1, mm)) return false;
+    const int K = (int) src0->ne[0], T = (int) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    const ggml_tensor * x_src = src1;
+    while (x_src->view_src != nullptr) x_src = x_src->view_src;
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    const lf_kq8_fixed * fr = lf_kq8_fixed_ready(src0->data, K, kk, ctx.device);
+    if (fr == nullptr) return false;
+    g_lf_kq8_amax_marks.erase(stream);
+    lf_kq8_act & ac = g_lf_kq8_acts[stream];
+    const lf_kq8_act_layout L(T, K, kk);
+    lf_kq8_act_reserve(ac, L.need, stream);
+    d->xq = (uint8_t *) ac.ptr; d->sx = (float *) (ac.ptr + L.o_sx); d->gbits = fr->gbits; d->margin = lf_kq8_fixed_margin();
+    d->pos = fr->pos; d->k = kk; d->K = K; d->Kp = K + 2 * kk;
+    // the matmul (and the others reading this input) find the activations ready
+    ac.x_src = x_src; ac.x_data = src1->data; ac.T = T; ac.K = K; ac.k = kk; ac.gen = gen; ac.fixed_pos = fr->pos;
+    ac.pre_src = nullptr;
+    return true;
+#else
+    GGML_UNUSED_VARS(ctx, producer, d);
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+// BigOne GLU16 (see lf-kq-blas.cuh)
+int ggml_cuda_lf_kq8_glu16_window(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, const int i) {
+#if defined(FRANK_HIPBLASLT)
+    if (lf_kq8_glu16_type() == 0 || lf_kq_mode() != 2) return 0;
+    const ggml_tensor * node = cgraph->nodes[i];
+    const bool cand = node->op == GGML_OP_MUL_MAT && node->type == GGML_TYPE_F32 && !(node->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+        node->view_src == nullptr && ggml_is_contiguous(node) && ggml_cuda_lf_kq_blas_will_take(node) &&
+        ggml_node_get_use_count(cgraph, i) == 1;
+    cudaStream_t stream = ctx.stream();
+    const uint64_t gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    std::vector<lf_kq8_glu16_mark> & marks = g_lf_kq8_glu16_marks[stream];
+    marks.erase(std::remove_if(marks.begin(), marks.end(), [&](const lf_kq8_glu16_mark & m) { return m.gen != gen || m.consumer < i; }),
+                marks.end());
+    if (cand) {
+        // the one reader: a split GLU, f32, contiguous, both inputs of the matmul's shape
+        for (int j = i + 1; j < std::min(cgraph->n_nodes, i + 8); ++j) {
+            const ggml_tensor * c = cgraph->nodes[j];
+            if (c->src[0] != node && c->src[1] != node) continue;
+            const ggml_glu_op op = c->op == GGML_OP_GLU ? ggml_get_glu_op(c) : GGML_GLU_OP_COUNT;
+            const bool glu = op == GGML_GLU_OP_REGLU || op == GGML_GLU_OP_GEGLU || op == GGML_GLU_OP_SWIGLU || op == GGML_GLU_OP_GEGLU_ERF ||
+                op == GGML_GLU_OP_GEGLU_QUICK;
+            if (glu && c->src[1] != nullptr && c->src[0] != c->src[1] && c->type == GGML_TYPE_F32 && c->src[0]->type == GGML_TYPE_F32 &&
+                c->src[1]->type == GGML_TYPE_F32 && ggml_is_contiguous(c->src[0]) && ggml_is_contiguous(c->src[1]) && ggml_is_contiguous(c) &&
+                ggml_are_same_shape(c->src[0], c->src[1]) && ggml_are_same_shape(c->src[0], node)) {
+                marks.push_back({ node, j, gen, false });
+                return 1;
+            }
+            break;
+        }
+    }
+    for (const lf_kq8_glu16_mark & m : marks) {
+        if (i <= m.consumer) return 1;
+    }
+    return 0;
+#else
+    GGML_UNUSED_VARS(ctx, cgraph, i);
+    return 0;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+int ggml_cuda_lf_kq8_glu16_take(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+#if defined(FRANK_HIPBLASLT)
+    if (lf_kq8_glu16_type() == 0 || t == nullptr) return 0;
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    auto pe = g_lf_kq8_glu16_pend.find(ctx.stream());
+    if (pe == g_lf_kq8_glu16_pend.end()) return 0;
+    const uint64_t gen = g_lf_fp8_graph_gen.load(std::memory_order_relaxed);
+    int type = 0;
+    std::vector<lf_kq8_glu16_pend> & v = pe->second;
+    for (auto it = v.begin(); it != v.end(); ) {
+        if (it->gen != gen) { it = v.erase(it); continue; }             // an earlier graph's
+        if (type == 0 && it->t == t) { type = it->type; it = v.erase(it); continue; }
+        ++it;
+    }
+    return type;
+#else
+    GGML_UNUSED_VARS(ctx, t);
+    return 0;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+bool ggml_cuda_lf_kq8_fp8_ready(ggml_backend_cuda_context & ctx, const ggml_tensor * producer, bool * skip_f32) {
+#if defined(FRANK_HIPBLASLT)
+    static const bool on = [] { const char * e = getenv("FRANK_KQ_BLAS_FIXED_PRODUCER"); return e == nullptr || atoi(e) != 0; }();
+    if (!on || lf_kq_mode() != 2 || lf_kq8_fixed_ncal() == 0) return false;
+    const ggml_tensor * mm = nullptr;
+    {
+        lf_blt_state & st = lf_blt();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        auto it = g_lf_kq8_amax_marks.find(ctx.stream());
+        if (it == g_lf_kq8_amax_marks.end() || it->second.prod != producer || it->second.gen != g_lf_fp8_graph_gen.load(std::memory_order_relaxed)) {
+            return false;
+        }
+        mm = it->second.mm;
+        if (skip_f32 != nullptr) {
+            static const bool share = !getenv("FRANK_KQ_BLAS_SHARE") || atoi(getenv("FRANK_KQ_BLAS_SHARE")) != 0;
+            *skip_f32 = it->second.only_k1 && share;   // as ggml_cuda_lf_kq8_fp8_take will set it
+        }
+    }
+    const ggml_tensor * src0 = mm->src[0], * src1 = mm->src[1];
+    const int kk = lf_kq_fp8_keep_for((int) src0->ne[0]);
+    if (kk == 0 || !ggml_cuda_lf_kq_blas_supported(ctx, src0, src1, mm)) return false;
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    return lf_kq8_fixed_ready(src0->data, (int) src0->ne[0], kk, ctx.device) != nullptr;
+#else
+    GGML_UNUSED_VARS(ctx, producer);
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+bool ggml_cuda_lf_kq_blas_will_take(const ggml_tensor * mm) {
+    if (!lf_kq_on() || mm->op != GGML_OP_MUL_MAT) return false;
+    if (!GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ggml_cuda_get_device()].cc)) return false;
+    if (!lf_kq_shape_ok(mm->src[0], mm->src[1])) return false;
+#if defined(FRANK_HIPBLASLT)
+    return lf_kq_probe(ggml_cuda_get_device()); // host-side query only; without kernels the fusions stay on
+#else
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+bool ggml_cuda_lf_kq_blas_supported(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+#if defined(FRANK_HIPBLASLT)
+    if (!lf_kq_on()) return false;
+    if (dst->type != GGML_TYPE_F32 || !GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ctx.device].cc)) return false;
+    if (!lf_kq_shape_ok(src0, src1)) return false;
+    if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) return false;
+    const int64_t K = src0->ne[0], M = src0->ne[1];
+    const int64_t T = src1->ne[1] * src1->ne[2] * src1->ne[3];
+    if (src1->ne[0] != K || dst->ne[0] != M || ggml_nrows(dst) != T) return false;
+    if (lf_kq_mode() == 2) {
+        if (K % 4 != 0) return false;
+        if (!ggml_cuda_lf_kq_fp8_ready(src0, ctx.device, (int) M, (int) T, (int) K)) {
+            hipStreamCaptureStatus st = hipStreamCaptureStatusNone;   // first use allocates: not while a graph is being captured
+            if (hipStreamIsCapturing(ctx.stream(), &st) != hipSuccess || st != hipStreamCaptureStatusNone) return false;
+        }
+        return true;
+    }
+    if (!lf_kq_ready(ctx.device, ctx.stream(), lf_kq_chunk_rows((int) M, (int) K), (int) T, (int) K, (int) M)) {
+        // first use probes / allocates / tunes: not while a graph is being captured
+        hipStreamCaptureStatus st = hipStreamCaptureStatusNone;
+        if (hipStreamIsCapturing(ctx.stream(), &st) != hipSuccess || st != hipStreamCaptureStatusNone) return false;
+        if (!lf_kq_probe(ctx.device)) return false;
+    }
+    return true;
+#else
+    GGML_UNUSED_VARS(ctx, src0, src1, dst);
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+static void lf_kq_f16_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst,
+        float * y, const float * c);
+
+#if defined(FRANK_HIPBLASLT)
+// K1 f16 takes the residual ADD unless its algorithms are timed (FRANK_KQ_BLAS_ALGOS=tune, or unset off gfx1201): the timing runs
+// write their products where the result goes, which can be the residual itself
+static bool lf_kq_f16_fusable(const int device) {
+    lf_kq_state & st = lf_kq();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (!st.handle) LF_KQ_CHECK(hipblasLtCreate(&st.handle));
+    lf_kq_algos_init(st, device);
+    return !lf_kq_timed();
+}
+#endif // defined(FRANK_HIPBLASLT)
+
+bool ggml_cuda_lf_kq8_mul_mat_add(ggml_backend_cuda_context & ctx, ggml_tensor * mm, ggml_tensor * add) {
+#if defined(FRANK_HIPBLASLT)
+    static const bool on = !getenv("FRANK_KQ_BLAS_ADD") || atoi(getenv("FRANK_KQ_BLAS_ADD")) != 0;
+    if (!on || lf_blt_algo_mode() == 2) return false;
+    const ggml_tensor * src0 = mm->src[0], * src1 = mm->src[1];
+    const ggml_tensor * other = add->src[0] == mm ? add->src[1] : add->src[0];
+    if (other == nullptr || other == mm || add->type != GGML_TYPE_F32 || other->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(add) || !ggml_is_contiguous(other) || !ggml_is_contiguous(mm) ||
+        !ggml_are_same_shape(add, mm) || !ggml_are_same_shape(other, mm)) {
+        return false;
+    }
+    // the GEMM reads c while it writes d element by element: the same buffer, or apart
+    const char * c = (const char *) other->data, * d = (const char *) add->data;
+    const size_t n = ggml_nbytes(add);
+    if (c != d && c < d + n && d < c + n) return false;
+    if (lf_kq_mode() == 2 && ggml_cuda_lf_kq_blas_supported(ctx, src0, src1, mm)) {
+        ggml_cuda_lf_kq_fp8_mul_mat(ctx, src0, src1, mm, (float *) add->data, (const float *) other->data);
+        return true;
+    }
+    // K1 f16: the same epilogue (beta 1, c the residual) on its f16 GEMM
+    if (lf_kq_mode() == 1 && ggml_cuda_lf_kq_blas_supported(ctx, src0, src1, mm) && lf_kq_f16_fusable(ctx.device)) {
+        lf_kq_f16_mul_mat(ctx, src0, src1, mm, (float *) add->data, (const float *) other->data);
+        return true;
+    }
+    // M4 (MXFP4 weights) in its blaslt mode: the same GEMM
+    return ggml_cuda_lf_mxfp4_mul_mat_add(ctx, src0, src1, mm, (float *) add->data, (const float *) other->data);
+#else
+    GGML_UNUSED_VARS(ctx, mm, add);
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+void ggml_cuda_lf_kq_blas_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+#if defined(FRANK_HIPBLASLT)
+    if (lf_kq_mode() == 2) {
+        ggml_cuda_lf_kq_fp8_mul_mat(ctx, src0, src1, dst, (float *) dst->data, nullptr);
+        return;
+    }
+    lf_kq_f16_mul_mat(ctx, src0, src1, dst, (float *) dst->data, nullptr);
+#else
+    GGML_UNUSED_VARS(ctx, src0, src1, dst);
+    GGML_ABORT("FRANK_KQ_BLAS needs hipBLASLt");
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+// K1 f16: y = the product (dst->data), or with c != nullptr the output of the residual ADD folded in: y = the product + c (beta 1;
+// c may be y itself), as the fp8 path does (see ggml_cuda_lf_kq8_mul_mat_add)
+static void lf_kq_f16_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst,
+        float * y, const float * c) {
+#if defined(FRANK_HIPBLASLT)
+    GGML_UNUSED(dst);
+    cudaStream_t stream = ctx.stream();
+    const int K  = (int) src0->ne[0], M = (int) src0->ne[1];
+    const int T  = (int) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    const int Mc = lf_kq_chunk_rows(M, K);
+    const float * x = (const float *) src1->data;
+
+    lf_kq_state & st = lf_kq();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (!st.handle) LF_KQ_CHECK(hipblasLtCreate(&st.handle));
+
+    lf_kq_scratch & sc = st.scratch[stream];
+    const size_t need = lf_kq_scratch_bytes(Mc, T, K, M);
+    if (sc.size < need) {
+        if (sc.ptr) {
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            CUDA_CHECK(cudaFree(sc.ptr));
+        }
+        CUDA_CHECK(cudaMalloc((void **) &sc.ptr, need));
+        sc.size  = need;
+        sc.x_src = nullptr;
+    }
+    half  * x16   = (half *) sc.ptr;
+    float * sx    = (float *) (sc.ptr + lf_kq_align((size_t) T * K * 2));
+    unsigned int * gbits = (unsigned int *) (sx + 16);
+    half  * w16   = (half *) ((char *) sx + LF_KQ_SCALE_BYTES);
+    float * av    = (float *) ((char *) w16 + lf_kq_align((size_t) Mc * K * 2));
+    char  * wsp   = (char *) av + lf_kq_align((size_t) M * 4);
+
+    // activations -> f16 with the batch scale, once per input and graph (FRANK_KQ_BLAS_SHARE=0: every call); alpha vector
+    static const bool share = !getenv("FRANK_KQ_BLAS_SHARE") || atoi(getenv("FRANK_KQ_BLAS_SHARE")) != 0;
+    const ggml_tensor * x_src = src1;
+    while (x_src->view_src != nullptr) x_src = x_src->view_src;
+    const uint64_t gen = g_lf_kq_graph_gen.load(std::memory_order_relaxed);
+    if (!share || sc.x_src != x_src || sc.x_data != src1->data || sc.x_T != T || sc.x_K != K || sc.x_gen != gen) {
+        CUDA_CHECK(cudaMemsetAsync(gbits, 0, sizeof(unsigned int), stream));
+        lf_kq_act_amax<<<T, 256, 0, stream>>>(x, K, gbits);
+        lf_kq_act_f16<<<T, 256, 0, stream>>>(x, x16, gbits, sx, K);
+        sc.x_src = x_src; sc.x_data = src1->data; sc.x_T = T; sc.x_K = K; sc.x_gen = gen;
+    }
+    lf_kq_alpha<<<(M + 255) / 256, 256, 0, stream>>>(sx, av, M);
+
+    lf_kq_algos_init(st, ctx.device);
+    const float beta = 0.f;     // the algorithm choice, and the plain product
+    const float beta_c = 1.f;   // the product + c
+
+    // descriptor + layouts for (rows per call, exact T): rows r0.. of dst, leading dimension M
+    auto layout = [&](const int mc, const int t) -> lf_kq_layout & {
+        lf_kq_layout & l = st.layouts[{ctx.device, mc, t, K, M}];
+        if (l.desc == nullptr) {
+            LF_KQ_CHECK(hipblasLtMatmulDescCreate(&l.desc, HIPBLAS_COMPUTE_32F, HIP_R_32F));
+            const hipblasOperation_t ta = HIPBLAS_OP_T, tb = HIPBLAS_OP_N;
+            const hipblasLtPointerMode_t pm = HIPBLASLT_POINTER_MODE_ALPHA_DEVICE_VECTOR_BETA_HOST;
+            LF_KQ_CHECK(hipblasLtMatmulDescSetAttribute(l.desc, HIPBLASLT_MATMUL_DESC_TRANSA, &ta, sizeof(ta)));
+            LF_KQ_CHECK(hipblasLtMatmulDescSetAttribute(l.desc, HIPBLASLT_MATMUL_DESC_TRANSB, &tb, sizeof(tb)));
+            LF_KQ_CHECK(hipblasLtMatmulDescSetAttribute(l.desc, HIPBLASLT_MATMUL_DESC_POINTER_MODE, &pm, sizeof(pm)));
+            LF_KQ_CHECK(hipblasLtMatrixLayoutCreate(&l.la, HIP_R_16F, K, mc, K));
+            LF_KQ_CHECK(hipblasLtMatrixLayoutCreate(&l.lb, HIP_R_16F, K, t, K));
+            LF_KQ_CHECK(hipblasLtMatrixLayoutCreate(&l.lc, HIP_R_32F, mc, t, M));
+        }
+        return l;
+    };
+    auto supported = [&](lf_kq_layout & l, hipblasLtMatmulAlgo_t & algo, size_t & ws) {
+        return hipblaslt_ext::matmulIsAlgoSupported(st.handle, l.desc, av, l.la, l.lb, &beta, l.lc, l.lc, algo, ws) == HIPBLAS_STATUS_SUCCESS &&
+            ws <= LF_KQ_WS_MAX;
+    };
+    // the heuristic's candidates for (rows per call, t columns)
+    auto heuristic = [&](lf_kq_layout & l, hipblasLtMatmulHeuristicResult_t * res, const int nmax) {
+        hipblasLtMatmulPreference_t pref;
+        LF_KQ_CHECK(hipblasLtMatmulPreferenceCreate(&pref));
+        LF_KQ_CHECK(hipblasLtMatmulPreferenceSetAttribute(pref, HIPBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &LF_KQ_WS_MAX, sizeof(LF_KQ_WS_MAX)));
+        int nres = 0;
+        LF_KQ_CHECK(hipblasLtMatmulAlgoGetHeuristic(st.handle, l.desc, l.la, l.lb, l.lc, l.lc, pref, nmax, res, &nres));
+        hipblasLtMatmulPreferenceDestroy(pref);
+        return nres;
+    };
+    // the algorithm of bucket b (tb = b * 256 <= T columns): from the given table (FRANK_KQ_BLAS_ALGOS), else the
+    // heuristic's first candidate (with a table, or GGML_LF_KQ_BLAS_TUNE=0), else the fastest candidate timed on the
+    // first tb columns of the real operands
+    auto choose = [&](const int mc, const int r0, const int b) -> lf_kq_algo & {
+        lf_kq_algo & a = st.bucket[{ctx.device, mc, b, K, M}];
+        if (a.ok) return a;
+        const int tb = b * LF_KQ_BUCKET;
+        lf_kq_layout & l = layout(mc, tb);
+        const char * how = "table";
+        float best = 0.f;
+        if (st.algos_use) {
+            auto it = st.table.find({mc, b, K, M});
+            if (it != st.table.end()) {
+                std::vector<int> idx{it->second};
+                std::vector<hipblasLtMatmulHeuristicResult_t> hr;
+                if (hipblaslt_ext::getAlgosFromIndex(st.handle, idx, hr) == HIPBLAS_STATUS_SUCCESS && !hr.empty() && supported(l, hr[0].algo, a.ws)) {
+                    a.algo = hr[0].algo;
+                    a.ok   = true;
+                } else {
+                    fprintf(stderr, "FRANK_KQ_BLAS_ALGOS: choice %d for (%d rows, K %d, %d tokens) not usable here, heuristic used\n",
+                            it->second, mc, K, tb);
+                }
+            } else if (!st.algos_missing_warned && !st.table.empty()) {
+                st.algos_missing_warned = true;
+                fprintf(stderr, "FRANK_KQ_BLAS_ALGOS: no choice for (%d rows, K %d, %d tokens) and possibly others (other model / -ub?), "
+                                "heuristic used\n", mc, K, tb);
+            }
+        }
+        if (!a.ok) {
+            const bool timed = lf_kq_timed();
+            hipblasLtMatmulHeuristicResult_t res[32];
+            const int nres = heuristic(l, res, (timed || st.def_mode) ? 32 : 1);
+            if (nres == 0) GGML_ABORT("hipBLASLt has no f16 algorithm for M=%d N=%d K=%d", mc, tb, K);
+            // position in the gfx1201 priority list; unlisted candidates after the listed ones, in the heuristic's order
+            auto rank_of = [&](const int i) {
+                auto it = st.prio.find(hipblaslt_ext::getIndexFromAlgo(res[i].algo));
+                return it == st.prio.end() ? 100000 + i : it->second;
+            };
+            int bi = 0;
+            how = "heuristic";
+            if (st.def_mode) {
+                how = "gfx1201v1";
+                bi = -1;
+                for (int i = 0; i < nres; ++i) {
+                    if (res[i].workspaceSize <= LF_KQ_WS_MAX && (bi < 0 || rank_of(i) < rank_of(bi))) bi = i;
+                }
+                if (bi < 0) bi = 0;
+            } else if (timed) {
+                GGML_ASSERT(c == nullptr);   // the timing runs write y (lf_kq_f16_fusable)
+                how = "timed";
+                hipEvent_t e0, e1;
+                CUDA_CHECK(hipEventCreate(&e0)); CUDA_CHECK(hipEventCreate(&e1));
+                // Timing on fixed pseudo-random activations (the real ones are restored below): one untimed run per
+                // candidate, then 5 rounds that time every candidate once in turn (slow clock drift hits all alike), each
+                // candidate's fastest run; tiny GEMMs (tens of us) repeat per sample.  Several candidates are usually within
+                // noise of each other and some of them round differently, so the choice is the first in the gfx1201 priority
+                // list (else the heuristic's ranking) among those within 3% of the fastest: near-ties resolve the same way
+                // every time.
+                lf_kq_fill_rand<<<1024, 256, 0, stream>>>(x16, (int64_t) tb * K);
+                auto run1 = [&](const int i) {
+                    return hipblasLtMatmul(st.handle, l.desc, av + r0, w16, l.la, x16, l.lb, &beta, y + r0, l.lc, y + r0, l.lc,
+                                           &res[i].algo, wsp, res[i].workspaceSize, stream) == HIPBLAS_STATUS_SUCCESS;
+                };
+                const double flop  = 2.0 * mc * tb * (double) K;
+                const int    iters = (int) std::min(32.0, std::max(1.0, std::ceil(4e9 / flop)));
+                std::vector<float> tms(nres, 1e30f);
+                std::vector<bool> usable(nres);
+                for (int i = 0; i < nres; ++i) {
+                    usable[i] = res[i].workspaceSize <= LF_KQ_WS_MAX && run1(i);
+                }
+                CUDA_CHECK(hipStreamSynchronize(stream));
+                for (int round = 0; round < 5; ++round) {
+                    for (int i = 0; i < nres; ++i) {
+                        if (!usable[i]) continue;
+                        CUDA_CHECK(hipEventRecord(e0, stream));
+                        for (int it = 0; it < iters && usable[i]; ++it) usable[i] = run1(i);
+                        CUDA_CHECK(hipEventRecord(e1, stream));
+                        CUDA_CHECK(hipEventSynchronize(e1));
+                        float ms = 0.f; CUDA_CHECK(hipEventElapsedTime(&ms, e0, e1));
+                        if (usable[i]) tms[i] = std::min(tms[i], ms / iters);
+                    }
+                }
+                CUDA_CHECK(hipEventDestroy(e0)); CUDA_CHECK(hipEventDestroy(e1));
+                lf_kq_act_f16<<<T, 256, 0, stream>>>(x, x16, gbits, sx, K); // the real activations back
+                best = 1e30f; bi = -1;
+                for (int i = 0; i < nres; ++i) {
+                    if (usable[i]) best = std::min(best, tms[i]);
+                }
+                for (int i = 0; i < nres; ++i) {
+                    if (usable[i] && tms[i] <= best * 1.03f && (bi < 0 || rank_of(i) < rank_of(bi))) bi = i;
+                }
+                if (lf_kq_log() >= 2) {
+                    std::string line;
+                    for (int i = 0; i < nres; ++i) {
+                        line += " " + std::to_string(hipblaslt_ext::getIndexFromAlgo(res[i].algo)) + ":" +
+                                (usable[i] ? std::to_string((int) (tms[i] * 1000.f)) : std::string("x"));
+                    }
+                    fprintf(stderr, "LF_KQ_BLAS cand rows %d N %d K %d M %d:%s\n", mc, tb, K, M, line.c_str());
+                }
+                if (bi < 0) GGML_ABORT("hipBLASLt: no f16 candidate ran for M=%d N=%d K=%d", mc, tb, K);
+                best = tms[bi];
+                // the timing runs left another candidate's result in y; the real call follows, so nothing to redo
+            }
+            a.algo = res[bi].algo;
+            a.ws   = res[bi].workspaceSize;
+            a.ok   = true;
+        }
+        a.idx = hipblaslt_ext::getIndexFromAlgo(a.algo);
+        if (lf_kq_log()) fprintf(stderr, "LF_KQ_BLAS f16 %s M=%d (rows %d per call) N=%d.. K=%d: %s, index %d%s\n",
+                                 ggml_type_name(src0->type), M, mc, tb, K, how, a.idx,
+                                 best > 0.f ? (" (" + std::to_string((int) (best * 1000.f)) + " us)").c_str() : "");
+        return a;
+    };
+    // the algorithm for this exact T: its bucket's choice, checked for T (heuristic's first candidate if unsupported)
+    auto resolve = [&](const int mc, const int r0) -> lf_kq_algo & {
+        lf_kq_algo & r = st.resolved[{ctx.device, mc, T, K, M}];
+        if (r.ok) return r;
+        const int b = T / LF_KQ_BUCKET;
+        { // the buckets below this one too, so the startup warm-up covers them all
+            for (int bb = std::max(1, (lf_kq_min_t() + LF_KQ_BUCKET - 1) / LF_KQ_BUCKET); bb < b; ++bb) {
+                choose(mc, r0, bb);
+            }
+        }
+        lf_kq_algo & a = choose(mc, r0, b);
+        lf_kq_layout & l = layout(mc, T);
+        r.algo = a.algo;
+        if (!supported(l, r.algo, r.ws)) {
+            hipblasLtMatmulHeuristicResult_t res[1];
+            if (heuristic(l, res, 1) == 0) GGML_ABORT("hipBLASLt has no f16 algorithm for M=%d N=%d K=%d", mc, T, K);
+            r.algo = res[0].algo;
+            r.ws   = res[0].workspaceSize;
+            if (lf_kq_log()) fprintf(stderr, "LF_KQ_BLAS f16 rows %d N=%d K=%d: bucket choice unsupported, heuristic used\n", mc, T, K);
+        }
+        r.ok = true;
+        return r;
+    };
+
+    const to_fp16_cuda_t to_fp16 = lf_kq_to_fp16_for(src0->type);
+    for (int r0 = 0; r0 < M; r0 += Mc) {
+        const int mc = std::min(Mc, M - r0);
+        // weight rows r0 .. r0+mc -> f16 (whole quant blocks: K is a multiple of 64)
+        to_fp16((const char *) src0->data + (size_t) r0 * src0->nb[1], w16, (int64_t) mc * K, stream);
+        lf_kq_algo & r = resolve(mc, r0);
+        lf_kq_layout & l = layout(mc, T);
+        LF_KQ_CHECK(hipblasLtMatmul(st.handle, l.desc, av + r0, w16, l.la, x16, l.lb, c ? &beta_c : &beta, c ? c + r0 : y + r0, l.lc,
+                                    y + r0, l.lc, &r.algo, wsp, r.ws, stream));
+    }
+    CUDA_CHECK(cudaGetLastError());
+#else
+    GGML_UNUSED_VARS(ctx, src0, src1, dst, y, c);
+    GGML_ABORT("FRANK_KQ_BLAS needs hipBLASLt");
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+void ggml_cuda_lf_kq_blas_graph_begin(const ggml_cgraph * cgraph) {
+#if defined(FRANK_HIPBLASLT)
+    g_lf_kq_graph_gen.fetch_add(1, std::memory_order_relaxed);
+    const uint64_t gen8 = g_lf_fp8_graph_gen.fetch_add(1, std::memory_order_relaxed) + 1;
+    lf_kq8_fixed_graph_begin(cgraph);   // BigOne 6d mode 2: an input is fixed at a decode step
+    {   // FRANK_KQ_BLAS_PRECONV: the graph for the look-ahead; the last graph's count, for the first few graphs with share hits
+        lf_blt_state & st = lf_blt();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        g_lf_kq8_graphs[ggml_cuda_get_device()] = { cgraph, 0, gen8 };
+        for (auto & e : g_lf_kq8_pre) {
+            lf_kq8_pre & p = e.second;
+            if (p.hits > 0 && p.logged < 3) {
+                GGML_LOG_INFO("FRANK_KQ_BLAS_PRECONV: a graph with %d share hits, %d of them on weights converted ahead%s%s\n", p.hits,
+                              p.used, p.missed.empty() ? "" : "; without: ", p.missed.c_str());
+                ++p.logged;
+            }
+            p.hits = p.used = 0;
+            p.e.clear();
+            p.missed.clear();
+        }
+    }
+#else
+    GGML_UNUSED(cgraph);
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+// Startup warm-up hooks (reached by llama-common through ggml_backend_reg_get_proc_address): whether the warm-up should
+// run a full ubatch (always when K1 is on: choices made and kernels loaded before the first prompt), and the resulting
+// table for FRANK_KQ_BLAS_ALGOS ("" if none).
+bool ggml_cuda_lf_kq_blas_wants_warmup() {
+#if defined(FRANK_HIPBLASLT)
+    // also reports the state at startup (hipBLASLt found, selection mode) instead of at the first long prompt
+    if (!lf_kq_on()) return false;
+    const int device = ggml_cuda_get_device();
+    if (!GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[device].cc) || !lf_kq_probe(device)) return false;
+    {
+        lf_kq_state & st = lf_kq();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        lf_kq_algos_init(st, device);
+    }
+    // every mode: the warm-up makes the choices and loads hipBLASLt's kernels (their code objects are loaded on first
+    // use, which otherwise lands in the first prompt: -3% at 30K), and prints the choices as a table
+    return true;
+#else
+    return false;
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+const char * ggml_cuda_lf_kq_blas_algos_string() {
+#if defined(FRANK_HIPBLASLT)
+    lf_kq8_fixed_reset();   // BigOne 6d: called once, right after the startup warm-up
+    static std::string out;
+    lf_kq_state & st = lf_kq();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    out = st.handle ? lf_kq_algos_export(st, ggml_cuda_get_device()) : std::string();
+    return out.c_str();
+#else
+    return "";
+#endif // defined(FRANK_HIPBLASLT)
+}
+
+// The fp8 GEMM shapes prepared so far (K1 fp8, M4).  The table above covers only the f16 GEMM, so it stays empty in the fp8
+// mode; the warm-up reports this count there instead.
+int ggml_cuda_lf_kq_blas_fp8_shapes() {
+#if defined(FRANK_HIPBLASLT)
+    lf_blt_state & st = lf_blt();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    return (int) st.shapes.size();
+#else
+    return 0;
+#endif // defined(FRANK_HIPBLASLT)
+}
diff --git a/ggml/src/ggml-cuda/lf-kq-blas.cuh b/ggml/src/ggml-cuda/lf-kq-blas.cuh
new file mode 100644
index 000000000..a01b182e6
--- /dev/null
+++ b/ggml/src/ggml-cuda/lf-kq-blas.cuh
@@ -0,0 +1,92 @@
+#pragma once
+#include "common.cuh"
+// K1: prefill GEMM of quantized weights through hipBLASLt (RDNA4), in fp8 (FRANK_KQ_BLAS=fp8, the default when every device
+// is a gfx1201) or as f16 (FRANK_KQ_BLAS=f16, described here); FRANK_KQ_BLAS=0 turns it off (unset with FRANK_ALL=0: off).
+// FRANK_KQ_BLAS_ALGOS selects how the f16 GEMM's algorithms are
+// chosen (unset: def.gfx1201v1 on gfx1201, else tune; "def.gfx1201v1", the built-in gfx1201 priority list; a printed
+// "K1a2." table; "tune", timed by the startup warm-up; "0" or anything else: hipBLASLt's first heuristic choice).  It takes dense MUL_MATs with at least
+// FRANK_KQ_BLAS_MIN_T tokens (default 384) on weights of 20M elements or more, and at least 1024 on smaller ones (below that
+// the per-call weight conversion does not pay off).  Matmuls of one graph with the same input
+// convert it once (FRANK_KQ_BLAS_SHARE=0: every call; same results either way).  FRANK_KQ_BLAS_LOG=1 prints the algorithm chosen per shape.
+// The weight is dequantized to f16 (to_fp16: one rounding of the block value), the activations go to f16 with one
+// power-of-two scale for the batch (exact scaling), and hipBLASLt multiplies f16 x f16 with f32 accumulation; the
+// batch scale is the per-row alpha vector.  Results differ from mmq (which rounds the activations to int8 per 32);
+// measured on gfx1201 / Qwen3.8-27B Q5_K_M: KLD 1.0..1.2x the one-bit f16 floor, pp2048 +26% (depth 0) / +15% (32K)
+// at -ub 2048.  Decode and speculative verify (<= 8 tokens) never reach it.
+bool ggml_cuda_lf_kq_blas_supported(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst);
+void ggml_cuda_lf_kq_blas_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+// K1 fp8 (or M4 in its blaslt mode): a matmul this path takes whose only reader is the next node, an ADD of the same shape (the residual): one GEMM,
+// beta 1, C = the ADD's other input, D = the ADD's output (false: not taken, run both nodes).  hipBLASLt adds C to the rounded
+// alpha * product, so D is the plain path's fl(product + C) bit for bit (tools/k1probe/k8beta: every gfx1201 fp8 candidate,
+// 384..2048 tokens).  FRANK_KQ_BLAS_ADD=0: off.
+bool ggml_cuda_lf_kq8_mul_mat_add(ggml_backend_cuda_context & ctx, ggml_tensor * mm, ggml_tensor * add);
+// The dense gate+up fusions (GLU and the mmq pair) stand down for the matmuls this path will take.
+bool ggml_cuda_lf_kq_blas_will_take(const ggml_tensor * mm);
+// Called at every graph start: the f16 input conversions shared by matmuls of one graph expire.
+void ggml_cuda_lf_kq_blas_graph_begin(const ggml_cgraph * cgraph);
+// Startup warm-up hooks, exported as ggml_backend_lf_kq_blas_wants_warmup / ggml_backend_lf_kq_blas_algos /
+// ggml_backend_lf_kq_blas_fp8_shapes.
+bool         ggml_cuda_lf_kq_blas_wants_warmup();
+const char * ggml_cuda_lf_kq_blas_algos_string();
+int          ggml_cuda_lf_kq_blas_fp8_shapes();
+
+// K1 v2: FRANK_KQ_BLAS=fp8 (lossy) rounds the quantized weight to fp8 e4m3 per row (row amax / 448, cached per tensor) and the
+// activations to fp8 with one scale per batch, then multiplies with hipBLASLt's fp8 GEMM (algorithm: the built-in gfx1201 fp8
+// priority list).  v3.2: after a weight's first use (which takes the row scales) its super-block types go straight from the quant
+// blocks to fp8 in one kernel, the same bytes as through f16 without the f16 copy in memory.  The fp8 GEMM is shared with M4
+// (MXFP4 weights, lf-mxfp4.cu):
+//   y[M][T] = av[m] * sx * (w8[m] . xq[t]), w8 fp8 [M][K] row-major, the fp8 activations converted from src1 once per input and graph
+bool ggml_cuda_lf_fp8_gemm_ready(int M, int T, int K);
+void ggml_cuda_lf_fp8_gemm(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const float * av, const uint8_t * w8, float * y,
+                           int M, int T, int K, const float * c = nullptr);
+
+// v3.3: the channel amax of the KEEP path folded into the kernel that writes the activation (a GLU, a gated unary fused with
+// its MUL, or an RMS_NORM fused with its MUL), instead of a pass of its own over the activation.  ggml_cuda_try_fuse calls ggml_cuda_lf_kq8_amax_mark for every
+// node: when node i (or node i + 1, the MUL of a UNARY + MUL pair) produces the activation of a matmul this path takes, the pair
+// is remembered for the stream.  The producer's launcher then asks ggml_cuda_lf_kq8_amax_take for the zeroed channel amax
+// buffer and the matmul's row length (a whole number of the producer's rows; nullptr: nothing to fold, run the plain kernel)
+// and folds atomicMax(|value| bits) per channel into it; the matmul skips its own amax pass.  A maximum does not depend on
+// the order: the same bits as without.
+void           ggml_cuda_lf_kq8_amax_mark(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
+unsigned int * ggml_cuda_lf_kq8_amax_take(ggml_backend_cuda_context & ctx, const ggml_tensor * producer, int64_t * row_len);
+
+// BigOne 6d step 2: with fixed KEEP (FRANK_KQ_BLAS_FIXED) calibrated for the matmul a producer feeds, the producer writes
+// the fp8 activations itself, next to its f32 output: element (t, c) of the matmul's T x K input -> xq[t*Kp + c] = fp8 of the
+// clamped value * 448 / (amax * margin), and for a kept channel (slot j = pos[c] - 1) the residual at K + j and the fp8 value at
+// K + k + j -- the bytes lf_kq8_quant_act_keep<true> writes from the f32 output; block (0, 0) thread 0 writes sx.  The matmul
+// then finds its activations ready.  Call before ggml_cuda_lf_kq8_amax_take (false: run that path).
+// FRANK_KQ_BLAS_FIXED_PRODUCER=0: off (the matmul quantizes the f32 output, the same bytes).  Step 4 (FRANK_KQ_BLAS_FIXED_NOF32=0: off):
+// when the graph shows that every reader of the output is such a K1 matmul, with no other K1 input between them, the
+// producer skips the f32 output (skip_f32).
+struct ggml_cuda_lf_kq8_fp8_dst {
+    uint8_t * xq; float * sx; const unsigned int * gbits; float margin; const uint8_t * pos; int k; int K; int Kp;
+    bool skip_f32;   // step 4: only K1 matmuls sharing these fp8 activations read the output -- its f32 copy is not written
+};
+bool ggml_cuda_lf_kq8_fp8_take(ggml_backend_cuda_context & ctx, const ggml_tensor * producer, ggml_cuda_lf_kq8_fp8_dst * d);
+// whether ggml_cuda_lf_kq8_fp8_take would hand the activations over now, without taking anything (a fusion that must run another
+// node first -- a K1 matmul, which uses the stream's activation buffer -- asks this, runs that node, then takes)
+bool ggml_cuda_lf_kq8_fp8_ready(ggml_backend_cuda_context & ctx, const ggml_tensor * producer, bool * skip_f32 = nullptr);
+// the producer's element v of channel c (pos_c = pos[c]) in row `out` (= xq + t*Kp): the bytes of lf_kq8_quant_act_keep<true>
+static __device__ __forceinline__ void ggml_cuda_lf_kq8_fp8_put(const float v, const float inv, const int c, const unsigned int pos_c,
+        uint8_t * out, const int K, const int k) {
+#if defined(RDNA4)
+    const int q = __builtin_amdgcn_cvt_pk_fp8_f32(fminf(fmaxf(v * inv, -448.f), 448.f), 0.f, 0, false);
+    out[c] = (uint8_t) (q & 0xff);
+    if (pos_c != 0u) {
+        const float r = fmaf(v, inv, -__builtin_amdgcn_cvt_f32_fp8(q, 0));
+        out[K + pos_c - 1]     = (uint8_t) (__builtin_amdgcn_cvt_pk_fp8_f32(fminf(fmaxf(r, -448.f), 448.f), 0.f, 0, false) & 0xff);
+        out[K + k + pos_c - 1] = (uint8_t) (q & 0xff);
+    }
+#else
+    GGML_UNUSED_VARS(v, inv, c, pos_c, out, K, k);
+#endif
+}
+
+// BigOne 6g, GLU16 (default off; FRANK_KQ_BLAS_GLU16=f16 or 1: on; lossy, one more rounding of the gate and the up, within
+// K1's own error; it pays only with 6d's producers -- without them the GLU writes f32 and copies the gate apart first): a K1 fp8
+// matmul whose only reader is a split GLU (gate / up) has hipBLASLt write its product as 16-bit floats into the first half of
+// its f32 output, and the GLU reads 16 bits.  ggml_cuda_try_fuse calls ggml_cuda_lf_kq8_glu16_window for every node: it marks
+// such a matmul and returns 1 (do not fuse) from it up to its GLU, so the GLU's own launcher reads the products; that launcher
+// asks ggml_cuda_lf_kq8_glu16_take for each input (GGML_TYPE_F16: 16-bit, the entry is consumed; 0: f32).
+int ggml_cuda_lf_kq8_glu16_window(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
+int ggml_cuda_lf_kq8_glu16_take(ggml_backend_cuda_context & ctx, const ggml_tensor * t);
diff --git a/ggml/src/ggml-cuda/lf-mxfp4.cu b/ggml/src/ggml-cuda/lf-mxfp4.cu
new file mode 100644
index 000000000..6b86b08a5
--- /dev/null
+++ b/ggml/src/ggml-cuda/lf-mxfp4.cu
@@ -0,0 +1,795 @@
+#include "lf-mxfp4.cuh"
+#include "lf-kq-blas.cuh"
+#include "convert.cuh"
+
+#ifndef LF_MX_ABL
+#define LF_MX_ABL 0 // diagnostic ablations of the fp8 GEMM (0 = normal)
+#endif
+
+#include <cstring>
+#include <mutex>
+#include <tuple>
+#include <map>
+#include <vector>
+#include <algorithm>
+#include <atomic>
+
+#if defined(FRANK_HIPBLASLT)
+#include <hipblaslt/hipblaslt.h>
+#include <hipblaslt/hipblaslt-ext.hpp>
+#endif // defined(FRANK_HIPBLASLT)
+
+// Layout notes (gfx12 WMMA 16x16x16, wave32): operand lane l holds row l%16, k = (l/16)*8 .. +7; result element
+// (v, lane) is row v + 8*(lane/16), column lane%16.  The WMMA computes D = X * W^T (A operand = activations), so the
+// result columns are weight rows and the stores to dst (row = token, contiguous in the weight row) coalesce.
+
+namespace {
+
+constexpr int LF_QK   = 32;  // MXFP4 block
+constexpr int LF_BS   = 17;  // sizeof(block_mxfp4): e8m0 scale + 16 bytes of nibbles
+constexpr int LF_BK8  = 64;  // fp8: k per stage
+constexpr int LF_LDS8 = LF_BK8 + 8;
+constexpr int LF_BK16 = 32;  // f16: k per stage (64 bytes per row, like the fp8 kernel)
+constexpr int LF_LDS16 = LF_BK16 * 2 + 16;
+// per-row power-of-two shift = emax - LF_SHIFT_*: fp8 puts the row's largest block at 12 * 2^5 = 384 <= 448,
+// f16 at 12 * 2^12 = 49152 <= 65504
+constexpr int LF_SHIFT8  = 133;
+constexpr int LF_SHIFT16 = 140;
+
+int lf_mode() { // 0 off, 1 fp8, 2 f16, 3 blaslt (MXFP4 -> fp8 copy + hipBLASLt fp8 GEMM); unset: blaslt (FRANK_ALL=0: off)
+    static const int mode = [] {
+        const char * s = getenv("FRANK_MXFP4_DIRECT");
+        if (s == nullptr) {
+            const char * a = getenv("FRANK_ALL");
+            if (a != nullptr && a[0] == '0' && a[1] == '\0') return 0;
+#if defined(FRANK_HIPBLASLT)
+            return 3;
+#else
+            return 0;
+#endif // defined(FRANK_HIPBLASLT)
+        }
+        if (strcmp(s, "0") == 0) return 0;
+        if (strcmp(s, "fp8") == 0) return 1;
+        if (strcmp(s, "f16") == 0) return 2;
+#if defined(FRANK_HIPBLASLT)
+        if (strcmp(s, "blaslt") == 0) return 3;
+#endif // defined(FRANK_HIPBLASLT)
+        GGML_LOG_WARN("FRANK_MXFP4_DIRECT=%s not recognized (fp8 | f16 | blaslt), direct path off\n", s);
+        return 0;
+    }();
+    return mode;
+}
+int lf_min_t() { static const int t = getenv("FRANK_MXFP4_MIN_T") ? atoi(getenv("FRANK_MXFP4_MIN_T")) : 64; return t; }
+int lf_log()   { static const int l = getenv("FRANK_MXFP4_LOG")   ? atoi(getenv("FRANK_MXFP4_LOG"))   : 0;  return l; }
+
+typedef int      lf_v2i __attribute__((ext_vector_type(2)));
+typedef float    lf_v8f __attribute__((ext_vector_type(8)));
+typedef _Float16 lf_v8h __attribute__((ext_vector_type(8)));
+
+// ------------------------------------------------------------------------------------------------ device helpers
+#if defined(RDNA4)
+// one block_mxfp4 at byte offset o of a 4-byte aligned base: aligned dword loads, then byte-shifted into place
+static __device__ __forceinline__ void lf_load_block(const uint8_t * __restrict__ base, const size_t o, int & e, uint4 & qs) {
+    const uint32_t * p = (const uint32_t *) (base + (o & ~(size_t) 3));
+    const int s = (int) (o & 3);
+    uint32_t d[5];
+#pragma unroll
+    for (int i = 0; i < 5; ++i) d[i] = p[i];
+    e = (int) ((d[0] >> (8 * s)) & 0xFF);
+    const int sh = 8 * (s + 1); // 8..32
+    uint32_t q[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) q[j] = (uint32_t) ((((uint64_t) d[j + 1] << 32) | d[j]) >> sh);
+    qs = make_uint4(q[0], q[1], q[2], q[3]);
+}
+
+// fp8 e4m3 table for one block: entry i = fp8(|kvalues_mxfp4[i]| * 2^delta); entries 0..3 -> t_lo, 4..7 -> t_hi
+static __device__ __forceinline__ void lf_table_fp8(const int delta, int & t_lo, int & t_hi) {
+    const float s = __builtin_ldexpf(1.0f, delta);
+    t_lo = __builtin_amdgcn_cvt_pk_fp8_f32(0.f,      1.f * s, 0,    false);
+    t_lo = __builtin_amdgcn_cvt_pk_fp8_f32(2.f * s,  3.f * s, t_lo, true);
+    t_hi = __builtin_amdgcn_cvt_pk_fp8_f32(4.f * s,  6.f * s, 0,    false);
+    t_hi = __builtin_amdgcn_cvt_pk_fp8_f32(8.f * s, 12.f * s, t_hi, true);
+}
+
+// f16 table: a normal f16 of kv * 2^delta has a zero low byte (kv has <= 2 mantissa bits), so only the high bytes
+static __device__ __forceinline__ void lf_table_f16(const int delta, int & t_lo, int & t_hi) {
+    const float s = __builtin_ldexpf(1.0f, delta);
+    const uint32_t d0 = __builtin_bit_cast(uint32_t, __builtin_amdgcn_cvt_pkrtz(0.f,     1.f * s));
+    const uint32_t d1 = __builtin_bit_cast(uint32_t, __builtin_amdgcn_cvt_pkrtz(2.f * s, 3.f * s));
+    const uint32_t d2 = __builtin_bit_cast(uint32_t, __builtin_amdgcn_cvt_pkrtz(4.f * s, 6.f * s));
+    const uint32_t d3 = __builtin_bit_cast(uint32_t, __builtin_amdgcn_cvt_pkrtz(8.f * s, 12.f * s));
+    t_lo = (int) __builtin_amdgcn_perm(d1, d0, 0x07050301u);
+    t_hi = (int) __builtin_amdgcn_perm(d3, d2, 0x07050301u);
+}
+
+// 4 nibbles (low nibble of each byte; bit 3 = sign) -> 4 table bytes with the sign in bit 7
+static __device__ __forceinline__ uint32_t lf_lookup4(const int nib, const int t_lo, const int t_hi) {
+    const int sel  = nib & 0x07070707;
+    const int sign = (nib & 0x08080808) << 4;
+    return __builtin_amdgcn_perm((uint32_t) t_hi, (uint32_t) t_lo, (uint32_t) sel) | (uint32_t) sign;
+}
+#endif // defined(RDNA4)
+
+// ------------------------------------------------------------------------------------------------ kernels
+__global__ void lf_row_emax(const uint8_t * __restrict__ w, const size_t nb01, const int nblk,
+        uint8_t * __restrict__ emax, unsigned int * __restrict__ lost) {
+    const uint8_t * r = w + blockIdx.x * nb01;
+    int m = 0;
+    for (int b = threadIdx.x; b < nblk; b += blockDim.x) m = max(m, (int) r[(size_t) b * LF_BS]);
+    __shared__ int red[256];
+    red[threadIdx.x] = m;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] = max(red[threadIdx.x], red[threadIdx.x + s]);
+        __syncthreads();
+    }
+    m = red[0];
+    if (threadIdx.x == 0) emax[blockIdx.x] = (uint8_t) m;
+    if (lost == nullptr) return;
+    // blocks whose smallest nonzero magnitude falls below the exact range (fp8: delta < -9, f16: delta < -14)
+    unsigned int l8 = 0, l16 = 0;
+    for (int b = threadIdx.x; b < nblk; b += blockDim.x) {
+        const int E = r[(size_t) b * LF_BS];
+        l8  += E - m + (LF_SHIFT8  - 128) < -9;
+        l16 += E - m + (LF_SHIFT16 - 128) < -14;
+    }
+    if (l8)  atomicAdd(&lost[0], l8);
+    if (l16) atomicAdd(&lost[1], l16);
+}
+
+__global__ void lf_quant_act_fp8(const float * __restrict__ x, uint8_t * __restrict__ xq, float * __restrict__ xs, const int K) {
+#if defined(RDNA4)
+    const int n = blockIdx.x;
+    const float * row = x + (size_t) n * K;
+    float amax = 0.f;
+    for (int k = threadIdx.x; k < K; k += blockDim.x) amax = fmaxf(amax, fabsf(row[k]));
+    __shared__ float red[256];
+    red[threadIdx.x] = amax;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] = fmaxf(red[threadIdx.x], red[threadIdx.x + s]);
+        __syncthreads();
+    }
+    amax = red[0];
+    const float scale = amax > 0.f ? amax / 448.f : 1.f;
+    const float inv   = amax > 0.f ? 448.f / amax : 0.f;
+    for (int k = 4 * threadIdx.x; k < K; k += 4 * blockDim.x) {
+        const float4 v = *(const float4 *) (row + k);
+        int w = __builtin_amdgcn_cvt_pk_fp8_f32(v.x * inv, v.y * inv, 0, false);
+        w     = __builtin_amdgcn_cvt_pk_fp8_f32(v.z * inv, v.w * inv, w, true);
+        *(int *) (xq + (size_t) n * K + k) = w;
+    }
+    if (threadIdx.x == 0) xs[n] = scale;
+#else
+    GGML_UNUSED_VARS(x, xq, xs, K);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// f16 with one power-of-two scale per token (amax / scale < 2^15): exact scaling, f16 rounding only
+__global__ void lf_quant_act_f16(const float * __restrict__ x, _Float16 * __restrict__ xh, float * __restrict__ xs, const int K) {
+    const int n = blockIdx.x;
+    const float * row = x + (size_t) n * K;
+    float amax = 0.f;
+    for (int k = threadIdx.x; k < K; k += blockDim.x) amax = fmaxf(amax, fabsf(row[k]));
+    __shared__ float red[256];
+    red[threadIdx.x] = amax;
+    __syncthreads();
+    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] = fmaxf(red[threadIdx.x], red[threadIdx.x + s]);
+        __syncthreads();
+    }
+    amax = red[0];
+    int e = 0;
+    frexpf(amax, &e); // amax < 2^e
+    const float scale = amax > 0.f ? ldexpf(1.f, e - 15) : 1.f;
+    const float inv   = amax > 0.f ? ldexpf(1.f, 15 - e) : 0.f;
+    for (int k = 2 * threadIdx.x; k < K; k += 2 * blockDim.x) {
+        const float2 v = *(const float2 *) (row + k);
+        xh[(size_t) n * K + k + 0] = (_Float16) (v.x * inv);
+        xh[(size_t) n * K + k + 1] = (_Float16) (v.y * inv);
+    }
+    if (threadIdx.x == 0) xs[n] = scale;
+}
+
+// Y[n][m] = xs[n] * 2^shift[m] * sum_k Wfp8[m][k] * Xfp8[n][k].  Block = WM x WN waves, each TM x TN 16x16 tiles.
+template <int WM, int WN, int TM, int TN, int BK = 64>
+__global__ void __launch_bounds__(WM * WN * 32, 1) lf_gemm_fp8(
+        const uint8_t * __restrict__ w, const size_t nb01, const uint8_t * __restrict__ emax,
+        const uint8_t * __restrict__ xq, const float * __restrict__ xs, float * __restrict__ y,
+        const int M, const int N, const int K, const int nst_per) {
+#if defined(RDNA4)
+    constexpr int NT    = WM * WN * 32;
+    constexpr int LDSS  = BK + 8;       // LDS bytes per row
+    constexpr int BMt   = WM * TM * 16, BNt = WN * TN * 16;
+    constexpr int A_BLK = BMt * (BK / LF_QK);
+    constexpr int A_PER = (A_BLK + NT - 1) / NT;
+    constexpr int B_CH  = BNt * (BK / 16);
+    constexpr int B_PER = (B_CH + NT - 1) / NT;
+    __shared__ __attribute__((aligned(16))) uint8_t As[2][BMt * LDSS];
+    __shared__ __attribute__((aligned(16))) uint8_t Bs[2][BNt * LDSS];
+    const int tid = threadIdx.x, lane = tid % 32, wave = tid / 32;
+    // blockIdx.x walks the token (N) tiles: the blocks sharing a weight tile run together, so the weights stream from
+    // DRAM once and the other N tiles hit L2
+    const int m0 = blockIdx.y * BMt, n0 = blockIdx.x * BNt;
+    const int wave_m = wave % WM, wave_n = wave / WM;
+
+    int ra_off[A_PER]; size_t ra_base[A_PER];   // per-thread weight rows are fixed across stages
+#pragma unroll
+    for (int i = 0; i < A_PER; ++i) {
+        const int c = tid + i * NT, r = min(m0 + c / (BK / LF_QK), M - 1);
+        ra_base[i] = (size_t) r * nb01 + (size_t) (c % (BK / LF_QK)) * LF_BS;
+        ra_off[i]  = (LF_SHIFT8 - 128) - (int) emax[r];
+    }
+
+    uint4 qa[A_PER]; int ea[A_PER]; uint4 xb[B_PER];
+    auto gloadA = [&](const int kb) {
+#pragma unroll
+        for (int i = 0; i < A_PER; ++i) {
+            if (A_BLK % NT == 0 || tid + i * NT < A_BLK) {
+#if LF_MX_ABL == 2 // diagnostic: no weight loads
+                qa[i] = make_uint4(ra_base[i] + kb, 0x12345678u, 0x9abcdef0u, (unsigned) kb); ea[i] = (int) (ra_base[i] & 7);
+#else
+                lf_load_block(w, ra_base[i] + (size_t) kb * (BK / LF_QK) * LF_BS, ea[i], qa[i]);
+#endif
+                ea[i] += ra_off[i];
+            }
+        }
+    };
+    auto gloadB = [&](const int kb, uint4 * dst) {
+#pragma unroll
+        for (int i = 0; i < B_PER; ++i) {
+            const int c = tid + i * NT;
+            if (B_CH % NT == 0 || c < B_CH) {
+                const int r = min(n0 + c / (BK / 16), N - 1), o = c % (BK / 16);
+#if LF_MX_ABL == 3 // diagnostic: no activation loads
+                dst[i] = make_uint4(r, o, kb, 0x38383838u);
+#else
+                dst[i] = *(const uint4 *) (xq + (size_t) r * K + kb * BK + o * 16);
+#endif
+            }
+        }
+    };
+    auto lstoreA = [&](const int buf) {
+#pragma unroll
+        for (int i = 0; i < A_PER; ++i) {
+            const int c = tid + i * NT;
+            if (A_BLK % NT == 0 || c < A_BLK) {
+                const int r = c / (BK / LF_QK), b = c % (BK / LF_QK);
+#if LF_MX_ABL == 1 // diagnostic: no conversion (raw bits)
+                const uint4 lo = qa[i], hi = make_uint4(qa[i].x ^ ea[i], qa[i].y, qa[i].z, qa[i].w);
+#else
+                int t_lo, t_hi;
+                lf_table_fp8(ea[i], t_lo, t_hi);
+                const int q[4] = {(int) qa[i].x, (int) qa[i].y, (int) qa[i].z, (int) qa[i].w};
+                uint4 lo, hi;
+                lo.x = lf_lookup4(q[0], t_lo, t_hi); hi.x = lf_lookup4(q[0] >> 4, t_lo, t_hi);
+                lo.y = lf_lookup4(q[1], t_lo, t_hi); hi.y = lf_lookup4(q[1] >> 4, t_lo, t_hi);
+                lo.z = lf_lookup4(q[2], t_lo, t_hi); hi.z = lf_lookup4(q[2] >> 4, t_lo, t_hi);
+                lo.w = lf_lookup4(q[3], t_lo, t_hi); hi.w = lf_lookup4(q[3] >> 4, t_lo, t_hi);
+#endif
+                uint8_t * pa = &As[buf][r * LDSS + b * LF_QK];
+                *(uint4 *) pa        = lo;
+                *(uint4 *) (pa + 16) = hi;
+            }
+        }
+    };
+    auto lstoreB = [&](const int buf, const uint4 * src) {
+#pragma unroll
+        for (int i = 0; i < B_PER; ++i) {
+            const int c = tid + i * NT;
+            if (B_CH % NT == 0 || c < B_CH) {
+                const int r = c / (BK / 16), o = c % (BK / 16);
+                *(uint4 *) &Bs[buf][r * LDSS + o * 16] = src[i];
+            }
+        }
+    };
+
+    lf_v8f acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j) acc[i][j] = lf_v8f{0, 0, 0, 0, 0, 0, 0, 0};
+
+    // split-K: blockIdx.z takes stages [s0, s0 + nst) and writes its own output slice (summed by lf_splitk_reduce)
+    const int s0  = blockIdx.z * nst_per;
+    const int nst = min(K / BK - s0, nst_per);
+    y += (size_t) blockIdx.z * N * M;
+    // activations are loaded two stages ahead (xb holds stage s+1 while stage s+2 is in flight), so storing them never
+    // waits on a load issued in the same round
+    gloadA(s0);
+    gloadB(s0, xb);
+    lstoreA(0);
+    lstoreB(0, xb);
+    gloadB(s0 + min(1, nst - 1), xb);
+    __syncthreads();
+    for (int s = 0; s < nst; ++s) {
+        const int buf = s & 1;
+        // unconditional prefetch (the last round reloads its own stage into the unused buffer): a conditional load
+        // makes the compiler wait for it early
+        gloadA(s0 + min(s + 1, nst - 1));
+        uint4 xn[B_PER];
+        gloadB(s0 + min(s + 2, nst - 1), xn);
+#pragma unroll
+        for (int ks = 0; ks < BK / 16; ++ks) {
+            const int kk = ks * 16 + (lane / 16) * 8;
+            lf_v2i a[TM], b[TN];
+#pragma unroll
+            for (int tm = 0; tm < TM; ++tm) a[tm] = *(const lf_v2i *) &As[buf][(wave_m * TM * 16 + tm * 16 + lane % 16) * LDSS + kk];
+#pragma unroll
+            for (int tn = 0; tn < TN; ++tn) b[tn] = *(const lf_v2i *) &Bs[buf][(wave_n * TN * 16 + tn * 16 + lane % 16) * LDSS + kk];
+#pragma unroll
+            for (int tm = 0; tm < TM; ++tm)
+#pragma unroll
+                for (int tn = 0; tn < TN; ++tn)
+#if LF_MX_ABL == 5 // diagnostic: no WMMA
+                    acc[tm][tn][0] += (float) (a[tm].x ^ b[tn].y);
+#else
+                    acc[tm][tn] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(b[tn], a[tm], acc[tm][tn]);
+#endif
+        }
+        // keep the next stage's LDS stores (and their global-load waits) after the compute: a compiler memory barrier
+        // stops the IR passes, sched_barrier the machine scheduler
+        asm volatile("" ::: "memory");
+        __builtin_amdgcn_sched_barrier(0);
+        lstoreA(buf ^ 1);
+        lstoreB(buf ^ 1, xb);
+#pragma unroll
+        for (int i = 0; i < B_PER; ++i) xb[i] = xn[i];
+#if LF_MX_ABL != 4 // diagnostic: 4 = no barrier in the loop
+        __syncthreads();
+#endif
+    }
+#pragma unroll
+    for (int tm = 0; tm < TM; ++tm) {
+        const int m = m0 + wave_m * TM * 16 + tm * 16 + lane % 16;
+        if (m >= M) continue;
+        const float rs = ldexpf(1.f, (int) emax[m] - LF_SHIFT8);
+#pragma unroll
+        for (int tn = 0; tn < TN; ++tn)
+#pragma unroll
+            for (int v = 0; v < 8; ++v) {
+                const int n = n0 + wave_n * TN * 16 + tn * 16 + v + 8 * (lane / 16);
+                if (n < N) y[(size_t) n * M + m] = acc[tm][tn][v] * xs[n] * rs;
+            }
+    }
+#else
+    GGML_UNUSED_VARS(w, nb01, emax, xq, xs, y, M, N, K, nst_per);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// sum of the split-K output slices, in a fixed order (deterministic)
+__global__ void lf_splitk_reduce(const float * __restrict__ part, float * __restrict__ y, const size_t n4, const int ks) {
+    const size_t i = (size_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n4) return;
+    float4 a = ((const float4 *) part)[i];
+    for (int z = 1; z < ks; ++z) {
+        const float4 b = ((const float4 *) part)[(size_t) z * n4 + i];
+        a.x += b.x; a.y += b.y; a.z += b.z; a.w += b.w;
+    }
+    ((float4 *) y)[i] = a;
+}
+
+// f16 variant: MXFP4 -> f16 (exact for normal-range blocks), f16 activations, one MXFP4 block per row per stage
+template <int WM, int WN, int TM, int TN>
+__global__ void __launch_bounds__(WM * WN * 32, 1) lf_gemm_f16(
+        const uint8_t * __restrict__ w, const size_t nb01, const uint8_t * __restrict__ emax,
+        const _Float16 * __restrict__ xh, const float * __restrict__ xs, float * __restrict__ y,
+        const int M, const int N, const int K) {
+#if defined(RDNA4)
+    constexpr int NT    = WM * WN * 32;
+    constexpr int BMt   = WM * TM * 16, BNt = WN * TN * 16;
+    constexpr int ROWB  = LF_BK16 * 2;
+    constexpr int A_BLK = BMt * (LF_BK16 / LF_QK);
+    constexpr int A_PER = (A_BLK + NT - 1) / NT;
+    constexpr int B_CH  = BNt * (ROWB / 16);
+    constexpr int B_PER = (B_CH + NT - 1) / NT;
+    __shared__ __attribute__((aligned(16))) uint8_t As[2][BMt * LF_LDS16];
+    __shared__ __attribute__((aligned(16))) uint8_t Bs[2][BNt * LF_LDS16];
+    const int tid = threadIdx.x, lane = tid % 32, wave = tid / 32;
+    const int m0 = blockIdx.x * BMt, n0 = blockIdx.y * BNt;
+    const int wave_m = wave % WM, wave_n = wave / WM;
+    const uint8_t * xhb = (const uint8_t *) xh;
+
+    int ra_off[A_PER]; size_t ra_base[A_PER];
+#pragma unroll
+    for (int i = 0; i < A_PER; ++i) {
+        const int c = tid + i * NT, r = min(m0 + c / (LF_BK16 / LF_QK), M - 1);
+        ra_base[i] = (size_t) r * nb01 + (size_t) (c % (LF_BK16 / LF_QK)) * LF_BS;
+        ra_off[i]  = (LF_SHIFT16 - 128) - (int) emax[r];
+    }
+
+    uint4 qa[A_PER]; int ea[A_PER]; uint4 xb[B_PER];
+    auto gload = [&](const int kb) {
+#pragma unroll
+        for (int i = 0; i < A_PER; ++i) {
+            if (A_BLK % NT == 0 || tid + i * NT < A_BLK) {
+                lf_load_block(w, ra_base[i] + (size_t) kb * (LF_BK16 / LF_QK) * LF_BS, ea[i], qa[i]);
+                ea[i] += ra_off[i];
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < B_PER; ++i) {
+            const int c = tid + i * NT;
+            if (B_CH % NT == 0 || c < B_CH) {
+                const int r = min(n0 + c / (ROWB / 16), N - 1), o = c % (ROWB / 16);
+                xb[i] = *(const uint4 *) (xhb + ((size_t) r * K + (size_t) kb * LF_BK16) * 2 + o * 16);
+            }
+        }
+    };
+    auto lstore = [&](const int buf) {
+#pragma unroll
+        for (int i = 0; i < A_PER; ++i) {
+            const int c = tid + i * NT;
+            if (A_BLK % NT == 0 || c < A_BLK) {
+                const int r = c / (LF_BK16 / LF_QK), b = c % (LF_BK16 / LF_QK);
+                int t_lo, t_hi;
+                lf_table_f16(ea[i], t_lo, t_hi);
+                const int q[4] = {(int) qa[i].x, (int) qa[i].y, (int) qa[i].z, (int) qa[i].w};
+                uint32_t lo[8], hi[8]; // elements 0..15 and 16..31 as f16 pairs (zero low bytes inserted)
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    const uint32_t hl = lf_lookup4(q[j], t_lo, t_hi), hh = lf_lookup4(q[j] >> 4, t_lo, t_hi);
+                    lo[2 * j] = __builtin_amdgcn_perm(0u, hl, 0x010C000Cu); lo[2 * j + 1] = __builtin_amdgcn_perm(0u, hl, 0x030C020Cu);
+                    hi[2 * j] = __builtin_amdgcn_perm(0u, hh, 0x010C000Cu); hi[2 * j + 1] = __builtin_amdgcn_perm(0u, hh, 0x030C020Cu);
+                }
+                uint8_t * pa = &As[buf][r * LF_LDS16 + b * 64];
+                *(uint4 *) (pa +  0) = make_uint4(lo[0], lo[1], lo[2], lo[3]);
+                *(uint4 *) (pa + 16) = make_uint4(lo[4], lo[5], lo[6], lo[7]);
+                *(uint4 *) (pa + 32) = make_uint4(hi[0], hi[1], hi[2], hi[3]);
+                *(uint4 *) (pa + 48) = make_uint4(hi[4], hi[5], hi[6], hi[7]);
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < B_PER; ++i) {
+            const int c = tid + i * NT;
+            if (B_CH % NT == 0 || c < B_CH) {
+                const int r = c / (ROWB / 16), o = c % (ROWB / 16);
+                *(uint4 *) &Bs[buf][r * LF_LDS16 + o * 16] = xb[i];
+            }
+        }
+    };
+
+    lf_v8f acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j) acc[i][j] = lf_v8f{0, 0, 0, 0, 0, 0, 0, 0};
+
+    const int nst = K / LF_BK16;
+    gload(0);
+    lstore(0);
+    __syncthreads();
+    for (int s = 0; s < nst; ++s) {
+        const int buf = s & 1;
+        if (s + 1 < nst) gload(s + 1);
+#pragma unroll
+        for (int ks = 0; ks < LF_BK16 / 16; ++ks) {
+            const int kb2 = (ks * 16 + (lane / 16) * 8) * 2;
+            lf_v8h a[TM], b[TN];
+#pragma unroll
+            for (int tm = 0; tm < TM; ++tm) a[tm] = *(const lf_v8h *) &As[buf][(wave_m * TM * 16 + tm * 16 + lane % 16) * LF_LDS16 + kb2];
+#pragma unroll
+            for (int tn = 0; tn < TN; ++tn) b[tn] = *(const lf_v8h *) &Bs[buf][(wave_n * TN * 16 + tn * 16 + lane % 16) * LF_LDS16 + kb2];
+#pragma unroll
+            for (int tm = 0; tm < TM; ++tm)
+#pragma unroll
+                for (int tn = 0; tn < TN; ++tn)
+                    acc[tm][tn] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(b[tn], a[tm], acc[tm][tn]);
+        }
+        if (s + 1 < nst) lstore(buf ^ 1);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int tm = 0; tm < TM; ++tm) {
+        const int m = m0 + wave_m * TM * 16 + tm * 16 + lane % 16;
+        if (m >= M) continue;
+        const float rs = ldexpf(1.f, (int) emax[m] - LF_SHIFT16);
+#pragma unroll
+        for (int tn = 0; tn < TN; ++tn)
+#pragma unroll
+            for (int v = 0; v < 8; ++v) {
+                const int n = n0 + wave_n * TN * 16 + tn * 16 + v + 8 * (lane / 16);
+                if (n < N) y[(size_t) n * M + m] = acc[tm][tn][v] * xs[n] * rs;
+            }
+    }
+#else
+    GGML_UNUSED_VARS(w, nb01, emax, xh, xs, y, M, N, K);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// fp8: 4x2 waves, 4x4 tiles (256 x 128); f16: 4x2 waves, 2x4 tiles (128 x 128) -- the prototype's best shapes
+constexpr int LF8_WM = 4, LF8_WN = 2, LF8_TM = 4, LF8_TN = 4;
+constexpr int LF16_WM = 4, LF16_WN = 2, LF16_TM = 2, LF16_TN = 4;
+
+// per weight tensor: the largest block exponent of each row (the per-row power-of-two shift), computed on first use
+struct lf_emax_cache {
+    std::mutex mutex;
+    std::map<std::tuple<const void *, int64_t, int64_t, int>, uint8_t *> rows;
+};
+lf_emax_cache & lf_cache() { static lf_emax_cache c; return c; }
+
+const uint8_t * lf_emax_lookup(const ggml_tensor * src0, const int device) {
+    lf_emax_cache & c = lf_cache();
+    std::lock_guard<std::mutex> lock(c.mutex);
+    auto it = c.rows.find({src0->data, src0->ne[0], src0->ne[1], device});
+    return it == c.rows.end() ? nullptr : it->second;
+}
+
+const uint8_t * lf_emax_get(ggml_backend_cuda_context & ctx, const ggml_tensor * src0) {
+    if (const uint8_t * p = lf_emax_lookup(src0, ctx.device)) return p;
+    const int64_t M = src0->ne[1];
+    const int nblk = (int) (src0->ne[0] / LF_QK);
+    uint8_t * emax = nullptr;
+    CUDA_CHECK(cudaMalloc(&emax, M));
+    unsigned int * lost = nullptr;
+    if (lf_log()) {
+        CUDA_CHECK(cudaMalloc(&lost, 2 * sizeof(unsigned int)));
+        CUDA_CHECK(cudaMemsetAsync(lost, 0, 2 * sizeof(unsigned int), ctx.stream()));
+    }
+    lf_row_emax<<<(unsigned) M, 256, 0, ctx.stream()>>>((const uint8_t *) src0->data, src0->nb[1], nblk, emax, lost);
+    CUDA_CHECK(cudaGetLastError());
+    if (lost) {
+        unsigned int h[2];
+        CUDA_CHECK(cudaMemcpyAsync(h, lost, sizeof(h), cudaMemcpyDeviceToHost, ctx.stream()));
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        CUDA_CHECK(cudaFree(lost));
+        const double tot = (double) M * nblk;
+        fprintf(stderr, "LF_MXFP4 %-28s M=%6lld K=%6lld  blocks below exact range: fp8 %u (%.4f%%)  f16 %u (%.4f%%)\n",
+            src0->name, (long long) M, (long long) src0->ne[0], h[0], 100.0 * h[0] / tot, h[1], 100.0 * h[1] / tot);
+    }
+    lf_emax_cache & c = lf_cache();
+    std::lock_guard<std::mutex> lock(c.mutex);
+    c.rows[{src0->data, src0->ne[0], src0->ne[1], ctx.device}] = emax;
+    return emax;
+}
+
+#if defined(FRANK_HIPBLASLT)
+// ------------------------------------------------------------------------------------------------ hipBLASLt path
+// The weight is copied to fp8 [M][K] with the same per-row power-of-two shift as the fp8 kernel (exact for blocks in
+// range); the shift goes into hipBLASLt's per-row alpha vector.  The activations get ONE scale for the whole batch
+// (hipBLASLt on gfx1201 has no per-column scale mode), passed as the device-side B scale.
+__global__ void lf_mxfp4_to_fp8_rows(const uint8_t * __restrict__ w, const size_t nb01, const int nblk,
+        const uint8_t * __restrict__ emax, uint8_t * __restrict__ w8, const int K) {
+#if defined(RDNA4)
+    const int row = blockIdx.x;
+    const int off = (LF_SHIFT8 - 128) - (int) emax[row];
+    for (int b = threadIdx.x; b < nblk; b += blockDim.x) {
+        int e; uint4 qs;
+        lf_load_block(w, (size_t) row * nb01 + (size_t) b * LF_BS, e, qs);
+        int t_lo, t_hi;
+        lf_table_fp8(e + off, t_lo, t_hi);
+        const int q[4] = {(int) qs.x, (int) qs.y, (int) qs.z, (int) qs.w};
+        uint4 lo, hi;
+        lo.x = lf_lookup4(q[0], t_lo, t_hi); hi.x = lf_lookup4(q[0] >> 4, t_lo, t_hi);
+        lo.y = lf_lookup4(q[1], t_lo, t_hi); hi.y = lf_lookup4(q[1] >> 4, t_lo, t_hi);
+        lo.z = lf_lookup4(q[2], t_lo, t_hi); hi.z = lf_lookup4(q[2] >> 4, t_lo, t_hi);
+        lo.w = lf_lookup4(q[3], t_lo, t_hi); hi.w = lf_lookup4(q[3] >> 4, t_lo, t_hi);
+        uint8_t * p = w8 + (size_t) row * K + (size_t) b * LF_QK;
+        *(uint4 *) p        = lo;
+        *(uint4 *) (p + 16) = hi;
+    }
+#else
+    GGML_UNUSED_VARS(w, nb01, nblk, emax, w8, K);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+// the same conversion with one thread per 32-value block over the whole matrix (the per-row launch above keeps only
+// 160 of 128 x 2 threads busy at K = 5120 and reaches ~230 GB/s); FRANK_MXFP4_CONV=row selects the old kernel
+__global__ void lf_mxfp4_to_fp8_flat(const uint8_t * __restrict__ w, const size_t nb01, const int nblk,
+        const uint8_t * __restrict__ emax, uint8_t * __restrict__ w8, const int K, const int64_t nall) {
+#if defined(RDNA4)
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= nall) return;
+    const int row = (int) (i / nblk), b = (int) (i - (int64_t) row * nblk);
+    const int off = (LF_SHIFT8 - 128) - (int) emax[row];
+    int e; uint4 qs;
+    lf_load_block(w, (size_t) row * nb01 + (size_t) b * LF_BS, e, qs);
+    int t_lo, t_hi;
+    lf_table_fp8(e + off, t_lo, t_hi);
+    const int q[4] = {(int) qs.x, (int) qs.y, (int) qs.z, (int) qs.w};
+    uint4 lo, hi;
+    lo.x = lf_lookup4(q[0], t_lo, t_hi); hi.x = lf_lookup4(q[0] >> 4, t_lo, t_hi);
+    lo.y = lf_lookup4(q[1], t_lo, t_hi); hi.y = lf_lookup4(q[1] >> 4, t_lo, t_hi);
+    lo.z = lf_lookup4(q[2], t_lo, t_hi); hi.z = lf_lookup4(q[2] >> 4, t_lo, t_hi);
+    lo.w = lf_lookup4(q[3], t_lo, t_hi); hi.w = lf_lookup4(q[3] >> 4, t_lo, t_hi);
+    uint8_t * p = w8 + (size_t) row * K + (size_t) b * LF_QK;
+    *(uint4 *) p        = lo;
+    *(uint4 *) (p + 16) = hi;
+#else
+    GGML_UNUSED_VARS(w, nb01, nblk, emax, w8, K, nall);
+    NO_DEVICE_CODE;
+#endif // defined(RDNA4)
+}
+
+__global__ void lf_alpha_vec(const uint8_t * __restrict__ emax, float * __restrict__ av, const int M) {
+    const int m = blockIdx.x * blockDim.x + threadIdx.x;
+    if (m < M) av[m] = ldexpf(1.f, (int) emax[m] - LF_SHIFT8);
+}
+
+// per MXFP4 weight tensor: hipBLASLt's per-row alpha vector (the power-of-two row shift)
+struct lf_m4_state {
+    std::mutex mutex;
+    std::map<std::tuple<const void *, int64_t, int64_t, int>, float *> avec;
+};
+lf_m4_state & lf_m4() { static lf_m4_state s; return s; }
+
+bool lf_blt_ready(const ggml_tensor * src0, const int device, const int M, const int N, const int K) {
+    {
+        lf_m4_state & st = lf_m4();
+        std::lock_guard<std::mutex> lock(st.mutex);
+        if (!st.avec.count({src0->data, src0->ne[0], src0->ne[1], device})) return false;
+    }
+    return ggml_cuda_lf_fp8_gemm_ready(M, N, K);
+}
+
+void lf_blt_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const uint8_t * emax,
+        const float * x, float * y, const int M, const int T, const int K, const float * c = nullptr) {
+    cudaStream_t stream = ctx.stream();
+    lf_m4_state & st = lf_m4();
+    std::lock_guard<std::mutex> lock(st.mutex);
+
+    const float * av = nullptr;
+    {
+        auto key = std::make_tuple((const void *) src0->data, src0->ne[0], src0->ne[1], ctx.device);
+        auto it = st.avec.find(key);
+        if (it == st.avec.end()) {
+            float * p = nullptr;
+            CUDA_CHECK(cudaMalloc(&p, (size_t) M * sizeof(float)));
+            lf_alpha_vec<<<(M + 255) / 256, 256, 0, stream>>>(emax, p, M);
+            it = st.avec.emplace(key, p).first;
+        }
+        av = it->second;
+    }
+
+    static const bool conv_row = getenv("FRANK_MXFP4_CONV") && strcmp(getenv("FRANK_MXFP4_CONV"), "row") == 0;
+    ggml_cuda_pool_alloc<uint8_t> w8(ctx.pool(), (size_t) M * K);
+    if (conv_row) {
+        lf_mxfp4_to_fp8_rows<<<M, 128, 0, stream>>>((const uint8_t *) src0->data, src0->nb[1], K / LF_QK, emax, w8.get(), K);
+    } else {
+        const int64_t nall = (int64_t) M * (K / LF_QK);
+        lf_mxfp4_to_fp8_flat<<<(unsigned) ((nall + 255) / 256), 256, 0, stream>>>((const uint8_t *) src0->data, src0->nb[1], K / LF_QK,
+                                                                                    emax, w8.get(), K, nall);
+    }
+    ggml_cuda_lf_fp8_gemm(ctx, src1, av, w8.get(), y, M, T, K, c);
+    GGML_UNUSED(x);
+}
+
+#endif // defined(FRANK_HIPBLASLT)
+
+} // namespace
+
+bool ggml_cuda_lf_mxfp4_will_take(const ggml_tensor * mm) {
+    if (lf_mode() == 0 || mm == nullptr || mm->op != GGML_OP_MUL_MAT) return false;
+    const ggml_tensor * src0 = mm->src[0], * src1 = mm->src[1];
+    if (src0->type != GGML_TYPE_MXFP4 || src1->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32) return false;
+    if (!GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ggml_cuda_get_device()].cc)) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src0->ne[0] % LF_BK8 != 0) return false;
+    const int64_t T = src1->ne[1] * src1->ne[2] * src1->ne[3];
+    return T >= lf_min_t() && T <= INT32_MAX / 8 && src0->ne[1] <= INT32_MAX / 8;
+}
+
+bool ggml_cuda_lf_mxfp4_supported(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (lf_mode() == 0) return false;
+    if (src0->type != GGML_TYPE_MXFP4 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (!GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ctx.device].cc)) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src0->nb[0] != LF_BS) return false;
+    if (!ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) return false;
+    if (src0->nb[1] % 4 != 0 || (uintptr_t) src0->data % 4 != 0) return false;
+    const int64_t K = src0->ne[0], M = src0->ne[1];
+    const int64_t T = src1->ne[1] * src1->ne[2] * src1->ne[3];
+    if (K % LF_BK8 != 0 || src1->ne[0] != K || dst->ne[0] != M || ggml_nrows(dst) != T) return false;
+    if (T < lf_min_t() || T > INT32_MAX / 8 || M > INT32_MAX / 8) return false;
+    bool first_use = lf_emax_lookup(src0, ctx.device) == nullptr;
+#if defined(FRANK_HIPBLASLT)
+    if (lf_mode() == 3 && !lf_blt_ready(src0, ctx.device, (int) M, (int) T, (int) K)) first_use = true;
+#endif // defined(FRANK_HIPBLASLT)
+    if (first_use) { // first use allocates / tunes: not while a CUDA graph is being captured
+#if defined(GGML_USE_HIP)
+        hipStreamCaptureStatus st = hipStreamCaptureStatusNone;
+        if (hipStreamIsCapturing(ctx.stream(), &st) != hipSuccess || st != hipStreamCaptureStatusNone) return false;
+#else
+        cudaStreamCaptureStatus st = cudaStreamCaptureStatusNone;
+        if (cudaStreamIsCapturing(ctx.stream(), &st) != cudaSuccess || st != cudaStreamCaptureStatusNone) return false;
+#endif // defined(GGML_USE_HIP)
+    }
+    return true;
+}
+
+void ggml_cuda_lf_mxfp4_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    cudaStream_t stream = ctx.stream();
+    const int K = (int) src0->ne[0], M = (int) src0->ne[1];
+    const int T = (int) (src1->ne[1] * src1->ne[2] * src1->ne[3]);
+    const uint8_t * emax = lf_emax_get(ctx, src0);
+    const uint8_t * w = (const uint8_t *) src0->data;
+    const float * x = (const float *) src1->data;
+    float * y = (float *) dst->data;
+#if defined(FRANK_HIPBLASLT)
+    if (lf_mode() == 3) {
+        lf_blt_mul_mat(ctx, src0, src1, emax, x, y, M, T, K);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+#endif // defined(FRANK_HIPBLASLT)
+    ggml_cuda_pool_alloc<float> xs(ctx.pool(), T);
+    if (lf_mode() == 1) {
+        ggml_cuda_pool_alloc<uint8_t> xq(ctx.pool(), (size_t) T * K);
+        lf_quant_act_fp8<<<T, 256, 0, stream>>>(x, xq.get(), xs.get(), K);
