+        }
+        const int64_t kc8 = fd.K, nr8 = ne / kc8;
+        const dim3 grid((unsigned) ((kc8 + CUDA_GLU_BLOCK_SIZE - 1) / CUDA_GLU_BLOCK_SIZE), (unsigned) ((nr8 + 63) / 64));
+        unary_gated_fp8_kernel<op, TI><<<grid, CUDA_GLU_BLOCK_SIZE, 0, stream>>>(x, g, d, nc, kc8, nr8, nc, nc, fd);
+        return true;
+    }
+    int64_t kc = 0;
+    if (unsigned int * cbits = ggml_cuda_lf_kq8_amax_take(ctx, dst, &kc)) {
+        apart();
+        unary_gated_chan_amax_cuda<op, TI>(x, g, d, nc, kc, ne / kc, nc, nc, cbits, stream);
+        return true;
+    }
+    return false;
+}
