diff --git a/ggml/src/ggml-cuda/gdn-chunked-wmma.cu b/ggml/src/ggml-cuda/gdn-chunked-wmma.cu
new file mode 100644
index 000000000..507302e8f
--- /dev/null
+++ b/ggml/src/ggml-cuda/gdn-chunked-wmma.cu
@@ -0,0 +1,870 @@
+// Chunked prefill for GGML_OP_GATED_DELTA_NET (scalar gate, S_k == S_v == 128) on RDNA4: bf16 WMMA operands, f32
+// accumulation, f32 state across chunks.
+//
+// Sources:
+//   - S. Yang, B. Wang, Y. Zhang, Y. Shen, Y. Kim, "Parallelizing Linear Transformers with the Delta Rule over Sequence
+//     Length", NeurIPS 2024, arXiv:2406.06484: the chunkwise delta rule in the WY / UT-transform form, where the new
+//     values of a chunk are one triangular solve, U = (I + strictly_lower(diag(beta) K K^T))^-1 (...).
+//   - S. Yang, J. Kautz, A. Hatamizadeh, "Gated Delta Networks: Improving Mamba2 with Delta Rule", ICLR 2025,
+//     arXiv:2412.06464: the gated chunkwise algorithm (the decay inside the chunk folded into the gram, the attention
+//     and the state update).
+//   - ggml-cuda/mma.cuh: the gfx12 bf16 WMMA tiles and mma().
+//
+// The recurrence of ggml_gated_delta_net (per head; S[i][j], i a key index, j a value index):
+//     S_t = e^{g_t} S_{t-1};   u_t = beta_t (v_t - S_t^T k_t);   S_t += k_t u_t^T;   o_t = scale S_t^T q_t
+// Over a chunk of C = 64 tokens with start state S, gam the chunk-local inclusive cumsum of g and Gam = e^gam:
+//     L[s][t] = beta_s e^{gam_s - gam_t} (k_s . k_t)   (t < s)        U solves (I + L) U = diag(beta) (V - diag(Gam) K S)
+//     P[r][s] = scale e^{gam_r - gam_s} (q_r . k_s)    (s <= r)        (U: the new values u_t of the chunk)
+//     O  = scale diag(Gam) Q S + P U
+//     S' = e^{gam_C} S + K^T diag(e^{gam_C - gam}) U
+// By 16-token blocks, with D_mb = (I + L_mb,mb)^-1:  U_mb = D_mb (beta R_mb - sum_{kb < mb} L_mb,kb U_kb),  R = V - Gam K S.
+//
+// Two kernels:
+//   gdn_wmma_prep (block per chunk, k head, sequence; fully parallel): the gram K K^T and Q K^T on WMMA once for the v heads
+//     of the k head (the Q operands straight from global, the K staged: 20 KiB of LDS); per v head the decay and beta
+//     applied per kept pair, written to a scratch block per (sequence, v head, chunk) in the scan's WMMA operand layout:
+//     -L for the six blocks below the diagonal, the four diagonal inverses D_mb (f32 forward substitution), P, gam (log2
+//     units) and beta.
+//   gdn_wmma_scan (block per 64 value columns of a v head and sequence, sequential over the chunks): the state of the
+//     block's columns stays in the WMMA accumulators (four waves of 16 columns; the value columns of the delta rule are
+//     independent, so the waves never exchange state).  Per chunk and wave, block by block of 16 tokens: X = K S (32 WMMA),
+//     R = V - Gam X, U by the block recurrence above (10), O = scale Gam (Q S) + P U (32 + 10), and S' = e^{gam_C} S +
+//     K^T W (32, with W = diag(e^{gam_C - gam}) U, and 32 more for the transposes of K).
+//
+// Decay: every exponent is a difference gam_a - gam_b with a later or equal token a, computed per element and only then
+// exponentiated (e^{gam_a} e^{-gam_b} is never formed).  With g <= 0 (ggml's gates are log-decays) every factor is
+// e^{<= 0} in [0, 1]: no overflow for any gate magnitude, and underflow to 0 is the exact limit.  The cumsum is kept in log2
+// units and exponentiated with v_exp_f32.  Padded tokens of a partial chunk read as k = v = 0, g = beta = 0, so gam stays
+// flat past the last token, their gram rows and columns are 0 and they add nothing to O or S' (their Q rows only reach P
+// rows of tokens that are not there).
+//
+// Data layout:
+//   - the scan's state tile kb of a wave: lane l holds S[16 kb + 8 (l / 16) + i][col], i < 8, col = the wave's column
+//     16 w + l % 16 -- the WMMA D layout of a (key x value) block.  Converted to bf16 it is the B operand of X = K S
+//     without any data movement; likewise the D layout of a (token x value) block is the B operand of the products that
+//     contract over tokens (L U, D C, P U, K^T W).  K^T comes from the K operand block times the identity on WMMA (exact):
+//     its D layout is the K^T operand.
+//   - K / Q chunks in LDS: bf16 rows of 128 keys (256 bytes), the 16-byte slots XOR-swizzled by swz() so that the operand
+//     reads (16 rows, one slot) hit distinct banks.
+//   - LDS of a scan block: K 16 KiB + Q 16 KiB + the prep block's operands 10 KiB = 42 KiB (gam through scalar loads, beta
+//     through vector loads: both as scalar loads overflow the scalar registers), so three blocks fit a WGP (LDS is
+//     allocated in 1 KiB steps) and the 96 blocks of a 48-head layer run in one round.
+//   - Loads: none behind a branch (the compiler waits for a guarded load before leaving its branch); the next chunk's prep
+//     block and V are loaded during the state update, the K / Q rows at the top of their chunk.  No register spills: a
+//     spill's reload waits for every load in flight (the load counter is in order).
+//
+// Inputs are rounded to bf16 as the prefill conv rounds its bf16 copies (+0x8000, upper half), so the f32 inputs and the
+// conv's bf16 rows (ggml_cuda_gdn_bf16_in) give the same results.
+
+#include "gdn-chunked-wmma.cuh"
+#include "gated_delta_net_chunked.cuh"   // ggml_cuda_kernel_launch_try
+#include "mma.cuh"
+
+#include <cstdint>
+#include <type_traits>
+
+namespace gdn_wmma {
+
+constexpr int CH   = 64;                  // chunk length
+constexpr int DK   = 128;                 // head size (S_k == S_v)
+constexpr int NB   = CH / 16;             // 16-token blocks of a chunk
+constexpr int NTRI = NB * (NB + 1) / 2;   // the lower 16x16 blocks of a chunk x chunk matrix (with the diagonal)
+constexpr int FRAG = 512;                 // a 16x16 bf16 operand fragment: 32 lanes x 16 bytes
+constexpr int ROWB = DK * 2;              // a bf16 row of 128 keys
+constexpr int MATB = CH * ROWB;           // a chunk of K or Q as bf16: 16 KiB
+
+constexpr int NOFF = NB * (NB - 1) / 2;   // the 16x16 blocks strictly below the diagonal
+
+// the block of one (sequence, v head, chunk) that the prep kernel writes and the scan reads
+constexpr int BLK_L = 0;                    // -L below the diagonal, operand fragments (NOFF)
+constexpr int BLK_D = NOFF * FRAG;          // the inverses of the diagonal blocks of I + L, operand fragments (NB)
+constexpr int BLK_P = (NOFF + NB) * FRAG;   // P, lower blocks, operand fragments (NTRI)
+constexpr int XB    = BLK_P + NTRI * FRAG;  // the part the scan stages into LDS: 10 KiB
+constexpr int BLK_G = XB;                   // gam2[CH] (the cumsum in log2 units), then beta[CH] (f32)
+constexpr int BLK   = BLK_G + 2 * CH * 4;   // 10752 bytes
+
+constexpr int SCAN_LDS = 2 * MATB + XB;     // K, Q, the prep block: 42 KiB (gam2: scalar loads, beta: vector loads)
+constexpr float LOG2E  = 1.4426950408889634f;
+constexpr int DSTR     = 17;              // f32 row stride of a 16x16 block in the prep's LDS
+constexpr int RMAX     = 8;               // v heads whose gates the prep keeps in LDS at a time
+// prep LDS: the K staging (later the diagonal blocks of L and their inverses, f32), then the gates
+constexpr int PREP_LDS = MATB + RMAX * 2 * CH * 4;
+static_assert(2 * NB * 16 * DSTR * 4 <= MATB, "the diagonal blocks alias the K staging");
+static_assert(SCAN_LDS <= 42 * 1024, "three scan blocks per WGP (LDS is allocated in 1 KiB steps)");
+static_assert(BLK % 16 == 0 && XB % 16 == 0, "16-byte copies");
+
+struct args {
+    const void  * q;
+    const void  * k;
+    const void  * v;
+    const float * g;
+    const float * beta;
+    const float * s0;
+    float       * dst;
+    float       * s_out;
+    uint8_t     * blk;
+    int64_t       sq1, sq2, sq3;   // q / k strides, in elements of the input type
+    int64_t       sv1, sv2, sv3;   // v strides
+    int64_t       sb1, sb2, sb3;   // g / beta strides (floats)
+    int64_t       n_tok_full;      // tokens per sequence in dst
+    int           H, H_k, rq3;
+    int           n_tok;           // tokens processed per sequence
+    int           n_chunks;
+    float         scale;
+};
+
+static __device__ __forceinline__ uint32_t f2bf(const float f) {
+    return (__float_as_uint(f) + 0x8000u) >> 16;
+}
+static __device__ __forceinline__ uint32_t pack2(const float lo, const float hi) {
+    return ((__float_as_uint(lo) + 0x8000u) >> 16) | ((__float_as_uint(hi) + 0x8000u) & 0xFFFF0000u);
+}
+
+// 2^x on the hardware exp (v_exp_f32): the decays are kept in log2 units (gam2 = gam log2(e)), so every factor is one
+// instruction; underflow to 0 for exponents below the f32 range is the exact limit
+static __device__ __forceinline__ float ex2(const float x) {
+    return __builtin_amdgcn_exp2f(x);
+}
+
+// a block barrier that orders LDS only (__syncthreads also waits for the block's outstanding global stores)
+static __device__ __forceinline__ void lds_barrier() {
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+}
+
+static __device__ __forceinline__ int swz(const int r) {
+    return (r & 7) ^ ((r & 8) >> 1);
+}
+// the 16-byte slot `slot` (keys 8 slot .. 8 slot + 7) of row r of a K / Q staging buffer is at byte
+// r * ROWB + ((slot ^ swz(r)) << 4)
+
+// the lower block index of block row hi, block column lo <= hi, and back
+static __device__ __forceinline__ int tri_index(const int hi, const int lo) {
+    return hi * (hi + 1) / 2 + lo;
+}
+// the index of block (hi, lo), lo < hi, among the blocks below the diagonal
+static __device__ __forceinline__ int off_index(const int hi, const int lo) {
+    return hi * (hi - 1) / 2 + lo;
+}
+static __device__ __forceinline__ void tri_rc(const int bi, int & hi, int & lo) {
+    hi = bi >= 6 ? 3 : (bi >= 3 ? 2 : (bi >= 1 ? 1 : 0));
+    lo = bi - hi * (hi + 1) / 2;
+}
+
+template <typename InT, bool VEC>
+static __device__ __forceinline__ uint4 ld8(const InT * p) {
+    if constexpr (std::is_same_v<InT, float>) {
+        float f[8];
+        if constexpr (VEC) {
+            const float4 x0 = ((const float4 *) p)[0];
+            const float4 x1 = ((const float4 *) p)[1];
+            f[0] = x0.x; f[1] = x0.y; f[2] = x0.z; f[3] = x0.w;
+            f[4] = x1.x; f[5] = x1.y; f[6] = x1.z; f[7] = x1.w;
+        } else {
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                f[e] = p[e];
+            }
+        }
+        return make_uint4(pack2(f[0], f[1]), pack2(f[2], f[3]), pack2(f[4], f[5]), pack2(f[6], f[7]));
+    } else {
+        if constexpr (VEC) {
+            return *(const uint4 *) p;
+        }
+        uint32_t u[4];
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            u[e] = (uint32_t) p[2*e] | ((uint32_t) p[2*e + 1] << 16);
+        }
+        return make_uint4(u[0], u[1], u[2], u[3]);
+    }
+}
+
+// lane parts of the K / Q staging: thread tid copies slot tid % 16 of the rows tid / 16 + 8 j, j < 8
+struct stage_offs {
+    uint32_t g;      // byte offset of row tid / 16, slot tid % 16 from the chunk's first row
+    int      s[2];   // LDS byte offsets for even / odd j (j * 8 * ROWB added)
+};
+template <typename InT>
+static __device__ __forceinline__ stage_offs make_stage_offs(const int64_t sq2) {
+    const int r = threadIdx.x >> 4, slot = threadIdx.x & 15;   // r < 8: swz(r + 8 j) = r ^ 4 (j & 1)
+    stage_offs o;
+    o.g    = (uint32_t) ((r * sq2 + slot * 8) * (int64_t) sizeof(InT));
+    o.s[0] = r * ROWB + ((slot ^ r) << 4);
+    o.s[1] = r * ROWB + ((slot ^ r ^ 4) << 4);
+    return o;
+}
+
+// the chunk's K and Q rows (zero from row nt on) as bf16 into the swizzled staging buffers; kp / qp: the chunk's first
+// row (uniform).  No load sits behind a branch (the compiler waits for a guarded load before leaving its branch, which
+// serializes the loads): a full chunk loads unguarded, a partial one reads row nt - 1 in place of the missing rows and
+// zeroes them afterwards; a batch of rows is in flight before the first is waited for.
+template <typename InT, bool VEC, bool WITH_Q = true>
+static __device__ __forceinline__ void stage_kq(uint8_t * sK, uint8_t * sQ, const InT * kp, const InT * qp,
+                                                const int64_t sq2, const stage_offs & o, const int nt) {
+    constexpr int BATCH = std::is_same_v<InT, float> ? 4 : 8;   // rows of 8 j in flight (registers)
+    const int r = threadIdx.x >> 4, slot = threadIdx.x & 15;
+#pragma unroll
+    for (int j0 = 0; j0 < CH / 8; j0 += BATCH) {
+        uint4 kv[BATCH], qv[BATCH];
+#pragma unroll
+        for (int jj = 0; jj < BATCH; ++jj) {
+            const int j = j0 + jj;
+            uint32_t off = o.g + (uint32_t) (8 * j * sq2 * (int64_t) sizeof(InT));
+            if (nt < CH) {   // uniform
+                off = (uint32_t) (((int64_t) min(r + 8 * j, nt - 1) * sq2 + slot * 8) * (int64_t) sizeof(InT));
+            }
+            kv[jj] = ld8<InT, VEC>((const InT *) ((const char *) kp + off));
+            if constexpr (WITH_Q) {
+                qv[jj] = ld8<InT, VEC>((const InT *) ((const char *) qp + off));
+            }
+        }
+#pragma unroll
+        for (int jj = 0; jj < BATCH; ++jj) {
+            const int j  = j0 + jj;
+            const int so = o.s[j & 1] + j * 8 * ROWB;
+            const bool z = r + 8 * j >= nt;
+            *(uint4 *) (sK + so) = z ? make_uint4(0, 0, 0, 0) : kv[jj];
+            if constexpr (WITH_Q) {
+                *(uint4 *) (sQ + so) = z ? make_uint4(0, 0, 0, 0) : qv[jj];
+            }
+        }
+    }
+}
+
+// operand read offsets of lane (rl, hb) in a staging buffer: row rl of block mb, slot 2 kb + hb is at
+// mb * 16 * ROWB + offa[kb & 3] + 128 (kb >> 2)
+static __device__ __forceinline__ void make_offa(int (&offa)[4], const int rl, const int hb) {
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {
+        offa[q] = rl * ROWB + (((2 * q) ^ hb ^ swz(rl)) << 4);
+    }
+}
+static __device__ __forceinline__ int opnd_off(const int (&offa)[4], const int mb, const int kb) {
+    return mb * 16 * ROWB + offa[kb & 3] + 128 * (kb >> 2);
+}
+
+#if defined(AMD_WMMA_128B_AVAILABLE)
+using namespace ggml_cuda_mma;
+// A / B operand: lane l holds row l % 16, 8 bf16 along the reduction at 8 (l / 16)
+typedef tile<16, 8, nv_bfloat162>                frag_t;
+// D: lane l holds column l % 16, rows 8 (l / 16) + i, i < 8
+typedef tile<16, 16, float, DATA_LAYOUT_J_MAJOR> acc_t;
+
+static __device__ __forceinline__ frag_t as_frag(const uint4 v) {
+    frag_t f;
+    static_assert(sizeof(f.x) == sizeof(uint4), "fragment size");
+    __builtin_memcpy(f.x, &v, sizeof(v));
+    return f;
+}
+static __device__ __forceinline__ frag_t as_frag(const float * x) {
+    return as_frag(make_uint4(pack2(x[0], x[1]), pack2(x[2], x[3]), pack2(x[4], x[5]), pack2(x[6], x[7])));
+}
+static __device__ __forceinline__ frag_t lds_frag(const uint8_t * p) {
+    return as_frag(*(const uint4 *) p);
+}
+#endif // defined(AMD_WMMA_128B_AVAILABLE)
+
+// The prep: one block per (chunk, k head, sequence) for all the v heads of the k head (they share K, so the staging and the
+// gram K K^T on WMMA are done once).  Per v head, with L[s][t] = beta_s e^{gam_s - gam_t} k_s.k_t (t < s): the blocks of -L
+// below the diagonal straight from the gram tiles (their D layout is the operand layout), and the inverses of the diagonal
+// blocks of I + L by forward substitution in f32 -- the scan solves (I + L) U = diag(beta) R block by block with them.
+template <typename InT, bool VEC>
+static __global__ void __launch_bounds__(128) gdn_wmma_prep(const args a) {
+#if defined(AMD_WMMA_128B_AVAILABLE)
+    __shared__ __align__(16) uint8_t sm[PREP_LDS];
+    uint8_t * sK   = sm;                        // the K staging, reused after the gram:
+    float   * sLd  = (float *) sm;              //   the diagonal blocks of L, [NB][16][DSTR]
+    float   * sTd  = sLd + NB * 16 * DSTR;      //   the inverses of the diagonal blocks of I + L
+    float   * sGam = (float *) (sm + MATB);     // per v head of the group: gam2[CH], beta[CH]
+
+    const int tid = threadIdx.x & 127, lane = tid & 31, w = tid >> 5, rl = lane & 15, hb = lane >> 4;
+    const int c = blockIdx.x, kh = blockIdx.y, seq = blockIdx.z;
+    const int t0 = c * CH;
+    const int nt = min(CH, a.n_tok - t0);
+    const int R  = a.H / a.H_k;
+
+    // the gates of v heads r0 .. r0 + RMAX - 1 (wave w: the heads w, w + 4, ...): gam2, the inclusive cumsum of g over the
+    // chunk in log2 units (zero past the last token), and beta into LDS and to each head's block.  Tokens past nt read the
+    // last token and are zeroed (no load behind a branch, see stage_kq).  The first group's loads are issued before the
+    // K staging and arrive during it.
+    float xg[RMAX / 4][2], xb[RMAX / 4][2];
+    auto gate_load = [&](const int r0) {
+#pragma unroll
+        for (int q = 0; q < RMAX / 4; ++q) {
+            const int r = min(r0 + w + 4 * q, R - 1);
+            const int64_t gb = (int64_t) seq * a.sb3 + (int64_t) (kh + a.H_k * r) * a.sb1 + (int64_t) t0 * a.sb2;
+#pragma unroll
+            for (int hh = 0; hh < 2; ++hh) {
+                const int64_t o = (int64_t) min(lane + 32 * hh, nt - 1) * a.sb2;
+                xg[q][hh] = a.g[gb + o];
+                xb[q][hh] = a.beta[gb + o];
+            }
+        }
+    };
+    auto gate_scan = [&](const int r0) {
+#pragma unroll
+        for (int q = 0; q < RMAX / 4; ++q) {
+            const int rg = w + 4 * q, r = r0 + rg;
+            if (r < R) {   // wave-uniform
+                float g0 = lane      < nt ? xg[q][0] * LOG2E : 0.0f, b0 = lane      < nt ? xb[q][0] : 0.0f;
+                float g1 = lane + 32 < nt ? xg[q][1] * LOG2E : 0.0f, b1 = lane + 32 < nt ? xb[q][1] : 0.0f;
+#pragma unroll
+                for (int o = 1; o < 32; o <<= 1) {
+                    const float x0 = ggml_cuda_shfl_up(g0, o, 32);
+                    const float x1 = ggml_cuda_shfl_up(g1, o, 32);
+                    if (lane >= o) {
+                        g0 += x0;
+                        g1 += x1;
+                    }
+                }
+                g1 += ggml_cuda_shfl(g0, 31, 32);
+                float * gs = sGam + rg * 2 * CH;
+                gs[lane] = g0; gs[lane + 32] = g1;
+                gs[CH + lane] = b0; gs[CH + lane + 32] = b1;
+                float * go = (float *) (a.blk + ((int64_t) (seq * a.H + kh + a.H_k * r) * a.n_chunks + c) * BLK + BLK_G);
+                go[lane] = g0; go[lane + 32] = g1;
+                go[CH + lane] = b0; go[CH + lane + 32] = b1;
+            }
+        }
+    };
+    gate_load(0);
+
+    const int64_t qk = (int64_t) (seq / a.rq3) * a.sq3 + (int64_t) kh * a.sq1 + (int64_t) t0 * a.sq2;
+    stage_kq<InT, VEC, false>(sK, nullptr, (const InT *) a.k + qk, nullptr, a.sq2, make_stage_offs<InT>(a.sq2), nt);
+    gate_scan(0);
+    lds_barrier();
+
+    int offa[4];
+    make_offa(offa, rl, hb);
+
+    // 20 tiles over the lower 16x16 blocks, five per wave: tiles 0..9 the gram block (s block hi, t block lo) as D[t][s]
+    // (its D layout is the operand layout of the L block), tiles 10..19 the Q K^T block (r block hi, s block lo) as
+    // D[s][r] (likewise the operand layout of the P block).  The Q operands straight from global (not staged: the LDS
+    // stays at 20 KiB); a partial chunk's Q rows past nt read row nt - 1 -- they only reach P rows of tokens that are not
+    // there
+    const InT * qrow = (const InT *) a.q + qk + (int64_t) (min(rl, nt - 1)) * a.sq2 + 8 * hb;   // + rows 16 hi, keys 16 kb
+    acc_t acc[5];
+#pragma unroll
+    for (int j = 0; j < 5; ++j) {
+        const int ti = w + 4 * j;
+        int hi, lo;
+        tri_rc(ti % NTRI, hi, lo);
+        const uint8_t * pa = sK + lo * 16 * ROWB;
+        if (ti < NTRI) {   // wave-uniform
+            const uint8_t * pb = sK + hi * 16 * ROWB;
+#pragma unroll
+            for (int kb = 0; kb < DK / 16; ++kb) {
+                mma(acc[j], lds_frag(pa + opnd_off(offa, 0, kb)), lds_frag(pb + opnd_off(offa, 0, kb)));
+            }
+        } else {
+            const InT * qr = 16 * hi + rl < nt ? qrow + (int64_t) (16 * hi) * a.sq2 : qrow;
+#pragma unroll
+            for (int kb = 0; kb < DK / 16; ++kb) {
+                mma(acc[j], lds_frag(pa + opnd_off(offa, 0, kb)), as_frag(ld8<InT, VEC>(qr + 16 * kb)));
+            }
+        }
+        __builtin_amdgcn_sched_barrier(0);   // one tile's operand reads in flight at a time (registers)
+    }
+    lds_barrier();   // the K staging is reused below
+
+    for (int r = 0; r < R; ++r) {
+        const int h  = kh + a.H_k * r;
+        const int rg = r % RMAX;
+        if (r > 0 && rg == 0) {   // the next group's gates
+            gate_load(r);
+            gate_scan(r);
+            lds_barrier();
+        }
+        const float * sGr = sGam + rg * 2 * CH;   // gam2, then beta of this v head
+        uint8_t * blk = a.blk + ((int64_t) (seq * a.H + h) * a.n_chunks + c) * BLK;
+
+        // L: below the diagonal as -L operand fragments to the block, the diagonal blocks into sLd; P[r][s] =
+        // scale e^{gam_r - gam_s} q_r.k_s (s <= r) to the block as operand fragments
+#pragma unroll
+        for (int j = 0; j < 5; ++j) {
+            const int ti = w + 4 * j;
+            int hi, lo;
+            tri_rc(ti % NTRI, hi, lo);
+            const int   n  = 16 * hi + rl;         // s (gram) or r (P)
+            const int   m0 = 16 * lo + 8 * hb;     // t (gram) or s (P), + i
+            const float gn = sGr[n];
+            if (ti >= NTRI) {
+                float x[8];
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int m = m0 + i;
+                    x[i] = m <= n ? a.scale * ex2(gn - sGr[m]) * acc[j].x[i] : 0.0f;
+                }
+                *(uint4 *) (blk + BLK_P + (ti - NTRI) * FRAG + lane * 16) =
+                    make_uint4(pack2(x[0], x[1]), pack2(x[2], x[3]), pack2(x[4], x[5]), pack2(x[6], x[7]));
+            } else {
+                const float bn = sGr[CH + n];
+                float x[8];
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int m = m0 + i;
+                    x[i] = m < n ? bn * ex2(gn - sGr[m]) * acc[j].x[i] : 0.0f;
+                }
+                if (hi != lo) {
+                    *(uint4 *) (blk + BLK_L + off_index(hi, lo) * FRAG + lane * 16) =
+                        make_uint4(pack2(-x[0], -x[1]), pack2(-x[2], -x[3]), pack2(-x[4], -x[5]), pack2(-x[6], -x[7]));
+                } else {
+#pragma unroll
+                    for (int i = 0; i < 8; ++i) {
+                        sLd[hi * 16 * DSTR + rl * DSTR + 8 * hb + i] = x[i];
+                    }
+                }
+            }
+        }
+        lds_barrier();
+
+        // (I + L_bb)^-1 by forward substitution in f32, thread (b, c) for column c of diagonal block b
+        if (tid < CH) {
+            const int b = tid >> 4, cc = tid & 15;
+            const float * Lb = sLd + b * 16 * DSTR;
+            float t[16];
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                t[i] = i == cc ? 1.0f : 0.0f;
+            }
+#pragma unroll
+            for (int i = 1; i < 16; ++i) {
+                float s0 = 0.0f, s1 = 0.0f;
+#pragma unroll
+                for (int k = 0; k < i; ++k) {
+                    if (k & 1) { s1 += Lb[i * DSTR + k] * t[k]; } else { s0 += Lb[i * DSTR + k] * t[k]; }
+                }
+                if (i > cc) {
+                    t[i] = -(s0 + s1);
+                }
+            }
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                sTd[b * 16 * DSTR + i * DSTR + cc] = t[i];
+            }
+        }
+        lds_barrier();
+
+        // the inverses to the block in the operand layout (lane l: row l % 16, columns 8 (l / 16) .. + 7), thread tid for
+        // lane tid % 32 of block tid / 32
+        {
+            const int b = tid >> 5, l = tid & 31;
+            const float * tr = sTd + b * 16 * DSTR + (l & 15) * DSTR + 8 * (l >> 4);
+            *(uint4 *) (blk + BLK_D + b * FRAG + l * 16) =
+                make_uint4(pack2(tr[0], tr[1]), pack2(tr[2], tr[3]), pack2(tr[4], tr[5]), pack2(tr[6], tr[7]));
+        }
+        // no barrier: the next head writes sLd (read only by the substitution, which every thread has passed) before the
+        // barrier that precedes its writes to sTd
+    }
+#else
+    GGML_UNUSED(a);
+    NO_DEVICE_CODE;
+#endif // defined(AMD_WMMA_128B_AVAILABLE)
+}
+
+// one value's bf16 bits, as the operand it would have been
+template <typename InT>
+static __device__ __forceinline__ uint32_t ldbf(const InT * p) {
+    if constexpr (std::is_same_v<InT, float>) {
+        return f2bf(*p);
+    } else {
+        return (uint32_t) *p;
+    }
+}
+static __device__ __forceinline__ float bf_lo(const uint32_t w) { return __uint_as_float(w << 16); }
+static __device__ __forceinline__ float bf_hi(const uint32_t w) { return __uint_as_float(w & 0xFFFF0000u); }
+
+constexpr int NPB = (XB / 16 + 127) / 128;   // 16-byte pieces of the staged prep block per scan thread (the last partial)
+
+// the lane constants of the scan's V loads
+struct scan_lane {
+    const char * vb;     // V of the head and sequence (uniform)
+    int64_t      vstr;   // bytes per token
+    uint32_t     voff;   // the lane's byte offset: token 8 hb, its column
+    int64_t      coff;   // the lane's column in bytes
+    int          hi8, tid;
+};
+
+// a chunk's prep block pieces (scan_issue_x) and this lane's V values (scan_issue_v: bf16 pairs of the tokens
+// 16 mb + 8 hb + 2 p, + 1); no load behind a branch (a guarded load is waited for before its branch ends): a partial chunk
+// reads its last token in place of the missing ones and zeroes them
+static __device__ __forceinline__ void scan_issue_x(uint4 (&pb)[NPB], const uint8_t * blk, const int c, const int tid) {
+    const uint4 * src = (const uint4 *) (blk + (int64_t) c * BLK);
+#pragma unroll
+    for (int k = 0; k < NPB; ++k) {
+        pb[k] = src[min(tid + 128 * k, XB / 16 - 1)];
+    }
+}
+
+template <typename InT>
+static __device__ __forceinline__ void scan_issue_v(uint32_t (&pv)[NB][4], const int c, const args & a, const scan_lane & sl) {
+    const int t0 = c * CH, nt = min(CH, a.n_tok - t0);
+    if (nt == CH) {   // uniform
+#pragma unroll
+        for (int mb = 0; mb < NB; ++mb) {
+#pragma unroll
+            for (int p = 0; p < 4; ++p) {
+                const char * r0 = sl.vb + (int64_t) (t0 + 16 * mb + 2 * p) * sl.vstr + sl.voff;
+                pv[mb][p] = ldbf((const InT *) r0) | (ldbf((const InT *) (r0 + sl.vstr)) << 16);
+            }
+        }
+    } else {
+        const char * vl = sl.vb + sl.coff;
+        const int    nl = nt - sl.hi8;
+#pragma unroll
+        for (int mb = 0; mb < NB; ++mb) {
+#pragma unroll
+            for (int p = 0; p < 4; ++p) {
+                const int e0 = 16 * mb + 2 * p;
+                const uint32_t lo = ldbf((const InT *) (vl + (int64_t) (t0 + min(e0 + sl.hi8,     nt - 1)) * sl.vstr));
+                const uint32_t hi = ldbf((const InT *) (vl + (int64_t) (t0 + min(e0 + sl.hi8 + 1, nt - 1)) * sl.vstr));
+                pv[mb][p] = (e0 < nl ? lo : 0u) | (e0 + 1 < nl ? hi << 16 : 0u);
+            }
+        }
+    }
+}
+
+// a chunk's K / Q rows (as stage_kq loads them) into registers
+template <typename InT, bool VEC>
+static __device__ __forceinline__ void scan_issue_kq(uint4 (&pk)[CH / 8], uint4 (&pq)[CH / 8], const InT * kp, const InT * qp,
+                                                     const int c, const args & a, const stage_offs & so4) {
+    const int t0 = c * CH, nt = min(CH, a.n_tok - t0);
+    const int r = (threadIdx.x & 127) >> 4, slot = threadIdx.x & 15;
+#pragma unroll
+    for (int j = 0; j < CH / 8; ++j) {
+        uint32_t off = so4.g + (uint32_t) (8 * j * a.sq2 * (int64_t) sizeof(InT));
+        if (nt < CH) {   // uniform
+            off = (uint32_t) (((int64_t) min(r + 8 * j, nt - 1) * a.sq2 + slot * 8) * (int64_t) sizeof(InT));
+        }
+        pk[j] = ld8<InT, VEC>((const InT *) ((const char *) (kp + (int64_t) t0 * a.sq2) + off));
+        pq[j] = ld8<InT, VEC>((const InT *) ((const char *) (qp + (int64_t) t0 * a.sq2) + off));
+    }
+}
+
+// blkr: the prep blocks (read-only here, restrict: its gam2 values are scalar loads)
+template <typename InT, bool VEC>
+static __global__ void __launch_bounds__(128) gdn_wmma_scan(const args a, const uint8_t * __restrict__ blkr) {
+#if defined(AMD_WMMA_128B_AVAILABLE)
+    // bf16 rows: the next chunk's K / Q rows wait in registers too (f32 rows would need twice the registers)
+
+    __shared__ __align__(16) uint8_t sm[SCAN_LDS];
+    uint8_t * sK = sm;
+    uint8_t * sQ = sm + MATB;
+    uint8_t * sX = sm + 2 * MATB;   // the prep block: -L below the diagonal, the diagonal inverses, P
+
+    const int tid = threadIdx.x & 127, lane = tid & 31, w = tid >> 5, rl = lane & 15, hb = lane >> 4, hi8 = 8 * hb;
+    const int h = blockIdx.y, seq = blockIdx.z;
+    const int col = blockIdx.x * 64 + w * 16 + rl;   // this lane's value column
+
+    // global addresses as a uniform row pointer plus a 32-bit lane offset
+    const int64_t qk = (int64_t) (seq / a.rq3) * a.sq3 + (int64_t) (h % a.H_k) * a.sq1;
+    const InT    * kp   = (const InT *) a.k + qk;
+    const InT    * qp   = (const InT *) a.q + qk;
+    const char   * vb   = (const char *) ((const InT *) a.v + (int64_t) seq * a.sv3 + (int64_t) h * a.sv1);
+    char         * ob   = (char *) (a.dst + ((int64_t) seq * a.n_tok_full * a.H + h) * DK);
+    const int64_t  vstr = a.sv2 * (int64_t) sizeof(InT);           // bytes per token
+    const int64_t  ostr = (int64_t) a.H * DK * (int64_t) sizeof(float);
+    const uint32_t voff = (uint32_t) ((hi8 * a.sv2 + col) * (int64_t) sizeof(InT));
+    const uint32_t ooff = (uint32_t) (hi8 * ostr + col * (int64_t) sizeof(float));
+    const uint8_t * blk = blkr + (int64_t) (seq * a.H + h) * a.n_chunks * BLK;
+    const stage_offs so4 = make_stage_offs<InT>(a.sq2);
+
+    // the state of the lane's column: tile kb holds S[16 kb + 8 hb + i][col] (ggml stores S transposed, keys contiguous)
+    acc_t S[DK / 16];
+    {
+        const float * s0 = a.s0 + (int64_t) (seq * a.H + h) * DK * DK + (int64_t) col * DK + hi8;
+#pragma unroll
+        for (int kb = 0; kb < DK / 16; ++kb) {
+            const float4 x0 = *(const float4 *) (s0 + 16 * kb);
+            const float4 x1 = *(const float4 *) (s0 + 16 * kb + 4);
+            S[kb].x[0] = x0.x; S[kb].x[1] = x0.y; S[kb].x[2] = x0.z; S[kb].x[3] = x0.w;
+            S[kb].x[4] = x1.x; S[kb].x[5] = x1.y; S[kb].x[6] = x1.z; S[kb].x[7] = x1.w;
+        }
+    }
+
+    int offa[4];
+    make_offa(offa, rl, hb);
+    // the 16x16 identity as a B operand: lane l holds row l % 16, columns 8 (l / 16) + e
+    frag_t ident;
+    {
+        uint32_t iw[4];
+#pragma unroll
+        for (int p = 0; p < 4; ++p) {
+            const int e0 = hi8 + 2 * p;
+            iw[p] = (rl == e0 ? 0x3F80u : 0u) | (rl == e0 + 1 ? 0x3F800000u : 0u);
+        }
+        ident = as_frag(make_uint4(iw[0], iw[1], iw[2], iw[3]));
+    }
+    const scan_lane sl = { vb, vstr, voff, (int64_t) col * (int64_t) sizeof(InT), hi8, tid };
+
+    // A chunk's loads -- K / Q rows (bf16 inputs; f32 rows convert as they arrive and are staged at the top of their chunk),
+    // the prep block, this lane's V values -- are issued after the previous chunk's per-block loop, wait in registers
+    // through its state update (which needs few registers) and are written to LDS at the top of their chunk.  K / Q first:
+    // loads complete in order, so the LDS stores do not wait for V.
+    constexpr bool PF_KQ = false;   // the K / Q rows in registers through the state update as well: spills (see the report)
+    uint4    pk[PF_KQ ? CH / 8 : 1], pq[PF_KQ ? CH / 8 : 1];
+    uint4    pb[NPB];
+    uint32_t pv[NB][4];
+    if constexpr (PF_KQ) {
+        scan_issue_kq<InT, VEC>(pk, pq, kp, qp, 0, a, so4);
+    }
+    scan_issue_x(pb, blk, 0, tid);
+    scan_issue_v<InT>(pv, 0, a, sl);
+
+    for (int c = 0; c < a.n_chunks; ++c) {
+        const int t0 = c * CH;
+        const int nt = min(CH, a.n_tok - t0);
+        const int nl = nt - hi8;   // this lane's tokens 16 mb + 8 hb + i are real while 16 mb + i < nl
+
+        // the chunk's operands into LDS (the barrier at the end of the previous chunk made the buffers free)
+        if constexpr (PF_KQ) {
+            const int r = tid >> 4;
+#pragma unroll
+            for (int j = 0; j < CH / 8; ++j) {
+                const int  so = so4.s[j & 1] + j * 8 * ROWB;
+                const bool z  = r + 8 * j >= nt;
+                *(uint4 *) (sK + so) = z ? make_uint4(0, 0, 0, 0) : pk[j];
+                *(uint4 *) (sQ + so) = z ? make_uint4(0, 0, 0, 0) : pq[j];
+            }
+        } else {
+            stage_kq<InT, VEC>(sK, sQ, kp + (int64_t) t0 * a.sq2, qp + (int64_t) t0 * a.sq2, a.sq2, so4, nt);
+        }
+#pragma unroll
+        for (int k = 0; k < NPB; ++k) {
+            if ((k + 1) * 128 <= XB / 16 || tid + 128 * k < XB / 16) {   // only the last k is a branch
+                ((uint4 *) sX)[tid + 128 * k] = pb[k];
+            }
+        }
+        __syncthreads();
+
+        // gam2 of this lane's tokens: scalar loads of the uniform block, picked by half-wave; beta: vector loads per block
+        // below (scalar loads of both would not fit the scalar registers)
+        const float * gp = (const float *) (blk + (int64_t) c * BLK + BLK_G);
+#define GAM(mb, i) (hb ? gp[16 * (mb) + 8 + (i)] : gp[16 * (mb) + (i)])
+        const float gl = gp[CH - 1];
+
+        frag_t Sb[DK / 16];
+#pragma unroll
+        for (int kb = 0; kb < DK / 16; ++kb) {
+            Sb[kb] = as_frag(S[kb].x);
+        }
+
+        // per 16-token block mb, with the chunk's start state: X = K S, R = V - Gam X, and (I + L) U = diag(beta) R solved
+        // block by block -- U_mb = (I + L_mb,mb)^-1 (beta R_mb - sum_{kb < mb} L_mb,kb U_kb) -- then
+        // W = diag(e^{gam_C - gam}) U, O = scale Gam (Q S) + P U
+        frag_t Ub[NB], Wb[NB];
+#pragma unroll
+        for (int mb = 0; mb < NB; ++mb) {
+            const float4 b0 = *(const float4 *) (gp + CH + 16 * mb + hi8);
+            const float4 b1 = *(const float4 *) (gp + CH + 16 * mb + hi8 + 4);
+            const float bt[8] = {b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w};
+            float G[8];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                G[i] = GAM(mb, i);
+            }
+            acc_t X;
+#pragma unroll
+            for (int kb = 0; kb < DK / 16; ++kb) {
+                mma(X, lds_frag(sK + opnd_off(offa, mb, kb)), Sb[kb]);
+            }
+            acc_t C;   // beta R - sum L U
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                const float v = i & 1 ? bf_hi(pv[mb][i / 2]) : bf_lo(pv[mb][i / 2]);
+                C.x[i] = bt[i] * (v - ex2(G[i]) * X.x[i]);
+            }
+#pragma unroll
+            for (int kb = 0; kb < mb; ++kb) {
+                mma(C, lds_frag(sX + BLK_L + off_index(mb, kb) * FRAG + lane * 16), Ub[kb]);
+            }
+            acc_t U;
+            mma(U, lds_frag(sX + BLK_D + mb * FRAG + lane * 16), as_frag(C.x));
+            Ub[mb] = as_frag(U.x);
+            {
+                float u[8];
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    u[i] = ex2(gl - G[i]) * U.x[i];
+                }
+                Wb[mb] = as_frag(u);
+            }
+            acc_t Y;
+#pragma unroll
+            for (int kb = 0; kb < DK / 16; ++kb) {
+                mma(Y, lds_frag(sQ + opnd_off(offa, mb, kb)), Sb[kb]);
+            }
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                Y.x[i] *= a.scale * ex2(G[i]);
+            }
+#pragma unroll
+            for (int kb = 0; kb <= mb; ++kb) {
+                mma(Y, lds_frag(sX + BLK_P + tri_index(mb, kb) * FRAG + lane * 16), Ub[kb]);
+            }
+            if (nt == CH) {   // uniform
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    *(float *) (ob + (int64_t) (t0 + 16 * mb + i) * ostr + ooff) = Y.x[i];
+                }
+            } else {
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    if (16 * mb + i < nl) {
+                        *(float *) (ob + (int64_t) (t0 + 16 * mb + i) * ostr + ooff) = Y.x[i];
+                    }
+                }
+            }
+            __builtin_amdgcn_sched_barrier(0);   // keeps the next block's operand reads from piling up (registers)
+        }
+
+        // the next chunk's loads (see above), in flight during the state update
+        if (c + 1 < a.n_chunks) {
+            if constexpr (PF_KQ) {
+                scan_issue_kq<InT, VEC>(pk, pq, kp, qp, c + 1, a, so4);
+            }
+            scan_issue_x(pb, blk, c + 1, tid);
+            scan_issue_v<InT>(pv, c + 1, a, sl);
+        }
+        __builtin_amdgcn_sched_barrier(0);
+
+        // S' = e^{gam_C} S + K^T W.  K^T through the WMMA unit: the operand block (tokens mb, keys kb) of K times the identity
+        // is that block in the D layout -- lane l holds key 16 kb + l % 16 of the tokens 16 mb + 8 (l / 16) + i -- which is
+        // the K^T operand; exact (bf16 values times 1 in f32), packed back by truncation
+        const float Gc = ex2(gl);
+#pragma unroll
+        for (int kb = 0; kb < DK / 16; ++kb) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                S[kb].x[i] *= Gc;
+            }
+#pragma unroll
+            for (int mb = 0; mb < NB; ++mb) {
+                acc_t kt;
+                mma(kt, lds_frag(sK + opnd_off(offa, mb, kb)), ident);
+                uint32_t wv[4];
+#pragma unroll
+                for (int p = 0; p < 4; ++p) {
+                    wv[p] = (__float_as_uint(kt.x[2 * p]) >> 16) | (__float_as_uint(kt.x[2 * p + 1]) & 0xFFFF0000u);
+                }
+                mma(S[kb], as_frag(make_uint4(wv[0], wv[1], wv[2], wv[3])), Wb[mb]);
+            }
+            __builtin_amdgcn_sched_barrier(0);   // one key block at a time (registers)
+        }
+#undef GAM
+        __syncthreads();   // the next chunk overwrites the staging
+    }
+
+    float * so = a.s_out + (int64_t) (seq * a.H + h) * DK * DK + (int64_t) col * DK + hi8;
+#pragma unroll
+    for (int kb = 0; kb < DK / 16; ++kb) {
+        *(float4 *) (so + 16 * kb)     = make_float4(S[kb].x[0], S[kb].x[1], S[kb].x[2], S[kb].x[3]);
+        *(float4 *) (so + 16 * kb + 4) = make_float4(S[kb].x[4], S[kb].x[5], S[kb].x[6], S[kb].x[7]);
+    }
+#else
+    GGML_UNUSED(a);
+    GGML_UNUSED(blkr);
+    NO_DEVICE_CODE;
+#endif // defined(AMD_WMMA_128B_AVAILABLE)
+}
+
+} // namespace gdn_wmma
+
+bool ggml_cuda_gdn_own_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_GDN_OWN");
+        if (e != nullptr) {
+            return atoi(e) != 0;
+        }
+        const char * a = getenv("FRANK_ALL");
+        return !(a != nullptr && a[0] == '0' && a[1] == '\0');
+    }();
+    return on;
+}
+
+bool ggml_cuda_op_gdn_chunked_wmma(ggml_backend_cuda_context & ctx, ggml_tensor * dst, float * state_d_ext,
+                                   int64_t n_tokens_limit, const ggml_cuda_gdn_bf16_in * in16) {
+    using namespace gdn_wmma;
+    const ggml_tensor * src_q     = dst->src[0];
+    const ggml_tensor * src_v     = dst->src[2];
+    const ggml_tensor * src_g     = dst->src[3];
+    const ggml_tensor * src_beta  = dst->src[4];
+    const ggml_tensor * src_state = dst->src[5];
+
+    const int64_t S_v      = src_v->ne[0];
+    const int64_t H        = src_v->ne[1];
+    const int64_t n_tokens = src_v->ne[2];
+    const int64_t n_seqs   = src_v->ne[3];
+    GGML_ASSERT(S_v == DK && src_q->ne[0] == DK && src_g->ne[0] == 1);
+    GGML_ASSERT(n_tokens_limit == 0 || n_seqs == 1);
+    GGML_ASSERT(in16 == nullptr || n_seqs == 1);
+
+    const int64_t n_tok = n_tokens_limit > 0 ? std::min(n_tokens_limit, n_tokens) : n_tokens;
+    if (n_tok <= 0) {
+        return true;
+    }
+
+    args a = {};
+    a.g          = (const float *) src_g->data;
+    a.beta       = (const float *) src_beta->data;
+    a.s0         = (const float *) src_state->data;
+    a.dst        = (float *) dst->data;
+    a.s_out      = state_d_ext != nullptr ? state_d_ext : (float *) dst->data + S_v * H * n_tokens * n_seqs;
+    a.sb1        = src_beta->nb[1] / sizeof(float);
+    a.sb2        = src_beta->nb[2] / sizeof(float);
+    a.sb3        = src_beta->nb[3] / sizeof(float);
+    a.n_tok_full = n_tokens;
+    a.H          = (int) H;
+    a.H_k        = (int) src_q->ne[1];
+    a.rq3        = (int) (n_seqs / src_q->ne[3]);
+    a.n_tok      = (int) n_tok;
+    a.n_chunks   = (int) ((n_tok + CH - 1) / CH);
+    a.scale      = 1.0f / sqrtf((float) S_v);
+
+    auto aligned = [](const void * p, int64_t s1, int64_t s2, int64_t s3, int64_t el) {
+        return ((uintptr_t) p % 16) == 0 && s1 % el == 0 && s2 % el == 0 && s3 % el == 0;
+    };
+    const bool bf = in16 != nullptr;
+    if (bf) {
+        a.q = in16->q; a.k = in16->k; a.v = in16->v;
+        a.sq1 = in16->sq1; a.sq2 = in16->sq2; a.sq3 = in16->sq3;
+        a.sv1 = in16->sv1; a.sv2 = in16->sv2; a.sv3 = in16->sv3;
+    } else {
+        const ggml_tensor * src_k = dst->src[1];
+        a.q = src_q->data; a.k = src_k->data; a.v = src_v->data;
+        a.sq1 = src_q->nb[1] / sizeof(float); a.sq2 = src_q->nb[2] / sizeof(float); a.sq3 = src_q->nb[3] / sizeof(float);
+        a.sv1 = src_v->nb[1] / sizeof(float); a.sv2 = src_v->nb[2] / sizeof(float); a.sv3 = src_v->nb[3] / sizeof(float);
+    }
+
+    ggml_cuda_pool_alloc<uint8_t> scratch(ctx.pool(), (size_t) n_seqs * H * a.n_chunks * BLK);
+    a.blk = scratch.get();
+
+    cudaStream_t stream = ctx.stream();
+    const ggml_cuda_kernel_launch_params lp_prep(dim3(a.n_chunks, a.H_k, n_seqs), dim3(128, 1, 1), 0, stream);
+    const ggml_cuda_kernel_launch_params lp_scan(dim3(DK / 64, H, n_seqs), dim3(128, 1, 1), 0, stream);
+    const bool vec = bf ? aligned(in16->q, a.sq1, a.sq2, a.sq3, 8) && aligned(in16->k, a.sq1, a.sq2, a.sq3, 8)
+                        : aligned(dst->src[0]->data, a.sq1, a.sq2, a.sq3, 4) && aligned(dst->src[1]->data, a.sq1, a.sq2, a.sq3, 4);
+    const uint8_t * blk = a.blk;
+    bool ok;
+    if (bf) {
+        ok = vec ? ggml_cuda_kernel_launch_try(gdn_wmma_prep<uint16_t, true>,  lp_prep, a) &&
+                   ggml_cuda_kernel_launch_try(gdn_wmma_scan<uint16_t, true>,  lp_scan, a, blk)
+                 : ggml_cuda_kernel_launch_try(gdn_wmma_prep<uint16_t, false>, lp_prep, a) &&
+                   ggml_cuda_kernel_launch_try(gdn_wmma_scan<uint16_t, false>, lp_scan, a, blk);
+    } else {
+        ok = vec ? ggml_cuda_kernel_launch_try(gdn_wmma_prep<float, true>,  lp_prep, a) &&
+                   ggml_cuda_kernel_launch_try(gdn_wmma_scan<float, true>,  lp_scan, a, blk)
+                 : ggml_cuda_kernel_launch_try(gdn_wmma_prep<float, false>, lp_prep, a) &&
+                   ggml_cuda_kernel_launch_try(gdn_wmma_scan<float, false>, lp_scan, a, blk);
+    }
+
+    static bool logged = false;
+    if (!logged && ok) {
+        logged = true;
+        GGML_LOG_INFO("%s: GDN prefill on the own chunked WMMA kernel (FRANK_GDN_OWN=0: off; chunk %d, %s inputs)\n",
+                      __func__, CH, bf ? "bf16" : "f32");
+    }
+    return ok;
+}
