+bool ggml_cuda_gdn_qk_redirect_take(ggml_backend_cuda_context & ctx, const ggml_tensor * gdn, ggml_cuda_gdn_qk_redirect_info * info) {
+    std::lock_guard<std::mutex> lock(g_gdn_qk_mu);
