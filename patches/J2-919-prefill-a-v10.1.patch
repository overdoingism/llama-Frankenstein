+
+// 0 off, 1 f16, 2 fp8 (the weight is rounded to fp8 per row and the hipBLASLt fp8 GEMM of M4 is used).  Unset: fp8 when every
+// device is a gfx1201 (where the built-in algorithm lists were measured; elsewhere the choice would be timed and could
+// change between runs), off with FRANK_ALL=0.
+int lf_kq_mode() {
+    static const int mode = [] {
+        const char * s = getenv("FRANK_KQ_BLAS");
+        if (s == nullptr || *s == '\0') {
+            const char * a = getenv("FRANK_ALL");
+            if (a != nullptr && a[0] == '0' && a[1] == '\0') return 0;
+#if defined(FRANK_HIPBLASLT)
+            int n = 0;
+            if (hipGetDeviceCount(&n) != hipSuccess || n <= 0) return 0;
+            for (int d = 0; d < n; ++d) {
+                hipDeviceProp_t prop;
+                if (hipGetDeviceProperties(&prop, d) != hipSuccess) return 0;
+                const std::string arch(prop.gcnArchName);
+                if (arch.substr(0, arch.find(':')) != "gfx1201") return 0;
+            }
+            GGML_LOG_INFO("FRANK_KQ_BLAS: fp8 prefill GEMM through hipBLASLt on (lossy; the default on gfx1201, FRANK_KQ_BLAS=0 turns it off)\n");
+            return 2;
+#else
+            return 0;
+#endif // defined(FRANK_HIPBLASLT)
+        }
+        if (strcmp(s, "0") == 0) return 0;
+#if defined(FRANK_HIPBLASLT)
+        if (strcmp(s, "f16") == 0) return 1;
+        if (strcmp(s, "fp8") == 0) { GGML_LOG_INFO("FRANK_KQ_BLAS: fp8 prefill GEMM through hipBLASLt on (lossy)\n"); return 2; }
+        GGML_LOG_WARN("FRANK_KQ_BLAS=%s not recognized (f16, fp8), off\n", s);
+#else
+        GGML_LOG_WARN("FRANK_KQ_BLAS=%s: this build has no hipBLASLt (FRANK_HIPBLASLT), off\n", s);
+#endif // defined(FRANK_HIPBLASLT)
+        return 0;
+    }();
+    return mode;
+}
