+template <typename TI>
+static __global__ void glu16_widen_kernel(const TI * x, float * y, const int64_t n) {
+    const int64_t i = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+    if (i < n) {
+        y[i] = glu16_ld(x + i);
+    }
