+static __global__ void __launch_bounds__(256) gdn_conv_widen_rows_kernel(float * y, const int C) {
+    constexpr int NV = 64;   // C <= 256 * 64
+    float v[NV];
+    const unsigned short * row16 = (const unsigned short *) (y + (size_t) blockIdx.x * C);
+#pragma unroll
+    for (int i = 0; i < NV; ++i) {
+        const int c = threadIdx.x + 256 * i;
+        v[i] = c < C ? __uint_as_float((unsigned) row16[c] << 16) : 0.0f;
+    }
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < NV; ++i) {
+        const int c = threadIdx.x + 256 * i;
+        if (c < C) y[(size_t) blockIdx.x * C + c] = v[i];
+    }
