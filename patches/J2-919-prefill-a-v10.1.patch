+__device__ unsigned long long cont_gate_n_checked = 0, cont_gate_n_bad = 0;
+static __global__ void cont_gate_copy(const float * __restrict__ v, float * __restrict__ c, const int64_t k, const int64_t n, const int64_t o) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < k) c[i] = v[(i / n) * o + i % n];
+}
+static __global__ void cont_gate_cmp(const float * __restrict__ a, const float * __restrict__ b, const int64_t k) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= k) return;
+    const unsigned long long c = atomicAdd(&cont_gate_n_checked, 1ull) + 1;
+    if (__float_as_uint(a[i]) != __float_as_uint(b[i])) {
+        const unsigned long long nb = atomicAdd(&cont_gate_n_bad, 1ull);
+        if (nb < 8) printf("cont gate check: element %lld differs: %08x vs %08x\n", (long long) i, __float_as_uint(a[i]), __float_as_uint(b[i]));
+    }
+    if (c == 1 || (c & ((1ull << 24) - 1)) == 0) printf("cont gate check: %llu floats checked, %llu differ\n", c, cont_gate_n_bad);
+}
