 };
 
 template <bool apply_silu, int TT, bool fuse_norm = false>
@@ -135,6 +141,156 @@ static __global__ void __launch_bounds__(256) gdn_conv_direct_kernel(const float
     }
 }
 
+// BigOne 6e (prefill, FRANK_GDN_CONV_NORM_INPLACE=0: off): the conv with the q / k l2 norm pair folded in, one wave a
+// 128-channel group (lane l holds channels 32g + l, g < 4, of its group), TT tokens a block.  The conv arithmetic is
+// gdn_conv_direct_kernel's (the same taps in the same order, the same silu, the same expression and so the same contraction),
+// and a q / k group's sums are rms_norm_scale_pair_wave_f32<4>'s (the same butterflies, the same second stage, the run-time
+// divisor, no contraction), so the outputs are bit-identical to the conv followed by that pair, with no block barrier.  The
+// normalized q / k are written over the conv output's own q / k channels (their only readers, the two RMS_NORMs, are folded)
+// and the GATED_DELTA_NET reads them there (ggml_cuda_gdn_qk_redirect_take): the SCALE outputs, which the allocator may place
+// over x or the state while this kernel still reads them, are not written.
+// the own chunked GDN kernel's rounding (gdn-chunked-wmma.cu: + 0x8000, upper half), so its operands come out the same
+static __device__ __forceinline__ unsigned short gdn_conv_f2bf(const float f) {
+    return (unsigned short) ((__float_as_uint(f) + 0x8000u) >> 16);
+}
