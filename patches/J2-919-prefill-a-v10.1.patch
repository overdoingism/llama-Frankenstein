+// Same products as unary_gated_op_kernel (f32), each thread one channel c of the K1 fp8 matmul that reads them (rows of kc =
+// R whole rows of n) over 64 of its rows, also folding the channel's absolute maximum into that matmul's channel amax buffer
+// (ggml_cuda_lf_kq8_amax_take), which then skips that pass.  Every product and its address are those of the plain kernel.
+// dst may be x (a GLU in place, GGML_GLU_INPLACE): each thread reads an element before it writes it, so no restrict.
+// TI: the inputs' type -- float, or the f16 products of BigOne GLU16 (half; then dst must not overlap them).
+template <typename TI>
+static __device__ __forceinline__ float glu16_ld(const TI * p) {
+    if constexpr (std::is_same<TI, float>::value) {
+        return __builtin_nontemporal_load(p);   // = ggml_cuda_nt_load
+    } else {
+        static_assert(std::is_same<TI, half>::value, "GLU16 products are f16");
+        return __half2float(__ushort_as_half(__builtin_nontemporal_load((const unsigned short *) p)));
+    }
+}
+
+template <float (*op)(float), typename TI = float>
+static __global__ void unary_gated_chan_amax_kernel(const TI * x, const TI * g, float * dst,
+        const int64_t n, const int64_t kc, const int64_t nrows, const int64_t o0, const int64_t o1, unsigned int * __restrict__ cbits) {
+    const int64_t c = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+    if (c >= kc) {
+        return;
+    }
+    const int64_t hp = c / n, cp = c - hp*n, R = kc / n;   // the matmul's channel c = producer row t*R + hp, column cp
+    // 64 rows per block: one atomic per channel and 64 rows, as lf_kq8_chan_amax (16 rows, unrolled, was slower in place)
+    const int64_t r0 = int64_t(blockIdx.y)*64, r1 = r0 + 64 < nrows ? r0 + 64 : nrows;
+    const TI * xp = x + hp*o0 + cp;
+    const TI * gp = g + hp*o1 + cp;
+    float a = 0.0f;
+    for (int64_t t = r0; t < r1; ++t) {
+        const float v = op(glu16_ld(xp + t*R*o0)) * glu16_ld(gp + t*R*o1);
+        dst[t*kc + c] = v;
+        a = fmaxf(a, fabsf(v));
+    }
+    atomicMax(cbits + c, __float_as_uint(a));
+}
+
+template <float (*op)(float), typename TI = float>
+static void unary_gated_chan_amax_cuda(const TI * x, const TI * g, float * dst, const int64_t n, const int64_t kc, const int64_t nrows,
+        const int64_t o0, const int64_t o1, unsigned int * cbits, cudaStream_t stream) {
+    const dim3 grid((unsigned) ((kc + CUDA_GLU_BLOCK_SIZE - 1) / CUDA_GLU_BLOCK_SIZE), (unsigned) ((nrows + 63) / 64));
+    unary_gated_chan_amax_kernel<op, TI><<<grid, CUDA_GLU_BLOCK_SIZE, 0, stream>>>(x, g, dst, n, kc, nrows, o0, o1, cbits);
+}
+
+// BigOne 6d step 2: unary_gated_chan_amax_kernel's products and addresses that also write the K1 fp8 activation of the fixed-KEEP
+// matmul (ggml_cuda_lf_kq8_fp8_take) instead of the channel amax; kc == d.K.
+template <float (*op)(float), typename TI = float>
+static __global__ void unary_gated_fp8_kernel(const TI * x, const TI * g, float * dst,
+        const int64_t n, const int64_t kc, const int64_t nrows, const int64_t o0, const int64_t o1, const ggml_cuda_lf_kq8_fp8_dst d) {
+    const int64_t c = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+    if (c >= kc) {
+        return;
+    }
+    const int64_t hp = c / n, cp = c - hp*n, R = kc / n;
+    const int64_t r0 = int64_t(blockIdx.y)*64, r1 = r0 + 64 < nrows ? r0 + 64 : nrows;
+    const TI * xp = x + hp*o0 + cp;
+    const TI * gp = g + hp*o1 + cp;
+    const float amax = __uint_as_float(*d.gbits) * d.margin;
+    const float inv  = amax > 0.f ? 448.f / amax : 0.f;
+    const unsigned int pc = d.pos[c];
+    for (int64_t t = r0; t < r1; ++t) {
+        const float v = op(glu16_ld(xp + t*R*o0)) * glu16_ld(gp + t*R*o1);
+        if (!d.skip_f32) {
+            dst[t*kc + c] = v;
+        }
+        ggml_cuda_lf_kq8_fp8_put(v, inv, (int) c, pc, d.xq + t*d.Kp, d.K, d.k);
