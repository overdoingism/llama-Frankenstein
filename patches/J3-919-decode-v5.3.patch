+
+// See head-int2.cuh.  Layout of the int2 copy of an M x ne0 weight (ne0 a multiple of 64):
+//   codes[row][u], u = 0 .. ne0/32 - 1: the 32 values of sub-block u as two 32-bit words P0, P1 where byte j of P_h holds
+//   the 2-bit codes of values 4*(4h + m) + j at bits 2m..2m+1 (m = 0..3), so (P_h >> 2m) & 0x03030303 lines up with the
+//   q8_1 int (4h + m) of the activations;
+//   sm[row][g], g = 0 .. ne0/64 - 1: (scale, minimum) of the group, value = minimum + scale * code.
+
+#if defined(GGML_USE_HIP)
+#define cudaStreamCaptureStatus     hipStreamCaptureStatus
+#define cudaStreamCaptureStatusNone hipStreamCaptureStatusNone
+#define cudaStreamIsCapturing       hipStreamIsCapturing
+#endif
+
+namespace {
+
+constexpr int32_t HEAD_INT2_MAGIC = 0x48493244;  // op_params[0] of a marked MUL_MAT: the draft selector's head (others -INF)
+
+// FRANK_HEAD_INT2: 0 = off, 1 (or more) = the draft selector's head (output unchanged).  Unset: on with one GPU that is an
+// RDNA4 one (where mmvk runs; with several devices the plain path stays), off with FRANK_ALL=0.
+bool head_int2_on() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_HEAD_INT2");
+        if (e != nullptr) {
+            return atoi(e) >= 1;
+        }
+        const char * a = getenv("FRANK_ALL");
+        if (a != nullptr && a[0] == '0' && a[1] == '\0') {
+            return false;
+        }
+        const ggml_cuda_device_info & info = ggml_cuda_info();
+        return info.device_count == 1 && GGML_CUDA_CC_IS_RDNA4(info.devices[0].cc);
+    }();
+    return on;
+}
+
+int head_int2_r() {
+    static const int r = [] {
+        const char * e = getenv("FRANK_HEAD_INT2_R");
+        const int v = e != nullptr ? atoi(e) : 512;
+        return v < 16 ? 16 : (v > 4096 ? 4096 : v);
+    }();
+    return r;
+}
+
+// candidates kept per column: R plus room for the keys that share the threshold's 22-bit bin
+int head_int2_cap() { return head_int2_r() + 256; }
+
+bool head_int2_type_ok(const ggml_type t) {
+    return t == GGML_TYPE_Q4_K || t == GGML_TYPE_Q5_K || t == GGML_TYPE_Q6_K;
+}
+
+struct head_copy {
+    uint2 * codes = nullptr;
+    half2 * sm    = nullptr;
+};
+
+std::mutex g_mutex;
+std::map<std::pair<int, const void *>, head_copy> g_copies;   // (device, weight data)
+std::set<std::pair<int, const void *>> g_failed;              // copies that could not be allocated: the plain path stays
+
+const head_copy * head_find(const int device, const void * w) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    const auto it = g_copies.find({device, w});
+    return it == g_copies.end() ? nullptr : &it->second;
+}
+
+__global__ void head_int2_quant(const float * __restrict__ x, uint2 * __restrict__ codes, half2 * __restrict__ sm, const int64_t nrows,
+                                const int ne0) {
+    const int64_t g = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int gpr = ne0 / 64;
+    if (g >= nrows * gpr) {
+        return;
+    }
+    const int64_t row = g / gpr;
+    const int gi = (int) (g % gpr);
+    const float * w = x + row * ne0 + gi * 64;
+    float lo = w[0], hi = w[0];
+    for (int k = 1; k < 64; ++k) {
+        lo = fminf(lo, w[k]);
+        hi = fmaxf(hi, w[k]);
+    }
+    const half2 hsm = __floats2half2_rn((hi - lo) / 3.0f, lo);
+    const float s = __low2float(hsm), m = __high2float(hsm);   // quantize against the stored f16 values
+    for (int b = 0; b < 2; ++b) {
+        uint32_t P[2] = { 0, 0 };
+        for (int v = 0; v < 32; ++v) {
+            const float q = s > 0.0f ? rintf((w[32 * b + v] - m) / s) : 0.0f;
+            const uint32_t c = (uint32_t) fminf(fmaxf(q, 0.0f), 3.0f);
+            const int l = v >> 2, j = v & 3;
+            P[l >> 2] |= c << (8 * j + 2 * (l & 3));
+        }
+        codes[row * (ne0 / 32) + 2 * gi + b] = make_uint2(P[0], P[1]);
+    }
+    sm[row * gpr + gi] = hsm;
+}
+
+// the same lane / sub-block walk as mmvk: a lane owns sub-blocks u = lane, lane + 32, ..., RW rows per lane group
+template <int NC>
+__launch_bounds__(128)
+__global__ void head_int2_coarse(const uint2 * __restrict__ codes, const half2 * __restrict__ sm, const block_q8_1 * __restrict__ Y,
+                                 float * __restrict__ dst, const int M, const int nsub, const int64_t stride_col_y,
+                                 const int64_t stride_col_dst) {
+    constexpr int RW = 8;
+    const int lane = threadIdx.x % 32, grp = threadIdx.x / 32;
+    const int row0 = (blockIdx.x * 4 + grp) * RW;
+    if (row0 >= M) {
+        return;
+    }
+    float acc[RW][NC];
+#pragma unroll
+    for (int r = 0; r < RW; ++r)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) acc[r][c] = 0.0f;
+    for (int u = lane; u < nsub; u += 32) {
+        int ya[NC][8];
+        float yd[NC], ys[NC];
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            const block_q8_1 * y = Y + c * stride_col_y + u;
+            yd[c] = __low2float(y->ds);
+            int s = 0;
+#pragma unroll
+            for (int l = 0; l < 8; ++l) {
+                ya[c][l] = ((const int *) y->qs)[l];
+                s = ggml_cuda_dp4a(0x01010101, ya[c][l], s);
+            }
+            ys[c] = yd[c] * (float) s;
+        }
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int row = row0 + r;
+            if (row >= M) {
+                break;
+            }
+            const uint2 q = codes[(int64_t) row * nsub + u];
+            const float2 g = __half22float2(sm[(int64_t) row * (nsub / 2) + (u >> 1)]);
+            int v[8];
+#pragma unroll
+            for (int m = 0; m < 4; ++m) {
+                v[m]     = (q.x >> (2 * m)) & 0x03030303;
+                v[4 + m] = (q.y >> (2 * m)) & 0x03030303;
+            }
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                int d = 0;
+#pragma unroll
+                for (int l = 0; l < 8; ++l) d = ggml_cuda_dp4a(v[l], ya[c][l], d);
+                acc[r][c] += g.x * yd[c] * (float) d + g.y * ys[c];
+            }
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < RW; ++r)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            float a = acc[r][c];
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) a += __shfl_xor(a, o, 32);
+            acc[r][c] = a;
+        }
+    for (int e = lane; e < RW * NC; e += 32) {
+        const int r = e / NC, c = e % NC;
+        float val = 0.0f;
+#pragma unroll
+        for (int rr = 0; rr < RW; ++rr)
+#pragma unroll
+            for (int cc = 0; cc < NC; ++cc) if (rr == r && cc == c) val = acc[rr][cc];
+        if (row0 + r < M) dst[c * stride_col_dst + row0 + r] = val;
+    }
+}
+
+// float -> uint32 with the same order (larger float = larger key)
+__device__ __forceinline__ uint32_t head_key(const float f) {
+    const uint32_t u = __float_as_uint(f);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+// PASS 0: histogram of the top 11 key bits; PASS 1: of bits 20..10, among the keys whose top 11 bits are sel[c][0]
+template <int PASS>
+__global__ void head_int2_hist(const float * __restrict__ dst, const int64_t stride_col_dst, const int M, uint32_t * __restrict__ hist,
+                               const int * __restrict__ sel) {
+    __shared__ uint32_t sh[2048];
+    for (int i = threadIdx.x; i < 2048; i += blockDim.x) sh[i] = 0;
+    __syncthreads();
+    const int c = blockIdx.y;
+    const float * col = dst + c * stride_col_dst;
+    const uint32_t b1 = PASS ? (uint32_t) sel[4 * c] : 0;
+    for (int v = blockIdx.x * blockDim.x + threadIdx.x; v < M; v += gridDim.x * blockDim.x) {
+        const uint32_t k = head_key(col[v]);
+        if (PASS == 0) {
+            atomicAdd(&sh[k >> 21], 1u);
+        } else if ((k >> 21) == b1) {
+            atomicAdd(&sh[(k >> 10) & 2047], 1u);
+        }
+    }
+    __syncthreads();
+    for (int i = threadIdx.x; i < 2048; i += blockDim.x) {
+        if (sh[i]) atomicAdd(&hist[(PASS * gridDim.y + c) * 2048 + i], sh[i]);
+    }
+}
+
+// one block of 256 per column: find, from the top, the bin in which the running count reaches R
+template <int PASS>
+__global__ void head_int2_scan(const uint32_t * __restrict__ hist, int * __restrict__ sel, const int R) {
+    __shared__ uint32_t part[256];
+    const int c = blockIdx.x, t = threadIdx.x;
+    const uint32_t * h = hist + (PASS * gridDim.x + c) * 2048;
+    uint32_t s = 0;
+    for (int i = 0; i < 8; ++i) s += h[8 * t + i];
+    part[t] = s;
+    __syncthreads();
+    if (t != 0) {
+        return;
+    }
+    int cum = PASS ? sel[4 * c + 1] : 0;
+    int b = 0;
+    for (int p = 255; p >= 0; --p) {
+        if (cum + (int) part[p] >= R || p == 0) {
+            for (b = 8 * p + 7; b > 8 * p; --b) {
+                if (cum + (int) h[b] >= R) break;
+                cum += (int) h[b];
+            }
+            break;
+        }
+        cum += (int) part[p];
+    }
+    if (PASS == 0) {
+        sel[4 * c] = b;
+        sel[4 * c + 1] = cum;   // keys strictly above bin b
+    } else {
+        sel[4 * c + 2] = b;
+    }
+}
+
+__global__ void head_int2_collect(const float * __restrict__ dst, const int64_t stride_col_dst, const int M, const int * __restrict__ sel,
+                                  int * __restrict__ rows, int * __restrict__ counts, const int cap) {
+    const int c = blockIdx.y;
+    const uint32_t T = ((uint32_t) sel[4 * c] << 21) | ((uint32_t) sel[4 * c + 2] << 10);
+    const float * col = dst + c * stride_col_dst;
+    for (int v = blockIdx.x * blockDim.x + threadIdx.x; v < M; v += gridDim.x * blockDim.x) {
+        if (head_key(col[v]) >= T) {
+            const int i = atomicAdd(&counts[c], 1);
+            if (i < cap) rows[c * cap + i] = v;
+        }
+    }
+}
+
+__global__ void head_int2_fill(float * __restrict__ dst, const int64_t stride_col_dst, const int M) {
+    const int c = blockIdx.y;
+    for (int v = blockIdx.x * blockDim.x + threadIdx.x; v < M; v += gridDim.x * blockDim.x) {
+        dst[c * stride_col_dst + v] = -INFINITY;
+    }
+}
+
+__global__ void head_int2_scatter(float * __restrict__ dst, const int64_t stride_col_dst, const int * __restrict__ rows,
+                                  const int * __restrict__ counts, const int cap, const float * __restrict__ vals) {
+    const int c = blockIdx.y;
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < min(counts[c], cap)) {
+        dst[c * stride_col_dst + rows[c * cap + i]] = vals[c * cap + i];
+    }
+}
+
+// FRANK_HEAD_INT2_CHECK=1 (diagnostic; with GGML_CUDA_DISABLE_GRAPHS=1 so the calls are not captured): every call also
+// computes the exact logits with mmvk and counts (a) recomputed entries that differ bit-wise from them, (b) columns whose exact
+// top-K (FRANK_HEAD_INT2_CHECK_K, default 16) was not entirely among the candidates; logged every 64 calls
+bool head_int2_check() {
+    static const bool on = [] {
+        const char * e = getenv("FRANK_HEAD_INT2_CHECK");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+int head_int2_check_k() {
+    static const int k = [] {
+        const char * e = getenv("FRANK_HEAD_INT2_CHECK_K");
+        return e != nullptr ? atoi(e) : 16;
+    }();
+    return k;
+}
+
+__device__ __forceinline__ void head_atomic_max(float * p, const float v) {
+    int * ip = (int *) p;
+    int old = *ip;
+    while (__int_as_float(old) < v) {
+        const int prev = atomicCAS(ip, old, __float_as_int(v));
+        if (prev == old) break;
+        old = prev;
+    }
+}
+
+__global__ void head_int2_check_mark(const int * __restrict__ rows, const int * __restrict__ counts, const int cap, const int M,
+                                     unsigned char * __restrict__ mask) {
+    const int c = blockIdx.y;
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < min(counts[c], cap)) mask[(int64_t) c * M + rows[c * cap + i]] = 1;
+}
+
+// per column: the largest exact value among the non-candidates, and the bit mismatches among the candidates
+__global__ void head_int2_check_scan(const float * __restrict__ D, const float * __restrict__ E, const unsigned char * __restrict__ mask,
+                                     const int64_t sd, const int M, float * __restrict__ maxnc, int * __restrict__ mism) {
+    const int c = blockIdx.y;
+    float m = -INFINITY;
+    int bad = 0;
+    for (int v = blockIdx.x * blockDim.x + threadIdx.x; v < M; v += gridDim.x * blockDim.x) {
+        const float d = D[c * sd + v], e = E[(int64_t) c * M + v];
+        if (!mask[(int64_t) c * M + v]) {
+            m = fmaxf(m, e);
+        } else if (__float_as_uint(d) != __float_as_uint(e)) {
+            ++bad;
+        }
+    }
+    head_atomic_max(&maxnc[c], m);
+    if (bad) atomicAdd(&mism[c], bad);
+}
+
+// per column: the K-th largest of the recomputed candidate values (a simple K-pass selection)
+__global__ void head_int2_check_kth(const float * __restrict__ vals, const int * __restrict__ counts, const int cap, const int K,
+                                    float * __restrict__ kth) {
+    const int c = blockIdx.x;
+    const int n = min(counts[c], cap);
+    __shared__ float best;
+    __shared__ int best_i;
+    __shared__ unsigned char used[4096 + 256];
+    for (int i = threadIdx.x; i < n; i += blockDim.x) used[i] = 0;
+    __syncthreads();
+    float last = -INFINITY;
+    for (int k = 0; k < K && k < n; ++k) {
+        if (threadIdx.x == 0) { best = -INFINITY; best_i = -1; }
+        __syncthreads();
+        for (int i = threadIdx.x; i < n; i += blockDim.x) {
+            if (!used[i]) head_atomic_max(&best, vals[c * cap + i]);
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            for (int i = 0; i < n; ++i) if (!used[i] && vals[c * cap + i] == best) { used[i] = 1; break; }
+            last = best;
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) kth[c] = n >= K ? last : INFINITY;
+}
+
+// the result may only be read by TOP_K (k <= R) and GET_ROWS, through views; anything else needs the full logits
+// (why: the first offending consumer, for the one-time log)
+bool head_int2_consumers_ok(const ggml_cgraph * cgraph, const ggml_tensor * node, const ggml_tensor ** why = nullptr) {
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * n = cgraph->nodes[i];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * t = n->src[s];
+            if (t == nullptr) continue;
+            while (t->view_src != nullptr && t != node) t = t->view_src;
+            if (t != node) continue;
+            switch (n->op) {
+                case GGML_OP_RESHAPE: case GGML_OP_VIEW: case GGML_OP_GET_ROWS: break;
+                case GGML_OP_TOP_K: if (n->ne[0] > head_int2_r()) { if (why) *why = n; return false; } break;
+                default: if (why) *why = n; return false;
+            }
+        }
+    }
+    return true;
+}
+
+// false when the copy cannot be allocated (it sits outside --fit): the head then keeps the plain path, once and for all
+bool head_int2_build(ggml_backend_cuda_context & ctx, const ggml_tensor * w) {
+    if (head_find(ctx.device, w->data) != nullptr) {
+        return true;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_failed.count({ctx.device, w->data}) != 0) {
+            return false;
+        }
+    }
+    const int64_t M = w->ne[1], ne0 = w->ne[0];
+    head_copy hc;
+    const size_t codes_bytes = (size_t) M * (ne0 / 32) * sizeof(uint2), sm_bytes = (size_t) M * (ne0 / 64) * sizeof(half2);
+    if (ggml_cuda_device_malloc((void **) &hc.codes, codes_bytes, ctx.device) != cudaSuccess ||
+        ggml_cuda_device_malloc((void **) &hc.sm, sm_bytes, ctx.device) != cudaSuccess) {
+        (void) cudaGetLastError();
+        if (hc.codes != nullptr) {
+            CUDA_CHECK(cudaFree(hc.codes));
+        }
+        {
+            std::lock_guard<std::mutex> lock(g_mutex);
+            g_failed.insert({ctx.device, w->data});
+        }
+        GGML_LOG_WARN("%s: int2 coarse head for %s: could not allocate %.1f MiB on device %d, the plain path stays\n", __func__,
+                      w->name, (double) (codes_bytes + sm_bytes) / (1024.0 * 1024.0), ctx.device);
+        return false;
+    }
+    cudaStream_t stream = ctx.stream();
+    const to_fp32_cuda_t to_f32 = ggml_get_to_fp32_cuda(w->type);
+    const int64_t chunk = 4096;
+    ggml_cuda_pool_alloc<float> tmp(ctx.pool(), chunk * ne0);
+    for (int64_t r0 = 0; r0 < M; r0 += chunk) {
+        const int64_t n = std::min(chunk, M - r0);
+        to_f32((const char *) w->data + r0 * w->nb[1], tmp.ptr, n * ne0, stream);
+        const int64_t groups = n * (ne0 / 64);
+        head_int2_quant<<<(groups + 255) / 256, 256, 0, stream>>>(tmp.ptr, hc.codes + r0 * (ne0 / 32), hc.sm + r0 * (ne0 / 64), n, (int) ne0);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_copies[{ctx.device, w->data}] = hc;
+    }
+    GGML_LOG_WARN("%s: int2 coarse head for %s (%s, %lld x %lld): %.1f MiB, R = %d\n", __func__, w->name, ggml_type_name(w->type),
+                  (long long) ne0, (long long) M, (double) M * (ne0 / 32 * sizeof(uint2) + ne0 / 64 * sizeof(half2)) / (1024.0 * 1024.0),
+                  head_int2_r());
+    return true;
+}
+
+} // namespace
+
+bool ggml_cuda_head_int2_node(const ggml_tensor * dst) {
+    return dst->op == GGML_OP_MUL_MAT && dst->op_params[0] == HEAD_INT2_MAGIC;
+}
+
+void ggml_cuda_head_int2_prepare(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph) {
+    // the copy is read only through mmvk: with mmvk off (FRANK_MMVK=0) nothing is marked and no copy is built
+    if (!head_int2_on() || !ggml_cuda_mmvk_enabled()) {
+        return;
+    }
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        ggml_tensor * n = cgraph->nodes[i];
+        if (n->op != GGML_OP_MUL_MAT || strncmp(n->name, "dflash2_lm_head", 15) != 0 || !head_int2_on()) {
+            continue;
+        }
+        const ggml_tensor * w = n->src[0];
+        // the output flag is llama's default for every t_logits (llama-graph); the DFlash2 drafter reads only the selector
+        // lattice built from the top-k below, never these raw logits (common/speculative.cpp), so it does not disqualify
+        const bool ok = head_int2_type_ok(w->type) && w->ne[0] % 64 == 0 && w->data != nullptr &&
+                        w->buffer != nullptr && ggml_backend_buffer_get_usage(w->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+                        ggml_is_contiguous(w) && w->ne[2] == 1 && w->ne[3] == 1 && head_int2_consumers_ok(cgraph, n);
+        n->op_params[0] = ok ? HEAD_INT2_MAGIC : 0;
+        static bool logged_off = false;
+        if (!ok && !logged_off) {
+            logged_off = true;
+            const ggml_tensor * why = nullptr;
+            const bool cons = head_int2_consumers_ok(cgraph, n, &why);
+            GGML_LOG_WARN("%s: %s not taken: output %d, type %s, ne0 %lld, consumers %s%s%s\n", __func__, n->name,
+                          (n->flags & GGML_TENSOR_FLAG_OUTPUT) ? 1 : 0, ggml_type_name(w->type), (long long) w->ne[0], cons ? "ok" : "not ok: ",
+                          why ? ggml_op_desc(why) : "", why ? why->name : "");
+        }
+        if (ok && !head_int2_build(ctx, w)) {
+            n->op_params[0] = 0;
+        }
+    }
+}
+
+bool ggml_cuda_head_int2_takes(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    return head_int2_on() && ggml_cuda_head_int2_node(dst) && ggml_cuda_mmvk_takes(src0, src1, dst) && head_int2_type_ok(src0->type) &&
+           dst->nb[0] == sizeof(float) && head_find(ctx.device, src0->data) != nullptr;
+}
+
+void ggml_cuda_head_int2_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    const head_copy * hc = head_find(ctx.device, src0->data);
+    cudaStream_t stream = ctx.stream();
+    const int M = (int) src0->ne[1];
+    const int ncols = (int) src1->ne[1];
+    const int nsub = (int) (src0->ne[0] / 32);
+    int64_t stride_col_y = 0;
+    const block_q8_1 * Y = ggml_cuda_mmvk_q8_1(ctx, src0, src1, stride_col_y);
+    const int64_t sd = dst->nb[1] / sizeof(float);
+    float * D = (float *) dst->data;
+
+    const int blocks = (M + 4 * 8 - 1) / (4 * 8);
+    switch (ncols) {
+        case 1: head_int2_coarse<1><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 2: head_int2_coarse<2><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 3: head_int2_coarse<3><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 4: head_int2_coarse<4><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 5: head_int2_coarse<5><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 6: head_int2_coarse<6><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 7: head_int2_coarse<7><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        case 8: head_int2_coarse<8><<<blocks, 128, 0, stream>>>(hc->codes, hc->sm, Y, D, M, nsub, stride_col_y, sd); break;
+        default: GGML_ABORT("head-int2: %d columns", ncols);
+    }
+    CUDA_CHECK(cudaGetLastError());
+
+    const int R = head_int2_r(), cap = head_int2_cap();
+    ggml_cuda_pool_alloc<uint32_t> hist(ctx.pool(), 2 * ncols * 2048);
+    ggml_cuda_pool_alloc<int> sel(ctx.pool(), 5 * ncols);   // 4 per column, then the counts
+    ggml_cuda_pool_alloc<int> rows(ctx.pool(), ncols * cap);
+    ggml_cuda_pool_alloc<float> vals(ctx.pool(), ncols * cap);
+    int * counts = sel.ptr + 4 * ncols;
+    CUDA_CHECK(cudaMemsetAsync(hist.ptr, 0, 2 * ncols * 2048 * sizeof(uint32_t), stream));
+    CUDA_CHECK(cudaMemsetAsync(counts, 0, ncols * sizeof(int), stream));
+
+    const dim3 gsel(64, ncols);
+    head_int2_hist<0><<<gsel, 256, 0, stream>>>(D, sd, M, hist.ptr, sel.ptr);
+    head_int2_scan<0><<<ncols, 256, 0, stream>>>(hist.ptr, sel.ptr, R);
+    head_int2_hist<1><<<gsel, 256, 0, stream>>>(D, sd, M, hist.ptr, sel.ptr);
+    head_int2_scan<1><<<ncols, 256, 0, stream>>>(hist.ptr, sel.ptr, R);
+    head_int2_collect<<<gsel, 256, 0, stream>>>(D, sd, M, sel.ptr, rows.ptr, counts, cap);
+    ggml_cuda_mmvk_rows_gather(src0, Y, stride_col_y, rows.ptr, counts, cap, ncols, vals.ptr, stream);
+    head_int2_fill<<<gsel, 256, 0, stream>>>(D, sd, M);
+    head_int2_scatter<<<dim3((cap + 255) / 256, ncols), 256, 0, stream>>>(D, sd, rows.ptr, counts, cap, vals.ptr);
+    CUDA_CHECK(cudaGetLastError());
+
+    if (head_int2_check()) {
+        cudaStreamCaptureStatus st = cudaStreamCaptureStatusNone;
+        if (cudaStreamIsCapturing(stream, &st) != cudaSuccess || st != cudaStreamCaptureStatusNone) {
+            return;
+        }
+        // the exact path into a scratch tensor of the same shape
+        ggml_cuda_pool_alloc<float> ex(ctx.pool(), (size_t) M * ncols);
+        ggml_tensor tmp = *dst;
+        tmp.data = ex.ptr;
+        tmp.nb[1] = (size_t) M * sizeof(float);
+        tmp.nb[2] = tmp.nb[3] = tmp.nb[1] * ncols;
+        ggml_cuda_mmvk_mul_mat(ctx, src0, src1, &tmp);
+        ggml_cuda_pool_alloc<float> stat(ctx.pool(), 2 * ncols);
+        ggml_cuda_pool_alloc<int> mism(ctx.pool(), ncols);
+        std::vector<float> h_init(2 * ncols, -INFINITY);
+        CUDA_CHECK(cudaMemcpyAsync(stat.ptr, h_init.data(), 2 * ncols * sizeof(float), cudaMemcpyHostToDevice, stream));
+        CUDA_CHECK(cudaMemsetAsync(mism.ptr, 0, ncols * sizeof(int), stream));
+        ggml_cuda_pool_alloc<unsigned char> mask(ctx.pool(), (size_t) M * ncols);
+        CUDA_CHECK(cudaMemsetAsync(mask.ptr, 0, (size_t) M * ncols, stream));
+        head_int2_check_mark<<<dim3((cap + 255) / 256, ncols), 256, 0, stream>>>(rows.ptr, counts, cap, M, mask.ptr);
+        head_int2_check_scan<<<dim3(64, ncols), 256, 0, stream>>>(D, ex.ptr, mask.ptr, sd, M, stat.ptr, mism.ptr);
+        head_int2_check_kth<<<ncols, 256, 0, stream>>>(vals.ptr, counts, cap, head_int2_check_k(), stat.ptr + ncols);
+        std::vector<float> h_stat(2 * ncols);
+        std::vector<int> h_mism(ncols), h_cnt(ncols);
+        CUDA_CHECK(cudaMemcpyAsync(h_stat.data(), stat.ptr, 2 * ncols * sizeof(float), cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaMemcpyAsync(h_mism.data(), mism.ptr, ncols * sizeof(int), cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaMemcpyAsync(h_cnt.data(), counts, ncols * sizeof(int), cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        static int64_t n_calls = 0, n_cols = 0, n_miss = 0, n_mism = 0, n_cand = 0, n_over = 0;
+        ++n_calls;
+        for (int c = 0; c < ncols; ++c) {
+            ++n_cols;
+            n_miss += h_stat[c] > h_stat[ncols + c];
+            n_mism += h_mism[c];
+            n_cand += h_cnt[c];
+            n_over += h_cnt[c] > cap;
+        }
+        if (n_calls % 64 == 0) {
+            GGML_LOG_WARN("%s: check: %lld calls, %lld columns: top-%d misses %lld, recomputed values differing from the exact path %lld, "
+                          "candidates/column %.1f (over cap %lld)\n", __func__, (long long) n_calls, (long long) n_cols, head_int2_check_k(),
+                          (long long) n_miss, (long long) n_mism, (double) n_cand / n_cols, (long long) n_over);
+        }
+    }
+}
diff --git a/ggml/src/ggml-cuda/head-int2.cuh b/ggml/src/ggml-cuda/head-int2.cuh
new file mode 100644
index 000000000..1320a747e
--- /dev/null
+++ b/ggml/src/ggml-cuda/head-int2.cuh
@@ -0,0 +1,18 @@
+#pragma once
+#include "common.cuh"
+
+// int2 coarse vocabulary head: a MUL_MAT named "dflash2_lm_head" (the DFlash2 draft selector's lm_head) whose result is
+// read only by TOP_K (k <= R) and GET_ROWS in the graph (its host copy, if any, is never read by the drafter).  A resident int2 copy of the weight (asymmetric,
+// 64 values per group: 2-bit codes, f16 scale and minimum) scores the whole vocabulary; the R best of each column
+// (FRANK_HEAD_INT2_R, default 512) are recomputed with the mmvk kernel, bit-identical to the exact path, and every
+// other entry is -INF.  A top-k with k <= R therefore returns the exact ids and values whenever the true top-k is among
+// the R candidates; when it is not, only the draft changes (its acceptance), never the verified output.
+// The copy (~0.37 GiB for a 248320 x 5120 head) is built in graph_optimize, outside any graph capture and outside --fit;
+// when it cannot be allocated the head keeps the plain path.
+// FRANK_HEAD_INT2: 0 = off, 1 = the draft selector's head (output unchanged); unset = on with one GPU that is an RDNA4 one,
+// off with FRANK_ALL=0.  It only takes the shapes mmvk takes (RDNA4, Q4_K/Q5_K/Q6_K weight, 1..8 columns) so that the
+// recomputed rows match what the exact path would produce, and with mmvk off (FRANK_MMVK=0) it builds no copy.
+bool ggml_cuda_head_int2_node(const ggml_tensor * dst);
+bool ggml_cuda_head_int2_takes(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst);
+void ggml_cuda_head_int2_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+void ggml_cuda_head_int2_prepare(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph);
diff --git a/ggml/src/ggml-cuda/mmvk.cu b/ggml/src/ggml-cuda/mmvk.cu
new file mode 100644
index 000000000..f1b95facd
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvk.cu
@@ -0,0 +1,463 @@
+#include "mmvk.cuh"
+#include "head-int2.cuh"
+#include "quantize.cuh"
+#include "vecdotq.cuh"
+#include <atomic>
+#include <cstdio>
+#include <type_traits>
+#include <cstring>
+#include <unordered_set>
+
+namespace {
+
+// FRANK_MMVK: 1 = single launches, 2 = same-input groups, both only when the program verifies speculative drafts
+// (ggml_backend_set_speculative_decoding, called by llama-server before it loads the models); 3 / 4 = the same, always;
+// 0 = off.  Unset: 2 (FRANK_ALL=0: off).
+bool mmvk_explicit() {
+    static const bool x = getenv("FRANK_MMVK") != nullptr;
+    return x;
+}
+
+int mmvk_mode() {
+    static const int m = [] {
+        if (mmvk_explicit()) return atoi(getenv("FRANK_MMVK"));
+        const char * a = getenv("FRANK_ALL");
+        return a != nullptr && a[0] == '0' && a[1] == '\0' ? 0 : 2;
+    }();
+    return m;
+}
+
+std::atomic<bool> mmvk_speculative{false};
+
+bool mmvk_on() {
+    const int m = mmvk_mode();
+    return m == 3 || m == 4 || ((m == 1 || m == 2) && mmvk_speculative.load(std::memory_order_relaxed));
+}
+
+// FRANK_MMVK_EXT (bit mask, default 1): 1 = groups may mix weight types (bit-identical to same-type groups),
+// 2 = also IQ4_XS / IQ4_NL / MXFP4 (their stock kernel already holds ~97% of the bandwidth at 6 columns: no gain on
+// UD-Q4_K_XL, values change; opt-in)
+int mmvk_ext() {
+    static const int e = getenv("FRANK_MMVK_EXT") ? atoi(getenv("FRANK_MMVK_EXT")) : 1;
+    return e;
+}
+
+constexpr int MMVK_LPR = 32;     // lanes per row group: fixed -- it sets the per-output summation order
+constexpr int MMVK_GMAX = 8;
+
+__device__ __forceinline__ int mmvk_ld32(const uint8_t * p) { int v; __builtin_memcpy(&v, p, 4); return v; }
+
+__device__ __forceinline__ void mmvk_scale_min_k4(const int j, const uint8_t * q, int & sc, int & m) {
+    if (j < 4) { sc = q[j] & 63; m = q[j + 4] & 63; }
+    else       { sc = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4); m = (q[j + 4] >> 4) | ((q[j] >> 6) << 4); }
+}
+
+bool mmvk_type_ok(const ggml_type t) {
+    return t == GGML_TYPE_Q4_K || t == GGML_TYPE_Q5_K || t == GGML_TYPE_Q6_K ||
+           ((mmvk_ext() & 2) && (t == GGML_TYPE_IQ4_XS || t == GGML_TYPE_IQ4_NL || t == GGML_TYPE_MXFP4));
+}
+
+bool mmvk_same_group(const ggml_tensor * a, const ggml_tensor * b) {
+    return b->op == GGML_OP_MUL_MAT && b->src[1] == a->src[1] && ((mmvk_ext() & 1) || b->src[0]->type == a->src[0]->type);
+}
+
+// rows per lane group (RW) and warps per block; GGML_TYPE_COUNT = a mixed-type group (every member at RW 2, WARPS 2)
+template <ggml_type type> struct mmvk_cfg { static constexpr int RW = 2, WARPS = 2; };
+template <> struct mmvk_cfg<GGML_TYPE_Q6_K> { static constexpr int RW = 4, WARPS = 4; };
+template <> struct mmvk_cfg<GGML_TYPE_IQ4_XS> { static constexpr int RW = 4, WARPS = 2; };
+template <> struct mmvk_cfg<GGML_TYPE_IQ4_NL> { static constexpr int RW = 4, WARPS = 2; };
+
+struct mmvk_args {
+    const uint8_t * W[MMVK_GMAX];
+    float *         D[MMVK_GMAX];
+    int             M[MMVK_GMAX];
+    int             type[MMVK_GMAX];
+    int             block_start[MMVK_GMAX + 1];
+    int64_t         row_bytes[MMVK_GMAX];
+    int64_t         stride_col_dst[MMVK_GMAX];  // in floats
+    int             n;
+};
+
+// RW rows of one matrix against NC columns; the lane walks the 32-value sub-blocks u = lane, lane + 32, ... of the row.
+// The per-output order (sub-blocks per lane, then the 32-lane butterfly) depends on neither NC nor RW.
+template <ggml_type T, int NC, int RW>
+__device__ __forceinline__ void mmvk_rows(const uint8_t * __restrict__ W, float * __restrict__ out, const int M, const int64_t row_bytes,
+                                             const int64_t stride_col_dst, const int row0, const int lane,
+                                             const block_q8_1 * __restrict__ Y, const int nsub, const int64_t stride_col_y) {
+    constexpr bool need_ys = T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K || T == GGML_TYPE_Q6_K;
+    float acc[RW][NC];
+#pragma unroll
+    for (int r = 0; r < RW; ++r)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) acc[r][c] = 0.f;
+    for (int u = lane; u < nsub; u += MMVK_LPR) {
+        const int kb = u >> 3, j = u & 7;
+        int ya[NC][8]; float yd[NC]; int ys0[NC], ys1[NC];
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            const block_q8_1 * y = Y + c * stride_col_y + u;
+            yd[c] = __low2float(y->ds);
+            int s0 = 0, s1 = 0;
+#pragma unroll
+            for (int l = 0; l < 8; ++l) {
+                ya[c][l] = ((const int *) y->qs)[l];
+                if constexpr (need_ys) {
+                    if (l < 4) s0 = ggml_cuda_dp4a(0x01010101, ya[c][l], s0); else s1 = ggml_cuda_dp4a(0x01010101, ya[c][l], s1);
+                }
+            }
+            ys0[c] = s0; ys1[c] = s1;
+        }
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int row = row0 + r;
+            if (row >= M) break;
+            const uint8_t * rowp = W + (int64_t) row * row_bytes;
+            if constexpr (T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K) {
+                using B = std::conditional_t<T == GGML_TYPE_Q4_K, block_q4_K, block_q5_K>;
+                const B * b = (const B *) rowp + kb;
+                const float2 dm = __half22float2(b->dm);
+                int sc, m;
+                mmvk_scale_min_k4(j, b->scales, sc, m);
+                const int shift = 4 * (j & 1);
+                int v[8];
+#pragma unroll
+                for (int l = 0; l < 8; ++l) {
+                    v[l] = (mmvk_ld32(b->qs + 32 * (j >> 1) + 4 * l) >> shift) & 0x0F0F0F0F;
+                    if constexpr (T == GGML_TYPE_Q5_K) v[l] |= ((mmvk_ld32(b->qh + 4 * l) >> j) & 0x01010101) << 4;
+                }
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    int s = 0;
+#pragma unroll
+                    for (int l = 0; l < 8; ++l) s = ggml_cuda_dp4a(v[l], ya[c][l], s);
+                    acc[r][c] += yd[c] * (dm.x * (float) (sc * s) - dm.y * (float) (m * (ys0[c] + ys1[c])));
+                }
+            } else if constexpr (T == GGML_TYPE_Q6_K) {
+                // sub-block t = j & 3 of half h = j >> 2; ql bytes 64h + 32(t & 1) (low nibbles for t < 2), qh bytes 32h
+                // bits 2t..2t+1, scales 8h + 2t (first 16 values) and 8h + 2t + 1; value = d * scale * (q - 32)
+                const block_q6_K * b = (const block_q6_K *) rowp + kb;
+                const int h = j >> 2, t = j & 3;
+                const float d = __half2float(b->d);
+                const int sa = b->scales[8 * h + 2 * t], sb = b->scales[8 * h + 2 * t + 1];
+                const int nshift = t < 2 ? 0 : 4, hshift = 2 * t;
+                int v[8];
+#pragma unroll
+                for (int l = 0; l < 8; ++l) {
+                    const int lo = (mmvk_ld32(b->ql + 64 * h + 32 * (t & 1) + 4 * l) >> nshift) & 0x0F0F0F0F;
+                    const int hi = (mmvk_ld32(b->qh + 32 * h + 4 * l) >> hshift) & 0x03030303;
+                    v[l] = lo | (hi << 4);
+                }
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    int s0 = 0, s1 = 0;
+#pragma unroll
+                    for (int l = 0; l < 4; ++l) s0 = ggml_cuda_dp4a(v[l], ya[c][l], s0);
+#pragma unroll
+                    for (int l = 4; l < 8; ++l) s1 = ggml_cuda_dp4a(v[l], ya[c][l], s1);
+                    acc[r][c] += yd[c] * d * (float) (sa * (s0 - 32 * ys0[c]) + sb * (s1 - 32 * ys1[c]));
+                }
+            } else {
+                // 16 bytes of nibbles per 32 values (low nibble = value l, high = 16 + l) through a 16-entry table
+                const uint8_t * qs; const int8_t * table; float d;
+                if constexpr (T == GGML_TYPE_IQ4_XS) {
+                    const block_iq4_xs * b = (const block_iq4_xs *) rowp + kb;
+                    const int ls = ((b->scales_l[j >> 1] >> (4 * (j & 1))) & 0x0F) | (((b->scales_h >> (2 * j)) & 0x03) << 4);
+                    qs = b->qs + 16 * j; table = kvalues_iq4nl; d = __half2float(b->d) * (float) (ls - 32);
+                } else if constexpr (T == GGML_TYPE_IQ4_NL) {
+                    const block_iq4_nl * b = (const block_iq4_nl *) rowp + u;
+                    qs = b->qs; table = kvalues_iq4nl; d = __half2float(b->d);
+                } else {
+                    static_assert(T == GGML_TYPE_MXFP4, "mmvk: type");
+                    const block_mxfp4 * b = (const block_mxfp4 *) rowp + u;
+                    qs = b->qs; table = kvalues_mxfp4; d = ggml_cuda_e8m0_to_fp32(b->e) * 0.5f;
+                }
+                int2 v[4];
+#pragma unroll
+                for (int l = 0; l < 4; ++l) v[l] = get_int_from_table_16(mmvk_ld32(qs + 4 * l), table);
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    int s = 0;
+#pragma unroll
+                    for (int l = 0; l < 4; ++l) {
+                        s = ggml_cuda_dp4a(v[l].x, ya[c][l], s);
+                        s = ggml_cuda_dp4a(v[l].y, ya[c][l + 4], s);
+                    }
+                    acc[r][c] += yd[c] * d * (float) s;
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < RW; ++r)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            float a = acc[r][c];
+#pragma unroll
+            for (int o = MMVK_LPR / 2; o > 0; o >>= 1) a += __shfl_xor(a, o, 32);
+            acc[r][c] = a;
+        }
+    for (int e = lane; e < RW * NC; e += MMVK_LPR) {
+        const int r = e / NC, c = e % NC;
+        float val = 0.f;
+#pragma unroll
+        for (int rr = 0; rr < RW; ++rr)
+#pragma unroll
+            for (int cc = 0; cc < NC; ++cc) if (rr == r && cc == c) val = acc[rr][cc];
+        if (row0 + r < M) out[c * stride_col_dst + row0 + r] = val;
+    }
+}
+
+// one launch over the rows of 1..MMVK_GMAX matrices that share the q8_1 activations Y; type = GGML_TYPE_COUNT: members of
+// different types (the switch is uniform per block)
+template <ggml_type type, int NC>
+__launch_bounds__(32 * mmvk_cfg<type>::WARPS)
+__global__ void mmvk_kernel(const mmvk_args args, const block_q8_1 * __restrict__ Y, const int nsub, const int64_t stride_col_y) {
+    constexpr int RW = mmvk_cfg<type>::RW, WARPS = mmvk_cfg<type>::WARPS, GPW = 32 / MMVK_LPR;
+    int g = 0;
+#pragma unroll
+    for (int k = 1; k < MMVK_GMAX; ++k) g += (k < args.n && (int) blockIdx.x >= args.block_start[k]) ? 1 : 0;
+    const int bx = blockIdx.x - args.block_start[g];
+    const int lane = threadIdx.x % MMVK_LPR, grp = threadIdx.x / MMVK_LPR;
+    const int row0 = (bx * WARPS * GPW + grp) * RW;
+    const int M = args.M[g];
+    if (row0 >= M) return;
+#define MMVK_ROWS(T) mmvk_rows<T, NC, RW>(args.W[g], args.D[g], M, args.row_bytes[g], args.stride_col_dst[g], row0, lane, Y, nsub, stride_col_y)
+    if constexpr (type != GGML_TYPE_COUNT) {
+        MMVK_ROWS(type);
+    } else {
+        switch (args.type[g]) {
+            case GGML_TYPE_Q4_K:   MMVK_ROWS(GGML_TYPE_Q4_K);   break;
+            case GGML_TYPE_Q5_K:   MMVK_ROWS(GGML_TYPE_Q5_K);   break;
+            case GGML_TYPE_Q6_K:   MMVK_ROWS(GGML_TYPE_Q6_K);   break;
+            case GGML_TYPE_IQ4_XS: MMVK_ROWS(GGML_TYPE_IQ4_XS); break;
+            case GGML_TYPE_IQ4_NL: MMVK_ROWS(GGML_TYPE_IQ4_NL); break;
+            case GGML_TYPE_MXFP4:  MMVK_ROWS(GGML_TYPE_MXFP4);  break;
+            default: break;
+        }
+    }
+#undef MMVK_ROWS
+}
+
+template <ggml_type type>
+void mmvk_launch(const mmvk_args & args, const int blocks, const block_q8_1 * Y, const int nsub, const int64_t stride_col_y,
+                    const int ncols, cudaStream_t stream) {
+    dim3 grid(blocks);
+    const dim3 block(32 * mmvk_cfg<type>::WARPS);
+    if (ggml_cuda_grid_stall_pad(grid, block)) {
+        grid.x++;   // the padding block lands past the last group's rows (row0 >= M) and returns
+    }
+    switch (ncols) {
+        case 1: mmvk_kernel<type, 1><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 2: mmvk_kernel<type, 2><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 3: mmvk_kernel<type, 3><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 4: mmvk_kernel<type, 4><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 5: mmvk_kernel<type, 5><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 6: mmvk_kernel<type, 6><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 7: mmvk_kernel<type, 7><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 8: mmvk_kernel<type, 8><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        default: GGML_ABORT("mmvk: unsupported ncols %d", ncols);
+    }
+}
+
+// one output per warp: row rows[c * cap + i] of W against column c of Y, through the same mmvk_rows as the launch above
+// (RW = NC = 1 leaves each output's arithmetic unchanged: see mmvk_rows), into vals[c * cap + i]
+template <ggml_type T>
+__launch_bounds__(128)
+__global__ void mmvk_gather_kernel(const uint8_t * __restrict__ W, const int64_t row_bytes, const block_q8_1 * __restrict__ Y, const int nsub,
+                                   const int64_t stride_col_y, const int * __restrict__ rows, const int * __restrict__ counts, const int cap,
+                                   float * __restrict__ vals) {
+    const int c = blockIdx.y;
+    const int i = blockIdx.x * 4 + (int) threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    if (i >= min(counts[c], cap)) return;
+    const int row = rows[c * cap + i];
+    mmvk_rows<T, 1, 1>(W + (int64_t) row * row_bytes, vals + c * cap + i, 1, row_bytes, 0, 0, lane, Y + c * stride_col_y, nsub, stride_col_y);
+}
+
+int mmvk_rows_per_block(const ggml_type t) {
+    switch (t) {
+        case GGML_TYPE_Q6_K:  return mmvk_cfg<GGML_TYPE_Q6_K>::RW * mmvk_cfg<GGML_TYPE_Q6_K>::WARPS * (32 / MMVK_LPR);
+        case GGML_TYPE_IQ4_XS: return mmvk_cfg<GGML_TYPE_IQ4_XS>::RW * mmvk_cfg<GGML_TYPE_IQ4_XS>::WARPS * (32 / MMVK_LPR);
+        case GGML_TYPE_IQ4_NL: return mmvk_cfg<GGML_TYPE_IQ4_NL>::RW * mmvk_cfg<GGML_TYPE_IQ4_NL>::WARPS * (32 / MMVK_LPR);
+        default:              return mmvk_cfg<GGML_TYPE_COUNT>::RW * mmvk_cfg<GGML_TYPE_COUNT>::WARPS * (32 / MMVK_LPR);
+    }
+}
+
+// quantize src1 once per graph (the MMVQ q8_1 cache), run the group
+void mmvk_run(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, const int n) {
+    const ggml_tensor * a = nodes[0];
+    const ggml_tensor * src1 = a->src[1];
+    const ggml_type type = a->src[0]->type;
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne10 = src1->ne[0], ne11 = src1->ne[1];
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const size_t q8_size = ne11 * ne10_padded * sizeof(block_q8_1) / QK8_1;
+    const ggml_tensor * key = src1;
+    while (key->view_src != nullptr) key = key->view_src;
+    const int64_t s11 = src1->nb[1] / sizeof(float), s12 = src1->nb[2] / sizeof(float), s13 = src1->nb[3] / sizeof(float);
+    bool cached = false;
+    void * y = ctx.q8_1_cache_get(key, ctx.curr_stream_no, q8_size, ne10, ne11, 1, 1, s11, s12, s13, cached);
+    if (!cached) {
+        quantize_row_q8_1_cuda((const float *) src1->data, y, ne10, s11, s12, s13, ne10_padded, ne11, 1, 1, stream);
+    }
+    bool mixed = false;
+    for (int g = 1; g < n; ++g) mixed |= nodes[g]->src[0]->type != type;
+    const int rpb = mixed ? mmvk_rows_per_block(GGML_TYPE_COUNT) : mmvk_rows_per_block(type);
+    mmvk_args args{};
+    args.n = n;
+    int blocks = 0;
+    for (int g = 0; g < n; ++g) {
+        const ggml_tensor * d = nodes[g];
+        const ggml_tensor * w = d->src[0];
+        args.W[g] = (const uint8_t *) w->data;
+        args.D[g] = (float *) d->data;
+        args.M[g] = (int) w->ne[1];
+        args.type[g] = (int) w->type;
+        args.row_bytes[g] = w->nb[1];
+        args.stride_col_dst[g] = d->nb[1] / sizeof(float);
+        args.block_start[g] = blocks;
+        blocks += (int) ((w->ne[1] + rpb - 1) / rpb);
+    }
+    args.block_start[n] = blocks;
+    const int nsub = (int) (a->src[0]->ne[0] / QK8_1);
+    const int64_t stride_col_y = ne10_padded / QK8_1;
+    const block_q8_1 * Y = (const block_q8_1 *) y;
+    switch (mixed ? GGML_TYPE_COUNT : type) {
+        case GGML_TYPE_Q4_K:   mmvk_launch<GGML_TYPE_Q4_K>  (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_Q5_K:   mmvk_launch<GGML_TYPE_Q5_K>  (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_Q6_K:   mmvk_launch<GGML_TYPE_Q6_K>  (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_IQ4_XS: mmvk_launch<GGML_TYPE_IQ4_XS>(args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_IQ4_NL: mmvk_launch<GGML_TYPE_IQ4_NL>(args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_MXFP4:  mmvk_launch<GGML_TYPE_MXFP4> (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_COUNT:  mmvk_launch<GGML_TYPE_COUNT> (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        default: GGML_ABORT("mmvk: type");
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool mmvk_member_ok(const ggml_tensor * n) {
+    return n->op == GGML_OP_MUL_MAT && !ggml_cuda_head_int2_node(n) && ggml_cuda_mmvk_takes(n->src[0], n->src[1], n) && ggml_is_contiguous(n) &&
+        n->src[0]->buffer != nullptr && ggml_backend_buffer_get_usage(n->src[0]->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE;
+}
+
+} // namespace
+
+bool ggml_cuda_mmvk_type(const ggml_type type) {
+    return mmvk_on() && mmvk_type_ok(type) && GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ggml_cuda_get_device()].cc);
+}
+
+bool ggml_cuda_mmvk_takes(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (!ggml_cuda_mmvk_type(src0->type)) return false;
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) return false;
+    if (src1->ne[1] < 1 || src1->ne[1] > 8 || src0->ne[0] % ggml_blck_size(src0->type) != 0 || src1->ne[0] != src0->ne[0]) return false;
+    if (!ggml_is_contiguous(src0) || src1->nb[0] != sizeof(float) || dst->nb[0] != sizeof(float) || src0->view_src) return false;
+    return true;
+}
+
+void ggml_cuda_mmvk_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    GGML_UNUSED(src0); GGML_UNUSED(src1);
+    ggml_tensor * nodes[1] = { dst };
+    mmvk_run(ctx, nodes, 1);
+}
+
+bool ggml_cuda_mmvk_group_on() { return mmvk_on() && (mmvk_mode() == 2 || mmvk_mode() == 4); }
+
+bool ggml_cuda_mmvk_enabled() { return mmvk_mode() >= 1 && mmvk_mode() <= 4; }
+
+const char * ggml_cuda_mmvk_set_speculative(const bool on) {
+    mmvk_speculative.store(on, std::memory_order_relaxed);
+    const int m = mmvk_mode();
+    if (m == 0) {
+        return nullptr;
+    }
+    bool rdna4 = false;
+    for (int d = 0; d < ggml_cuda_info().device_count; ++d) {
+        rdna4 |= GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[d].cc);
+    }
+    static char msg[160];
+    if (m < 0 || m > 4) {
+        snprintf(msg, sizeof(msg), "mmvk: FRANK_MMVK=%d not recognized (1..4), off", m);
+    } else if (!rdna4) {
+        if (!mmvk_explicit()) {
+            return nullptr; // the default, on a GPU it does not run on: nothing to report
+        }
+        snprintf(msg, sizeof(msg), "mmvk: FRANK_MMVK=%d, but no RDNA4 device, off", m);
+    } else if (m >= 3 || on) {
+        snprintf(msg, sizeof(msg), "mmvk on (FRANK_MMVK=%d%s: %s, %s launches)", m, mmvk_explicit() ? "" : " by default",
+                 m >= 3 ? "always" : "speculative decoding", m % 2 == 0 ? "grouped" : "single");
+    } else {
+        snprintf(msg, sizeof(msg), "mmvk off (FRANK_MMVK=%d%s: no speculative decoding; 3 / 4 turn it on anyway)", m,
+                 mmvk_explicit() ? "" : " by default");
+    }
+    return msg;
+}
+
+void ggml_cuda_mmvk_group_reorder(ggml_cgraph * cgraph) {
+    // moving a MUL_MAT earlier is safe: its inputs are a weight and the shared src1, computed before the group's first node
+    constexpr int max_distance = 160;
+    std::unordered_set<const ggml_tensor *> taken;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        ggml_tensor * a = cgraph->nodes[i];
+        if (taken.count(a) || !mmvk_member_ok(a)) continue;
+        taken.insert(a);
+        int last = i, n = 1;
+        const int j_end = std::min(cgraph->n_nodes, i + 1 + max_distance);
+        for (int j = i + 1; j < j_end && n < MMVK_GMAX; ++j) {
+            ggml_tensor * b = cgraph->nodes[j];
+            if (taken.count(b) || !mmvk_same_group(a, b) || !mmvk_member_ok(b)) continue;
+            if (j != last + 1) {
+                memmove(cgraph->nodes + last + 2, cgraph->nodes + last + 1, (j - last - 1) * sizeof(ggml_tensor *));
+                cgraph->nodes[last + 1] = b;
+            }
+            taken.insert(b);
+            ++last; ++n;
+        }
+        i = last;
+    }
+}
+
+int ggml_cuda_mmvk_group(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, const int i) {
+    ggml_tensor * a = cgraph->nodes[i];
+    if (!mmvk_member_ok(a)) return 0;
+    int n = 1;
+    while (n < MMVK_GMAX && i + n < cgraph->n_nodes) {
+        const ggml_tensor * b = cgraph->nodes[i + n];
+        if (!mmvk_same_group(a, b) || !mmvk_member_ok(b)) break;
+        ++n;
+    }
+    if (n < 2) return 0;
+    mmvk_run(ctx, cgraph->nodes + i, n);
+    return n;
+}
+
+const block_q8_1 * ggml_cuda_mmvk_q8_1(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, int64_t & stride_col_y) {
+    // the same quantization (and the same per-graph cache entry) as mmvk_run
+    const int64_t ne10 = src1->ne[0], ne11 = src1->ne[1];
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const size_t q8_size = ne11 * ne10_padded * sizeof(block_q8_1) / QK8_1;
+    const ggml_tensor * key = src1;
+    while (key->view_src != nullptr) key = key->view_src;
+    const int64_t s11 = src1->nb[1] / sizeof(float), s12 = src1->nb[2] / sizeof(float), s13 = src1->nb[3] / sizeof(float);
+    bool cached = false;
+    void * y = ctx.q8_1_cache_get(key, ctx.curr_stream_no, q8_size, ne10, ne11, 1, 1, s11, s12, s13, cached);
+    if (!cached) {
+        quantize_row_q8_1_cuda((const float *) src1->data, y, ne10, s11, s12, s13, ne10_padded, ne11, 1, 1, ctx.stream());
+    }
+    stride_col_y = ne10_padded / QK8_1;
+    return (const block_q8_1 *) y;
+}
+
+void ggml_cuda_mmvk_rows_gather(const ggml_tensor * src0, const block_q8_1 * Y, const int64_t stride_col_y, const int * rows,
+                                const int * counts, const int cap, const int ncols, float * vals, cudaStream_t stream) {
+    const dim3 grid((cap + 3) / 4, ncols), block(128);
+    const int nsub = (int) (src0->ne[0] / QK8_1);
+    const uint8_t * W = (const uint8_t *) src0->data;
+    switch (src0->type) {
+        case GGML_TYPE_Q4_K: mmvk_gather_kernel<GGML_TYPE_Q4_K><<<grid, block, 0, stream>>>(W, src0->nb[1], Y, nsub, stride_col_y, rows, counts, cap, vals); break;
+        case GGML_TYPE_Q5_K: mmvk_gather_kernel<GGML_TYPE_Q5_K><<<grid, block, 0, stream>>>(W, src0->nb[1], Y, nsub, stride_col_y, rows, counts, cap, vals); break;
+        case GGML_TYPE_Q6_K: mmvk_gather_kernel<GGML_TYPE_Q6_K><<<grid, block, 0, stream>>>(W, src0->nb[1], Y, nsub, stride_col_y, rows, counts, cap, vals); break;
+        default: GGML_ABORT("mmvk gather: type %d", (int) src0->type);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
