+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, x->ne[0], x->ne[1]);
+
+    ggml_set_op_params_i32(result, 0, block_size);
+    ggml_set_op_params_i32(result, 1, n_taps);
+
+    result->op     = GGML_OP_DYN_CONV;
+    result->src[0] = x;
+    result->src[1] = c;
+    result->src[2] = w;
+
+    return result;
+}
