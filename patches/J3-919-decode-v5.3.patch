+// ggml_compute_forward_dyn_conv
+
+void ggml_compute_forward_dyn_conv(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const ggml_tensor * c = dst->src[1];
+    const ggml_tensor * w = dst->src[2];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && c->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+
+    const int     block_size = ggml_get_op_params_i32(dst, 0);
+    const int     n_taps     = ggml_get_op_params_i32(dst, 1);
+    const int64_t n          = x->ne[0];
+    const int64_t n_tokens   = x->ne[1];
+    const int64_t gs         = n / c->ne[0];
+
+    for (int64_t t = params->ith; t < n_tokens; t += params->nth) {
+        const int64_t p = t % block_size;
+        float * out = (float *) ((char *) dst->data + t * dst->nb[1]);
+        for (int64_t i = 0; i < n; ++i) {
+            float acc = 0.0f;
+            for (int tap = 0; tap < n_taps; ++tap) {
+                const float cv = *(const float *) ((const char *) c->data + (i / gs) * c->nb[0] + tap * c->nb[1] + t * c->nb[2]);
+                const float wt = cv + *(const float *) ((const char *) w->data + i * w->nb[0] + tap * w->nb[1]);
+                const float v  = p >= tap ? *(const float *) ((const char *) x->data + i * x->nb[0] + (t - tap) * x->nb[1]) : 0.0f;
+                const float term = wt * v;
+                acc = tap == 0 ? term : acc + term;
+            }
+            out[i] = acc;
+        }
+    }
+}
