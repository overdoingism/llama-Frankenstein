+            beta = ggml_sigmoid(ctx, beta);
+        }
+        ggml_tensor * fac      = nullptr;
+        ggml_tensor * n_replay = nullptr;
+        const int64_t n_fac = ggml_gated_delta_net_n_fac(head_size, H, head_size, head_count);
+        if (n_fac_tokens > 0) {
+            // rows: twice as many factor rows as sequences, sequence s reading row 2s + 1
+            fac      = rows ? ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_fac * n_fac_tokens, 2 * n_seqs)
+                            : ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_fac, n_fac_tokens, n_seqs);
+            n_replay = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_seqs);
+            ggml_set_name(fac,      "fac");
+            ggml_set_name(n_replay, "n_replay");
+        }
+        q = ggml_l2_norm(ctx, q, 1e-6f);
+        k = ggml_l2_norm(ctx, k, 1e-6f);
+        if (rows && fac != nullptr) {
+            ggml_tensor * ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_seqs);
+            ggml_set_name(ids, "fac_ids");
+            return ggml_gated_delta_net_anchor_rows(ctx, q, k, v, g, beta, state, fac, ids, n_replay);
+        }
+        return ggml_gated_delta_net_anchor(ctx, q, k, v, g, beta, state, fac, n_replay);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "g") == 0) {
+                init_tensor_uniform(t, -0.5f, -1e-4f);
+            } else if (strcmp(t->name, "beta") == 0) {
+                init_tensor_uniform(t, 0.0f, 1.0f);
+            } else if (strcmp(t->name, "v") == 0) {
+                init_tensor_uniform(t, -0.3f, 5.0f);
+            } else if (strcmp(t->name, "n_replay") == 0) {
+                // every count from 0 to n_fac_tokens across the sequences
+                std::vector<int32_t> n(t->ne[0]);
+                for (int64_t i = 0; i < t->ne[0]; ++i) {
+                    n[i] = (int32_t) ((i * 3 + 1) % (n_fac_tokens + 1));
+                }
+                ggml_backend_tensor_set(t, n.data(), 0, n.size() * sizeof(int32_t));
+            } else if (strcmp(t->name, "fac") == 0) {
+                init_tensor_uniform(t, 0.0f, 1.0f); // decays and betas in (0, 1); v and k small
+            } else if (strcmp(t->name, "fac_ids") == 0) {
+                std::vector<int32_t> ids(t->ne[0]);
+                for (int64_t i = 0; i < t->ne[0]; ++i) {
+                    ids[i] = (int32_t) (2 * i + 1);
+                }
+                ggml_backend_tensor_set(t, ids.data(), 0, ids.size() * sizeof(int32_t));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
