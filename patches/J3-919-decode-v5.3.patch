index 000000000..4fdf4c190
--- /dev/null
+++ b/ggml/src/ggml-cuda/dyn-conv.cu
@@ -0,0 +1,48 @@
+#include "dyn-conv.cuh"
+
+// GGML_OP_DYN_CONV: one thread per output, the float ops in the order of the ADD (coefficient + base), MUL, ADD chain
+// the op replaces, without contraction, so the result is bit-identical to that chain
+static __global__ void dyn_conv_f32(const float * __restrict__ x, const char * __restrict__ c, const float * __restrict__ w,
+                                    float * __restrict__ dst, const int n, const int n_tokens, const int gs, const int block_size,
+                                    const int n_taps, const int64_t x_s1, const int64_t c_nb0, const int64_t c_nb1, const int64_t c_nb2,
+                                    const int64_t w_s1, const int64_t dst_s1) {
+#pragma clang fp contract(off)
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const char * cg = c + (int64_t) (i / gs) * c_nb0;
+    for (int t = blockIdx.y; t < n_tokens; t += gridDim.y) {
+        const int p = t % block_size;
+        const char * ct = cg + (int64_t) t * c_nb2;
+        float acc = 0.0f;
+        for (int tap = 0; tap < n_taps; ++tap) {
+            const float wt   = *(const float *) (ct + (int64_t) tap * c_nb1) + w[(int64_t) tap * w_s1 + i];
+            const float v    = p >= tap ? x[(int64_t) (t - tap) * x_s1 + i] : 0.0f;
+            const float term = wt * v;
+            acc = tap == 0 ? term : acc + term;
+        }
+        dst[(int64_t) t * dst_s1 + i] = acc;
+    }
+}
+
+void ggml_cuda_op_dyn_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
