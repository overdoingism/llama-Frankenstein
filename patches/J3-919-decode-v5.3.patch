+void llama_memory_recurrent::anchor_input(uint32_t i, int32_t & row, int32_t & n_replay, int32_t & fac_src, int32_t & fac_dst) const {
+    const uint32_t   cell_idx = head + i;
+    const mem_cell & cell     = cells[cell_idx];
+    const int32_t    src0     = cell.src0;
+
+    uint32_t r = 0;
+    if (!cell.seq_id.empty()) {
+        const llama_seq_id seq = *cell.seq_id.begin();
+        if (seq >= 0 && (size_t) seq < rs_idx.size()) {
+            r = rs_idx[seq];
+        }
+    }
+
+    if (r > 0 || (replay_all && cell.n_fac_prev > 0)) {
+        // the start state of the last batch, with its accepted tokens replayed (replay_all: plane 0 was not written)
+        GGML_ASSERT(r <= cell.n_fac_prev);
+        row      = (int32_t) size + src0;
+        n_replay = (int32_t) (cell.n_fac_prev - r);
+    } else {
+        row      = src0;
+        n_replay = 0;
+    }
+    fac_src = (int32_t) (cell.fpar_prev * size) + src0;
+    fac_dst = (int32_t) (cell.fpar * size + cell_idx);
